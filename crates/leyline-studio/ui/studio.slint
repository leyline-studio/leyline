// Leyline Studio main window (`docs/roadmap.md` phase 5).
//
// The library browser: a filter bar on top, a thumbnail grid on the left,
// the metadata of the selected photo on the right.
//
// This file is the assembly point (ADR 0045): shared types live in
// `types.slint`, reusable controls in `widgets/`, and each panel or dialog
// in its own file. `StudioWindow` below holds the window attributes, the
// keyboard `FocusScope`, and the layout that puts the pieces together.
//
// The generated Rust re-exports what it needs through the `ui` module in
// `src/main.rs`, so every type named here must stay `export`ed from the
// file that declares it.

import {
    Cell,
    CollectionRow,
    ColorGradingZoneValues,
    CurveMarker,
    DevSettings,
    HslBandValues,
    MapPinMarker,
    Tr,
} from "types.slint";
import { LibraryState } from "state/library.slint";
import { FilterState } from "state/filter.slint";
import { DetailState } from "state/detail.slint";
import { CollectionState } from "state/collection.slint";
import { GridState } from "state/grid.slint";
import { MapState } from "state/map.slint";
import { DevelopState } from "state/develop.slint";
import { DialogState } from "state/dialog.slint";
import { DetailRow, EditSlider, FilterChip, GroupHeader } from "widgets/controls.slint";
import { MenuDropdown, MenuRow, MenuSep, SubmenuHeader, TopMenuLabel } from "widgets/menu.slint";

// Structs reach the generated Rust just by being used in the compiled tree,
// but a `global` only does when the root file re-exports it explicitly —
// without this, `ui::Tr` doesn't exist and Rust can't build its status-line
// and dialog messages (ADR 0019).
export { CollectionState, DetailState, DevelopState, DialogState, FilterState, GridState, LibraryState, MapState, Tr }

export component StudioWindow inherits Window {
    title: "Leyline Studio — " + LibraryState.library-name;
    // Taskbar/Alt-Tab/window-manager icon: the square badge, matching the
    // .exe icon embedded via windows-manifest.rc and the Linux desktop
    // entry's `packaging/icons` (ADR 0019) — one source of truth for "the
    // app icon" everywhere it's requested at a fixed square size.
    icon: @image-url("../../../packaging/icons/icon.png");
    preferred-width: 1280px;
    preferred-height: 800px;
    // Keeps the window from being resized below a usable size — mirrors
    // `MIN_WINDOW_WIDTH`/`MIN_WINDOW_HEIGHT` in main.rs, which only clamp
    // the *initial* screen-relative size and don't constrain later resizes.
    min-width: 1024px;
    min-height: 700px;
    background: #1b1b1b;
    forward-focus: keys;




    // A new photo's image just loaded (entered develop, or navigated):
    // loupe zoom is per-photo UI state, so it resets like Compare
    // Before/After does (in Rust, for `dev-compare`).
    //
    // `changed` only attaches to a property of the element declaring it, so
    // watching a global takes this local mirror. It moves into the develop
    // panel along with `dev-zoomed` itself (ADR 0045 §2).
    property <image> loaded-develop-image: DevelopState.develop-image;
    changed loaded-develop-image => {
        root.dev-zoomed = false;
    }





    property <length> cell-size: 176px;

    // Develop panel accordion state — purely local UI state, not mirrored
    // to Rust. Basic adjustments start open; the rest start collapsed so a
    // photo that only needs exposure/white-balance doesn't force scrolling
    // past groups that weren't touched.
    property <bool> expand-white-balance: true;
    property <bool> expand-tone: true;
    property <bool> expand-presence: false;
    property <bool> expand-camera-profile: false;
    property <bool> expand-lens: false;
    property <bool> expand-detail: false;
    property <bool> expand-tone-curve: false;
    property <bool> expand-hsl: false;
    property <bool> expand-color-grading: false;
    // Fixed band order (ADR 0031), parallel to `DevSettings::hsl`.
    property <[string]> hsl-band-names: [
        @tr("Red"), @tr("Orange"), @tr("Yellow"), @tr("Green"),
        @tr("Aqua"), @tr("Blue"), @tr("Purple"), @tr("Magenta"),
    ];
    property <bool> expand-spot-removal: false;
    property <bool> expand-geometry: false;
    property <bool> expand-history: false;

    // Which drag tool the develop image responds to: "select" (default,
    // dragging does nothing), "crop" (dragging draws the crop rectangle),
    // or "spot" (two clicks place a spot-removal clone, ADR 0032).
    property <string> active-tool: "select";
    // Loupe zoom: fit-to-window (false) or 100%-with-pan (true). Only
    // meaningful for the Select tool — Crop/Spot's coordinate mapping
    // assumes the fit-to-window letterbox, so switching tools drops back to
    // fit rather than making every drag tool zoom-aware.
    property <bool> dev-zoomed: false;
    // Spot tool's two-click gesture: true between the first (source) click
    // and the second (target) one, with the first click's viewport
    // position held here so a pending-source marker can be drawn.
    property <bool> spot-pending: false;
    property <float> spot-pending-vx: 0;
    property <float> spot-pending-vy: 0;

    // Custom menu bar state (see `TopMenuLabel`/`MenuDropdown` above).
    // `open-menu` is "" or one of "file"/"library"/"photo"/"develop-menu"/
    // "view"/"help"; the inline-expand submenus are independent booleans
    // since at most one of each is ever meaningfully open at a time.
    property <string> open-menu: "";
    property <bool> rate-submenu-open: false;
    property <bool> label-submenu-open: false;
    property <bool> flag-submenu-open: false;
    property <bool> apply-preset-submenu-open: false;
    property <bool> open-recent-submenu-open: false;

    function reset-submenus() {
        root.rate-submenu-open = false;
        root.label-submenu-open = false;
        root.flag-submenu-open = false;
        root.apply-preset-submenu-open = false;
        root.open-recent-submenu-open = false;
    }

    // Moves the selection to `index` and scrolls it into view.
    function select-cell(index: int) {
        if (index < 0 || index >= GridState.total-cells) {
            return;
        }
        GridState.selected = index;
        GridState.select(index);
        if (Math.floor(index / flick.columns) * root.cell-size < -flick.viewport-y) {
            flick.viewport-y = -Math.floor(index / flick.columns) * root.cell-size;
        } else if ((Math.floor(index / flick.columns) + 1) * root.cell-size > -flick.viewport-y + flick.height) {
            flick.viewport-y = flick.height - (Math.floor(index / flick.columns) + 1) * root.cell-size;
        }
    }


    keys := FocusScope {
        key-pressed(event) => {
            if (DialogState.dialog != "") {
                if (event.text == Key.Escape) {
                    DialogState.dialog = "";
                }
                return accept;
            }
            if (root.open-menu != "") {
                if (event.text == Key.Escape) {
                    root.open-menu = "";
                    root.reset-submenus();
                }
                return accept;
            }
            if (MapState.map-mode) {
                if (event.text == "m" || event.text == "M" || event.text == Key.Escape) {
                    MapState.exit-map();
                }
                return accept;
            }
            if (event.modifiers.control && (event.text == "p" || event.text == "P")) {
                DialogState.open-print();
                return accept;
            }
            if (event.modifiers.control && (event.text == "c" || event.text == "C")) {
                DevelopState.copy-settings();
                return accept;
            }
            if (event.modifiers.control && (event.text == "v" || event.text == "V")) {
                DevelopState.paste-settings();
                return accept;
            }
            if (DevelopState.develop-mode) {
                if (event.text == "g" || event.text == "G" || event.text == Key.Escape) {
                    DevelopState.exit-develop();
                    return accept;
                }
                if (event.modifiers.control && (event.text == "z" || event.text == "Z")) {
                    DevelopState.develop-undo();
                    return accept;
                }
                if (event.modifiers.control && (event.text == "y" || event.text == "Y")) {
                    DevelopState.develop-redo();
                    return accept;
                }
                if (event.text == "s" || event.text == "S") {
                    DevelopState.open-preset-dialog();
                    return accept;
                }
                if (event.text == "r" || event.text == "R") {
                    DevelopState.develop-reprocess();
                    return accept;
                }
                if (event.text == "\\") {
                    DevelopState.toggle-compare();
                    return accept;
                }
                if ((event.text == "z" || event.text == "Z") && root.active-tool == "select") {
                    root.dev-zoomed = !root.dev-zoomed;
                    return accept;
                }
                if (event.text == Key.LeftArrow) {
                    DevelopState.develop-prev();
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    DevelopState.develop-next();
                    return accept;
                }
                GridState.classify(event.text);
                return accept;
            }
            if (event.text == "d" || event.text == "D" || event.text == Key.Return) {
                DevelopState.enter-develop();
                return accept;
            }
            if (event.text == "i" || event.text == "I") {
                DialogState.dialog-result = "";
                DialogState.dialog = "import";
                return accept;
            }
            if (event.text == "e" || event.text == "E") {
                DialogState.open-export();
                return accept;
            }
            if (event.text == "t" || event.text == "T") {
                DialogState.open-tether();
                return accept;
            }
            if (event.text == "m" || event.text == "M") {
                MapState.enter-map();
                return accept;
            }
            if (event.text == "n" || event.text == "N") {
                DialogState.dialog-result = "";
                DialogState.dialog = "collection";
                return accept;
            }
            if (event.text == "b" || event.text == "B") {
                if (event.modifiers.shift) {
                    CollectionState.remove-from-collection();
                } else {
                    CollectionState.add-to-collection();
                }
                return accept;
            }
            if ((event.text == "r" || event.text == "R") && event.modifiers.shift) {
                DevelopState.reprocess-library();
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.select-cell(max(GridState.selected - 1, 0));
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.select-cell(GridState.selected < 0 ? 0 : GridState.selected + 1);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.select-cell(GridState.selected - flick.columns);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.select-cell(GridState.selected < 0 ? 0 : GridState.selected + flick.columns);
                return accept;
            }
            GridState.classify(event.text);
            accept
        }

        HorizontalLayout {
            visible: DevelopState.develop-mode;
            VerticalLayout {
                horizontal-stretch: 1;
                padding: 12px;
                spacing: 8px;

                Rectangle {
                    height: 28px;
                }

                HorizontalLayout {
                    Text {
                        text: DevelopState.develop-filename;
                        color: #f0f0f0;
                        font-size: 14px;
                        font-weight: 600;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: @tr("← →: next/prev photo · G: library · Ctrl+Z/Y: undo/redo · S: save preset · R: reprocess · Ctrl+P: print");
                        color: #666666;
                        font-size: 12px;
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    FilterChip {
                        text: @tr("Select");
                        active: root.active-tool == "select";
                        clicked => {
                            root.active-tool = "select";
                            root.spot-pending = false;
                        }
                    }
                    FilterChip {
                        text: @tr("Crop");
                        active: root.active-tool == "crop";
                        clicked => {
                            root.active-tool = "crop";
                            root.spot-pending = false;
                            root.dev-zoomed = false;
                        }
                    }
                    FilterChip {
                        text: @tr("Spot Removal");
                        active: root.active-tool == "spot";
                        clicked => {
                            root.active-tool = "spot";
                            root.dev-zoomed = false;
                        }
                    }
                    FilterChip {
                        // Loupe zoom (Z): 100%-with-pan vs fit-to-window,
                        // Select tool only (see `dev-zoomed`'s declaration).
                        text: root.dev-zoomed ? @tr("Fit") : @tr("100%    Z");
                        active: root.dev-zoomed;
                        enabled: root.active-tool == "select";
                        clicked => {
                            root.dev-zoomed = !root.dev-zoomed;
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    clip: true;

                    if !root.dev-zoomed: Image {
                        source: DevelopState.dev-compare ? DevelopState.develop-image-before : DevelopState.develop-image;
                        image-fit: contain;
                        width: 100%;
                        height: 100%;
                    }

                    // 100%-with-pan: the image at its native pixel size
                    // inside a scrollable viewport, instead of scaled to
                    // fit — for judging sharpening/noise reduction at the
                    // pixel level, which fit-to-window can't show.
                    if root.dev-zoomed: Flickable {
                        width: 100%;
                        height: 100%;
                        viewport-width: DevelopState.develop-image.width * 1px;
                        viewport-height: DevelopState.develop-image.height * 1px;
                        Image {
                            source: DevelopState.dev-compare ? DevelopState.develop-image-before : DevelopState.develop-image;
                            width: DevelopState.develop-image.width * 1px;
                            height: DevelopState.develop-image.height * 1px;
                        }
                    }

                    if DevelopState.dev-compare: Rectangle {
                        x: 8px;
                        y: 8px;
                        width: label.preferred-width + 16px;
                        height: label.preferred-height + 8px;
                        background: #000000aa;
                        border-radius: 4px;
                        label := Text {
                            x: 8px;
                            y: 4px;
                            text: @tr("Before");
                            color: #f0f0f0;
                            font-size: 12px;
                        }
                    }

                    // Only the Crop tool drags a crop rectangle — the
                    // default Select tool leaves dragging a no-op so a
                    // photo can be looked at without accidentally cropping.
                    crop-drag := TouchArea {
                        enabled: root.active-tool == "crop";
                        mouse-cursor: crosshair;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                DevelopState.develop-crop-drag(
                                    self.pressed-x / 1px, self.pressed-y / 1px,
                                    self.mouse-x / 1px, self.mouse-y / 1px,
                                    self.width / 1px, self.height / 1px,
                                    DevelopState.develop-image.width, DevelopState.develop-image.height);
                            }
                        }
                    }

                    // Selection rectangle, live while the mouse is down.
                    Rectangle {
                        visible: crop-drag.pressed;
                        x: min(crop-drag.pressed-x, crop-drag.mouse-x);
                        y: min(crop-drag.pressed-y, crop-drag.mouse-y);
                        width: abs((crop-drag.pressed-x - crop-drag.mouse-x) / 1px) * 1px;
                        height: abs((crop-drag.pressed-y - crop-drag.mouse-y) / 1px) * 1px;
                        background: #ffffff22;
                        border-width: 1px;
                        border-color: #f0f0f0;
                    }

                    // Spot removal (ADR 0032): two clicks place one spot —
                    // the first sets the source pin (shown as a marker
                    // until the second click), the second sets the target
                    // and commits the clone in one `develop-spot-click`
                    // call, mirroring `develop-crop-drag`'s single-call
                    // shape.
                    spot-click := TouchArea {
                        enabled: root.active-tool == "spot";
                        mouse-cursor: crosshair;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                if (!root.spot-pending) {
                                    root.spot-pending = true;
                                    root.spot-pending-vx = self.mouse-x / 1px;
                                    root.spot-pending-vy = self.mouse-y / 1px;
                                } else {
                                    DevelopState.develop-spot-click(
                                        root.spot-pending-vx, root.spot-pending-vy,
                                        self.mouse-x / 1px, self.mouse-y / 1px,
                                        self.width / 1px, self.height / 1px,
                                        DevelopState.develop-image.width, DevelopState.develop-image.height);
                                    root.spot-pending = false;
                                }
                            }
                        }
                    }

                    // Pending source pin, shown between the two spot clicks.
                    Rectangle {
                        visible: root.spot-pending;
                        x: root.spot-pending-vx * 1px - 5px;
                        y: root.spot-pending-vy * 1px - 5px;
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        background: #ffcc0055;
                        border-width: 1px;
                        border-color: #ffcc00;
                    }

                    // Right-click (ADR 0021): every entry is an existing
                    // callback already wired to a keyboard shortcut or a
                    // panel control above.
                    ContextMenuArea {
                        Menu {
                            MenuItem {
                                title: @tr("Reset Crop");
                                activated => {
                                    DevelopState.develop-edit("crop-reset", 0);
                                }
                            }
                            MenuItem {
                                title: @tr("Undo Last Spot");
                                enabled: DevelopState.dev-spot-count > 0;
                                activated => {
                                    DevelopState.develop-spot-undo();
                                }
                            }
                            MenuItem {
                                title: @tr("Clear All Spots");
                                enabled: DevelopState.dev-spot-count > 0;
                                activated => {
                                    DevelopState.develop-spot-reset();
                                }
                            }
                            MenuItem {
                                title: DevelopState.dev-compare ? @tr("Show After    \\") : @tr("Compare Before/After    \\");
                                activated => {
                                    DevelopState.toggle-compare();
                                }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: @tr("Reprocess    R");
                                activated => {
                                    DevelopState.develop-reprocess();
                                }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: @tr("Back to Library    G");
                                activated => {
                                    DevelopState.exit-develop();
                                }
                            }
                        }
                    }
                }

                // Filmstrip: the loaded grid window's thumbnails, so
                // switching photos doesn't require leaving develop mode.
                // Reuses `GridState.cells` (already populated for the grid) —
                // no separate data path.
                Flickable {
                    height: 64px;
                    viewport-width: GridState.cells.length * 64px;
                    HorizontalLayout {
                        for cell[i] in GridState.cells: TouchArea {
                            width: 64px;
                            height: 64px;
                            clicked => {
                                DevelopState.develop-switch(GridState.window-start + i);
                            }
                            Rectangle {
                                x: 2px;
                                y: 2px;
                                width: parent.width - 4px;
                                height: parent.height - 4px;
                                border-radius: 3px;
                                border-width: GridState.window-start + i == GridState.selected ? 2px : 0px;
                                border-color: #6fa8dc;
                                Image {
                                    source: cell.thumbnail;
                                    image-fit: contain;
                                    width: 100%;
                                    height: 100%;
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                width: 300px;
                background: #212121;

                Flickable {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        alignment: start;

                        Rectangle {
                            height: 28px;
                        }

                        Text {
                            text: @tr("Presets");
                            color: #9a9a9a;
                            font-size: 11px;
                        }
                        for name[i] in DevelopState.dev-presets: HorizontalLayout {
                            spacing: 6px;
                            TouchArea {
                                horizontal-stretch: 1;
                                Text {
                                    text: name;
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    overflow: elide;
                                    width: 100%;
                                    height: 100%;
                                    vertical-alignment: center;
                                }
                                clicked => {
                                    DevelopState.apply-preset(i);
                                }
                            }
                            TouchArea {
                                width: 16px;
                                height: 16px;
                                Text {
                                    text: "×";
                                    color: #9a9a9a;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                                clicked => {
                                    DevelopState.delete-preset(i);
                                }
                            }
                        }
                        HorizontalLayout {
                            alignment: end;
                            FilterChip {
                                text: @tr("Save as preset…");
                                active: false;
                                clicked => {
                                    DevelopState.open-preset-dialog();
                                }
                            }
                        }

                        // Histogram (RGB, sqrt-scaled so one dominant bin
                        // doesn't flatten the rest, `develop::histogram_layout`):
                        // read-only, refreshed whenever the develop preview
                        // itself refreshes (i.e. at each commit point, the
                        // same cadence the image updates at).
                        Rectangle {
                            height: 90px;
                            background: #1a1a1a;
                            border-radius: 4px;
                            Path {
                                width: 100%;
                                height: 100%;
                                viewbox-width: 256;
                                viewbox-height: 90;
                                fill: #ff444455;
                                commands: DevelopState.dev-histogram-r;
                            }
                            Path {
                                width: 100%;
                                height: 100%;
                                viewbox-width: 256;
                                viewbox-height: 90;
                                fill: #44ff4455;
                                commands: DevelopState.dev-histogram-g;
                            }
                            Path {
                                width: 100%;
                                height: 100%;
                                viewbox-width: 256;
                                viewbox-height: 90;
                                fill: #4444ff55;
                                commands: DevelopState.dev-histogram-b;
                            }
                        }

                        GroupHeader {
                            label: @tr("White balance");
                            expanded <=> root.expand-white-balance;
                        }
                        if root.expand-white-balance: VerticalLayout {
                            spacing: 12px;
                            EditSlider {
                                label: @tr("Temperature");
                                minimum: 2000;
                                maximum: 12000;
                                value: DevelopState.dev.wb-temp;
                                edited(v) => {
                                    DevelopState.develop-edit("wb-temp", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Tint");
                                minimum: -100;
                                maximum: 100;
                                value: DevelopState.dev.wb-tint;
                                edited(v) => {
                                    DevelopState.develop-edit("wb-tint", v);
                                }
                            }
                        }

                        GroupHeader {
                            label: @tr("Tone");
                            expanded <=> root.expand-tone;
                        }
                        if root.expand-tone: VerticalLayout {
                            spacing: 12px;
                            EditSlider {
                                label: @tr("Exposure");
                                minimum: -5;
                                maximum: 5;
                                decimals: 2;
                                value: DevelopState.dev.exposure;
                                edited(v) => {
                                    DevelopState.develop-edit("exposure", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Contrast");
                                minimum: -100;
                                maximum: 100;
                                value: DevelopState.dev.contrast;
                                edited(v) => {
                                    DevelopState.develop-edit("contrast", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Highlights");
                                minimum: -100;
                                maximum: 100;
                                value: DevelopState.dev.highlights;
                                edited(v) => {
                                    DevelopState.develop-edit("highlights", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Shadows");
                                minimum: -100;
                                maximum: 100;
                                value: DevelopState.dev.shadows;
                                edited(v) => {
                                    DevelopState.develop-edit("shadows", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Whites");
                                minimum: -100;
                                maximum: 100;
                                value: DevelopState.dev.whites;
                                edited(v) => {
                                    DevelopState.develop-edit("whites", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Blacks");
                                minimum: -100;
                                maximum: 100;
                                value: DevelopState.dev.blacks;
                                edited(v) => {
                                    DevelopState.develop-edit("blacks", v);
                                }
                            }
                        }

                        GroupHeader {
                            label: @tr("Presence");
                            expanded <=> root.expand-presence;
                        }
                        if root.expand-presence: VerticalLayout {
                            spacing: 12px;
                            EditSlider {
                                label: @tr("Clarity");
                                minimum: -100;
                                maximum: 100;
                                value: DevelopState.dev.clarity;
                                edited(v) => {
                                    DevelopState.develop-edit("clarity", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Texture");
                                minimum: -100;
                                maximum: 100;
                                value: DevelopState.dev.texture;
                                edited(v) => {
                                    DevelopState.develop-edit("texture", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Dehaze");
                                minimum: -100;
                                maximum: 100;
                                value: DevelopState.dev.dehaze;
                                edited(v) => {
                                    DevelopState.develop-edit("dehaze", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Highlight roll-off");
                                minimum: 0;
                                maximum: 100;
                                value: DevelopState.dev.highlight-rolloff;
                                edited(v) => {
                                    DevelopState.develop-edit("highlight-rolloff", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Vibrance");
                                minimum: -100;
                                maximum: 100;
                                value: DevelopState.dev.vibrance;
                                edited(v) => {
                                    DevelopState.develop-edit("vibrance", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Saturation");
                                minimum: -100;
                                maximum: 100;
                                value: DevelopState.dev.saturation;
                                edited(v) => {
                                    DevelopState.develop-edit("saturation", v);
                                }
                            }
                        }

                        GroupHeader {
                            label: @tr("Camera profile");
                            expanded <=> root.expand-camera-profile;
                        }
                        if root.expand-camera-profile: VerticalLayout {
                            spacing: 8px;
                            // The matrix path has not been validated against
                            // Adobe's own renders yet (`docs/pipeline.md`
                            // process 11): say so where the user chooses,
                            // not only in the ADR.
                            Text {
                                text: @tr("Experimental: colors are not yet validated against reference renders.");
                                color: #c8a45a;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: DevelopState.camera-profile-name == ""
                                    ? @tr("No profile — the decoder's own colors")
                                    : DevelopState.camera-profile-name;
                                color: #9a9a9a;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                FilterChip {
                                    text: @tr("Choose .dcp…");
                                    active: false;
                                    clicked => {
                                        DevelopState.browse-camera-profile();
                                    }
                                }
                                if DevelopState.camera-profile-name != "": FilterChip {
                                    active: DevelopState.dev.camera-profile;
                                    text: DevelopState.dev.camera-profile ? @tr("Enabled") : @tr("Disabled");
                                    clicked => {
                                        DevelopState.develop-edit("camera-profile", DevelopState.dev.camera-profile ? 0 : 1);
                                    }
                                }
                            }
                        }

                        GroupHeader {
                            label: @tr("Lens correction");
                            expanded <=> root.expand-lens;
                        }
                        if root.expand-lens: VerticalLayout {
                            spacing: 12px;
                            FilterChip {
                                active: DevelopState.dev.lens-correction;
                                text: DevelopState.dev.lens-correction ? @tr("Enabled") : @tr("Disabled");
                                clicked => {
                                    DevelopState.develop-edit("lens-correction", DevelopState.dev.lens-correction ? 0 : 1);
                                }
                            }
                        }

                        GroupHeader {
                            label: @tr("Detail");
                            expanded <=> root.expand-detail;
                        }
                        if root.expand-detail: VerticalLayout {
                            spacing: 12px;
                            EditSlider {
                                label: @tr("Luminance NR");
                                minimum: 0;
                                maximum: 100;
                                value: DevelopState.dev.nr-luminance;
                                edited(v) => {
                                    DevelopState.develop-edit("nr-luminance", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Color NR");
                                minimum: 0;
                                maximum: 100;
                                value: DevelopState.dev.nr-color;
                                edited(v) => {
                                    DevelopState.develop-edit("nr-color", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Sharpen amount");
                                minimum: 0;
                                maximum: 100;
                                value: DevelopState.dev.sharpen-amount;
                                edited(v) => {
                                    DevelopState.develop-edit("sharpen-amount", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Sharpen radius");
                                minimum: 0.5;
                                maximum: 3;
                                decimals: 1;
                                value: DevelopState.dev.sharpen-radius;
                                edited(v) => {
                                    DevelopState.develop-edit("sharpen-radius", v);
                                }
                            }
                        }

                        GroupHeader {
                            label: @tr("Tone Curve");
                            expanded <=> root.expand-tone-curve;
                        }
                        if root.expand-tone-curve: VerticalLayout {
                            spacing: 8px;
                            Text {
                                text: @tr("Click to add a point, click a point to remove it.");
                                color: #666666;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                            Rectangle {
                                width: 220px;
                                height: 220px;
                                background: #1b1b1b;
                                border-width: 1px;
                                border-color: #3a3a3a;

                                // Diagonal reference line: the identity curve.
                                Path {
                                    width: 220px;
                                    height: 220px;
                                    viewbox-width: 220;
                                    viewbox-height: 220;
                                    commands: "M0 220 L220 0";
                                    stroke: #444444;
                                    stroke-width: 1px;
                                }
                                // The actual curve, empty when there are no
                                // points (the identity curve above already
                                // shows that case).
                                Path {
                                    width: 220px;
                                    height: 220px;
                                    viewbox-width: 220;
                                    viewbox-height: 220;
                                    commands: DevelopState.dev-curve-path;
                                    stroke: #6fa8dc;
                                    stroke-width: 2px;
                                }
                                for point in DevelopState.dev-curve-points: Rectangle {
                                    x: point.x * 1px - 4px;
                                    y: point.y * 1px - 4px;
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: #6fa8dc;
                                }
                                curve-click := TouchArea {
                                    mouse-cursor: crosshair;
                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                            DevelopState.develop-curve-click(self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px);
                                        }
                                    }
                                }
                            }
                            FilterChip {
                                text: @tr("Reset Curve");
                                active: false;
                                clicked => {
                                    DevelopState.develop-curve-reset();
                                }
                            }
                        }

                        GroupHeader {
                            label: @tr("HSL Mixer");
                            expanded <=> root.expand-hsl;
                        }
                        if root.expand-hsl: VerticalLayout {
                            spacing: 14px;
                            for band[i] in DevelopState.dev.hsl: VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: root.hsl-band-names[i];
                                    color: #c0c0c0;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                                EditSlider {
                                    label: @tr("Hue");
                                    minimum: -100;
                                    maximum: 100;
                                    value: band.hue;
                                    edited(v) => {
                                        DevelopState.develop-edit-hsl-band(i, "hue", v);
                                    }
                                }
                                EditSlider {
                                    label: @tr("Saturation");
                                    minimum: -100;
                                    maximum: 100;
                                    value: band.saturation;
                                    edited(v) => {
                                        DevelopState.develop-edit-hsl-band(i, "saturation", v);
                                    }
                                }
                                EditSlider {
                                    label: @tr("Luminance");
                                    minimum: -100;
                                    maximum: 100;
                                    value: band.luminance;
                                    edited(v) => {
                                        DevelopState.develop-edit-hsl-band(i, "luminance", v);
                                    }
                                }
                            }
                        }

                        GroupHeader {
                            label: @tr("Color Grading");
                            expanded <=> root.expand-color-grading;
                        }
                        if root.expand-color-grading: VerticalLayout {
                            spacing: 14px;
                            VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: @tr("Shadows");
                                    color: #c0c0c0;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                                EditSlider {
                                    label: @tr("Hue");
                                    minimum: 0;
                                    maximum: 359;
                                    value: DevelopState.dev.color-grading-shadows.hue;
                                    edited(v) => {
                                        DevelopState.develop-edit-color-grading-zone("shadows", "hue", v);
                                    }
                                }
                                EditSlider {
                                    label: @tr("Saturation");
                                    minimum: 0;
                                    maximum: 100;
                                    value: DevelopState.dev.color-grading-shadows.saturation;
                                    edited(v) => {
                                        DevelopState.develop-edit-color-grading-zone("shadows", "saturation", v);
                                    }
                                }
                                EditSlider {
                                    label: @tr("Luminance");
                                    minimum: -100;
                                    maximum: 100;
                                    value: DevelopState.dev.color-grading-shadows.luminance;
                                    edited(v) => {
                                        DevelopState.develop-edit-color-grading-zone("shadows", "luminance", v);
                                    }
                                }
                            }
                            VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: @tr("Midtones");
                                    color: #c0c0c0;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                                EditSlider {
                                    label: @tr("Hue");
                                    minimum: 0;
                                    maximum: 359;
                                    value: DevelopState.dev.color-grading-midtones.hue;
                                    edited(v) => {
                                        DevelopState.develop-edit-color-grading-zone("midtones", "hue", v);
                                    }
                                }
                                EditSlider {
                                    label: @tr("Saturation");
                                    minimum: 0;
                                    maximum: 100;
                                    value: DevelopState.dev.color-grading-midtones.saturation;
                                    edited(v) => {
                                        DevelopState.develop-edit-color-grading-zone("midtones", "saturation", v);
                                    }
                                }
                                EditSlider {
                                    label: @tr("Luminance");
                                    minimum: -100;
                                    maximum: 100;
                                    value: DevelopState.dev.color-grading-midtones.luminance;
                                    edited(v) => {
                                        DevelopState.develop-edit-color-grading-zone("midtones", "luminance", v);
                                    }
                                }
                            }
                            VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: @tr("Highlights");
                                    color: #c0c0c0;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                                EditSlider {
                                    label: @tr("Hue");
                                    minimum: 0;
                                    maximum: 359;
                                    value: DevelopState.dev.color-grading-highlights.hue;
                                    edited(v) => {
                                        DevelopState.develop-edit-color-grading-zone("highlights", "hue", v);
                                    }
                                }
                                EditSlider {
                                    label: @tr("Saturation");
                                    minimum: 0;
                                    maximum: 100;
                                    value: DevelopState.dev.color-grading-highlights.saturation;
                                    edited(v) => {
                                        DevelopState.develop-edit-color-grading-zone("highlights", "saturation", v);
                                    }
                                }
                                EditSlider {
                                    label: @tr("Luminance");
                                    minimum: -100;
                                    maximum: 100;
                                    value: DevelopState.dev.color-grading-highlights.luminance;
                                    edited(v) => {
                                        DevelopState.develop-edit-color-grading-zone("highlights", "luminance", v);
                                    }
                                }
                            }
                            EditSlider {
                                label: @tr("Balance");
                                minimum: -100;
                                maximum: 100;
                                value: DevelopState.dev.color-grading-balance;
                                edited(v) => {
                                    DevelopState.develop-edit("color-grading-balance", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Blending");
                                minimum: 0;
                                maximum: 100;
                                value: DevelopState.dev.color-grading-blending;
                                edited(v) => {
                                    DevelopState.develop-edit("color-grading-blending", v);
                                }
                            }
                        }

                        GroupHeader {
                            label: @tr("Spot Removal");
                            expanded <=> root.expand-spot-removal;
                        }
                        if root.expand-spot-removal: VerticalLayout {
                            spacing: 8px;
                            Text {
                                text: @tr("Pick the Spot Removal tool above, click a clean source, then the spot to fix.");
                                color: #666666;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    spacing: 4px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: @tr("Radius %");
                                        color: #9a9a9a;
                                        font-size: 12px;
                                    }
                                    Rectangle {
                                        height: 26px;
                                        background: #1b1b1b;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: #3a3a3a;
                                        TextInput {
                                            x: 6px;
                                            width: parent.width - 12px;
                                            height: 100%;
                                            text <=> DevelopState.spot-radius-text;
                                            color: #e6e6e6;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            single-line: true;
                                        }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: @tr("Feather %");
                                        color: #9a9a9a;
                                        font-size: 12px;
                                    }
                                    Rectangle {
                                        height: 26px;
                                        background: #1b1b1b;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: #3a3a3a;
                                        TextInput {
                                            x: 6px;
                                            width: parent.width - 12px;
                                            height: 100%;
                                            text <=> DevelopState.spot-feather-text;
                                            color: #e6e6e6;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            single-line: true;
                                        }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: @tr("Opacity %");
                                        color: #9a9a9a;
                                        font-size: 12px;
                                    }
                                    Rectangle {
                                        height: 26px;
                                        background: #1b1b1b;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: #3a3a3a;
                                        TextInput {
                                            x: 6px;
                                            width: parent.width - 12px;
                                            height: 100%;
                                            text <=> DevelopState.spot-opacity-text;
                                            color: #e6e6e6;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            single-line: true;
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: @tr("{} spot(s)", DevelopState.dev-spot-count);
                                    color: #9a9a9a;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                FilterChip {
                                    text: @tr("Undo Last");
                                    active: false;
                                    clicked => {
                                        DevelopState.develop-spot-undo();
                                    }
                                }
                                FilterChip {
                                    text: @tr("Clear All");
                                    active: false;
                                    clicked => {
                                        DevelopState.develop-spot-reset();
                                    }
                                }
                            }
                        }

                        GroupHeader {
                            label: @tr("Geometry");
                            expanded <=> root.expand-geometry;
                        }
                        if root.expand-geometry: VerticalLayout {
                            spacing: 12px;
                            EditSlider {
                                label: @tr("Rotation");
                                minimum: -45;
                                maximum: 45;
                                decimals: 1;
                                value: DevelopState.dev.rotation;
                                edited(v) => {
                                    DevelopState.develop-edit("rotation", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Crop left");
                                minimum: 0;
                                maximum: 100;
                                value: DevelopState.dev.crop-left;
                                edited(v) => {
                                    DevelopState.develop-edit("crop-left", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Crop top");
                                minimum: 0;
                                maximum: 100;
                                value: DevelopState.dev.crop-top;
                                edited(v) => {
                                    DevelopState.develop-edit("crop-top", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Crop width");
                                minimum: 1;
                                maximum: 100;
                                value: DevelopState.dev.crop-width;
                                edited(v) => {
                                    DevelopState.develop-edit("crop-width", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Crop height");
                                minimum: 1;
                                maximum: 100;
                                value: DevelopState.dev.crop-height;
                                edited(v) => {
                                    DevelopState.develop-edit("crop-height", v);
                                }
                            }
                            HorizontalLayout {
                                alignment: end;
                                FilterChip {
                                    text: @tr("Reset crop");
                                    active: false;
                                    clicked => {
                                        DevelopState.develop-edit("crop-reset", 0);
                                    }
                                }
                            }
                        }

                        GroupHeader {
                            label: @tr("History");
                            expanded <=> root.expand-history;
                        }
                        // Browsable revision list beyond linear undo/redo
                        // (Ctrl+Z/Y): head first, click any row to jump
                        // straight to it (`checkout-history-row`).
                        if root.expand-history: VerticalLayout {
                            for entry[index] in DevelopState.dev-history: touch := TouchArea {
                                height: 26px;
                                clicked => {
                                    DevelopState.checkout-history-row(index);
                                }
                                Rectangle {
                                    width: 100%;
                                    height: 100%;
                                    background: index == DevelopState.dev-history-current ? #2f4f6f : (touch.has-hover ? #2a2a2a : transparent);
                                    border-radius: 4px;
                                    Text {
                                        x: 8px;
                                        text: index == DevelopState.dev-history-current ? @tr("{} (current)", entry) : entry;
                                        color: #d0d0d0;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        height: 100%;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            visible: MapState.map-mode;
            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    height: 28px;
                    spacing: 8px;
                    Text {
                        text: @tr("Map");
                        color: #f0f0f0;
                        font-size: 15px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    if MapState.map-pack-imported: FilterChip {
                        text: "−";
                        active: false;
                        clicked => {
                            MapState.map-zoom-out();
                        }
                    }
                    if MapState.map-pack-imported: FilterChip {
                        text: "+";
                        active: false;
                        clicked => {
                            MapState.map-zoom-in();
                        }
                    }
                    FilterChip {
                        text: @tr("Import Map Pack…");
                        active: false;
                        clicked => {
                            MapState.browse-map-pack();
                        }
                    }
                    FilterChip {
                        text: @tr("Close");
                        active: false;
                        clicked => {
                            MapState.exit-map();
                        }
                    }
                }

                if !MapState.map-pack-imported: VerticalLayout {
                    alignment: center;
                    Text {
                        text: MapState.map-status == "" ? @tr("No map pack imported yet. Import an offline MBTiles map pack to place GPS-tagged photos on a map.") : MapState.map-status;
                        color: #9a9a9a;
                        font-size: 13px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                if MapState.map-pack-imported: Rectangle {
                    width: 720px;
                    height: 480px;
                    clip: true;
                    background: #1a1a1a;

                    Image {
                        source: MapState.map-image;
                        width: 720px;
                        height: 480px;
                    }

                    // Drag-to-pan: recomputed once on release, not on every
                    // pointer move — repositioning would mean refetching
                    // and recompositing tiles, too heavy to do per pixel of
                    // movement.
                    map-drag := TouchArea {
                        width: 100%;
                        height: 100%;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                MapState.map-pan(
                                    (self.mouse-x - self.pressed-x) / 1px,
                                    (self.mouse-y - self.pressed-y) / 1px,
                                );
                            }
                        }
                    }

                    for pin[index] in MapState.map-pins: TouchArea {
                        x: pin.x * 1px - 6px;
                        y: pin.y * 1px - 6px;
                        width: 12px;
                        height: 12px;
                        clicked => {
                            MapState.map-pin-clicked(index);
                        }
                        Rectangle {
                            width: 12px;
                            height: 12px;
                            border-radius: 6px;
                            background: #e05c3e;
                            border-width: 1.5px;
                            border-color: #ffffff;
                        }
                    }

                    // OpenStreetMap attribution (ODbL requires it travel
                    // with wherever the data is displayed, ADR 0040) — a
                    // fixed overlay, not just a mention buried in About.
                    Rectangle {
                        x: parent.width - self.width - 4px;
                        y: parent.height - self.height - 4px;
                        width: attribution-text.width + 8px;
                        height: attribution-text.height + 4px;
                        background: #000000aa;
                        attribution-text := Text {
                            x: 4px;
                            y: 2px;
                            text: MapState.map-pack-attribution == "" ? "© OpenStreetMap contributors" : MapState.map-pack-attribution;
                            color: #d8d8d8;
                            font-size: 10px;
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            visible: !DevelopState.develop-mode && !MapState.map-mode;

            Rectangle {
                width: 190px;
                background: #202020;

                VerticalLayout {
                    padding: 10px;
                    spacing: 4px;

                    Rectangle {
                        height: 28px;
                    }

                    Text {
                        text: @tr("Collections");
                        color: #9a9a9a;
                        font-size: 11px;
                    }

                    Rectangle {
                        height: 24px;
                        border-radius: 4px;
                        background: CollectionState.active-collection == -1 ? #2f4f6f : transparent;
                        Text {
                            x: 8px;
                            width: parent.width - 16px;
                            height: 100%;
                            text: @tr("All photos");
                            color: #e6e6e6;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        TouchArea {
                            clicked => {
                                CollectionState.select-collection(-1);
                            }
                        }
                    }

                    Flickable {
                        vertical-stretch: 1;
                        viewport-height: CollectionState.collections.length * 26px;
                        for row[i] in CollectionState.collections: Rectangle {
                            y: i * 26px;
                            height: 24px;
                            width: parent.width;
                            border-radius: 4px;
                            background: CollectionState.active-collection == i ? #2f4f6f : transparent;
                            Text {
                                x: 8px + row.depth * 12px;
                                width: parent.width - self.x - 8px;
                                height: 100%;
                                text: (row.smart ? "◈ " : "") + row.name;
                                color: #d0d0d0;
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            TouchArea {
                                clicked => {
                                    CollectionState.select-collection(i);
                                }
                            }
                        }
                    }

                    Text {
                        text: @tr("N: new · B: add photo");
                        color: #666666;
                        font-size: 10px;
                    }
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                padding: 12px;
                spacing: 8px;

                Rectangle {
                    height: 28px;
                }

                HorizontalLayout {
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 2px;
                        for s in 5: TouchArea {
                            width: 18px;
                            height: 24px;
                            Text {
                                text: FilterState.filter-rating > s ? "★" : "☆";
                                color: FilterState.filter-rating > s ? #d8b23c : #666666;
                                font-size: 15px;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                            clicked => {
                                FilterState.rating-filter(s + 1);
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        for l in 5: TouchArea {
                            width: 16px;
                            height: 24px;
                            Rectangle {
                                width: 12px;
                                height: 12px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 6px;
                                background: FilterState.label-colors[l];
                                border-width: FilterState.filter-label == l ? 2px : 0px;
                                border-color: #f0f0f0;
                                opacity: FilterState.filter-label == l || FilterState.filter-label == -1 ? 1 : 0.35;
                            }
                            clicked => {
                                FilterState.label-filter(l);
                            }
                        }
                    }

                    FilterChip {
                        text: @tr("⚑ Picked");
                        active: FilterState.filter-pick == 1;
                        clicked => {
                            FilterState.pick-filter(1);
                        }
                    }
                    FilterChip {
                        text: @tr("✕ Rejected");
                        active: FilterState.filter-pick == 2;
                        clicked => {
                            FilterState.pick-filter(2);
                        }
                    }
                    FilterChip {
                        text: @tr("– Unflagged");
                        active: FilterState.filter-pick == 0;
                        clicked => {
                            FilterState.pick-filter(0);
                        }
                    }

                    if FilterState.filter-keyword-label != "": FilterChip {
                        text: "🏷 " + FilterState.filter-keyword-label;
                        active: true;
                        clicked => {
                            FilterState.clear-keyword-filter();
                        }
                    }

                    Rectangle {
                        height: 24px;
                        width: 180px;
                        background: #1b1b1b;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: search-input.text == "" ? #333333 : #6fa8dc;
                        search-input := TextInput {
                            x: 10px;
                            width: parent.width - 20px;
                            height: 100%;
                            color: #e6e6e6;
                            font-size: 12px;
                            vertical-alignment: center;
                            single-line: true;
                            accepted => {
                                FilterState.search(self.text);
                                keys.focus();
                            }
                        }
                        if search-input.text == "" && !search-input.has-focus: Text {
                            x: 10px;
                            height: 100%;
                            text: @tr("Search…");
                            color: #666666;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    FilterChip {
                        text: @tr("Sort: {}", FilterState.sort-label);
                        active: false;
                        clicked => {
                            FilterState.cycle-sort();
                        }
                    }
                }

                Text {
                    text: LibraryState.status-line;
                    color: #9a9a9a;
                    font-size: 13px;
                }

                flick := Flickable {
                    property <int> columns: max(1, Math.floor(self.width / root.cell-size));
                    // Virtual scrolling: only the loaded window has cells, but
                    // the viewport spans the whole grid; scrolling or resizing
                    // asks Rust for the matching window.
                    property <int> first-cell: Math.floor(-self.viewport-y / root.cell-size) * self.columns;
                    property <int> visible-cells: (Math.ceil(self.height / root.cell-size) + 1) * self.columns;
                    viewport-height: Math.ceil(GridState.total-cells / self.columns) * root.cell-size;
                    changed first-cell => {
                        GridState.viewport-moved(self.first-cell, self.visible-cells);
                    }
                    changed visible-cells => {
                        GridState.viewport-moved(self.first-cell, self.visible-cells);
                    }

                    for cell[i] in GridState.cells: Rectangle {
                        x: Math.mod(GridState.window-start + i, flick.columns) * root.cell-size;
                        y: Math.floor((GridState.window-start + i) / flick.columns) * root.cell-size;
                        width: root.cell-size;
                        height: root.cell-size;

                        Rectangle {
                            x: 4px;
                            y: 4px;
                            width: parent.width - 8px;
                            height: parent.height - 8px;
                            background: (GridState.window-start + i == GridState.selected || cell.multi-selected) ? #2f4f6f : #242424;
                            border-radius: 4px;
                            border-width: (GridState.window-start + i == GridState.selected || cell.multi-selected) ? 2px : 1px;
                            border-color: GridState.window-start + i == GridState.selected ? #6fa8dc : (cell.multi-selected ? #4a7aa8 : #333333);

                            VerticalLayout {
                                padding: 6px;
                                spacing: 4px;

                                Image {
                                    source: cell.thumbnail;
                                    image-fit: contain;
                                    vertical-stretch: 1;
                                }
                                HorizontalLayout {
                                    spacing: 4px;
                                    if cell.has-label: Rectangle {
                                        width: 10px;
                                        height: 10px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 5px;
                                        background: cell.label;
                                    }
                                    Text {
                                        text: cell.filename;
                                        color: #d0d0d0;
                                        font-size: 11px;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: cell.stars;
                                        color: #d8b23c;
                                        font-size: 11px;
                                    }
                                }
                            }
                        }

                        TouchArea {
                            double-clicked => {
                                GridState.selected = GridState.window-start + i;
                                GridState.select(GridState.window-start + i);
                                DevelopState.enter-develop();
                            }
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                    GridState.cell-clicked(GridState.window-start + i, event.modifiers.control, event.modifiers.shift);
                                }
                            }
                        }

                        // Right-click (ADR 0021): a second, per-photo path
                        // to the same classement/collection/reprocess
                        // callbacks already wired above and to the
                        // MenuBar (ADR 0020). Rate/Label/Flag/Reprocess/Copy
                        // Settings reset to a plain single selection here
                        // (`GridState.selected = ...; GridState.select(...)`), like
                        // every keyboard shortcut and menu-bar entry —
                        // *Paste* Settings is the one exception, acting on
                        // whatever multi-selection is already current
                        // instead (see its own comment below).
                        ContextMenuArea {
                            Menu {
                                MenuItem {
                                    title: @tr("Develop    D");
                                    activated => {
                                        GridState.selected = GridState.window-start + i;
                                        GridState.select(GridState.window-start + i);
                                        DevelopState.enter-develop();
                                    }
                                }
                                MenuSeparator { }
                                Menu {
                                    title: @tr("Rate");
                                    MenuItem {
                                        title: @tr("1 star    1");
                                        activated => {
                                            GridState.selected = GridState.window-start + i;
                                            GridState.select(GridState.window-start + i);
                                            GridState.classify("1");
                                        }
                                    }
                                    MenuItem {
                                        title: @tr("2 stars    2");
                                        activated => {
                                            GridState.selected = GridState.window-start + i;
                                            GridState.select(GridState.window-start + i);
                                            GridState.classify("2");
                                        }
                                    }
                                    MenuItem {
                                        title: @tr("3 stars    3");
                                        activated => {
                                            GridState.selected = GridState.window-start + i;
                                            GridState.select(GridState.window-start + i);
                                            GridState.classify("3");
                                        }
                                    }
                                    MenuItem {
                                        title: @tr("4 stars    4");
                                        activated => {
                                            GridState.selected = GridState.window-start + i;
                                            GridState.select(GridState.window-start + i);
                                            GridState.classify("4");
                                        }
                                    }
                                    MenuItem {
                                        title: @tr("5 stars    5");
                                        activated => {
                                            GridState.selected = GridState.window-start + i;
                                            GridState.select(GridState.window-start + i);
                                            GridState.classify("5");
                                        }
                                    }
                                    MenuSeparator { }
                                    MenuItem {
                                        title: @tr("Clear Rating    0");
                                        activated => {
                                            GridState.selected = GridState.window-start + i;
                                            GridState.select(GridState.window-start + i);
                                            GridState.classify("0");
                                        }
                                    }
                                }
                                Menu {
                                    title: @tr("Label");
                                    MenuItem {
                                        title: @tr("Red    6");
                                        activated => {
                                            GridState.selected = GridState.window-start + i;
                                            GridState.select(GridState.window-start + i);
                                            GridState.classify("6");
                                        }
                                    }
                                    MenuItem {
                                        title: @tr("Yellow    7");
                                        activated => {
                                            GridState.selected = GridState.window-start + i;
                                            GridState.select(GridState.window-start + i);
                                            GridState.classify("7");
                                        }
                                    }
                                    MenuItem {
                                        title: @tr("Green    8");
                                        activated => {
                                            GridState.selected = GridState.window-start + i;
                                            GridState.select(GridState.window-start + i);
                                            GridState.classify("8");
                                        }
                                    }
                                    MenuItem {
                                        title: @tr("Blue    9");
                                        activated => {
                                            GridState.selected = GridState.window-start + i;
                                            GridState.select(GridState.window-start + i);
                                            GridState.classify("9");
                                        }
                                    }
                                }
                                Menu {
                                    title: @tr("Flag");
                                    MenuItem {
                                        title: @tr("Pick    P");
                                        activated => {
                                            GridState.selected = GridState.window-start + i;
                                            GridState.select(GridState.window-start + i);
                                            GridState.classify("p");
                                        }
                                    }
                                    MenuItem {
                                        title: @tr("Reject    X");
                                        activated => {
                                            GridState.selected = GridState.window-start + i;
                                            GridState.select(GridState.window-start + i);
                                            GridState.classify("x");
                                        }
                                    }
                                    MenuItem {
                                        title: @tr("Clear    U");
                                        activated => {
                                            GridState.selected = GridState.window-start + i;
                                            GridState.select(GridState.window-start + i);
                                            GridState.classify("u");
                                        }
                                    }
                                }
                                MenuSeparator { }
                                MenuItem {
                                    title: @tr("Add to Collection    B");
                                    enabled: CollectionState.active-collection >= 0;
                                    activated => {
                                        GridState.selected = GridState.window-start + i;
                                        GridState.select(GridState.window-start + i);
                                        CollectionState.add-to-collection();
                                    }
                                }
                                MenuItem {
                                    title: @tr("Remove from Collection    Shift+B");
                                    enabled: CollectionState.active-collection >= 0;
                                    activated => {
                                        GridState.selected = GridState.window-start + i;
                                        GridState.select(GridState.window-start + i);
                                        CollectionState.remove-from-collection();
                                    }
                                }
                                MenuSeparator { }
                                MenuItem {
                                    // Library::reprocess (§10.4) on this photo
                                    // alone — not the EditSession::reprocess
                                    // path behind `R`, which needs an open
                                    // develop session. Same call as
                                    // Shift+R, scoped to one version.
                                    title: @tr("Reprocess");
                                    activated => {
                                        GridState.selected = GridState.window-start + i;
                                        GridState.select(GridState.window-start + i);
                                        DevelopState.reprocess-selected();
                                    }
                                }
                                MenuSeparator { }
                                MenuItem {
                                    // Copies from this one cell — reset to a
                                    // plain single selection is fine, the
                                    // source of a copy is always singular.
                                    title: @tr("Copy Settings");
                                    activated => {
                                        GridState.selected = GridState.window-start + i;
                                        GridState.select(GridState.window-start + i);
                                        DevelopState.copy-settings();
                                    }
                                }
                                MenuItem {
                                    // Deliberately does *not* touch
                                    // `selected`/`select` first: pasting must
                                    // act on whatever multi-selection is
                                    // already current (right-clicking one of
                                    // several already-selected photos), not
                                    // collapse it down to this one cell.
                                    title: @tr("Paste Settings");
                                    enabled: DevelopState.has-settings-clipboard;
                                    activated => {
                                        DevelopState.paste-settings();
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                width: 300px;
                background: #212121;

                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    alignment: start;

                    Rectangle {
                        height: 28px;
                    }

                    Text {
                        text: GridState.selected < 0 ? @tr("No photo selected") : DetailState.detail-filename;
                        color: #f0f0f0;
                        font-size: 15px;
                        font-weight: 600;
                        overflow: elide;
                    }
                    if GridState.selected >= 0: VerticalLayout {
                        spacing: 6px;
                        DetailRow {
                            label: @tr("Path");
                            value: DetailState.detail-path;
                        }
                        DetailRow {
                            label: @tr("Captured");
                            value: DetailState.detail-capture;
                        }
                        DetailRow {
                            label: @tr("Size");
                            value: DetailState.detail-dimensions;
                        }
                        DetailRow {
                            label: @tr("File");
                            value: DetailState.detail-file-size;
                        }
                        DetailRow {
                            label: @tr("Camera");
                            value: DetailState.detail-camera;
                        }
                        DetailRow {
                            label: @tr("Lens");
                            value: DetailState.detail-lens;
                        }
                        DetailRow {
                            label: @tr("Exposure");
                            value: DetailState.detail-exposure;
                        }

                        Text {
                            text: @tr("Keywords");
                            color: #9a9a9a;
                            font-size: 11px;
                        }
                        for kw[i] in DetailState.detail-keywords: HorizontalLayout {
                            spacing: 6px;
                            TouchArea {
                                horizontal-stretch: 1;
                                Text {
                                    text: kw;
                                    color: FilterState.filter-keyword-label == kw ? #6fa8dc : #e6e6e6;
                                    font-size: 12px;
                                    overflow: elide;
                                    width: 100%;
                                    height: 100%;
                                    vertical-alignment: center;
                                }
                                clicked => {
                                    FilterState.keyword-filter(i);
                                }
                            }
                            TouchArea {
                                width: 16px;
                                height: 16px;
                                Text {
                                    text: "×";
                                    color: #9a9a9a;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                                clicked => {
                                    DetailState.remove-keyword(i);
                                }
                            }
                        }
                        Rectangle {
                            height: 24px;
                            background: #1b1b1b;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: keyword-input.text == "" ? #333333 : #6fa8dc;
                            keyword-input := TextInput {
                                x: 8px;
                                width: parent.width - 16px;
                                height: 100%;
                                color: #e6e6e6;
                                font-size: 12px;
                                vertical-alignment: center;
                                single-line: true;
                                accepted => {
                                    DetailState.add-keyword(self.text);
                                    self.text = "";
                                    keys.focus();
                                }
                            }
                            if keyword-input.text == "" && !keyword-input.has-focus: Text {
                                x: 8px;
                                height: 100%;
                                text: @tr("Add keyword (Nature/Birds)…");
                                color: #666666;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Modal overlay: import and export dialogs.
        Rectangle {
            visible: DialogState.dialog != "";
            background: #000000aa;
            TouchArea {
                clicked => {
                    DialogState.dialog = "";
                }
            }

            Rectangle {
                width: 480px;
                background: #262626;
                border-radius: 8px;
                border-width: 1px;
                border-color: #3a3a3a;
                height: body.preferred-height;
                TouchArea { }

                body := VerticalLayout {
                    padding: 20px;
                    spacing: 12px;

                    if DialogState.dialog == "import": VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: @tr("Import photos");
                            color: #f0f0f0;
                            font-size: 15px;
                            font-weight: 600;
                        }
                        Text {
                            text: @tr("Source folder (absolute path)");
                            color: #9a9a9a;
                            font-size: 12px;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                height: 28px;
                                horizontal-stretch: 1;
                                background: #1b1b1b;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #3a3a3a;
                                import-source := TextInput {
                                    x: 8px;
                                    width: parent.width - 16px;
                                    height: 100%;
                                    text <=> DialogState.import-source-text;
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    single-line: true;
                                }
                            }
                            FilterChip {
                                text: @tr("Browse…");
                                active: false;
                                clicked => {
                                    DialogState.browse-import-source();
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            FilterChip {
                                text: @tr("Copy into library");
                                active: DialogState.import-copy;
                                clicked => {
                                    DialogState.import-copy = !DialogState.import-copy;
                                }
                            }
                            FilterChip {
                                text: @tr("Recursive");
                                active: DialogState.import-recursive;
                                clicked => {
                                    DialogState.import-recursive = !DialogState.import-recursive;
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            FilterChip {
                                text: @tr("Cancel");
                                active: false;
                                clicked => {
                                    DialogState.dialog = "";
                                }
                            }
                            FilterChip {
                                text: @tr("Import");
                                active: true;
                                clicked => {
                                    DialogState.run-import(import-source.text, DialogState.import-copy, DialogState.import-recursive);
                                }
                            }
                        }
                    }

                    if DialogState.dialog == "export": VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: DialogState.export-photo-count > 1
                                ? @tr("Export {} selected photos", DialogState.export-photo-count)
                                : @tr("Export selected photo");
                            color: #f0f0f0;
                            font-size: 15px;
                            font-weight: 600;
                        }
                        Text {
                            text: @tr("Preset");
                            color: #9a9a9a;
                            font-size: 12px;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            FilterChip {
                                text: @tr("Custom");
                                active: DialogState.export-preset == -1;
                                clicked => {
                                    DialogState.export-preset = -1;
                                }
                            }
                            for name[i] in DialogState.export-presets: FilterChip {
                                text: name;
                                active: DialogState.export-preset == i;
                                clicked => {
                                    DialogState.export-preset = i;
                                }
                            }
                        }
                        if DialogState.export-preset == -1: VerticalLayout {
                            spacing: 8px;
                            Text {
                                text: @tr("Format");
                                color: #9a9a9a;
                                font-size: 12px;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                for name[i] in ["JPEG", "PNG", "TIFF", "WebP", "AVIF"]: FilterChip {
                                    text: name;
                                    active: DialogState.export-format == i;
                                    clicked => {
                                        DialogState.export-format = i;
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    spacing: 4px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: @tr("Quality (1-100)");
                                        color: #9a9a9a;
                                        font-size: 12px;
                                    }
                                    Rectangle {
                                        height: 28px;
                                        background: #1b1b1b;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: #3a3a3a;
                                        TextInput {
                                            x: 8px;
                                            width: parent.width - 16px;
                                            height: 100%;
                                            text <=> DialogState.export-quality-text;
                                            color: #e6e6e6;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            single-line: true;
                                        }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: @tr("Max edge px (blank = full size)");
                                        color: #9a9a9a;
                                        font-size: 12px;
                                    }
                                    Rectangle {
                                        height: 28px;
                                        background: #1b1b1b;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: #3a3a3a;
                                        TextInput {
                                            x: 8px;
                                            width: parent.width - 16px;
                                            height: 100%;
                                            text <=> DialogState.export-max-edge-text;
                                            color: #e6e6e6;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            single-line: true;
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    spacing: 4px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: @tr("Save as preset (optional name)");
                                        color: #9a9a9a;
                                        font-size: 12px;
                                    }
                                    Rectangle {
                                        height: 28px;
                                        background: #1b1b1b;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: #3a3a3a;
                                        TextInput {
                                            x: 8px;
                                            width: parent.width - 16px;
                                            height: 100%;
                                            text <=> DialogState.export-preset-name;
                                            color: #e6e6e6;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            single-line: true;
                                        }
                                    }
                                }
                                FilterChip {
                                    text: @tr("Save as preset");
                                    active: false;
                                    clicked => {
                                        DialogState.run-save-export-preset(
                                            DialogState.export-preset-name,
                                            DialogState.export-format,
                                            DialogState.export-quality-text,
                                            DialogState.export-max-edge-text,
                                        );
                                    }
                                }
                            }
                        }
                        Text {
                            text: @tr("Destination folder (absolute path)");
                            color: #9a9a9a;
                            font-size: 12px;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                height: 28px;
                                horizontal-stretch: 1;
                                background: #1b1b1b;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #3a3a3a;
                                export-destination := TextInput {
                                    x: 8px;
                                    width: parent.width - 16px;
                                    height: 100%;
                                    text <=> DialogState.export-destination-text;
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    single-line: true;
                                }
                            }
                            FilterChip {
                                text: @tr("Browse…");
                                active: false;
                                clicked => {
                                    DialogState.browse-export-destination();
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            FilterChip {
                                text: @tr("Cancel");
                                active: false;
                                clicked => {
                                    DialogState.dialog = "";
                                }
                            }
                            FilterChip {
                                text: @tr("Export");
                                active: true;
                                clicked => {
                                    DialogState.run-export(
                                        DialogState.export-preset,
                                        export-destination.text,
                                        DialogState.export-format,
                                        DialogState.export-quality-text,
                                        DialogState.export-max-edge-text,
                                    );
                                }
                            }
                        }
                    }

                    if DialogState.dialog == "print": VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: @tr("Print selected photo");
                            color: #f0f0f0;
                            font-size: 15px;
                            font-weight: 600;
                        }
                        Text {
                            text: @tr("Preset");
                            color: #9a9a9a;
                            font-size: 12px;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            FilterChip {
                                text: @tr("Custom");
                                active: DialogState.print-preset == -1;
                                clicked => {
                                    DialogState.print-preset = -1;
                                }
                            }
                            for name[i] in DialogState.print-presets: FilterChip {
                                text: name;
                                active: DialogState.print-preset == i;
                                clicked => {
                                    DialogState.print-preset = i;
                                }
                            }
                        }
                        if DialogState.print-preset == -1: VerticalLayout {
                            spacing: 8px;
                            Text {
                                text: @tr("Paper");
                                color: #9a9a9a;
                                font-size: 12px;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                for name[i] in ["A4", "A3", "Letter"]: FilterChip {
                                    text: name;
                                    active: DialogState.print-paper == i;
                                    clicked => {
                                        DialogState.print-paper = i;
                                    }
                                }
                            }
                            Text {
                                text: @tr("Orientation");
                                color: #9a9a9a;
                                font-size: 12px;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                for name[i] in ["Portrait", "Landscape"]: FilterChip {
                                    text: name;
                                    active: DialogState.print-orientation == i;
                                    clicked => {
                                        DialogState.print-orientation = i;
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    spacing: 4px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: @tr("Margins (mm, all sides)");
                                        color: #9a9a9a;
                                        font-size: 12px;
                                    }
                                    Rectangle {
                                        height: 28px;
                                        background: #1b1b1b;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: #3a3a3a;
                                        TextInput {
                                            x: 8px;
                                            width: parent.width - 16px;
                                            height: 100%;
                                            text <=> DialogState.print-margins-text;
                                            color: #e6e6e6;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            single-line: true;
                                        }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: @tr("DPI");
                                        color: #9a9a9a;
                                        font-size: 12px;
                                    }
                                    Rectangle {
                                        height: 28px;
                                        background: #1b1b1b;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: #3a3a3a;
                                        TextInput {
                                            x: 8px;
                                            width: parent.width - 16px;
                                            height: 100%;
                                            text <=> DialogState.print-dpi-text;
                                            color: #e6e6e6;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            single-line: true;
                                        }
                                    }
                                }
                            }
                            Text {
                                text: @tr("Destination ICC profile (blank = sRGB)");
                                color: #9a9a9a;
                                font-size: 12px;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    height: 28px;
                                    horizontal-stretch: 1;
                                    background: #1b1b1b;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: #3a3a3a;
                                    TextInput {
                                        x: 8px;
                                        width: parent.width - 16px;
                                        height: 100%;
                                        text <=> DialogState.print-profile-text;
                                        color: #e6e6e6;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        single-line: true;
                                    }
                                }
                                FilterChip {
                                    text: @tr("Browse…");
                                    active: false;
                                    clicked => {
                                        DialogState.browse-print-profile();
                                    }
                                }
                            }
                            Text {
                                text: @tr("Rendering intent");
                                color: #9a9a9a;
                                font-size: 12px;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                for name[i] in ["Perceptual", "Relative", "Saturation", "Absolute"]: FilterChip {
                                    text: name;
                                    active: DialogState.print-intent == i;
                                    clicked => {
                                        DialogState.print-intent = i;
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    spacing: 4px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: @tr("Save as preset (optional name)");
                                        color: #9a9a9a;
                                        font-size: 12px;
                                    }
                                    Rectangle {
                                        height: 28px;
                                        background: #1b1b1b;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: #3a3a3a;
                                        TextInput {
                                            x: 8px;
                                            width: parent.width - 16px;
                                            height: 100%;
                                            text <=> DialogState.print-preset-name;
                                            color: #e6e6e6;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            single-line: true;
                                        }
                                    }
                                }
                                FilterChip {
                                    text: @tr("Save as preset");
                                    active: false;
                                    clicked => {
                                        DialogState.run-save-print-preset(
                                            DialogState.print-preset-name,
                                            DialogState.print-paper,
                                            DialogState.print-orientation,
                                            DialogState.print-margins-text,
                                            DialogState.print-dpi-text,
                                            DialogState.print-profile-text,
                                            DialogState.print-intent,
                                        );
                                    }
                                }
                            }
                        }
                        Text {
                            text: @tr("Destination folder (absolute path)");
                            color: #9a9a9a;
                            font-size: 12px;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                height: 28px;
                                horizontal-stretch: 1;
                                background: #1b1b1b;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #3a3a3a;
                                print-destination := TextInput {
                                    x: 8px;
                                    width: parent.width - 16px;
                                    height: 100%;
                                    text <=> DialogState.print-destination-text;
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    single-line: true;
                                }
                            }
                            FilterChip {
                                text: @tr("Browse…");
                                active: false;
                                clicked => {
                                    DialogState.browse-print-destination();
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                Text {
                                    text: @tr("Copies");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                                Rectangle {
                                    height: 28px;
                                    background: #1b1b1b;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: #3a3a3a;
                                    TextInput {
                                        x: 8px;
                                        width: parent.width - 16px;
                                        height: 100%;
                                        text <=> DialogState.print-copies-text;
                                        color: #e6e6e6;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        single-line: true;
                                    }
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            FilterChip {
                                text: @tr("Cancel");
                                active: false;
                                clicked => {
                                    DialogState.dialog = "";
                                }
                            }
                            FilterChip {
                                text: @tr("Print");
                                active: true;
                                clicked => {
                                    DialogState.run-print(
                                        DialogState.print-preset,
                                        print-destination.text,
                                        DialogState.print-paper,
                                        DialogState.print-orientation,
                                        DialogState.print-margins-text,
                                        DialogState.print-dpi-text,
                                        DialogState.print-profile-text,
                                        DialogState.print-intent,
                                        DialogState.print-copies-text,
                                    );
                                }
                            }
                        }
                    }

                    if DialogState.dialog == "tether": VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: @tr("Tethered capture");
                            color: #f0f0f0;
                            font-size: 15px;
                            font-weight: 600;
                        }
                        Text {
                            text: DialogState.tether-connected ? @tr("Connected — waiting for shots") : (DialogState.tether-status == "" ? @tr("Not connected. Plug in a camera over USB and click Connect.") : DialogState.tether-status);
                            color: DialogState.tether-connected ? #7fc97f : #9a9a9a;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        if DialogState.tether-connected: Text {
                            text: @tr("{} captured this session", DialogState.tether-captured-count);
                            color: #9a9a9a;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        if DialogState.tether-connected && DialogState.tether-last-captured != "": Text {
                            text: @tr("Last: {}", DialogState.tether-last-captured);
                            color: #9a9a9a;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            FilterChip {
                                text: @tr("Close");
                                active: false;
                                clicked => {
                                    DialogState.dialog = "";
                                }
                            }
                            if !DialogState.tether-connected: FilterChip {
                                text: @tr("Connect");
                                active: true;
                                clicked => {
                                    DialogState.run-tether-connect();
                                }
                            }
                            if DialogState.tether-connected: FilterChip {
                                text: @tr("Disconnect");
                                active: true;
                                clicked => {
                                    DialogState.run-tether-disconnect();
                                }
                            }
                        }
                    }

                    if DialogState.dialog == "watch": VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: @tr("Auto import");
                            color: #f0f0f0;
                            font-size: 15px;
                            font-weight: 600;
                        }
                        Text {
                            text: DialogState.watch-active ? @tr("Watching — waiting for files") : (DialogState.watch-status == "" ? @tr("Not watching. Pick a folder and click Start.") : DialogState.watch-status);
                            color: DialogState.watch-active ? #7fc97f : #9a9a9a;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        if !DialogState.watch-active: HorizontalLayout {
                            spacing: 8px;
                            watch-folder-input := TextInput {
                                text <=> DialogState.watch-folder-text;
                                color: #f0f0f0;
                                font-size: 12px;
                            }
                            FilterChip {
                                text: @tr("Browse…");
                                active: false;
                                clicked => {
                                    DialogState.browse-watch-folder();
                                }
                            }
                        }
                        if DialogState.watch-active: Text {
                            text: @tr("{} imported this session", DialogState.watch-imported-count);
                            color: #9a9a9a;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        if DialogState.watch-active && DialogState.watch-last-imported != "": Text {
                            text: @tr("Last: {}", DialogState.watch-last-imported);
                            color: #9a9a9a;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            FilterChip {
                                text: @tr("Close");
                                active: false;
                                clicked => {
                                    DialogState.dialog = "";
                                }
                            }
                            if !DialogState.watch-active: FilterChip {
                                text: @tr("Start");
                                active: true;
                                clicked => {
                                    DialogState.run-watch-start();
                                }
                            }
                            if DialogState.watch-active: FilterChip {
                                text: @tr("Stop");
                                active: true;
                                clicked => {
                                    DialogState.run-watch-stop();
                                }
                            }
                        }
                    }

                    if DialogState.dialog == "collection": VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: @tr("New collection");
                            color: #f0f0f0;
                            font-size: 15px;
                            font-weight: 600;
                        }
                        Text {
                            text: @tr("Name");
                            color: #9a9a9a;
                            font-size: 12px;
                        }
                        Rectangle {
                            height: 28px;
                            background: #1b1b1b;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #3a3a3a;
                            collection-name := TextInput {
                                x: 8px;
                                width: parent.width - 16px;
                                height: 100%;
                                color: #e6e6e6;
                                font-size: 12px;
                                vertical-alignment: center;
                                single-line: true;
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            FilterChip {
                                text: @tr("Cancel");
                                active: false;
                                clicked => {
                                    DialogState.dialog = "";
                                }
                            }
                            FilterChip {
                                text: @tr("Create");
                                active: true;
                                clicked => {
                                    CollectionState.run-new-collection(collection-name.text);
                                }
                            }
                        }
                    }

                    if DialogState.dialog == "preset": save-group := VerticalLayout {
                        spacing: 12px;
                        property <bool> g-white-balance: true;
                        property <bool> g-tone: true;
                        property <bool> g-presence: true;
                        property <bool> g-lens-correction: false;
                        property <bool> g-detail: false;
                        property <bool> g-geometry: false;

                        Text {
                            text: @tr("Save as preset");
                            color: #f0f0f0;
                            font-size: 15px;
                            font-weight: 600;
                        }
                        Text {
                            text: @tr("Name");
                            color: #9a9a9a;
                            font-size: 12px;
                        }
                        Rectangle {
                            height: 28px;
                            background: #1b1b1b;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #3a3a3a;
                            preset-name := TextInput {
                                x: 8px;
                                width: parent.width - 16px;
                                height: 100%;
                                color: #e6e6e6;
                                font-size: 12px;
                                vertical-alignment: center;
                                single-line: true;
                            }
                        }
                        Text {
                            text: @tr("Groups (geometry is rarely reused across photos)");
                            color: #9a9a9a;
                            font-size: 12px;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            FilterChip {
                                text: @tr("White balance");
                                active: save-group.g-white-balance;
                                clicked => {
                                    save-group.g-white-balance = !save-group.g-white-balance;
                                }
                            }
                            FilterChip {
                                text: @tr("Tone");
                                active: save-group.g-tone;
                                clicked => {
                                    save-group.g-tone = !save-group.g-tone;
                                }
                            }
                            FilterChip {
                                text: @tr("Presence");
                                active: save-group.g-presence;
                                clicked => {
                                    save-group.g-presence = !save-group.g-presence;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            FilterChip {
                                text: @tr("Lens correction");
                                active: save-group.g-lens-correction;
                                clicked => {
                                    save-group.g-lens-correction = !save-group.g-lens-correction;
                                }
                            }
                            FilterChip {
                                text: @tr("Detail");
                                active: save-group.g-detail;
                                clicked => {
                                    save-group.g-detail = !save-group.g-detail;
                                }
                            }
                            FilterChip {
                                text: @tr("Geometry");
                                active: save-group.g-geometry;
                                clicked => {
                                    save-group.g-geometry = !save-group.g-geometry;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            FilterChip {
                                text: @tr("Cancel");
                                active: false;
                                clicked => {
                                    DialogState.dialog = "";
                                }
                            }
                            FilterChip {
                                text: @tr("Save");
                                active: true;
                                clicked => {
                                    DevelopState.run-save-preset(
                                        preset-name.text,
                                        save-group.g-white-balance,
                                        save-group.g-tone,
                                        save-group.g-presence,
                                        save-group.g-lens-correction,
                                        save-group.g-detail,
                                        save-group.g-geometry);
                                }
                            }
                        }
                    }

                    // Help ▸ Keyboard Shortcuts…: the shortcut list already
                    // in this file, made discoverable outside develop mode
                    // too. Designing a dedicated panel is out of scope for
                    // ADR 0020 — this is the minimal read-only stand-in.
                    if DialogState.dialog == "shortcuts": VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: @tr("Keyboard shortcuts");
                            color: #f0f0f0;
                            font-size: 15px;
                            font-weight: 600;
                        }
                        VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: "G / D";
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    font-weight: 600;
                                    width: 110px;
                                }
                                Text {
                                    text: @tr("Library / develop");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: "I";
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    font-weight: 600;
                                    width: 110px;
                                }
                                Text {
                                    text: @tr("Import");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: "E";
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    font-weight: 600;
                                    width: 110px;
                                }
                                Text {
                                    text: @tr("Export");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: "T";
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    font-weight: 600;
                                    width: 110px;
                                }
                                Text {
                                    text: @tr("Tethered capture");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: "N";
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    font-weight: 600;
                                    width: 110px;
                                }
                                Text {
                                    text: @tr("New collection");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: "B / Shift+B";
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    font-weight: 600;
                                    width: 110px;
                                }
                                Text {
                                    text: @tr("Add / remove from collection");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: "Shift+R";
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    font-weight: 600;
                                    width: 110px;
                                }
                                Text {
                                    text: @tr("Reprocess library");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: "R";
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    font-weight: 600;
                                    width: 110px;
                                }
                                Text {
                                    text: @tr("Reprocess (develop mode)");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: "Ctrl+Z / Ctrl+Y";
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    font-weight: 600;
                                    width: 110px;
                                }
                                Text {
                                    text: @tr("Undo / redo");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: "S";
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    font-weight: 600;
                                    width: 110px;
                                }
                                Text {
                                    text: @tr("Save preset");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: "0–5";
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    font-weight: 600;
                                    width: 110px;
                                }
                                Text {
                                    text: @tr("Rate");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: "6–9";
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    font-weight: 600;
                                    width: 110px;
                                }
                                Text {
                                    text: @tr("Color label");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: "P / X / U";
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    font-weight: 600;
                                    width: 110px;
                                }
                                Text {
                                    text: @tr("Pick / reject / clear");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            FilterChip {
                                text: @tr("Close");
                                active: true;
                                clicked => {
                                    DialogState.dialog = "";
                                }
                            }
                        }
                    }

                    if DialogState.dialog == "about": VerticalLayout {
                        spacing: 12px;
                        HorizontalLayout {
                            alignment: center;
                            // The wide wordmark banner, not the square app
                            // icon: About is the one place in the UI with
                            // room to show the full brand lockup rather than
                            // just the badge used everywhere else (window
                            // icon, taskbar, installer — see `icon:` on
                            // `StudioWindow`).
                            Image {
                                source: @image-url("../../../assets/leyline-studio.png");
                                width: 300px;
                                height: 200px;
                                image-fit: contain;
                            }
                        }
                        Text {
                            text: @tr("Version {}", LibraryState.app-version);
                            color: #9a9a9a;
                            font-size: 11px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: @tr("Local-first, non-destructive RAW development.");
                            color: #c8c8c8;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        Text {
                            text: @tr("Library: {}", LibraryState.library-path);
                            color: #909090;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "https://github.com/leyline-studio/leyline";
                            color: #c8b06a;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        Text {
                            text: @tr("Licensed under {}", "GPL-3.0-only");
                            color: #9a9a9a;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            FilterChip {
                                text: @tr("Close");
                                active: true;
                                clicked => {
                                    DialogState.dialog = "";
                                }
                            }
                        }
                    }

                    if DialogState.dialog-result != "": Text {
                        text: DialogState.dialog-result;
                        color: #d8b23c;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // Custom menu bar's dropdown panels (see `TopMenuLabel` above for
        // why this isn't Slint's native `MenuBar`). Declared last so they
        // paint over everything, including the modal dialog overlay above.
        if root.open-menu != "": Rectangle {
            // Invisible full-window catcher: clicking outside any dropdown
            // closes the open menu.
            TouchArea {
                clicked => {
                    root.open-menu = "";
                    root.reset-submenus();
                }
            }

            if root.open-menu == "file": MenuDropdown {
                x: file-label.x;
                y: 28px;
                MenuRow {
                    title: @tr("Import…    I");
                    activated => {
                        DialogState.dialog-result = "";
                        DialogState.dialog = "import";
                        root.open-menu = "";
                    }
                }
                MenuRow {
                    title: @tr("Export…    E");
                    activated => {
                        DialogState.open-export();
                        root.open-menu = "";
                    }
                }
                MenuSep { }
                MenuRow {
                    title: @tr("Open Library…");
                    activated => {
                        LibraryState.open-library-requested();
                        root.open-menu = "";
                    }
                }
                SubmenuHeader {
                    title: @tr("Open Recent");
                    expanded <=> root.open-recent-submenu-open;
                    enabled: LibraryState.recent-libraries.length > 0;
                }
                if root.open-recent-submenu-open: VerticalLayout {
                    for path[index] in LibraryState.recent-libraries: MenuRow {
                        title: path;
                        activated => {
                            LibraryState.open-recent-library(index);
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                }
                MenuSep { }
                MenuRow {
                    title: @tr("Print…    Ctrl+P");
                    activated => {
                        DialogState.open-print();
                        root.open-menu = "";
                    }
                }
                MenuRow {
                    title: @tr("Tethered Capture…    T");
                    activated => {
                        DialogState.open-tether();
                        root.open-menu = "";
                    }
                }
                MenuRow {
                    title: @tr("Auto Import…");
                    activated => {
                        DialogState.open-watch();
                        root.open-menu = "";
                    }
                }
                MenuRow {
                    title: @tr("Map…    M");
                    activated => {
                        MapState.enter-map();
                        root.open-menu = "";
                    }
                }
                MenuSep { }
                MenuRow {
                    // ADR 0019 (language preferences) is decided but not
                    // yet implemented: kept visible per the ADR 0020 menu
                    // map, disabled until there is a preferences panel to
                    // open.
                    title: @tr("Preferences…");
                    enabled: false;
                }
                MenuSep { }
                MenuRow {
                    title: @tr("Quit");
                    activated => {
                        LibraryState.quit();
                    }
                }
            }

            if root.open-menu == "library": MenuDropdown {
                x: library-label.x;
                y: 28px;
                MenuRow {
                    title: @tr("New Collection…    N");
                    activated => {
                        DialogState.dialog-result = "";
                        DialogState.dialog = "collection";
                        root.open-menu = "";
                    }
                }
                MenuRow {
                    title: @tr("Add to Collection    B");
                    enabled: GridState.selected >= 0 && CollectionState.active-collection >= 0;
                    activated => {
                        CollectionState.add-to-collection();
                        root.open-menu = "";
                    }
                }
                MenuRow {
                    title: @tr("Remove from Collection    Shift+B");
                    enabled: GridState.selected >= 0 && CollectionState.active-collection >= 0;
                    activated => {
                        CollectionState.remove-from-collection();
                        root.open-menu = "";
                    }
                }
                MenuSep { }
                MenuRow {
                    title: @tr("Reprocess Library…    Shift+R");
                    activated => {
                        DevelopState.reprocess-library();
                        root.open-menu = "";
                    }
                }
            }

            if root.open-menu == "photo": MenuDropdown {
                x: photo-label.x;
                y: 28px;
                SubmenuHeader {
                    title: @tr("Rate");
                    expanded <=> root.rate-submenu-open;
                }
                if root.rate-submenu-open: VerticalLayout {
                    MenuRow {
                        title: @tr("1 star    1");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("1");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                    MenuRow {
                        title: @tr("2 stars    2");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("2");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                    MenuRow {
                        title: @tr("3 stars    3");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("3");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                    MenuRow {
                        title: @tr("4 stars    4");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("4");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                    MenuRow {
                        title: @tr("5 stars    5");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("5");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                    MenuSep { }
                    MenuRow {
                        title: @tr("Clear Rating    0");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("0");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                }
                SubmenuHeader {
                    title: @tr("Label");
                    expanded <=> root.label-submenu-open;
                }
                if root.label-submenu-open: VerticalLayout {
                    MenuRow {
                        title: @tr("Red    6");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("6");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                    MenuRow {
                        title: @tr("Yellow    7");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("7");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                    MenuRow {
                        title: @tr("Green    8");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("8");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                    MenuRow {
                        title: @tr("Blue    9");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("9");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                }
                SubmenuHeader {
                    title: @tr("Flag");
                    expanded <=> root.flag-submenu-open;
                }
                if root.flag-submenu-open: VerticalLayout {
                    MenuRow {
                        title: @tr("Pick    P");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("p");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                    MenuRow {
                        title: @tr("Reject    X");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("x");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                    MenuRow {
                        title: @tr("Clear    U");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("u");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                }
                MenuSep { }
                MenuRow {
                    title: @tr("Develop    D");
                    enabled: GridState.selected >= 0 && !DevelopState.develop-mode;
                    activated => {
                        DevelopState.enter-develop();
                        root.open-menu = "";
                    }
                }
                MenuRow {
                    // Today `R` only reprocesses the photo open in
                    // develop — same contract here: disabled outside
                    // that context rather than silently acting on
                    // something else.
                    title: @tr("Reprocess    R");
                    enabled: DevelopState.develop-mode;
                    activated => {
                        DevelopState.develop-reprocess();
                        root.open-menu = "";
                    }
                }
            }

            if root.open-menu == "develop-menu" && DevelopState.develop-mode: MenuDropdown {
                x: develop-label.x;
                y: 28px;
                MenuRow {
                    title: @tr("Undo    Ctrl+Z");
                    activated => {
                        DevelopState.develop-undo();
                        root.open-menu = "";
                    }
                }
                MenuRow {
                    title: @tr("Redo    Ctrl+Y");
                    activated => {
                        DevelopState.develop-redo();
                        root.open-menu = "";
                    }
                }
                MenuSep { }
                MenuRow {
                    title: @tr("Save Preset…    S");
                    activated => {
                        DevelopState.open-preset-dialog();
                        root.open-menu = "";
                    }
                }
                SubmenuHeader {
                    title: @tr("Apply Preset");
                    expanded <=> root.apply-preset-submenu-open;
                    enabled: DevelopState.dev-presets.length > 0;
                }
                if root.apply-preset-submenu-open: VerticalLayout {
                    for name[index] in DevelopState.dev-presets: MenuRow {
                        title: name;
                        activated => {
                            DevelopState.apply-preset(index);
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                }
                MenuSep { }
                MenuRow {
                    title: @tr("Back to Library    G");
                    activated => {
                        DevelopState.exit-develop();
                        root.open-menu = "";
                    }
                }
            }

            if root.open-menu == "view": MenuDropdown {
                x: view-label.x;
                y: 28px;
                MenuRow {
                    title: @tr("Library    G");
                    enabled: DevelopState.develop-mode;
                    activated => {
                        DevelopState.exit-develop();
                        root.open-menu = "";
                    }
                }
                MenuRow {
                    title: @tr("Develop    D");
                    enabled: !DevelopState.develop-mode && GridState.selected >= 0;
                    activated => {
                        DevelopState.enter-develop();
                        root.open-menu = "";
                    }
                }
            }

            if root.open-menu == "help": MenuDropdown {
                x: help-label.x;
                y: 28px;
                MenuRow {
                    title: @tr("Keyboard Shortcuts…");
                    activated => {
                        DialogState.dialog-result = "";
                        DialogState.dialog = "shortcuts";
                        root.open-menu = "";
                    }
                }
                MenuRow {
                    title: @tr("About Leyline");
                    activated => {
                        DialogState.dialog-result = "";
                        DialogState.dialog = "about";
                        root.open-menu = "";
                    }
                }
            }
        }
    }

    // `MenuBar` was a magic top-level element Slint gives special sizing
    // treatment (reserving space above the rest of the content natively);
    // a plain `HorizontalLayout` isn't. `keys` above (and its content)
    // therefore keeps its untouched, default fill-parent geometry —
    // giving it (or any ancestor of its repeaters: the grid, the
    // collections list) an explicit position/size override of any kind,
    // even a inert-looking one, was enough on its own to reintroduce a
    // repaint bug extremely similar to the native-`MenuBar` one this whole
    // rewrite exists to avoid (confirmed repeatedly; see
    // studio-repaint-bug-unresolved in project memory for the fuller
    // writeup). Concretely, this means: (1) `menu-row` is declared last —
    // after `keys` — purely so it paints on top of it (Slint paints
    // siblings in declaration order); it is not stacked above `keys` via
    // layout, the two simply overlap, and (2) each content column that
    // needs to visually clear the menu row's height reserves that space
    // with a plain spacer `Rectangle` as an extra *child* inside its own
    // already-existing `VerticalLayout` (adding a sibling element was
    // safe in testing) — never via a property override on the column
    // itself or on `keys`.
    menu-row := HorizontalLayout {
        // Custom menu bar (ADR 0020): a second, discoverable path to the
        // same callbacks already wired to keyboard shortcuts above — no
        // new functionality, no new code path. Context-sensitive entries
        // are disabled outside the context where their shortcut is
        // meaningful. Not Slint's native `MenuBar` — see the comment above
        // `TopMenuLabel` for why. The dropdown panels themselves are
        // declared later, in the same overlay z-order as the modal
        // dialogs, so they paint on top of the grid/develop view; only the
        // row of labels lives here.
        x: 0;
        y: 0;
        height: 28px;
        alignment: start;
        padding-left: 4px;
        spacing: 2px;

        file-label := TopMenuLabel {
            title: @tr("File");
            active: root.open-menu == "file";
            clicked => {
                root.open-menu = root.open-menu == "file" ? "" : "file";
                root.reset-submenus();
            }
        }
        library-label := TopMenuLabel {
            title: @tr("Library");
            active: root.open-menu == "library";
            clicked => {
                root.open-menu = root.open-menu == "library" ? "" : "library";
                root.reset-submenus();
            }
        }
        photo-label := TopMenuLabel {
            title: @tr("Photo");
            active: root.open-menu == "photo";
            clicked => {
                root.open-menu = root.open-menu == "photo" ? "" : "photo";
                root.reset-submenus();
            }
        }
        develop-label := TopMenuLabel {
            title: @tr("Develop");
            active: root.open-menu == "develop-menu";
            enabled: DevelopState.develop-mode;
            clicked => {
                root.open-menu = root.open-menu == "develop-menu" ? "" : "develop-menu";
                root.reset-submenus();
            }
        }
        view-label := TopMenuLabel {
            title: @tr("View");
            active: root.open-menu == "view";
            clicked => {
                root.open-menu = root.open-menu == "view" ? "" : "view";
                root.reset-submenus();
            }
        }
        help-label := TopMenuLabel {
            title: @tr("Help");
            active: root.open-menu == "help";
            clicked => {
                root.open-menu = root.open-menu == "help" ? "" : "help";
                root.reset-submenus();
            }
        }
    }
}
