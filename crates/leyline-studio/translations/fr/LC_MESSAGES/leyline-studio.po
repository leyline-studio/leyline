msgctxt "ReportDialog"
msgid "The folder will hold three files, and nothing else:"
msgstr "Le dossier contiendra trois fichiers, et rien d'autre :"

#: crates/leyline-studio/ui/dialogs/report.slint:58
msgctxt "ReportDialog"
msgid ""
"description.txt — what you just wrote\n"
