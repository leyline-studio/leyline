// Leyline Studio main window (`docs/roadmap.md` phase 5).
//
// The assembly point, and nothing else (ADR 0045 §3): shared types live in
// `types.slint`, application state in `state/`, reusable controls in
// `widgets/`, and each view or dialog in its own file under `panels/` and
// `dialogs/`. What is left here is what genuinely belongs to the window —
// its attributes, the keyboard `FocusScope`, and the order the pieces are
// mounted in.

import { Cell, CollectionRow, ColorGradingZoneValues, CurveMarker, DevSettings, FolderRow, HslBandValues, KeywordRow, MapPinMarker, MaskDab, MaskRow, PresetRow, ProfileRow, SurveyCell, TetherControl, Tr } from "types.slint";
import { CollectionState } from "state/collection.slint";
import { FolderState } from "state/folder.slint";
import { DetailState } from "state/detail.slint";
import { DevelopState } from "state/develop.slint";
import { DialogState } from "state/dialog.slint";
import { FilterState } from "state/filter.slint";
import { GridState } from "state/grid.slint";
import { KeywordState } from "state/keyword.slint";
import { LibraryState } from "state/library.slint";
import { MapState } from "state/map.slint";
import { MaskState } from "state/mask.slint";
import { PreferencesState } from "state/preferences.slint";
import { TetherState } from "state/tether.slint";
import { BrowserPanel } from "panels/browser.slint";
import { DevelopPanel } from "panels/develop.slint";
import { DialogOverlay } from "panels/dialogs.slint";
import { DragState } from "state/drag.slint";
import { HintState } from "state/hint.slint";
import { ComparePanel } from "panels/compare.slint";
import { LoupePanel } from "panels/loupe.slint";
import { SurveyPanel } from "panels/survey.slint";
import { MapPanel } from "panels/map.slint";
import { MenuBar } from "panels/menubar.slint";
import { TetherBar } from "panels/tether.slint";
// A second top-level window, not a panel of this one: it is shown when
// `StudioWindow` was never built (ADR 0122). Imported and re-exported here
// because the generated Rust only sees what this root file exports.
import { StartupErrorWindow } from "startup_error.slint";

// The generated Rust only sees what the root file re-exports: the structs it
// builds models from, and the globals it reads and writes through
// `Global::<T>::get(&window)` (ADR 0045 §1).
export {
    Cell,
    CollectionRow,
    CollectionState,
    ColorGradingZoneValues,
    CurveMarker,
    DetailState,
    DevSettings,
    DevelopState,
    DialogState,
    FilterState,
    FolderRow,
    FolderState,
    GridState,
    HslBandValues,
    KeywordRow,
    KeywordState,
    LibraryState,
    MapPinMarker,
    MapState,
    MaskDab,
    MaskRow,
    MaskState,
    PreferencesState,
    PresetRow,
    ProfileRow,
    SurveyCell,
    TetherControl,
    TetherState,
    Tr,
    StartupErrorWindow,
}

export component StudioWindow inherits Window {
    title: "Leyline Studio — " + LibraryState.library-name;
    // Taskbar/Alt-Tab/window-manager icon: the square badge, matching the
    // .exe icon embedded via windows-manifest.rc and the Linux desktop
    // entry's `packaging/icons` (ADR 0019) — one source of truth for "the
    // app icon" everywhere it's requested at a fixed square size.
    icon: @image-url("../../../packaging/icons/icon.png");
    preferred-width: 1280px;
    preferred-height: 800px;
    // The smallest the window may be dragged to — and a size the interface
    // genuinely honours, which 1024x700 did not: at that width the right
    // panel was pushed clean off the window, in English before French even
    // came into it. What makes 900x600 true is `narrow-threshold` below,
    // which folds the side panels away before the layout runs out of room.
    //
    // Mirrors `MIN_WINDOW_WIDTH`/`MIN_WINDOW_HEIGHT` in main.rs, which set
    // the *initial* size; this constrains later resizes.
    min-width: 900px;
    min-height: 600px;
    // A main window's maximum size must never be dictated by what happens to
    // be on screen. Slint derives a window's constraints from its content,
    // and a column of fixed-height rows reports a bounded maximum, which the
    // winit backend forwards to the window manager as
    // `program specified maximum size`. Two things followed: the window
    // could not be maximized at all, and every recomposition that changed
    // that bound (opening or closing a dialog, creating a collection)
    // re-applied it — a maximized window snapped back to the content's
    // maximum. Declaring the maximum here overrides the computed one, which
    // is the only way to say "no maximum" in Slint 1.13.
    max-width: 100000px;
    max-height: 100000px;
    background: #1b1b1b;
    forward-focus: keys;

    // Panel folding (ADR 0055 §6). Declared on the window rather than in a
    // global because it is interface state that three panels read and Rust
    // never does (ADR 0045 §2): the window owns it, the panels take it as an
    // input. `Tab` drops the side panels, `Maj+Tab` drops the toolbars and
    // the filmstrip too — the menu row always stays, since it carries the
    // module switcher and therefore the way out.
    // Seeded from the stored preference and reported back on every change
    // (ADR 0136 §5). Only the manual fold is stored: the automatic one below
    // `narrow-threshold` is a constraint, not a decision.
    property <bool> side-panels-hidden: PreferencesState.panels-folded;
    property <bool> chrome-hidden: false;
    // Below this width the side panels fold on their own, and the fold is a
    // constraint rather than a preference: the sidebar and the detail panel
    // are 500px of fixed width between them, and the filter bar cannot
    // shrink past its controls, so keeping all three on a narrow window does
    // not compress the layout — it pushes the right-hand panel outside the
    // window, where nothing hints that it exists. Folding is what makes
    // `min-width: 900px` a size the interface can actually honour.
    //
    // The threshold is set from the *longest* translation rather than from
    // English: the same bar is noticeably wider in French, and a threshold
    // tuned to English would leave French overflowing in the band between.
    //
    // Measured, not guessed: at 1340px the sidebar, the French filter bar's
    // minimum and the 300px metadata panel add up to more than the window,
    // and a `HorizontalLayout` that cannot fit its children overflows to the
    // right instead of shrinking — the metadata panel went off the edge, the
    // description fields cut in half. The layout first fits at ~1384px, and
    // 1340px was exactly the width `startup_size` opens a 1920x1080 screen
    // at, so the commonest desktop there is met that overflow on its first
    // launch. 1400px is the first round number clear of it.
    //
    // Since ADR 0130 §2 this is the **metadata** panel's threshold alone —
    // which is what the measurement above was always about — and the
    // sidebar has its own, lower, one below.
    property <length> narrow-threshold: 1400px;
    // And below this one the sidebar goes too (ADR 0130 §2). 1100px:
    // 200px of sidebar and the filter bar's own minimum — the bar is chips
    // sized by their labels beside a search field that gives ground down to
    // 90px — leave the grid a usable width there, and nothing off the edge
    // of the window. It is the *other* 300px, the metadata panel, that the
    // 1340px measurement above was about.
    property <length> sidebar-threshold: 1100px;
    // What the **browser** reads. `side-panels-hidden` stays the manual
    // gesture (Tab, ADR 0055 §6) and keeps working; this is that choice, or
    // the window being too narrow to have one.
    //
    // Deliberately not used by Develop. There, the 300px panel *is* the
    // module — every slider lives in it — so folding it automatically would
    // turn Develop into a picture viewer on a small screen, which is a
    // worse failure than the one this fixes. In the browser the same panel
    // is informational, and the grid is still a grid without it. Develop
    // therefore keeps only the manual fold, where hiding the controls is
    // what the user just asked for.
    // **Assigned, never bound.** A binding that reads `root.width` here is a
    // cycle: the window's width is derived from what its content asks for,
    // the content asks for less once the panels fold, and the fold would be
    // read off the width — Slint reports
    // `side-panels-hidden -> layoutinfo-h -> ... -> browser-panels-folded`
    // and then resolves it with a stale value, which is a warning rather
    // than an error and would have shipped looking fine. The same geometry
    // hazard ADR 0045 §3 records, reached from the other side.
    //
    // Writing it from a `changed` handler breaks the cycle: an event handler
    // assigns, it does not participate in the dependency graph.
    property <bool> browser-panels-folded: false;
    // The metadata panel folds earlier than the sidebar (ADR 0130 §2): it
    // is informational, and dropping it alone is what lets a 1366px laptop
    // keep its folders and its collections instead of losing both panels
    // at once. It keeps `narrow-threshold`, which it always was the
    // measurement for: what went off the edge at 1340px was the metadata
    // panel.
    property <bool> browser-detail-folded: false;
    // The same fold for Develop, at its own threshold and on one column
    // only (ADR 0125 §1). The paragraph above says Develop keeps its panels
    // because there the panels *are* the module — which is true of the
    // right-hand one, and not of the left. Navigator, presets, versions and
    // history are what one *chooses* with (ADR 0124 §1); the sliders are
    // what one *works* with. So the left column is the one that yields,
    // and the settings panel never does.
    //
    // 1150px, and measured rather than picked: 260px of left column plus
    // 300px of settings leaves 590px of viewer at that width, which is
    // still a photograph one can judge; below it the viewer is the thing
    // being squeezed, and the column that chooses is worth less then than
    // the picture. Assigned from the same handler, for the same
    // cycle-avoidance reason.
    property <length> develop-narrow-threshold: 1150px;
    property <bool> develop-left-folded: false;
    function refresh-fold() {
        root.browser-detail-folded =
            root.side-panels-hidden || root.width < root.narrow-threshold;
        root.browser-panels-folded =
            root.side-panels-hidden || root.width < root.sidebar-threshold;
        root.develop-left-folded = root.width < root.develop-narrow-threshold;
    }
    changed width => {
        root.refresh-fold();
    }
    changed side-panels-hidden => {
        root.refresh-fold();
        PreferencesState.remember-panels-folded(self.side-panels-hidden);
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (DialogState.dialog != "") {
                if (event.text == Key.Escape) {
                    DialogState.dialog = "";
                }
                return accept;
            }
            if (menubar.open-menu != "") {
                if (event.text == Key.Escape) {
                    menubar.open-menu = "";
                    menubar.reset-submenus();
                }
                return accept;
            }
            if (MapState.map-mode) {
                if (event.text == "m" || event.text == "M" || event.text == Key.Escape) {
                    MapState.exit-map();
                }
                return accept;
            }
            if (event.modifiers.control && (event.text == "p" || event.text == "P")) {
                DialogState.open-print();
                return accept;
            }
            // Panel folding (ADR 0055 §6), before every view-specific branch
            // so it works the same in the library, the loupe and develop.
            // `Maj+Tab` folds everything and unfolds everything: from any
            // state, one press gets the interface back.
            if (event.text == Key.Tab || event.text == Key.Backtab) {
                // Shift+Tab arrives as `Backtab` on some platforms with the
                // modifier already consumed, so the key itself counts too.
                if (event.modifiers.shift || event.text == Key.Backtab) {
                    root.chrome-hidden = !root.chrome-hidden;
                    root.side-panels-hidden = root.chrome-hidden;
                } else {
                    root.side-panels-hidden = !root.side-panels-hidden;
                    if (!root.side-panels-hidden) {
                        root.chrome-hidden = false;
                    }
                }
                return accept;
            }
            // Export moved off `E` so the loupe could have it, the letter a
            // Lightroom user presses without thinking (ADR 0055 §4). Handled
            // here, before the develop branch, so exporting works from both
            // views rather than only from the library.
            if (event.modifiers.control && (event.text == "e" || event.text == "E")) {
                DialogState.open-export();
                return accept;
            }
            // Ctrl+Shift+C asks which categories, Ctrl+C copies the
            // remembered set without asking (ADR 0132 §5). Tested first,
            // since Shift is not exclusive with the plain form below.
            if (event.modifiers.control && event.modifiers.shift
                && (event.text == "c" || event.text == "C")) {
                DevelopState.open-copy-dialog();
                return accept;
            }
            if (event.modifiers.control && (event.text == "c" || event.text == "C")) {
                DevelopState.copy-settings();
                return accept;
            }
            if (event.modifiers.control && (event.text == "v" || event.text == "V")) {
                DevelopState.paste-settings();
                return accept;
            }
            // `Ctrl+Z` means "undo here" (ADR 0129 §3): in Develop it walks
            // the revision graph, in the library it steps the edit stack.
            // Placed before the develop branch, and guarded by it, so the
            // two never race for the same keystroke.
            if (!DevelopState.develop-mode && event.modifiers.control
                && (event.text == "z" || event.text == "Z")) {
                LibraryState.undo-library();
                return accept;
            }
            if (!DevelopState.develop-mode && event.modifiers.control
                && (event.text == "y" || event.text == "Y")) {
                LibraryState.redo-library();
                return accept;
            }
            if (DevelopState.develop-mode) {
                if (event.text == "g" || event.text == "G" || event.text == Key.Escape) {
                    DevelopState.exit-develop();
                    return accept;
                }
                if (event.modifiers.control && (event.text == "z" || event.text == "Z")) {
                    DevelopState.develop-undo();
                    return accept;
                }
                // Clipping overlays (ADR 0092 §2): J toggles the pair, the
                // Lightroom muscle memory.
                if (event.text == "j" || event.text == "J") {
                    DevelopState.toggle-clipping("both");
                    return accept;
                }
                // Composition guides (ADR 0135 §3): O cycles them, the key
                // both references use. It reaches the panel rather than a
                // global, because the guide is a property of the crop tool
                // and nothing outside develop has an opinion about it.
                if (event.text == "o" || event.text == "O") {
                    develop.cycle-guide();
                    return accept;
                }
                if (event.modifiers.control && (event.text == "y" || event.text == "Y")) {
                    DevelopState.develop-redo();
                    return accept;
                }
                if (event.text == "s" || event.text == "S") {
                    DevelopState.open-preset-dialog();
                    return accept;
                }
                if (event.text == "r" || event.text == "R") {
                    DevelopState.develop-reprocess();
                    return accept;
                }
                if (event.text == "\\") {
                    DevelopState.toggle-compare();
                    return accept;
                }
                if ((event.text == "z" || event.text == "Z") && develop.active-tool == "select") {
                    develop.dev-zoomed = !develop.dev-zoomed;
                    return accept;
                }
                if (event.text == Key.LeftArrow) {
                    DevelopState.develop-prev();
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    DevelopState.develop-next();
                    return accept;
                }
                GridState.classify(event.text);
                return accept;
            }
            // Leaving the loupe is `G` — the same key that leaves develop —
            // or Escape, and it is checked before `G` can mean anything else.
            if (GridState.loupe-mode && (event.text == "g" || event.text == "G" || event.text == Key.Escape)) {
                GridState.loupe-mode = false;
                GridState.loupe-mode-changed();
                return accept;
            }
            if (GridState.loupe-mode && (event.text == "z" || event.text == "Z")) {
                loupe.zoomed = !loupe.zoomed;
                return accept;
            }
            // Compare (ADR 0057): the arrows move the candidate and only the
            // candidate, `↑` promotes it, `Z` zooms both views at once.
            if (GridState.compare-mode) {
                if (event.text == "g" || event.text == "G" || event.text == Key.Escape
                    || event.text == "c" || event.text == "C") {
                    GridState.compare-mode = false;
                    GridState.compare-mode-changed();
                    return accept;
                }
                if (event.text == Key.LeftArrow) {
                    GridState.compare-candidate-step(-1);
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    GridState.compare-candidate-step(1);
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    GridState.compare-swap();
                    return accept;
                }
                if (event.text == "z" || event.text == "Z") {
                    compare.zoomed = !compare.zoomed;
                    return accept;
                }
                if (event.text == "d" || event.text == "D") {
                    GridState.compare-mode = false;
                    GridState.compare-mode-changed();
                    DevelopState.enter-develop();
                    return accept;
                }
                GridState.classify(event.text);
                return accept;
            }
            if (GridState.survey-mode) {
                if (event.text == "g" || event.text == "G" || event.text == Key.Escape
                    || event.text == "n" || event.text == "N") {
                    GridState.survey-mode = false;
                    GridState.survey-mode-changed();
                    return accept;
                }
                if (event.text == "d" || event.text == "D") {
                    GridState.survey-mode = false;
                    GridState.survey-mode-changed();
                    DevelopState.enter-develop();
                    return accept;
                }
                GridState.classify(event.text);
                return accept;
            }
            // `C` and `N` are the Lightroom keys for these two views; both
            // leave the loupe behind, since three ways of looking at once is
            // none (ADR 0057 §1).
            if (event.text == "c" || event.text == "C") {
                if (GridState.selected >= 0) {
                    GridState.loupe-mode = false;
                    GridState.loupe-mode-changed();
                    GridState.compare-mode = true;
                    GridState.compare-mode-changed();
                }
                return accept;
            }
            if ((event.text == "n" || event.text == "N") && !event.modifiers.control) {
                if (GridState.selected >= 0) {
                    GridState.loupe-mode = false;
                    GridState.loupe-mode-changed();
                    GridState.survey-mode = true;
                    GridState.survey-mode-changed();
                }
                return accept;
            }
            if (event.text == "d" || event.text == "D" || event.text == Key.Return) {
                // Develop takes over the window: the loupe steps aside
                // rather than staying up behind it.
                GridState.loupe-mode = false;
                DevelopState.enter-develop();
                return accept;
            }
            if (event.text == "i" || event.text == "I") {
                DialogState.dialog-result = "";
                DialogState.dialog = "import";
                return accept;
            }
            // `E` shows the selected photo large without opening an edit
            // session, and toggles back (ADR 0055 §3-4).
            if (event.text == "e" || event.text == "E") {
                if (GridState.selected >= 0) {
                    GridState.loupe-mode = !GridState.loupe-mode;
                    GridState.loupe-mode-changed();
                }
                return accept;
            }
            if (event.text == "t" || event.text == "T") {
                DialogState.open-tether();
                return accept;
            }
            if (event.text == "m" || event.text == "M") {
                MapState.enter-map();
                return accept;
            }
            // New Collection moved off `N` so the survey view could have it,
            // the same trade `E`/`Ctrl+E` made in ADR 0055 §4.
            if (event.modifiers.control && (event.text == "n" || event.text == "N")) {
                DialogState.dialog-result = "";
                DialogState.dialog = "collection";
                return accept;
            }
            if (event.text == "b" || event.text == "B") {
                if (event.modifiers.shift) {
                    CollectionState.remove-from-collection();
                } else {
                    CollectionState.add-to-collection();
                }
                return accept;
            }
            if ((event.text == "r" || event.text == "R") && event.modifiers.shift) {
                DevelopState.reprocess-library();
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                browser.select-cell(max(GridState.selected - 1, 0));
                return accept;
            }
            if (event.text == Key.RightArrow) {
                browser.select-cell(GridState.selected < 0 ? 0 : GridState.selected + 1);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                browser.select-cell(GridState.selected - browser.columns);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                browser.select-cell(GridState.selected < 0 ? 0 : GridState.selected + browser.columns);
                return accept;
            }
            GridState.classify(event.text);
            accept
        }

        develop := DevelopPanel {
            side-panels-hidden: root.side-panels-hidden;
            chrome-hidden: root.chrome-hidden;
            left-panel-folded: root.develop-left-folded;
        }

        MapPanel { }

        browser := BrowserPanel {
            sidebar-hidden: root.browser-panels-folded;
            detail-hidden: root.browser-detail-folded;
            chrome-hidden: root.chrome-hidden;
            folded-by-hand: root.side-panels-hidden;
            unfold => {
                root.side-panels-hidden = false;
                root.chrome-hidden = false;
                root.refresh-fold();
            }
            return-focus => {
                keys.focus();
            }
        }

        // Declared after the browser so it paints over it (ADR 0055 §3): the
        // loupe is the same library, looked at one photo at a time.
        loupe := LoupePanel {
            chrome-hidden: root.chrome-hidden;
        }

        // The other two ways of looking at the same selection (ADR 0057),
        // mounted next to the loupe and gated the same way.
        compare := ComparePanel {
            chrome-hidden: root.chrome-hidden;
        }

        SurveyPanel {
            chrome-hidden: root.chrome-hidden;
        }

        // The tethered-capture bar (ADR 0087 §7), over every module and
        // under the modal overlay: a session is not a mode, so the bar
        // outlives every view switch — but a dialog the user just opened
        // still has to be the thing in front of them.
        TetherBar { }

        // Modal overlay: whichever dialog is open, over the view above.
        DialogOverlay {
            window-height: root.height;
        }
    }

    menubar := MenuBar { }

    // What is under the pointer while photographs are being dragged
    // (ADR 0130 §1). Drawn by the window for the same reason the hint is:
    // it has to escape every panel's clipping, and it must not join any
    // layout it passes over.
    if DragState.dragging: Rectangle {
        x: DragState.x + 12px;
        y: DragState.y + 12px;
        width: drag-label.preferred-width + 16px;
        height: 22px;
        background: #2f4f6f;
        border-radius: 4px;
        border-width: 1px;
        border-color: #6fa8dc;

        drag-label := Text {
            // Says *how many*, because the answer differs from what the
            // pointer is on top of whenever a multi-selection is dragged.
            // `Tr.photo-count` is the phrase the import and removal
            // dialogs already use, plural form included.
            text: Tr.photo-count(DragState.count);
            color: #e6e6e6;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
        }
    }

    // The hint layer (ADR 0127 §3): one on screen, drawn by the window.
    //
    // Here, and not by the control that asks for it, for three mechanical
    // reasons — a hint has to escape the `Flickable` that clips its
    // control, it must not join any layout it appears over, and there must
    // be exactly one. Declared last so it draws above every panel, and
    // *after* the menu bar so an open menu does not cover it.
    //
    // 500 ms, restarted by each new control: long enough that crossing a
    // toolbar shows nothing, short enough to read as an answer.
    hint-delay := Timer {
        interval: 500ms;
        running: HintState.hint != "" && !HintState.shown;
        triggered => {
            HintState.shown = true;
        }
    }
    if HintState.shown && HintState.hint != "": Rectangle {
        // Clamped into the window: a control at the right edge — the
        // settings panel's ⟲ is one — would otherwise put its hint outside
        // it.
        x: clamp(HintState.x, 8px, max(8px, root.width - self.width - 8px));
        y: clamp(HintState.y + 6px, 8px, max(8px, root.height - self.height - 8px));
        // Wide enough for a sentence, narrow enough to stay a hint
        // (ADR 0133 §2 caps one at about 110 characters, which is two lines
        // here). A glyph's three words still get one line and a box that
        // hugs them, because the width is the *smaller* of the two.
        width: min(hint-text.preferred-width + 16px, 320px);
        height: hint-text.preferred-height + 12px;
        background: #0e0e0e;
        border-radius: 4px;
        border-width: 1px;
        border-color: #3a3a3a;

        hint-text := Text {
            text: HintState.hint;
            color: #e6e6e6;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
            // A sentence wraps; before ADR 0133 the layer was a single 22px
            // row sized to `preferred-width`, which would have drawn a
            // 900px sliver.
            wrap: word-wrap;
            width: parent.width - 16px;
            x: 8px;
            height: 100%;
        }
    }
}
