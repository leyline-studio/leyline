// Save a develop preset (`docs/presets.md` §3.1, ADR 0058 §2): a name, the
// folder to file it under, and which categories of settings to capture.
//
// The categories are the seventeen of ADR 0132 §1 and the widget drawing
// them is shared with Copy Settings — the two dialogs ask the same question,
// and until that ADR both asked it about seven categories out of seventeen,
// so a preset could not hold a tone curve.
//
// One of the dialogs hosted by `panels/dialogs.slint` (ADR 0045 §3).

import { DevelopState } from "../state/develop.slint";
import { DialogState } from "../state/dialog.slint";
import { FilterChip, SettingsGroupChips, SettingsGroups } from "../widgets/controls.slint";

export component PresetDialog inherits VerticalLayout {
    spacing: 12px;
    // A preset starts on the look and nothing positional — the same default
    // Copy Settings uses, and the rule `docs/presets.md` §3.1 states.
    property <int> mask: SettingsGroups.look;
    // The folder to file it under: an index into `DevelopState.preset-folders`,
    // -1 for the root.
    property <int> folder: -1;

    Text {
        text: @tr("Save as preset");
        color: #f0f0f0;
        font-size: 15px;
        font-weight: 600;
    }
    Text {
        text: @tr("Name");
        color: #9a9a9a;
        font-size: 12px;
    }
    Rectangle {
        height: 28px;
        background: #1b1b1b;
        border-radius: 4px;
        border-width: 1px;
        border-color: #3a3a3a;
        preset-name := TextInput {
            x: 8px;
            width: parent.width - 16px;
            height: 100%;
            color: #e6e6e6;
            font-size: 12px;
            vertical-alignment: center;
            single-line: true;
        }
    }
    Text {
        // Wrapped, and short enough not to need it: a single-line `Text`
        // here was silently elided at the dialog's width.
        text: @tr("Categories (the six that start off are not part of a look)");
        color: #9a9a9a;
        font-size: 12px;
        wrap: word-wrap;
    }
    SettingsGroupChips {
        mask: root.mask;
        toggled(bit) => {
            root.mask = SettingsGroups.flip(root.mask, bit);
        }
    }
    HorizontalLayout {
        spacing: 8px;
        FilterChip {
            text: @tr("The look");
            active: false;
            clicked => {
                root.mask = SettingsGroups.look;
            }
        }
        FilterChip {
            text: @tr("Everything");
            active: false;
            clicked => {
                root.mask = SettingsGroups.every;
            }
        }
        FilterChip {
            text: @tr("Nothing");
            active: false;
            clicked => {
                root.mask = 0;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
    }

    Text {
        text: @tr("Folder");
        color: #9a9a9a;
        font-size: 12px;
    }
    Flickable {
        height: min(96px, folders.preferred-height);
        viewport-height: folders.preferred-height;
        folders := VerticalLayout {
            width: parent.width;
            spacing: 2px;
            Rectangle {
                height: 22px;
                background: root.folder == -1 ? #2f4f6f : (root-touch.has-hover ? #ffffff10 : transparent);
                border-radius: 3px;
                Text {
                    x: 8px;
                    height: 100%;
                    text: @tr("No folder");
                    color: #e6e6e6;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                root-touch := TouchArea {
                    clicked => {
                        root.folder = -1;
                    }
                }
            }
            for name[index] in DevelopState.preset-folders: Rectangle {
                height: 22px;
                background: root.folder == index ? #2f4f6f : (folder-touch.has-hover ? #ffffff10 : transparent);
                border-radius: 3px;
                Text {
                    x: 8px;
                    width: parent.width - 16px;
                    height: 100%;
                    text: name;
                    color: #e6e6e6;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                folder-touch := TouchArea {
                    clicked => {
                        root.folder = index;
                    }
                }
            }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        Rectangle {
            height: 24px;
            horizontal-stretch: 1;
            background: #1b1b1b;
            border-radius: 4px;
            border-width: 1px;
            border-color: #3a3a3a;
            new-folder := TextInput {
                x: 8px;
                width: parent.width - 16px;
                height: 100%;
                color: #e6e6e6;
                font-size: 11px;
                vertical-alignment: center;
                single-line: true;
            }
        }
        FilterChip {
            text: @tr("New folder");
            active: false;
            clicked => {
                DevelopState.new-preset-folder(new-folder.text);
                new-folder.text = "";
            }
        }
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: end;
        FilterChip {
            text: @tr("Cancel");
            active: false;
            clicked => {
                DialogState.dialog = "";
            }
        }
        FilterChip {
            text: @tr("Save");
            active: true;
            clicked => {
                DevelopState.run-save-preset(preset-name.text, root.mask, root.folder);
            }
        }
    }
}
