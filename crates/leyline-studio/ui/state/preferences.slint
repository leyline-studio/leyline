// Application preferences and the update check they gate (ADR 0078,
// ADR 0077) — the two settings that belong to the installation rather than
// to a photo, a library or a view (ADR 0045 §1).
//
// Rust owns `preferences.json`: every callback here is a report of what was
// clicked, and every property is what Rust decided to display. Nothing on
// this side keeps a setting of its own — a value shown but not written
// would survive exactly until the next launch.
export global PreferencesState {
    // The language menu in display order, native names as Rust assembles
    // them: "System language", "English", then every bundled translation.
    in property <[string]> languages;
    // Which entry is current. `in-out` because the panel highlights it and
    // Rust sets it at startup from the stored preference.
    in-out property <int> language;
    // Applies the choice at once (ADR 0078 §3): Slint re-evaluates every
    // `@tr(...)` on the spot, so no relaunch is involved.
    callback choose-language(int);

    // Consent to the update check (ADR 0077 §2). False until someone says
    // otherwise, including when the preferences file is missing or damaged.
    // What the viewers paint behind the photograph, and behind a soft proof
    // (ADR 0117): an index into `background-names`.
    in property <[string]> background-names;
    in-out property <int> viewer-background;
    in-out property <int> proof-background;
    callback choose-viewer-background(int);
    callback choose-proof-background(int);
    // The colours themselves, resolved by Rust so the panels do not each
    // repeat the table.
    in property <color> viewer-ground;
    in property <color> proof-ground;
    in-out property <bool> update-check;
    callback set-update-check(bool);
    // The second-launch question (ADR 0078 §4). Any way out of that dialog
    // — the button, Escape, a click on the backdrop — reports `false`, and
    // Rust stores the first answer it gets and ignores later ones.
    callback answer-update-consent(bool);

    // A newer version was found. This is what puts the mark on the Help
    // label and turns "Check for Updates…" into "Update to X…"; nothing
    // else about a found update interrupts anything (ADR 0077 §2).
    in-out property <bool> update-available;
    in-out property <string> update-version;
    in-out property <string> update-notes;
    // Where the update dialog is, as one of a closed set of words:
    // "" (nothing to say), "checking", "current", "unreachable",
    // "installing", "installed", "failed".
    //
    // A word rather than a sentence, because the sentence has to be
    // translatable: every string a user reads lives in a `.slint` behind
    // `@tr(...)`, and none is ever assembled in Rust (ADR 0078 §3 relies on
    // that being true for the language switch to reach everything).
    in-out property <string> update-state;
    // A request is in flight — the dialog's buttons stand down rather than
    // queueing a second one.
    in-out property <bool> update-busy;
    // Help ▸ Check for Updates…: the manual check, which unlike the
    // automatic one reports every outcome, including "up to date".
    callback check-updates();
    // The second click ADR 0077 §3 requires: finding a version never
    // installs it.
    callback install-update();
    // File ▸ Preferences…
    callback open-preferences();

    // How the interface was left, so it comes back that way (ADR 0128).
    //
    // **Numbers Rust never interprets.** Each is a bitfield the panel that
    // owns it composes and decomposes: bit 0 of `develop-view` is Full mode,
    // the rest are its setting groups, and `develop-left-view` carries the
    // four sections of the left column. Rust reads neither — it stores the
    // number and hands it back at the next launch — which is what keeps
    // ADR 0045 §2 true rather than merely bypassed: the crossing is real
    // (persistence needs it) and it is as narrow as the need, so a
    // sixteenth group costs one line, in Slint, in the panel that owns it.
    //
    // A number and not a list of names because Slint 1.13 has no string
    // search: `is-float`, `to-float`, `is-empty`, `character-count` and the
    // two case conversions are the whole of its string surface, so a panel
    // could write `"basic,detail"` and never read it back.
    //
    // **-1 means nothing is stored** — a first launch — and each panel then
    // uses the defaults its own ADR chose (ADR 0128 §2). It is not the same
    // as 0, which is a deliberately empty interface.
    in property <int> develop-view: -1;
    in property <int> develop-left-view: -1;
    callback remember-develop-view(int);
    callback remember-develop-left-view(int);

    // Advance after a classement (ADR 0131): the selection steps to the next
    // photograph once a lone one has been rated, labelled or flagged.
    //
    // Stored here for the same reason `develop-view` is — a way of working,
    // kept across launches — and shown *not* here but in Photo ▸ Advance
    // after rating, which is ADR 0078 §1's third condition applied: a
    // setting with a natural place in the surface it governs never enters
    // the Preferences dialog.
    //
    // `in-out` because the menu row and the two toolbar chips all flip it,
    // and Rust sets it at startup from the stored value.
    in-out property <bool> advance-after-classement;
    callback set-advance-after-classement(bool);

    // The categories the clipboard last picked up (ADR 0132 §6), as the
    // seventeen-bit mask `SettingsGroupChips` composes. Unlike the two
    // opaque numbers above, Rust **does** read this one — it has to, to turn
    // it into a `Vec<SettingsGroup>` — so the bit order is a contract, and
    // `crate::groups` holds the other half of it.
    //
    // Seeded with the look (bits 0..10), which is what a first launch gets.
    in-out property <int> copy-groups: 2047;

    // The three settings ADR 0128 left behind and ADR 0136 §5 finishes: the
    // window opening the way it was left.
    //
    // The thumbnail size in logical pixels — a property of the screen and of
    // the eyes in front of it, not of the photographs, which is why it is
    // stored per installation and not per library.
    in-out property <int> thumbnail-size: 176;
    callback remember-thumbnail-size(int);
    // Whether the side panels were folded **by hand**. Only the manual fold:
    // below the narrow threshold the fold is a constraint (ADR 0125), and
    // storing a constraint as a decision would fold a wide window tomorrow
    // because a small one folded today.
    in-out property <bool> panels-folded;
    callback remember-panels-folded(bool);
}
