// The loupe view (ADR 0055 §3): the selected photo, large, with the strip of
// its neighbours under it (ADR 0045 §3).
//
// Same shape as the develop and map panels — a whole-window mode gated on a
// flag, inheriting a layout and setting no geometry of its own.
//
// What makes it worth existing next to develop: **no edit session is
// opened**. It shows the cached preview and nothing else, so it costs a file
// read, creates no revision and has nothing to undo. Looking at a photo and
// working on it are two different intentions, and only one of them should
// write to the catalog.

import { Frame, Theme } from "../theme.slint";
import { GridState } from "../state/grid.slint";
import { PreferencesState } from "../state/preferences.slint";
import { Filmstrip, ZoomableImage } from "../widgets/controls.slint";
import { PhotoInfo, PhotoKeywords } from "photo_details.slint";
import { Rail } from "rail.slint";

export component LoupePanel inherits HorizontalLayout {
    // Panel folding, owned by the window (ADR 0055 §6): the rail's panel
    // with the width, the rail with the side panels, the filmstrip with
    // the chrome.
    in property <bool> chrome-hidden;
    in property <bool> filmstrip-hidden;
    in property <bool> detail-hidden;
    in property <bool> rail-hidden;
    // The rail (ADR 0158 §4), shared with the grid by the window.
    in-out property <string> rail-entry;
    in property <bool> full-mode;
    callback return-focus();
    // Room left on the left for the window's library column (ADR 0158 §3),
    // which is drawn over this view rather than inside it.
    in property <length> left-inset;

    // Zoom and viewpoint, panel-private: the loupe drives one image, the
    // compare view drives two (ADR 0057 §2).
    // `in-out`: the window's `Z` shortcut toggles it from outside.
    in-out property <bool> zoomed: false;
    // One scale for the view — and in compare, one for both halves, like the
    // centre beside it (ADR 0112 §3).
    in-out property <float> scale: 1.0;
    property <float> center-x: 0.5;
    property <float> center-y: 0.5;
    // A different photo starts fitted and centred again.
    property <image> loaded: GridState.loupe-image;
    changed loaded => {
        root.zoomed = false;
        root.center-x = 0.5;
        root.center-y = 0.5;
    }

    visible: GridState.loupe-mode;

    VerticalLayout {
        padding: 12px;
        padding-left: 12px + root.left-inset;
        spacing: 8px;

        // Clears the menu row above, like every other whole-window panel.
        Rectangle {
            height: Frame.top-bar;
        }

        ZoomableImage {
            vertical-stretch: 1;
            // ADR 0117: the loupe is where a photograph is looked at, so it is
            // the first view the ground matters in.
            background: PreferencesState.viewer-ground;
            source: GridState.loupe-image;
            zoomed: root.zoomed;
            scale: root.scale;
            center-x: root.center-x;
            center-y: root.center-y;
            panned(x, y) => {
                root.center-x = x;
                root.center-y = y;
            }
            zoom-requested(s, x, y) => {
                root.scale = s;
                root.center-x = x;
                root.center-y = y;
                root.zoomed = true;
            }
        }

        if !root.chrome-hidden && !root.filmstrip-hidden: Filmstrip {
            cells: GridState.cells;
            window-start: GridState.window-start;
            selected: GridState.selected;
            clicked(index) => {
                // Plain selection, exactly what clicking the same photo in the
                // grid does — the loupe follows the selection rather than owning
                // one of its own.
                GridState.selected = index;
                GridState.select(index);
            }
        }

        // Under the bottom bar of the window (ADR 0158 §2), which carries the
        // views and the zoom this panel's own strip used to.
        if !root.chrome-hidden: Rectangle {
            height: Frame.bottom-bar;
        }
    }

    if !root.detail-hidden && (root.rail-entry == "info" || root.rail-entry == "keywords"): Rectangle {
        width: 300px;
        background: Theme.surface;

        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            alignment: start;

            Rectangle {
                height: Frame.top-bar;
            }

            if root.rail-entry == "info": PhotoInfo {
                return-focus => {
                    root.return-focus();
                }
            }
            if root.rail-entry == "keywords": PhotoKeywords {
                return-focus => {
                    root.return-focus();
                }
            }
        }
    }
    if !root.rail-hidden: Rail {
        open-entry <=> root.rail-entry;
        full-mode: root.full-mode;
    }
}
