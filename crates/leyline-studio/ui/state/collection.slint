// Collections sidebar: the tree, the active collection, membership changes,
// and the three operations that manage the tree itself (ADR 0045 §1,
// `docs/catalog.md` §24).
//
// Rust flattens the tree into `CollectionRow`s with their depth; the UI
// only indents and reports clicks.
//
// Renaming, moving and deleting ask Rust *before* their dialog opens
// (`open-*`), because each needs something only the catalog side knows: the
// current name, the parents a collection may legally move to, and how many
// collections a deletion would take with it.
import { CollectionRow } from "../types.slint";

export global CollectionState {
    in property <[CollectionRow]> collections;
    in-out property <int> active-collection: -1;
    callback select-collection(int);
    // Whether the dialog is creating a **dynamic** collection — one that
    // holds whatever the current filter answers, rather than the
    // photographs one drops into it (ADR 0143).
    in-out property <bool> new-collection-smart: false;
    // What the dynamic collection would remember, in words, or why the
    // current filter cannot be saved as one. Written by Rust when the
    // dialog opens: the criteria are the query's, and the query is Rust's.
    in-out property <string> smart-summary;
    // Set when `smart-summary` is a refusal rather than a description.
    in-out property <bool> smart-refused: false;
    // Asked when the dialog opens: Rust reads the grid's query and says
    // what a dynamic collection would remember, or why it cannot (ADR 0143).
    callback prepare-new-collection();
    callback run-new-collection(string, bool);
    callback add-to-collection();
    callback remove-from-collection();
    // Photographs dropped on a collection row (ADR 0130 §1): the grid cell
    // the drag started from, then the row it was let go over. The cell is
    // named because the drop must act on what was *dragged* — Rust widens
    // it to the whole selection when that cell is part of one, and leaves
    // the selection itself alone either way.
    callback drop-on-collection(int, int);

    // The collection a management dialog is about: an index into
    // `collections`, -1 when none is.
    in-out property <int> target-collection: -1;
    in property <string> target-name;
    // How many collections the pending deletion would take, the target
    // included — a subtree goes as a whole (`docs/catalog.md` §24).
    in property <int> target-doomed;
    // Where the target may legally move: "Top level" first, then every
    // collection that is neither the target nor one of its descendants.
    in property <[string]> move-targets;

    callback open-rename(int);
    callback open-move(int);
    callback open-delete(int);
    callback run-rename(string);
    // Index into `move-targets`.
    callback run-move(int);
    callback run-delete();
}
