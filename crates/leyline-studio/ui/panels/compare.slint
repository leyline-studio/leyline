// The compare view (ADR 0057): two photos side by side, at the same place and
// the same magnification, so the one that is sharp can be told from the one
// that is nearly sharp (ADR 0045 §3).
//
// Left is the **select** — the photo currently being defended — and right is
// the **candidate**; the arrows move only the candidate, and `↑` promotes it
// (§3). Both are cached previews: no edit session, nothing written.
//
// The zoom and the centre live here rather than in each view, because sharing
// them *is* the feature (§2).

import { Frame, Theme } from "../theme.slint";
import { GridState } from "../state/grid.slint";
import { PreferencesState } from "../state/preferences.slint";
import { Filmstrip, FilterChip, ZoomableImage } from "../widgets/controls.slint";

export component ComparePanel inherits VerticalLayout {
    in property <bool> chrome-hidden;
    // Room left on the left for the window's library column (ADR 0158 §3),
    // which is drawn over this view rather than inside it.
    in property <length> left-inset;

    // One viewpoint for the two images (ADR 0057 §2).
    // `in-out`: the window's `Z` shortcut toggles it from outside.
    in-out property <bool> zoomed: false;
    // One scale for the view — and in compare, one for both halves, like the
    // centre beside it (ADR 0112 §3).
    in-out property <float> scale: 1.0;
    property <float> center-x: 0.5;
    property <float> center-y: 0.5;

    // A new pair resets the viewpoint: the place that mattered on the last
    // two photos means nothing on these.
    property <image> loaded: GridState.compare-select-image;
    changed loaded => {
        root.zoomed = false;
        root.center-x = 0.5;
        root.center-y = 0.5;
    }

    visible: GridState.compare-mode;
    padding: 12px;
    padding-left: 12px + root.left-inset;
    spacing: 8px;

    Rectangle {
        height: Frame.top-bar;
    }

    if !root.chrome-hidden: HorizontalLayout {
        height: 24px;
        spacing: 8px;
        alignment: start;

        FilterChip {
            text: @tr("Swap    ↑");
            active: false;
            clicked => {
                GridState.compare-swap();
            }
        }
    }

    HorizontalLayout {
        vertical-stretch: 1;
        spacing: 8px;

        VerticalLayout {
            spacing: 4px;
            horizontal-stretch: 1;
            ZoomableImage {
                vertical-stretch: 1;
                background: PreferencesState.viewer-ground;
                source: GridState.compare-select-image;
                zoomed: root.zoomed;
                scale: root.scale;
                center-x: root.center-x;
                center-y: root.center-y;
                panned(x, y) => {
                    root.center-x = x;
                    root.center-y = y;
                }
                zoom-requested(s, x, y) => {
                    root.scale = s;
                    root.center-x = x;
                    root.center-y = y;
                    root.zoomed = true;
                }
            }
            Text {
                text: GridState.compare-select-name;
                color: Theme.text;
                font-size: 12px;
                horizontal-alignment: center;
                overflow: elide;
            }
        }

        VerticalLayout {
            spacing: 4px;
            horizontal-stretch: 1;
            ZoomableImage {
                vertical-stretch: 1;
                background: PreferencesState.viewer-ground;
                source: GridState.compare-candidate-image;
                zoomed: root.zoomed;
                scale: root.scale;
                center-x: root.center-x;
                center-y: root.center-y;
                panned(x, y) => {
                    root.center-x = x;
                    root.center-y = y;
                }
                zoom-requested(s, x, y) => {
                    root.scale = s;
                    root.center-x = x;
                    root.center-y = y;
                    root.zoomed = true;
                }
            }
            Text {
                // The candidate says so, because which side is which is the
                // one thing a glance cannot recover.
                text: GridState.compare-candidate-name == ""
                    ? @tr("No candidate — ← → to choose one")
                    : @tr("{} (candidate)", GridState.compare-candidate-name);
                color: Theme.text-dim;
                font-size: 12px;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
    }

    if !root.chrome-hidden: Filmstrip {
        cells: GridState.cells;
        window-start: GridState.window-start;
        selected: GridState.selected;
        clicked(index) => {
            GridState.selected = index;
            GridState.select(index);
        }
    }

    // Under the bottom bar of the window (ADR 0158 §2), which carries the
    // views and the zoom this panel's own strip used to.
    if !root.chrome-hidden: Rectangle {
        height: Frame.bottom-bar;
    }
}
