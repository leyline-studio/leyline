// Import (`docs/specification.md`): pick a source folder, choose whether
// to copy the files in and whether to recurse, then hand the whole thing to
// Rust.
//
// One of the dialogs hosted by `panels/dialogs.slint` (ADR 0045 §3).

import { DialogState } from "../state/dialog.slint";
import { FilterChip } from "../widgets/controls.slint";

export component ImportDialog inherits VerticalLayout {
    spacing: 12px;
    Text {
        text: @tr("Import photos");
        color: #f0f0f0;
        font-size: 15px;
        font-weight: 600;
    }
    Text {
        text: @tr("Source folder (absolute path)");
        color: #9a9a9a;
        font-size: 12px;
    }
    HorizontalLayout {
        spacing: 8px;
        Rectangle {
            height: 28px;
            horizontal-stretch: 1;
            background: #1b1b1b;
            border-radius: 4px;
            border-width: 1px;
            border-color: #3a3a3a;
            import-source := TextInput {
                x: 8px;
                width: parent.width - 16px;
                height: 100%;
                text <=> DialogState.import-source-text;
                color: #e6e6e6;
                font-size: 12px;
                vertical-alignment: center;
                single-line: true;
            }
        }
        FilterChip {
            text: @tr("Browse…");
            active: false;
            clicked => {
                DialogState.browse-import-source();
            }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        FilterChip {
            text: @tr("Copy into library");
            active: DialogState.import-copy;
            clicked => {
                DialogState.import-copy = !DialogState.import-copy;
            }
        }
        FilterChip {
            text: @tr("Recursive");
            active: DialogState.import-recursive;
            clicked => {
                DialogState.import-recursive = !DialogState.import-recursive;
            }
        }
        // ADR 0079 §8: an import option and not a preference — it governs
        // this library, not the installation.
        FilterChip {
            text: @tr("Pair RAW+JPEG");
            active: DialogState.import-pair;
            clicked => {
                DialogState.import-pair = !DialogState.import-pair;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        // Looking before taking (ADR 0065): fills the list below without
        // writing anything, so the choice is made on what is there rather
        // than on a folder name.
        // Exactness costs a full read of every file, so it is asked for
        // (ADR 0095 §2) — and it is what marks a copy that was renamed.
        if !DialogState.job-done && DialogState.job-progress < 0: FilterChip {
            text: @tr("Exact (reads every file)");
            active: DialogState.import-exact;
            clicked => {
                DialogState.import-exact = !DialogState.import-exact;
            }
        }
        if !DialogState.job-done && DialogState.job-progress < 0: FilterChip {
            text: DialogState.import-scanned ? @tr("Rescan") : @tr("Look first");
            active: false;
            clicked => {
                DialogState.scan-import(import-source.text, DialogState.import-recursive, DialogState.import-exact);
            }
        }
    }

    // The contact sheet. Present only once a scan has run: without one the
    // dialog keeps its original meaning, "import this whole folder".
    if DialogState.import-scanned && DialogState.job-progress < 0: VerticalLayout {
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: DialogState.import-candidates.length == 0
                    ? @tr("Nothing importable here.")
                    : @tr("{} of {} chosen", DialogState.import-chosen, DialogState.import-candidates.length);
                color: #9a9a9a;
                font-size: 12px;
                vertical-alignment: center;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            if DialogState.import-candidates.length > 0: FilterChip {
                text: @tr("All");
                active: false;
                clicked => {
                    DialogState.select-candidates(true);
                }
            }
            if DialogState.import-candidates.length > 0: FilterChip {
                text: @tr("None");
                active: false;
                clicked => {
                    DialogState.select-candidates(false);
                }
            }
        }

        Flickable {
            // Tall enough for six lines; longer cards scroll rather than
            // push the buttons off the bottom of the window.
            height: min(DialogState.import-candidates.length * 60px, 360px);
            viewport-height: DialogState.import-candidates.length * 60px;
            for row[i] in DialogState.import-candidates: Rectangle {
                y: i * 60px;
                height: 56px;
                width: parent.width;
                border-radius: 4px;
                background: row.selected ? #2f4f6f : #1e1e1e;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 10px;

                    Image {
                        width: 72px;
                        height: 100%;
                        source: row.thumbnail;
                        image-fit: contain;
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: row.filename;
                            color: #e6e6e6;
                            font-size: 12px;
                            overflow: elide;
                        }
                        Text {
                            // The mark that matters: this one is probably
                            // already in the library (ADR 0065 §3).
                            text: row.already ? @tr("already imported · {}", row.detail) : row.detail;
                            color: row.already ? #d8b23c : #8a8a8a;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }

                    Text {
                        width: 20px;
                        height: 100%;
                        text: row.selected ? "☑" : "☐";
                        color: row.selected ? #e6e6e6 : #6f6f6f;
                        font-size: 15px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    clicked => {
                        DialogState.toggle-candidate(i);
                    }
                }
            }
        }
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: end;
        FilterChip {
            // Highlighted once the job is done, because it is then the only
            // thing left to do.
            text: DialogState.job-done ? @tr("Close") : @tr("Cancel");
            active: DialogState.job-done;
            clicked => {
                DialogState.dialog = "";
            }
        }
        // Hidden while a job runs and once it has finished: re-importing the
        // same folder from a dialog still showing its own result is never
        // what anyone means.
        if !DialogState.job-done && DialogState.job-progress < 0: FilterChip {
            // After a scan the button takes what is ticked, and says how
            // many — a button reading "Import" over a list of forty photos
            // with three ticked would be lying about what it does.
            text: DialogState.import-scanned
                ? @tr("Import {}", DialogState.import-chosen)
                : @tr("Import");
            active: true;
            enabled: !DialogState.import-scanned || DialogState.import-chosen > 0;
            clicked => {
                DialogState.run-import(import-source.text, DialogState.import-copy, DialogState.import-recursive, DialogState.import-pair);
            }
        }
    }
}
