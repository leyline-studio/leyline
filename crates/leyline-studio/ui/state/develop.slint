// The develop view: the rendered photo, every adjustment that can be made
// to it, and the revision history behind it (ADR 0045 §1).
//
// The largest domain by far, and the one with the clearest boundary: Rust
// owns the edit session and the pipeline, the UI owns none of it. Sliders
// report a released value and get the authoritative settings back.
//
// What is *not* here, by ADR 0045 §2: the accordion expand flags, the
// active drag tool, the loupe zoom and the spot tool's pending first
// click. None of those cross to Rust, so they stay private to the develop
// panel.

import { CurveMarker, DevSettings, HistoryRow, KeystoneGuide, PresetRow, ProfileRow } from "../types.slint";
export global DevelopState {
    // Develop view state, mirrored from Rust.
    in property <bool> develop-mode;
    in property <string> develop-filename;
    in property <image> develop-image;
    // The neutral (as-shot) render of the same photo, fetched once per
    // develop session — the "before" half of Compare Before/After.
    in property <image> develop-image-before;
    in-out property <bool> dev-compare: false;

    // What the develop viewer shows, in one place rather than in the two
    // `Image` elements that need it (fit-to-window and 100%-with-pan).
    //
    // The trial wins over Compare Before/After: hovering a preset is a
    // deliberate, momentary question — "what would this one do?" — and it
    // is asked about the photo as it is, not about the photo as it was.
    //
    // A **property** and not a `pure function`: a binding tracks the
    // properties it reads and re-runs when they change, which is exactly
    // what a viewer that has to follow `dev-trial-active` needs.
    out property <image> viewer-image: root.dev-trial-active
        ? root.dev-trial-image
        : (root.dev-compare ? root.develop-image-before : root.develop-image);
    callback toggle-compare();
    in property <DevSettings> dev;
    // Filled-area SVG paths, one per channel, in a 256x90 viewbox — see
    // `develop::histogram_layout` in main.rs.
    in property <string> dev-histogram-r;
    // Clipping (ADR 0092): whether each end of the histogram is occupied
    // (the triangles light from it), and whether each overlay is on.
    in property <bool> dev-highlights-clipped;
    in property <bool> dev-shadows-clipped;
    in property <bool> dev-clip-highlights;
    in property <bool> dev-clip-shadows;
    in property <string> dev-histogram-g;
    in property <string> dev-histogram-b;
    // How the photo was taken, under the histogram: four values kept apart
    // rather than one sentence, because the panel spreads them across its
    // width. Each arrives already formatted (`format::iso`, `focal`,
    // `aperture`, `shutter`) and empty when the file didn't record it.
    in property <string> dev-iso;
    in property <string> dev-focal;
    in property <string> dev-aperture;
    in property <string> dev-shutter;
    // Tone-curve graph state, mirrored from the current revision's
    // settings: line commands and marker positions, both already in the
    // canvas' own pixel space (`develop::curve_layout`).
    in property <string> dev-curve-path;
    // The parametric curve, sampled by Rust from the very table the stage
    // renders through (ADR 0137 §4) — what is drawn and what is rendered
    // cannot drift. Same canvas space as `dev-curve-path`.
    in property <string> dev-parametric-path;
    // Which of the two curves the Tone Curve group shows: "point" or
    // "region". A view state, not a setting — both curves apply whichever
    // one is on screen.
    in-out property <string> dev-curve-mode: "point";
    // A split dragged to a new position, in percent of the tonal axis:
    // "shadow", "midtone" or "highlight", then the value. Previews while it
    // moves and commits on release, like every other drag (ADR 0074 §1).
    callback develop-preview-split(string, int);
    callback develop-set-split(string, int);
    in property <[CurveMarker]> dev-curve-points;
    in property <int> dev-spot-count;
    // Defaults applied to the *next* placed spot — dialog-local text
    // fields, not part of any stored revision until a spot is placed.
    in-out property <string> spot-radius-text: "5";
    in-out property <string> spot-feather-text: "50";
    in-out property <string> spot-opacity-text: "100";
    in property <string> camera-profile-name;
    // Camera profile (ADR 0035): native `.dcp` picker, immediately followed
    // by the import into `Profiles/Camera/` and the reference being stored
    // on the edited version — one click, same shape as `browse-map-pack`.
    // The file name of the referenced profile, empty when none is set.
    callback browse-camera-profile();
    // Creative LUT (ADR 0053): the referenced `.cube`'s file name, empty when
    // none is referenced, and the picker that imports one — same one-click
    // shape as `browse-camera-profile`.
    in property <string> lut-name;
    callback browse-lut();
    callback clear-lut();
    // Screen soft proof (ADR 0034): the destination profile's file name
    // (empty = no proof in effect), the intent index (0 perceptual,
    // 1 relative, 2 saturation, 3 absolute) and whether what the destination
    // cannot reproduce is flagged. None of it is stored anywhere — a proof is
    // a way of looking at the photo (ADR 0051 §4), which is why it lives on
    // this global and not in a revision.
    in property <string> soft-proof-name;
    in-out property <int> soft-proof-intent: 1;
    in-out property <bool> soft-proof-gamut-warning: false;
    callback browse-soft-proof();
    callback clear-soft-proof();
    callback set-soft-proof-intent(int);
    callback toggle-soft-proof-gamut-warning();
    callback enter-develop();
    callback exit-develop();
    // Moves the develop view to the next/previous photo in the grid
    // without leaving develop mode.
    callback develop-next();
    callback develop-prev();
    // Filmstrip click: switches develop to the clicked whole-grid index
    // directly, without leaving develop mode.
    callback develop-switch(int);
    callback develop-edit(string, float);
    // The same three edits, *shown* rather than applied (ADR 0074): fired
    // while a slider is being dragged, throttled by Rust, and writing
    // nothing — no revision, no cached preview. The committing twins above
    // still fire on release.
    callback develop-preview(string, float);
    // Measures this photo's chromatic aberration and writes both
    // coefficients (ADR 0111 §2): a press, never an automatic step, and the
    // result lands in the history as one ordinary edit.
    callback measure-tca();
    // Puts one panel group back to neutral in a single revision
    // (ADR 0112 §4); the identifier is `develop::reset_group`'s.
    callback reset-group(string);
    // The pixel under the pointer, in [0, 1] image coordinates: Rust reads
    // the render it already holds and fills `pixel-readout` (ADR 0112 §2).
    callback sample-pixel(float, float);
    // The targeted adjustment (ADR 0130 §3): point at a tone in the
    // photograph and drag it. Rust answers with the **name** of the tonal
    // setting that tone belongs to — and only that, because choosing it is
    // the one part that needs the pixels. Everything after is the panel's
    // own arithmetic on a slider it already knows, through the same
    // preview-then-commit pair a drag on the track uses (ADR 0074 §1).
    //
    // Empty when the click landed outside the photograph.
    in-out property <string> target-setting;
    callback target-pick(float, float);
    // Already formatted — "R 215  G 215  B 215", or empty when the pointer
    // is off the photo.
    in-out property <string> pixel-readout: "";
    // Highlight reconstruction (ADR 0050): the mode name the decoder is
    // asked for — "clip", "blend" or "rebuild". Its own callback rather than
    // a `develop-edit` with a number, because the three modes are not points
    // on a scale.
    callback develop-set-highlight-reconstruction(string);
    // ADR 0061 — a named algorithm, never a slider: DCB is not "more VNG".
    callback develop-set-demosaic(string);
    // HSL mixer band edit (ADR 0031): band index (0..8, fixed order red..
    // magenta), field ("hue"/"saturation"/"luminance"), released value.
    callback develop-edit-hsl-band(int, string, float);
    callback develop-preview-hsl-band(int, string, float);
    // Color grading zone edit (ADR 0031): zone ("shadows"/"midtones"/
    // "highlights"), field ("hue"/"saturation"/"luminance"), released
    // value. `balance`/`blending` go through the plain `develop-edit`
    // above (`"color-grading-balance"`/`"color-grading-blending"`) since
    // they don't need a zone.
    callback develop-edit-color-grading-zone(string, string, float);
    callback develop-preview-color-grading-zone(string, string, float);
    // Mouse crop: press x/y, release x/y, viewport w/h, preview w/h (px).
    callback develop-crop-drag(float, float, float, float, float, float, float, float);
    // Tone curve graph (ADR 0030): click position in the curve canvas'
    // own pixel space (0..width, 0..height, y already screen-down).
    // Which of the four curves the canvas edits (ADR 0098 §4): "master",
    // "red", "green" or "blue". `in-out` because the chips set it and Rust
    // reads it on every click and every refresh.
    in-out property <string> dev-curve-channel: "master";
    callback develop-curve-click(float, float, float, float);
    callback develop-curve-reset();
    // Spot removal (ADR 0032): source click x/y, target click x/y,
    // viewport w/h, preview w/h (px) — same letterbox convention as
    // `develop-crop-drag`.
    callback develop-spot-click(float, float, float, float, float, float, float, float);
    // Red-eye (ADR 0103): one click places one disk — view x/y, viewport
    // w/h, preview w/h, the same letterbox convention as the others.
    // Reshape (ADR 0109): one drag, press where the content is and release
    // where it should go — press x/y, release x/y, viewport w/h, image w/h.
    callback develop-reshape-drag(float, float, float, float, float, float, float, float);
    callback develop-reshape-reset();
    in-out property <string> reshape-radius-text: "12";
    in-out property <string> reshape-strength-text: "1";
    callback develop-red-eye-click(float, float, float, float, float, float);
    callback develop-red-eye-reset();
    in property <int> dev-red-eye-count;
    in property <int> dev-reshape-count;
    // Keystone by drawn lines (ADR 0119): one drag per guide, same letterbox
    // convention as the others. `begin` zeroes the two perspective sliders,
    // because the guides are read against the photograph *before* the
    // correction (§4); `apply` solves and writes; `clear` drops the guides
    // without touching the revision.
    callback develop-keystone-begin();
    callback develop-keystone-drag(float, float, float, float, float, float, float, float);
    callback develop-keystone-apply();
    callback develop-keystone-clear();
    in property <[KeystoneGuide]> keystone-guides;
    // The three red-eye fields, typed like the spot ones.
    in-out property <string> red-eye-radius-text: "2";
    in-out property <string> red-eye-feather-text: "0.5";
    in-out property <string> red-eye-darken-text: "0.6";
    callback develop-spot-undo();
    callback develop-spot-reset();
    callback develop-undo();
    callback develop-redo();
    // Whether either of those has anywhere to go (ADR 0149 §2), read off
    // the history list below: something to undo when the head is not the
    // first revision, something to redo when a row follows it. The toolbar
    // chips and the two menu rows take the same guard, so nothing on screen
    // offers a move the panel says does not exist.
    in property <bool> dev-can-undo;
    in property <bool> dev-can-redo;
    callback develop-reprocess();
    callback reprocess-library();
    // Library::reprocess (§10.4) scoped to the currently selected photo —
    // same call as Shift+R, just bounded to one version instead of the
    // whole catalog (ADR 0021, grid context menu).
    callback reprocess-selected();
    // Revision history, head first, formatted timestamps — a browsable
    // history panel beyond linear undo/redo.
    // Branches of the open photo (ADR 0094 §2): one chip per version, in
    // catalog order, with `dev-version-current` pointing at the one being
    // developed. The chips are the selector the context menu is not.
    in property <[string]> dev-versions;
    in property <int> dev-version-current: 0;
    // Switch to the version at that index; create a branch from what is
    // being looked at. Neither rewrites the graph — a switch moves a
    // pointer (ADR 0008).
    callback switch-version(int);
    callback create-version();
    in property <[HistoryRow]> dev-history;
    // Index within `dev-history` of the currently-checked-out revision —
    // not always 0: the list is stable across a jump (see the Rust-side
    // `dev_history` field doc), so "current" moves within it instead of
    // always being the top row.
    in property <int> dev-history-current: 0;
    callback checkout-history-row(int);
    // The camera-profile browser (ADR 0089): what the library holds, each
    // showing the open photo as that profile renders it. Filled by Rust when
    // the group is opened; empty until then, because every row costs a
    // render.
    in property <[ProfileRow]> profile-rows;
    // Ask Rust to fill `profile-rows` for the photo currently open.
    callback load-profiles();
    // Reference the profile at this index of `profile-rows`; index 0 is
    // "no profile" and clears the reference.
    callback choose-profile(int);

    // Automatic tone (ADR 0088 §1): asks the engine what it would set, then
    // writes it through the ordinary edit session — one revision, undoable
    // like any other. No argument: it always answers for the photo open in
    // develop, at its current settings.
    callback run-auto-tone();
    // Clipping toggles (ADR 0092 §2): "highlights", "shadows", or "both"
    // (the J key). The flags live in Rust with the other overlay state.
    callback toggle-clipping(string);
    // The white-balance picker (ADR 0091 §1): a click on a neutral grey,
    // view x/y, viewport w/h, preview w/h (px) — same letterbox convention
    // as `develop-spot-click`. The engine solves temperature and tint and
    // the answer lands as one ordinary revision.
    callback develop-wb-click(float, float, float, float, float, float);
    // Grey-world white balance (ADR 0091 §3): the same solver as the
    // picker, fed the whole frame.
    callback run-auto-wb();
    // One fixed white balance by its stable key ("daylight", …), or
    // "as-shot" to clear the override (ADR 0091 §4).
    callback apply-wb-preset(string);
    // Stored develop preset names, already ordered by Rust. Flat, and the
    // menu bar's Apply/Delete submenus are what it is for; the panel reads
    // `dev-preset-rows` instead, whose `index` points back into this same
    // list so both drive the same two callbacks.
    in property <[string]> dev-presets;
    // The presets panel's rows: folders and the presets filed under them,
    // already flattened, filtered and ordered by Rust (ADR 0058 §1–§2).
    in property <[PresetRow]> dev-preset-rows;
    // The panel's search box. Filtering is Rust's, like every other filter.
    in-out property <string> preset-filter: "";
    callback filter-presets(string);
    // Expand or collapse the folder row at an index of `dev-preset-rows`.
    callback toggle-preset-folder(int);
    // Apply / delete the develop preset at an index of `dev-presets`.
    callback apply-preset(int);
    callback delete-preset(int);
    callback open-preset-dialog();
    // Star a preset, so it sorts to the top of its folder (ADR 0058 §2).
    callback favourite-preset(int, bool);
    // Replace a preset's settings with the photo currently open in develop,
    // bumping its version counter (ADR 0058 §6).
    callback update-preset(int);
    // Delete a preset folder; the presets it held move back to the root
    // (ADR 0058 §2). Takes an index into the folder list, not the rows.
    callback delete-preset-folder(int);
    // Show the open photo *with* the preset at this index of `dev-presets`,
    // writing nothing (ADR 0058 §4). `-1` stops the trial.
    callback trial-preset(int);
    // The trial render, and whether it is what the viewer should show.
    // Rust sets both; leaving the hover clears the flag and the real photo
    // is back, because it never went anywhere.
    in property <image> dev-trial-image;
    in property <bool> dev-trial-active: false;
    // Name, then the categories to capture as the seventeen-bit mask
    // `SettingsGroupChips` composes (ADR 0132 §1 — bit 0 is White balance,
    // bit 16 Local adjustments), then the folder to file it under: an index
    // into the folder list, `-1` for the root (ADR 0058 §2).
    callback run-save-preset(string, int, int);
    // The preset folders that already exist, for the save dialog's picker.
    in property <[string]> preset-folders;
    // Create a folder from the save dialog and file the preset in it.
    callback new-preset-folder(string);
    // Copy/paste develop settings between photos (distinct from named
    // presets): captures the chosen categories from one photo, pastes onto
    // the whole grid selection.
    //
    // `copy-settings` is `Ctrl+C` — it copies the remembered set without
    // asking. `open-copy-dialog` is `Ctrl+Shift+C`, and
    // `copy-settings-groups` is what its Copy button reports: the mask
    // chosen, which Rust both acts on and stores (ADR 0132 §5, §6).
    callback copy-settings();
    callback open-copy-dialog();
    callback copy-settings-groups(int);
    callback paste-settings();
    in property <bool> has-settings-clipboard: false;
}
