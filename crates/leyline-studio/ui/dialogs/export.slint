// Export (ADR 0025): either a stored preset or an ad-hoc recipe —
// format, quality and longest edge — with the option of saving that recipe
// as a new preset.
//
// One of the dialogs hosted by `panels/dialogs.slint` (ADR 0045 §3).

import { DialogState } from "../state/dialog.slint";
import { FilterChip } from "../widgets/controls.slint";

export component ExportDialog inherits VerticalLayout {
    spacing: 12px;
    Text {
        text: DialogState.export-photo-count > 1
            ? @tr("Export {} selected photos", DialogState.export-photo-count)
            : @tr("Export selected photo");
        color: #f0f0f0;
        font-size: 15px;
        font-weight: 600;
    }
    Text {
        text: @tr("Preset");
        color: #9a9a9a;
        font-size: 12px;
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        FilterChip {
            text: @tr("Custom");
            active: DialogState.export-preset == -1;
            clicked => {
                DialogState.export-preset = -1;
            }
        }
        for name[i] in DialogState.export-presets: FilterChip {
            text: name;
            active: DialogState.export-preset == i;
            clicked => {
                DialogState.export-preset = i;
            }
        }
    }
    if DialogState.export-preset == -1: VerticalLayout {
        spacing: 8px;
        Text {
            text: @tr("Format");
            color: #9a9a9a;
            font-size: 12px;
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            for name[i] in ["JPEG", "PNG", "TIFF", "WebP", "AVIF"]: FilterChip {
                text: name;
                active: DialogState.export-format == i;
                clicked => {
                    DialogState.export-format = i;
                }
            }
        }
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                Text {
                    text: @tr("Quality (1-100)");
                    color: #9a9a9a;
                    font-size: 12px;
                }
                Rectangle {
                    height: 28px;
                    background: #1b1b1b;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #3a3a3a;
                    TextInput {
                        x: 8px;
                        width: parent.width - 16px;
                        height: 100%;
                        text <=> DialogState.export-quality-text;
                        color: #e6e6e6;
                        font-size: 12px;
                        vertical-alignment: center;
                        single-line: true;
                    }
                }
            }
            // AVIF is the only encoder with an effort dial (ADR 0067), so the
            // field only exists when AVIF is the chosen format.
            if DialogState.export-format == 4: VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                Text {
                    text: @tr("AVIF speed (1-10)");
                    color: #9a9a9a;
                    font-size: 12px;
                }
                Rectangle {
                    height: 28px;
                    background: #1b1b1b;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #3a3a3a;
                    TextInput {
                        x: 8px;
                        width: parent.width - 16px;
                        height: 100%;
                        text <=> DialogState.export-avif-speed-text;
                        color: #e6e6e6;
                        font-size: 12px;
                        vertical-alignment: center;
                        single-line: true;
                    }
                }
            }
            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                Text {
                    text: @tr("Max edge px (blank = full size)");
                    color: #9a9a9a;
                    font-size: 12px;
                }
                Rectangle {
                    height: 28px;
                    background: #1b1b1b;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #3a3a3a;
                    TextInput {
                        x: 8px;
                        width: parent.width - 16px;
                        height: 100%;
                        text <=> DialogState.export-max-edge-text;
                        color: #e6e6e6;
                        font-size: 12px;
                        vertical-alignment: center;
                        single-line: true;
                    }
                }
            }
        }
        VerticalLayout {
            spacing: 4px;
            Text {
                text: @tr("Watermark text (blank = none)");
                color: #9a9a9a;
                font-size: 12px;
            }
            Rectangle {
                height: 28px;
                background: #1b1b1b;
                border-radius: 4px;
                border-width: 1px;
                border-color: #3a3a3a;
                TextInput {
                    x: 8px;
                    width: parent.width - 16px;
                    height: 100%;
                    text <=> DialogState.export-watermark-text;
                    color: #e6e6e6;
                    font-size: 12px;
                    vertical-alignment: center;
                    single-line: true;
                }
            }
        }
        // The watermark's own settings (ADR 0106 §2). Shown only once there
        // is a line to decorate: four controls above an empty field would be
        // four questions about nothing.
        if DialogState.export-watermark-text != "": VerticalLayout {
            spacing: 8px;
            Text {
                text: @tr("Watermark corner");
                color: #9a9a9a;
                font-size: 12px;
            }
            // Laid out as the frame is, not as the indices are: five chips
            // in one row overflow the dialog in both languages, and two
            // rows that mirror the corners read faster than a list anyway.
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                FilterChip {
                    text: @tr("Top left");
                    active: DialogState.export-watermark-anchor == 3;
                    clicked => {
                        DialogState.export-watermark-anchor = 3;
                    }
                }
                FilterChip {
                    text: @tr("Top right");
                    active: DialogState.export-watermark-anchor == 2;
                    clicked => {
                        DialogState.export-watermark-anchor = 2;
                    }
                }
                FilterChip {
                    text: @tr("Center");
                    active: DialogState.export-watermark-anchor == 4;
                    clicked => {
                        DialogState.export-watermark-anchor = 4;
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                FilterChip {
                    text: @tr("Bottom left");
                    active: DialogState.export-watermark-anchor == 1;
                    clicked => {
                        DialogState.export-watermark-anchor = 1;
                    }
                }
                FilterChip {
                    text: @tr("Bottom right");
                    active: DialogState.export-watermark-anchor == 0;
                    clicked => {
                        DialogState.export-watermark-anchor = 0;
                    }
                }
            }
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    spacing: 4px;
                    horizontal-stretch: 1;
                    Text {
                        text: @tr("Size (% of height)");
                        color: #9a9a9a;
                        font-size: 12px;
                    }
                    Rectangle {
                        height: 28px;
                        background: #1b1b1b;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #3a3a3a;
                        TextInput {
                            x: 8px;
                            width: parent.width - 16px;
                            height: 100%;
                            text <=> DialogState.export-watermark-size-text;
                            color: #e6e6e6;
                            font-size: 12px;
                            vertical-alignment: center;
                            single-line: true;
                        }
                    }
                }
                VerticalLayout {
                    spacing: 4px;
                    horizontal-stretch: 1;
                    Text {
                        text: @tr("Colour (#RRGGBB)");
                        color: #9a9a9a;
                        font-size: 12px;
                    }
                    Rectangle {
                        height: 28px;
                        background: #1b1b1b;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #3a3a3a;
                        TextInput {
                            x: 8px;
                            width: parent.width - 16px;
                            height: 100%;
                            text <=> DialogState.export-watermark-color-text;
                            color: #e6e6e6;
                            font-size: 12px;
                            vertical-alignment: center;
                            single-line: true;
                        }
                    }
                }
                VerticalLayout {
                    spacing: 4px;
                    horizontal-stretch: 1;
                    Text {
                        text: @tr("Opacity (0-1)");
                        color: #9a9a9a;
                        font-size: 12px;
                    }
                    Rectangle {
                        height: 28px;
                        background: #1b1b1b;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #3a3a3a;
                        TextInput {
                            x: 8px;
                            width: parent.width - 16px;
                            height: 100%;
                            text <=> DialogState.export-watermark-opacity-text;
                            color: #e6e6e6;
                            font-size: 12px;
                            vertical-alignment: center;
                            single-line: true;
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                Text {
                    text: @tr("Save as preset (optional name)");
                    color: #9a9a9a;
                    font-size: 12px;
                }
                Rectangle {
                    height: 28px;
                    background: #1b1b1b;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #3a3a3a;
                    TextInput {
                        x: 8px;
                        width: parent.width - 16px;
                        height: 100%;
                        text <=> DialogState.export-preset-name;
                        color: #e6e6e6;
                        font-size: 12px;
                        vertical-alignment: center;
                        single-line: true;
                    }
                }
            }
            FilterChip {
                text: @tr("Save as preset");
                active: false;
                clicked => {
                    DialogState.run-save-export-preset(
                        DialogState.export-preset-name,
                        DialogState.export-format,
                        DialogState.export-quality-text,
                        DialogState.export-avif-speed-text,
                        DialogState.export-max-edge-text,
                    );
                }
            }
        }
    }
    Text {
        text: @tr("Destination folder (absolute path)");
        color: #9a9a9a;
        font-size: 12px;
    }
    HorizontalLayout {
        spacing: 8px;
        Rectangle {
            height: 28px;
            horizontal-stretch: 1;
            background: #1b1b1b;
            border-radius: 4px;
            border-width: 1px;
            border-color: #3a3a3a;
            export-destination := TextInput {
                x: 8px;
                width: parent.width - 16px;
                height: 100%;
                text <=> DialogState.export-destination-text;
                color: #e6e6e6;
                font-size: 12px;
                vertical-alignment: center;
                single-line: true;
            }
        }
        FilterChip {
            text: @tr("Browse…");
            active: false;
            clicked => {
                DialogState.browse-export-destination();
            }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: end;
        FilterChip {
            text: @tr("Cancel");
            active: false;
            clicked => {
                DialogState.dialog = "";
            }
        }
        FilterChip {
            text: @tr("Export");
            active: true;
            clicked => {
                DialogState.run-export(
                    DialogState.export-preset,
                    export-destination.text,
                    DialogState.export-format,
                    DialogState.export-quality-text,
                    DialogState.export-avif-speed-text,
                    DialogState.export-max-edge-text,
                );
            }
        }
    }
}
