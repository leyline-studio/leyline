msgctxt "BasicGroup"
msgid "Clip"
msgstr ""

#: crates/leyline-studio/ui/panels/develop_basic.slint:301
msgctxt "BasicGroup"
msgid ""
"Cuts the clipped channels off at white. Fastest, and what a photograph "
"without blown highlights wants."
msgstr ""

#: crates/leyline-studio/ui/panels/develop_basic.slint:308
msgctxt "BasicGroup"
msgid "Blend"
msgstr ""

#: crates/leyline-studio/ui/panels/develop_basic.slint:309
msgctxt "BasicGroup"
msgid ""
"Fills a clipped channel from the ones that did not clip, keeping the colour "
"plausible."
msgstr ""

