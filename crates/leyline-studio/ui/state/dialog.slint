// The modal dialogs and the panels that behave like them: which one is
// open, what it reports back, and the fields each one holds (ADR 0045 §1).
//
// One `dialog` slot rather than a flag per dialog: only ever one is open at
// a time, and `dialog-result` is the single line where each reports success
// or failure.
//
// The text fields are `in-out` because both sides write them — the user
// types into them, and the native pickers (`browse-*`) fill them in from
// Rust. The two input paths stay in sync because they bind the same
// property.
import { CandidateRow, RootRow } from "../types.slint";

export global DialogState {
    // Modal dialog state: "" (none), "import", "export", "print",
    // "contact-sheet", "tether",
    // "watch" or "confirm".
    in-out property <string> dialog;
    in-out property <string> dialog-result;
    // The long job a dialog is waiting on: completed fraction and the count
    // beside it. `job-progress < 0` means no job is running, which is what
    // hides the bar — a bar stuck at zero reads as a job that failed to
    // start.
    in-out property <float> job-progress: -1;
    in-out property <string> job-caption: "";
    // The job this dialog was waiting on has finished. It is what turns
    // "Cancel" into "Close": after a completed import that word no longer
    // means "close", it means "undo what I just did", so nobody presses it
    // — and the only remaining way out was clicking outside, which is a
    // guess and not an affordance.
    in-out property <bool> job-done: false;
    // The generic confirmation dialog (ADR 0060 §4). Studio had none until
    // removal needed one, and removal is exactly the kind of act that must
    // not happen on a mis-click: `confirm-danger` styles the accept button
    // as destructive, and `confirm-accept` carries no payload — the caller
    // that opened the dialog already knows what it asked about.
    in-out property <string> confirm-title;
    in-out property <string> confirm-message;
    in-out property <string> confirm-accept-text;
    in-out property <bool> confirm-danger: false;
    callback confirm-accept();
    // source, copy into the library, recurse, pair RAW+JPEG (ADR 0079 §4).
    callback run-import(string, bool, bool, bool);
    in-out property <bool> import-copy: true;
    in-out property <bool> import-recursive: true;
    // Answer the duplicate question exactly (ADR 0095): reads every file
    // in the folder, so it is off unless asked for.
    in-out property <bool> import-exact: false;
    in-out property <bool> import-pair: true;
    in-out property <string> import-source-text: "";
    // Opens a native OS folder picker; on a non-cancelled pick, Rust sets
    // `import-source-text` / `export-destination-text` below. Manual typing
    // into the paired TextInput keeps working — the picker is just a
    // faster alternative, not a replacement (both are `<=>` bound to the
    // same property so either input path stays in sync).
    callback browse-import-source();
    // Looking before taking (ADR 0065). The scan writes nothing; it fills
    // `import-candidates` with what the source holds, each line ticked or
    // not. Rust owns the ticks — the panel reports clicks and displays what
    // comes back (ADR 0045 §1).
    callback scan-import(string, bool, bool);
    in-out property <[CandidateRow]> import-candidates;
    // A scan has run, even if it found nothing: it is what turns the
    // dialog from "import this folder" into "import these photos".
    in-out property <bool> import-scanned: false;
    // How many lines are ticked, shown on the button that will take them.
    in-out property <int> import-chosen: 0;
    callback toggle-candidate(int);
    // Ticks or unticks every line at once; the already-imported ones are
    // left alone, since ticking them is a deliberate act.
    callback select-candidates(bool);
    callback open-export();
    // preset index (-1 = ad-hoc), destination, format index, quality text,
    // avif-speed text, max-edge text. Everything after the destination is
    // ignored when a stored preset is chosen.
    //
    // The watermark is *not* here: its five fields travel together, so the
    // wiring reads them from this state rather than being handed them one by
    // one (ADR 0106 §3).
    callback run-export(int, string, int, string, string, string);
    // Name, format index, quality text, avif-speed text, max-edge text —
    // stores the custom export dialog's current recipe as a reusable preset
    // (§12). The watermark is read from the state, as above.
    callback run-save-export-preset(string, int, string, string, string);
    in property <[string]> export-presets;
    in-out property <int> export-preset: -1;
    in-out property <string> export-preset-name: "";
    // How many photos `run-export` will act on — the multi-selection when
    // there is one, otherwise 1 for the lone focused photo.
    in-out property <int> export-photo-count: 1;
    in-out property <int> export-format: 0;
    in-out property <string> export-quality-text: "90";
    // AVIF encoder effort, 1 to 10 (ADR 0067). Only shown, and only read,
    // when the chosen format is AVIF — no other encoder has the notion.
    in-out property <string> export-avif-speed-text: "9";
    in-out property <string> export-max-edge-text: "";
    // Text watermark drawn on the export, empty = none (ADR 0034). The line
    // and its four decorations, all editable (ADR 0106 §2) — before that,
    // every watermark Leyline could produce was white, 3 %, 70 % opaque, in
    // the bottom-right corner.
    in-out property <string> export-watermark-text: "";
    // Corner index, in `WatermarkAnchor`'s own order: bottom-right,
    // bottom-left, top-right, top-left, center. The dialog draws the chips
    // in the frame's geometry instead, which is a layout, not a meaning.
    in-out property <int> export-watermark-anchor: 0;
    // Cap height as a percentage of the image height, in (0, 50].
    in-out property <string> export-watermark-size-text: "3";
    in-out property <string> export-watermark-color-text: "#FFFFFF";
    // Blend strength in [0, 1].
    in-out property <string> export-watermark-opacity-text: "0.7";
    in-out property <string> export-destination-text: "";
    callback browse-export-destination();
    callback open-print();
    // Print (ADR 0036): preset index (-1 = ad-hoc), destination, paper
    // index, orientation index, margins text (mm, all four edges), dpi
    // text, ICC profile path (blank = sRGB), intent index, copies text.
    // Paper/orientation/margins/dpi/profile/intent are ignored when a
    // stored preset is chosen — same pattern as `run-export`.
    callback run-print(int, string, int, int, string, string, string, int, string);
    callback run-save-print-preset(string, int, int, string, string, string, int);
    in property <[string]> print-presets;
    in-out property <int> print-preset: -1;
    in-out property <string> print-preset-name: "";
    in-out property <int> print-paper: 0;
    in-out property <int> print-orientation: 0;
    in-out property <string> print-margins-text: "10";
    in-out property <string> print-dpi-text: "300";
    in-out property <int> print-intent: 1;
    in-out property <string> print-copies-text: "1";
    in-out property <string> print-destination-text: "";
    in-out property <string> print-profile-text: "";
    callback browse-print-destination();
    callback browse-print-profile();

    // Contact sheet (ADR 0110). The callbacks take no arguments: every field
    // below is two-way bound, so Rust reads the state rather than a dozen
    // positional parameters.
    callback open-contact-sheet();
    callback run-contact-sheet();
    callback run-save-sheet-preset();
    callback browse-sheet-destination();
    callback browse-sheet-profile();
    in property <[string]> sheet-presets;
    in-out property <int> sheet-preset: -1;
    in-out property <string> sheet-preset-name: "";
    in-out property <int> sheet-paper: 0;
    in-out property <int> sheet-orientation: 0;
    in-out property <string> sheet-margins-text: "10";
    in-out property <string> sheet-dpi-text: "200";
    in-out property <string> sheet-columns-text: "4";
    in-out property <string> sheet-rows-text: "5";
    in-out property <string> sheet-gutter-text: "4";
    in-out property <bool> sheet-captions: true;
    in-out property <string> sheet-caption-size-text: "3";
    in-out property <int> sheet-intent: 1;
    in-out property <string> sheet-destination-text: "";
    in-out property <string> sheet-profile-text: "";
    // Opens the tethered-capture dialog (ADR 0038, ADR 0087 §7) and connects
    // from the first USB camera libgphoto2 finds.
    callback open-tether();
    callback run-tether-connect();
    in-out property <bool> tether-connected: false;
    in-out property <string> tether-status: "";
    // What is decided *before* a session opens (ADR 0087 §4): the folder
    // under `Photos/` its shots are filed in, and the develop preset each
    // arriving shot is developed with. Everything about a session already
    // running lives in `TetherState` instead — that is the bar's business,
    // not this dialog's.
    in-out property <string> tether-session: "";
    // Index into `tether-presets`, -1 for "no preset".
    in-out property <int> tether-preset: -1;
    in property <[string]> tether-presets: [];
    // Reporting a problem (ADR 0123): `run-report` writes the folder and
    // opens it. Leyline sends nothing, here or anywhere.
    callback open-report();
    callback run-report();
    in-out property <string> report-description: "";
    // What will be copied into the folder, one line each, already worded by
    // Rust (name and size). The list *is* the promise of ADR 0123 §3: what
    // it shows is what the folder will hold, and it is shown before the
    // folder exists.
    in property <[string]> report-attachments;
    // Files the photographer chose themselves — their own screenshot, taken
    // with whatever tool they use. Optional: a description alone is a report.
    callback report-add-files();
    callback report-remove-attachment(int);

    // Opens the watched-folder auto-import panel (ADR 0039): starts/stops
    // watching a folder, importing every file that settles there.
    callback open-watch();
    callback browse-watch-folder();
    callback run-watch-start();
    callback run-watch-stop();
    in-out property <bool> watch-active: false;
    in-out property <string> watch-status: "";
    in-out property <string> watch-folder-text: "";
    in-out property <string> watch-last-imported: "";
    in-out property <int> watch-imported-count: 0;
    // Opens the roots panel (ADR 0085 §8): which folders this library may
    // reference photographs inside, and which are reachable right now.
    callback open-roots();
    // Renaming files on disk (ADR 0100): the template last used, and the
    // call that applies it to the grid selection.
    in-out property <string> rename-template: "{name}";
    callback open-rename();
    callback run-rename(string);
    // Pick a folder and add it as a root, or tell the library where a root
    // it already knows has moved to. Both open a native folder picker, so
    // neither takes a typed path: a root is identified by the marker inside
    // the folder, and typing a path only makes it easier to point at the
    // wrong one.
    callback run-root-add();
    callback run-root-locate(string);
    callback run-root-forget(string);
    in-out property <[RootRow]> roots: [];
    in-out property <string> roots-status: "";
}
