// Small reusable controls of the Studio UI (ADR 0045 §3).
//
// Nothing here knows about application state: each control takes what it
// displays as an `in` property and reports interaction through a callback.
// That is what makes them the one part of the UI that *is* reusable, unlike
// the singleton panels of `ui/panels/`.

import { Cell } from "../types.slint";

export component DetailRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 8px;
    Text {
        text: root.label;
        color: #9a9a9a;
        font-size: 12px;
        width: 72px;
    }
    Text {
        text: root.value;
        color: #e6e6e6;
        font-size: 12px;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}

// Collapsible section header for the develop panel's setting groups: lets
// a photo's edit stay focused on the groups actually touched instead of
// scrolling past sliders for adjustments that were never made.
export component GroupHeader inherits HorizontalLayout {
    in property <string> label;
    in-out property <bool> expanded;

    TouchArea {
        horizontal-stretch: 1;
        Text {
            text: (root.expanded ? "▾ " : "▸ ") + root.label;
            color: #9a9a9a;
            font-size: 11px;
            width: 100%;
        }
        clicked => {
            root.expanded = !root.expanded;
        }
    }
}

// A sub-heading *inside* a group: names a run of sliders without adding a
// third thing to fold. Basic is one group read top to bottom (ADR 0054 §2),
// so its internal divisions must not be clickable — a header that collapses
// is an invitation to collapse it, and the sequence is the point.
export component SubHeading inherits VerticalLayout {
    in property <string> label;
    spacing: 4px;
    padding-top: 6px;

    Rectangle {
        height: 1px;
        background: #2c2c2c;
    }
    Text {
        text: root.label;
        color: #9a9a9a;
        font-size: 11px;
        horizontal-alignment: center;
    }
}

export component FilterChip inherits Rectangle {
    in property <bool> active;
    in property <bool> enabled: true;
    in property <string> text;
    callback clicked;

    height: 24px;
    width: chip-text.preferred-width + 18px;
    border-radius: 12px;
    background: root.active ? #2f4f6f : #242424;
    border-width: 1px;
    border-color: root.active ? #6fa8dc : #333333;
    opacity: root.enabled ? 1.0 : 0.4;

    chip-text := Text {
        text: root.text;
        color: root.active ? #e6e6e6 : #9a9a9a;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
    TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// The loaded grid window, seen edge-on (ADR 0055 §5): one strip of
// thumbnails under a photo shown large, in develop as in the loupe.
//
// Takes the cell model rather than reading `GridState` itself, like every
// other control here — that is what lets the two panels mount it without
// either of them owning it.
export component Filmstrip inherits Flickable {
    in property <[Cell]> cells;
    // Grid index of `cells[0]`, so a click can report a whole-grid index.
    in property <int> window-start;
    in property <int> selected;
    callback clicked(int);

    height: 64px;
    viewport-width: root.cells.length * 64px;

    HorizontalLayout {
        for cell[i] in root.cells: TouchArea {
            width: 64px;
            height: 64px;
            clicked => {
                root.clicked(root.window-start + i);
            }
            Rectangle {
                x: 2px;
                y: 2px;
                width: parent.width - 4px;
                height: parent.height - 4px;
                border-radius: 3px;
                border-width: root.window-start + i == root.selected ? 2px : 0px;
                border-color: #6fa8dc;
                Image {
                    source: cell.thumbnail;
                    image-fit: contain;
                    width: 100%;
                    height: 100%;
                }
            }
        }
    }
}

// A track and nothing else, for a setting whose effect is the feedback
// (ADR 0055 §3: the thumbnail size). Unlike `EditSlider` it reports while
// dragging rather than on release — a size that only changed once the mouse
// came up would feel broken, and there is nothing expensive behind it.
export component MiniSlider inherits Rectangle {
    in property <float> minimum;
    in property <float> maximum;
    in property <float> value;
    callback edited(float);

    property <bool> dragging;

    width: 96px;
    height: 20px;

    Rectangle {
        y: parent.height / 2 - 2px;
        height: 4px;
        border-radius: 2px;
        background: #3a3a3a;
    }
    Rectangle {
        x: (root.width - 12px) * (root.value - root.minimum) / (root.maximum - root.minimum);
        y: parent.height / 2 - 6px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: root.dragging ? #6fa8dc : #8a8a8a;
    }
    TouchArea {
        moved => {
            if (self.pressed) {
                root.dragging = true;
                root.edited(Math.clamp(root.minimum + (self.mouse-x / self.width) * (root.maximum - root.minimum), root.minimum, root.maximum));
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up) {
                root.dragging = false;
            }
        }
    }
}

// The two ways of looking at a library (ADR 0055 §3), shared by the grid and
// the loupe so leaving one is never a keyboard-only gesture.
export component ViewModeChips inherits HorizontalLayout {
    in property <bool> loupe;
    // A loupe with no photo in it would be an empty grey rectangle.
    in property <bool> loupe-available: true;
    callback show-grid();
    callback show-loupe();

    spacing: 6px;

    FilterChip {
        text: @tr("Grid");
        active: !root.loupe;
        clicked => {
            root.show-grid();
        }
    }
    FilterChip {
        text: @tr("Loupe");
        active: root.loupe;
        enabled: root.loupe-available;
        clicked => {
            root.show-loupe();
        }
    }
}

// One develop slider: label, track and value on a single row (ADR 0054 §2).
//
// One row rather than two, because the panel is read as a *stack*: the eye
// scans a column of names and numbers, and a track that pushes each control
// onto two lines halves how much of the edit is visible at once. The whole
// tonal set fits on one screen this way, which is what makes a settings panel
// feel like one thing instead of a scroll.
//
// The displayed position follows the authoritative value from Rust except
// while dragging, so refreshing the settings after a commit never breaks a
// binding.
export component EditSlider inherits HorizontalLayout {
    in property <string> label;
    in property <float> minimum;
    in property <float> maximum;
    in property <float> value;
    in property <int> decimals;
    // Where a double-click sends the slider back to (ADR 0054 §2). Zero for
    // almost everything; the settings whose neutral is not zero say so, and
    // the value is clamped to the range so a slider that never reaches zero
    // (a radius, a temperature) still resets to something it can hold.
    in property <float> neutral: 0;
    // A track that shows what the slider does: the white-balance and colour
    // sliders carry a gradient of their own effect, the tonal ones stay grey.
    // Two colours rather than a `brush`, so a caller cannot accidentally hand
    // a solid fill to a control whose meaning is the gradient.
    in property <color> track-from: #333333;
    in property <color> track-to: #333333;
    callback edited(float);

    property <bool> dragging;
    property <float> drag-value;
    property <float> shown: root.dragging ? root.drag-value : root.value;
    property <float> factor: root.decimals == 0 ? 1 : 100;
    property <float> rounded: Math.round(root.shown * root.factor) / root.factor;

    spacing: 8px;
    height: 22px;

    Text {
        // Right-aligned against the track, fixed width: the labels line up as
        // a column, and the tracks all start at the same x.
        text: root.label;
        color: #9a9a9a;
        font-size: 12px;
        width: 88px;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }
    track := Rectangle {
        horizontal-stretch: 1;
        Rectangle {
            y: parent.height / 2 - 2px;
            height: 4px;
            border-radius: 2px;
            background: @linear-gradient(90deg, root.track-from 0%, root.track-to 100%);
        }
        Rectangle {
            x: (track.width - 12px) * (root.shown - root.minimum) / (root.maximum - root.minimum);
            y: parent.height / 2 - 6px;
            width: 12px;
            height: 12px;
            border-radius: 6px;
            background: root.dragging ? #6fa8dc : #8a8a8a;
        }
        TouchArea {
            moved => {
                if (self.pressed) {
                    root.dragging = true;
                    root.drag-value = Math.clamp(root.minimum + (self.mouse-x / self.width) * (root.maximum - root.minimum), root.minimum, root.maximum);
                }
            }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.up && root.dragging) {
                    root.dragging = false;
                    root.edited(root.drag-value);
                }
            }
            // The gesture everyone already has in their fingers: a
            // double-click puts the slider back where it does nothing.
            double-clicked => {
                root.dragging = false;
                root.edited(Math.clamp(root.neutral, root.minimum, root.maximum));
            }
        }
    }
    Text {
        // A fixed column so the numbers align, and an explicit sign so a
        // glance tells which way a slider was moved — on the two-sided
        // sliders only: a temperature in kelvin or a strength in percent is
        // a quantity, not a deviation, and "+6500 K" reads as an error.
        text: root.minimum < 0 && root.rounded > 0 ? "+\{root.rounded}" : "\{root.rounded}";
        color: #e6e6e6;
        font-size: 12px;
        width: 46px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}
