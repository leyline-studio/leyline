msgctxt "BasicGroup"
msgid "Rebuild"
msgstr ""

#: crates/leyline-studio/ui/panels/develop_basic.slint:317
msgctxt "BasicGroup"
msgid ""
"Reconstructs clipped detail from neighbouring pixels. Slowest, for a badly "
"blown sky."
msgstr ""

