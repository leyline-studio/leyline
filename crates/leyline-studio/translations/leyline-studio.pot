msgctxt "BasicGroup"
msgid "Whites"
msgstr ""

#: crates/leyline-studio/ui/panels/develop_basic.slint:181
msgctxt "BasicGroup"
msgid ""
"Where the brightest tones clip. Highlights bends what is below that point; "
"this sets the point."
msgstr ""

