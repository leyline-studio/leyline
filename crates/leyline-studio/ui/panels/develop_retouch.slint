// Groups of the develop panel's adjustment column, each the body of one
// collapsible group in `develop.slint`, which keeps the headers and the
// expanded state. Like the panel itself (ADR 0045 §3), a group inherits the
// `VerticalLayout` it replaces and sets no geometry of its own.

import { Theme } from "../theme.slint";
import { DevelopState } from "../state/develop.slint";
import { FilterChip } from "../widgets/controls.slint";

// The Spot removal group of the develop panel.
export component SpotRemovalGroup inherits VerticalLayout {
        spacing: 8px;
        Text {
            text: @tr("Pick the Spot Removal tool above, click a clean source, then the spot to fix.");
            color: Theme.text-disabled;
            font-size: 11px;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                Text {
                    text: @tr("Radius %");
                    color: Theme.text-dim;
                    font-size: 12px;
                }
                Rectangle {
                    height: 26px;
                    background: Theme.surface;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border;
                    TextInput {
                        x: 6px;
                        width: parent.width - 12px;
                        height: 100%;
                        text <=> DevelopState.spot-radius-text;
                        color: Theme.text;
                        font-size: 12px;
                        vertical-alignment: center;
                        single-line: true;
                    }
                }
            }
            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                Text {
                    text: @tr("Feather %");
                    color: Theme.text-dim;
                    font-size: 12px;
                }
                Rectangle {
                    height: 26px;
                    background: Theme.surface;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border;
                    TextInput {
                        x: 6px;
                        width: parent.width - 12px;
                        height: 100%;
                        text <=> DevelopState.spot-feather-text;
                        color: Theme.text;
                        font-size: 12px;
                        vertical-alignment: center;
                        single-line: true;
                    }
                }
            }
            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                Text {
                    text: @tr("Opacity %");
                    color: Theme.text-dim;
                    font-size: 12px;
                }
                Rectangle {
                    height: 26px;
                    background: Theme.surface;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border;
                    TextInput {
                        x: 6px;
                        width: parent.width - 12px;
                        height: 100%;
                        text <=> DevelopState.spot-opacity-text;
                        color: Theme.text;
                        font-size: 12px;
                        vertical-alignment: center;
                        single-line: true;
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: @tr("{} spot(s)", DevelopState.dev-spot-count);
                color: Theme.text-dim;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            FilterChip {
                text: @tr("Undo Last");
                active: false;
                clicked => {
                    DevelopState.develop-spot-undo();
                }
            }
            FilterChip {
                text: @tr("Clear All");
                active: false;
                clicked => {
                    DevelopState.develop-spot-reset();
                }
            }
        }
}

// The Red eye group (ADR 0103).
export component RedEyeGroup inherits VerticalLayout {
        spacing: 8px;
        Text {
            text: @tr("Pick the Red Eye tool above, then click each pupil. Only red pixels inside the circle are corrected, so the circle need not be precise.");
            color: Theme.text-disabled;
            font-size: 11px;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            for field in [
                { label: @tr("Radius %"), value: DevelopState.red-eye-radius-text, key: "radius" },
                { label: @tr("Feather"), value: DevelopState.red-eye-feather-text, key: "feather" },
                { label: @tr("Darken"), value: DevelopState.red-eye-darken-text, key: "darken" },
            ]: VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                Text {
                    text: field.label;
                    color: Theme.text-dim;
                    font-size: 12px;
                }
                Rectangle {
                    height: 26px;
                    background: Theme.surface;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border;
                    red-eye-input := TextInput {
                        x: 6px;
                        width: parent.width - 12px;
                        height: 100%;
                        text: field.value;
                        color: Theme.text;
                        font-size: 12px;
                        vertical-alignment: center;
                        single-line: true;
                        edited => {
                            if (field.key == "radius") {
                                DevelopState.red-eye-radius-text = self.text;
                            } else if (field.key == "feather") {
                                DevelopState.red-eye-feather-text = self.text;
                            } else {
                                DevelopState.red-eye-darken-text = self.text;
                            }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: space-between;
            Text {
                text: @tr("{} placed", DevelopState.dev-red-eye-count);
                color: Theme.text-dim;
                font-size: 12px;
                vertical-alignment: center;
            }
            FilterChip {
                text: @tr("Clear");
                active: false;
                enabled: DevelopState.dev-red-eye-count > 0;
                clicked => {
                    DevelopState.develop-red-eye-reset();
                }
            }
        }
}

// The Reshape group.
export component ReshapeGroup inherits VerticalLayout {
        spacing: 8px;
        Text {
            text: @tr("Pick the Reshape tool above, then drag from the content to where it should go. The pixels within the radius follow and fade to nothing at its edge; nothing is invented.");
            color: Theme.text-disabled;
            font-size: 11px;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            for field in [
                { label: @tr("Radius %"), value: DevelopState.reshape-radius-text, key: "radius" },
                { label: @tr("Strength"), value: DevelopState.reshape-strength-text, key: "strength" },
            ]: VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                Text {
                    text: field.label;
                    color: Theme.text-dim;
                    font-size: 12px;
                }
                Rectangle {
                    height: 26px;
                    background: Theme.surface;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border;
                    reshape-input := TextInput {
                        x: 6px;
                        width: parent.width - 12px;
                        height: 100%;
                        text: field.value;
                        color: Theme.text;
                        font-size: 12px;
                        vertical-alignment: center;
                        single-line: true;
                        edited => {
                            if (field.key == "radius") {
                                DevelopState.reshape-radius-text = self.text;
                            } else {
                                DevelopState.reshape-strength-text = self.text;
                            }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: space-between;
            Text {
                text: @tr("{} placed", DevelopState.dev-reshape-count);
                color: Theme.text-dim;
                font-size: 12px;
                vertical-alignment: center;
            }
            FilterChip {
                text: @tr("Clear");
                active: false;
                enabled: DevelopState.dev-reshape-count > 0;
                clicked => {
                    DevelopState.develop-reshape-reset();
                }
            }
        }
}
