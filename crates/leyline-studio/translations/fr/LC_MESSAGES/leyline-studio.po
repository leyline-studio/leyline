#: ui/studio.slint:2078
msgctxt "StudioWindow"
msgid ""
"G / D — library / develop\n"
"I — import · E — export · N — new collection\n"
"B / Shift+B — add / remove from collection\n"
"Shift+R — reprocess library · R — reprocess (develop)\n"
"Ctrl+Z / Ctrl+Y — undo / redo · S — save preset\n"
"0–5 — rate · 6–9 — color label · P / X / U — pick / reject / clear"
msgstr ""
"G / D — bibliothèque / développement\n"
"I — importer · E — exporter · N — nouvelle collection\n"
"B / Maj+B — ajouter / retirer de la collection\n"
"Maj+R — retraiter la bibliothèque · R — retraiter (développement)\n"
"Ctrl+Z / Ctrl+Y — annuler / rétablir · S — enregistrer le preset\n"
"0–5 — noter · 6–9 — étiquette de couleur · P / X / U — sélectionner / rejeter / effacer"

