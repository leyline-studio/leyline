msgctxt "BasicGroup"
msgid "Blacks"
msgstr ""

#: crates/leyline-studio/ui/panels/develop_basic.slint:194
msgctxt "BasicGroup"
msgid ""
"Where the darkest tones clip. Shadows lifts what is above that point; this "
"sets the point."
msgstr ""

#: crates/leyline-studio/ui/panels/develop_basic.slint:207
msgctxt "BasicGroup"
msgid "Presence"
msgstr ""

#: crates/leyline-studio/ui/panels/develop_basic.slint:210
msgctxt "BasicGroup"
msgid "Texture"
msgstr ""

#: crates/leyline-studio/ui/panels/develop_basic.slint:211
msgctxt "BasicGroup"
msgid ""
"Contrast over fine detail: skin, bark, fabric. Unlike sharpening, it leaves "
"edges alone."
msgstr ""

