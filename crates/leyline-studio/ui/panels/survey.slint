// The survey view (ADR 0057 §4): everything currently selected, side by side,
// and a way to drop what does not survive the comparison (ADR 0045 §3).
//
// It is a funnel, not a gallery: one starts with twelve photos and ends with
// two. Removing a photo takes it out of the *selection* — nothing is deleted
// and nothing is written.

import { SurveyCell } from "../types.slint";
import { GridState } from "../state/grid.slint";
import { DevelopState } from "../state/develop.slint";
import { FilterChip } from "../widgets/controls.slint";

export component SurveyPanel inherits VerticalLayout {
    in property <bool> chrome-hidden;

    // How many fit per row: enough to keep the cells roughly square without
    // asking Rust anything, since the count is all it takes.
    property <int> columns: Math.max(1, Math.ceil(Math.sqrt(Math.max(GridState.survey-cells.length, 1))));

    visible: GridState.survey-mode;
    padding: 12px;
    spacing: 8px;

    Rectangle {
        height: 28px;
    }

    if !root.chrome-hidden: HorizontalLayout {
        height: 24px;
        spacing: 8px;
        alignment: start;

        FilterChip {
            text: @tr("Grid    G");
            active: false;
            clicked => {
                GridState.survey-mode = false;
                GridState.survey-mode-changed();
            }
        }
        FilterChip {
            text: @tr("Develop    D");
            active: false;
            enabled: GridState.selected >= 0;
            clicked => {
                GridState.survey-mode = false;
                GridState.survey-mode-changed();
                DevelopState.enter-develop();
            }
        }
        Text {
            text: @tr("Click ✕ to drop a photo from the selection");
            color: #7a7a7a;
            font-size: 11px;
            vertical-alignment: center;
        }
    }

    Rectangle {
        vertical-stretch: 1;

        property <length> cell-w: self.width / root.columns;
        property <length> cell-h: self.height / Math.max(1, Math.ceil(GridState.survey-cells.length / root.columns));

        for cell[i] in GridState.survey-cells: Rectangle {
            x: Math.mod(i, root.columns) * parent.cell-w + 4px;
            y: Math.floor(i / root.columns) * parent.cell-h + 4px;
            width: parent.cell-w - 8px;
            height: parent.cell-h - 8px;
            // A drawn tile rather than photos floating on the background:
            // with two photos left the cells are tall, the images letterbox
            // inside them, and without the tile the ✕ in the corner looks
            // like it belongs to nothing.
            background: #1e1e1e;
            border-radius: 6px;
            border-width: 1px;
            border-color: #2c2c2c;

            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                Image {
                    source: cell.image;
                    image-fit: contain;
                    vertical-stretch: 1;
                }
                Text {
                    text: cell.filename;
                    color: #9a9a9a;
                    font-size: 11px;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }

            // Top-right, over the photo: the gesture that makes this view a
            // funnel. Only shown while there is more than one photo left —
            // emptying the survey from inside it would leave nothing to look
            // at and no way to say so.
            if GridState.survey-cells.length > 1: Rectangle {
                x: parent.width - 26px;
                y: 8px;
                width: 20px;
                height: 20px;
                border-radius: 10px;
                background: #000000aa;
                Text {
                    text: "✕";
                    color: #e6e6e6;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
                TouchArea {
                    clicked => {
                        GridState.survey-remove(i);
                    }
                }
            }
        }
    }
}
