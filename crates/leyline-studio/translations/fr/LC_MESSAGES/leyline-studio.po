msgid "Behind a soft proof"
msgstr "Derrière une épreuve écran"

#: crates/leyline-studio/ui/dialogs/preferences.slint:85
msgctxt "PreferencesDialog"
msgid ""
"White by default: a proof answers what a print will look like, and a print "
"is looked at on paper."
msgstr "Blanc par défaut : une épreuve répond à « de quoi aura l'air le tirage », et un tirage se regarde sur du papier."

#: crates/leyline-studio/ui/dialogs/preferences.slint:92
msgctxt "PreferencesDialog"
msgid "Updates"
