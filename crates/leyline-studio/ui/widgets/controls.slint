// Small reusable controls of the Studio UI (ADR 0045 §3).
//
// Nothing here knows about application state: each control takes what it
// displays as an `in` property and reports interaction through a callback.
// That is what makes them the one part of the UI that *is* reusable, unlike
// the singleton panels of `ui/panels/`.

import { Cell } from "../types.slint";
import { HintState } from "../state/hint.slint";
import { PreferencesState } from "../state/preferences.slint";

export component DetailRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 8px;
    Text {
        text: root.label;
        color: #9a9a9a;
        font-size: 12px;
        width: 72px;
    }
    Text {
        text: root.value;
        color: #e6e6e6;
        font-size: 12px;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}

// Collapsible section header for the develop panel's setting groups: lets
// a photo's edit stay focused on the groups actually touched instead of
// scrolling past sliders for adjustments that were never made.
// The zoom law, in one place (ADR 0112 §3): how far one wheel notch moves
// the scale, and where it stops at either end.
//
// A multiplier and not a step, because zoom is perceived in ratios: the same
// notch has to feel the same at 30 % and at 400 %.
export global Zoom {
    // One image pixel per screen pixel is 1.0; the floor is well below any
    // fit scale, so the wheel can always come back down to the whole photo.
    out property <float> minimum: 0.05;
    out property <float> maximum: 8.0;
    out property <float> per-notch: 1.15;

    public pure function stepped(current: float, delta: length) -> float {
        return Math.clamp(
            delta > 0 ? current * root.per-notch : current / root.per-notch,
            root.minimum,
            root.maximum);
    }
    // What the corner reads: "100 %", never "100.0000 %".
    public pure function percent(scale: float) -> string {
        return Math.round(scale * 100) + " %";
    }
}

export component GroupHeader inherits HorizontalLayout {
    in property <string> label;
    // The group's identifier for `develop::reset_group`. Empty means this
    // header has nothing to reset — a view toggle, or a list (ADR 0112 §4).
    in property <string> group;
    in-out property <bool> expanded;
    callback reset();

    TouchArea {
        horizontal-stretch: 1;
        Text {
            text: (root.expanded ? "▾ " : "▸ ") + root.label;
            color: #9a9a9a;
            font-size: 11px;
            width: 100%;
        }
        clicked => {
            root.expanded = !root.expanded;
        }
    }
    // Put the whole group back to neutral, in one revision (ADR 0112 §4).
    // Shown only while the group is open: a header row is read as a list,
    // and a column of buttons down the side of a folded panel invites the
    // one click nobody wants to make by accident.
    if root.group != "" && root.expanded: reset-glyph := TouchArea {
        width: 16px;
        mouse-cursor: pointer;
        Text {
            text: "⟲";
            color: parent.has-hover ? #e6e6e6 : #6a6a6a;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        clicked => {
            HintState.dismiss();
            root.reset();
        }
        // A glyph with no word anywhere near it (ADR 0127 §1).
        changed has-hover => {
            if (self.has-hover) {
                HintState.enter(@tr("Put this group back to neutral"),
                    self.absolute-position.x, self.absolute-position.y + self.height);
            } else {
                HintState.leave(@tr("Put this group back to neutral"));
            }
        }
    }
}

// A sub-heading *inside* a group: names a run of sliders without adding a
// third thing to fold. Basic is one group read top to bottom (ADR 0054 §2),
// so its internal divisions must not be clickable — a header that collapses
// is an invitation to collapse it, and the sequence is the point.
export component SubHeading inherits VerticalLayout {
    in property <string> label;
    spacing: 4px;
    padding-top: 6px;

    Rectangle {
        height: 1px;
        background: #2c2c2c;
    }
    Text {
        text: root.label;
        color: #9a9a9a;
        font-size: 11px;
        horizontal-alignment: center;
    }
}

export component FilterChip inherits Rectangle {
    in property <bool> active;
    in property <bool> enabled: true;
    in property <string> text;
    // What to say on hover, for a chip whose label is a glyph (ADR 0127
    // §1). Empty for every chip that carries a word, which is nearly all
    // of them — a hint on a chip that says `Crop` is the layer of
    // explanation ADR 0054 §4 was right to refuse.
    in property <string> hint;
    callback clicked;

    height: 24px;
    width: chip-text.preferred-width + 18px;
    border-radius: 12px;
    background: root.active ? #2f4f6f : #242424;
    border-width: 1px;
    border-color: root.active ? #6fa8dc : #333333;
    opacity: root.enabled ? 1.0 : 0.4;

    chip-text := Text {
        text: root.text;
        color: root.active ? #e6e6e6 : #9a9a9a;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            HintState.dismiss();
            root.clicked();
        }
        changed has-hover => {
            if (root.hint != "") {
                if (self.has-hover) {
                    HintState.enter(root.hint, root.absolute-position.x, root.absolute-position.y + root.height);
                } else {
                    HintState.leave(root.hint);
                }
            }
        }
    }
}

// An eyedropper, drawn rather than written.
//
// A picker is a pictogram everywhere in photography, and Leyline had it as a
// labelled button — which reads as "a thing that happens" rather than "a thing
// you then click the photograph with". Drawn as a `Path` and not a character:
// there is no eyedropper in a font one can rely on, and the emoji that come
// close vanish on the fonts of a bare X session.
//
// The viewbox is square and the element is square, which is the rule for a
// `Path` here: a viewbox whose ratio differs from the element's distorts the
// drawing rather than letterboxing it.
export component PipetteChip inherits Rectangle {
    in property <bool> active;
    // A picker is a pictogram by design, so this one is never empty
    // (ADR 0127 §1).
    in property <string> hint;
    callback clicked;

    height: 24px;
    width: 30px;
    border-radius: 12px;
    background: root.active ? #2f4f6f : #242424;
    border-width: 1px;
    border-color: root.active ? #6fa8dc : #333333;

    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        viewbox-width: 16;
        viewbox-height: 16;
        // The barrel from tip to shoulder, then the bulb across it.
        commands: "M1.5 14.5 L3 10.5 L9.5 4 L12 6.5 L5.5 13 Z M10 3.5 L12.5 1 L15 3.5 L12.5 6 Z";
        fill: root.active ? #e6e6e6 : #9a9a9a;
    }
    TouchArea {
        clicked => {
            HintState.dismiss();
            root.clicked();
        }
        changed has-hover => {
            if (root.hint != "") {
                if (self.has-hover) {
                    HintState.enter(root.hint, root.absolute-position.x, root.absolute-position.y + root.height);
                } else {
                    HintState.leave(root.hint);
                }
            }
        }
    }
}

// The end of a toolbar that does not fit, and the way to reach it
// (ADR 0125 §3).
//
// A chevron rather than a scrollbar: a 24px-tall row would carry a 4px bar
// under controls that are themselves 24px tall, and the gesture that bar
// invites — grabbing something thinner than the thing it scrolls — is the
// one a cramped window is least able to serve. This is a button, the size
// of the chips beside it, and it says which way there is more.
//
// It paints its own ground because it sits *over* the row it scrolls: with
// a transparent one, a chip would read through the glyph.
export component ToolbarChevron inherits Rectangle {
    in property <bool> forward;
    callback clicked;

    width: 18px;
    height: 24px;
    background: #1b1b1b;

    Text {
        text: root.forward ? "›" : "‹";
        color: touch.has-hover ? #e6e6e6 : #9a9a9a;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            HintState.dismiss();
            root.clicked();
        }
        changed has-hover => {
            if (self.has-hover) {
                HintState.enter(@tr("More tools"),
                    self.absolute-position.x, self.absolute-position.y + self.height);
            } else {
                HintState.leave(@tr("More tools"));
            }
        }
    }
}

// A thin rule between groups of tools: the toolbar carries a dozen of them,
// and a dozen chips in one undifferentiated row is a list, not a toolbar.
export component ToolSeparator inherits Rectangle {
    width: 1px;
    height: 16px;
    background: #3a3a3a;
}

// A photo shown large, fitted or at 100 %, with the viewpoint driven from
// **outside** (ADR 0057 §2).
//
// That last part is the whole point: the compare view mounts two of these and
// feeds both the same `zoomed` and the same centre, which is what makes the
// two images show the same place at the same magnification. The loupe mounts
// one and drives it alone.
//
// The centre is in **normalised image coordinates** — 0.5, 0.5 is the middle
// of the photo whatever its pixel dimensions — so two images of different
// sizes stay on the same relative area (§2, Alternatives).
// One shot-filter interval, typed rather than dragged (ADR 0064 §1).
//
// Typed because both bounds are optional: a two-handle slider would have to
// invent a way of saying "no upper bound at all", and "ISO ≥ 3200" is the
// common request. The text is read by Rust, never here.
export component RangeField inherits HorizontalLayout {
    in property <string> label;
    in property <string> placeholder;
    callback accepted(string);

    // Empties the field from outside, for the panel's Clear chip: once the
    // user has typed, the input owns its text and no binding can take it
    // back.
    public function clear() {
        input.text = "";
    }

    spacing: 5px;

    Text {
        text: root.label;
        color: #9a9a9a;
        font-size: 12px;
        vertical-alignment: center;
    }

    Rectangle {
        width: 84px;
        height: 24px;
        background: #1b1b1b;
        border-radius: 12px;
        border-width: 1px;
        border-color: input.text == "" ? #333333 : #6fa8dc;
        input := TextInput {
            x: 9px;
            width: parent.width - 18px;
            height: 100%;
            color: #e6e6e6;
            font-size: 12px;
            vertical-alignment: center;
            single-line: true;
            accepted => {
                root.accepted(self.text);
            }
        }
        if input.text == "" && !input.has-focus: Text {
            x: 9px;
            height: 100%;
            text: root.placeholder;
            color: #666666;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

export component ZoomableImage inherits Rectangle {
    in property <image> source;
    in property <bool> zoomed;
    // Image pixels per screen pixel while zoomed (ADR 0112 §3): 1.0 is
    // 100 %. Meaningless while `zoomed` is false, where the image is fitted.
    in property <float> scale: 1.0;
    in property <float> center-x: 0.5;
    in property <float> center-y: 0.5;
    // Dragging asks for a new centre and the wheel a new scale; the parent
    // decides, since in compare it is one centre and one scale for two views
    // — which is the whole reason neither is owned here.
    callback panned(float, float);
    callback zoom-requested(float);

    clip: true;

    property <float> image-w: max(root.source.width, 1);
    property <float> image-h: max(root.source.height, 1);
    property <length> shown-w: root.image-w * root.scale * 1px;
    property <length> shown-h: root.image-h * root.scale * 1px;

    if !root.zoomed: Image {
        source: root.source;
        image-fit: contain;
        width: 100%;
        height: 100%;
    }

    // Zoomed, the image is laid out at `scale` image-pixels per screen pixel
    // and slid so the requested centre sits in the middle of the viewport. A
    // plain `Flickable` would carry its own scroll position, which is exactly
    // the state that must not be per-view here — and it would own the wheel,
    // which `Ctrl` needs for the zoom.
    if root.zoomed: Image {
        source: root.source;
        width: root.shown-w;
        height: root.shown-h;
        x: parent.width / 2 - root.center-x * root.shown-w;
        y: parent.height / 2 - root.center-y * root.shown-h;
    }

    TouchArea {
        property <float> from-x;
        property <float> from-y;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                self.from-x = root.center-x;
                self.from-y = root.center-y;
            }
        }
        moved => {
            if (self.pressed && root.zoomed) {
                // The drag moves the photo under the viewport, so the centre
                // moves against the pointer.
                root.panned(
                    Math.clamp(self.from-x - (self.mouse-x - self.pressed-x) / root.shown-w, 0, 1),
                    Math.clamp(self.from-y - (self.mouse-y - self.pressed-y) / root.shown-h, 0, 1));
            }
        }
        // `Ctrl` + wheel, the same law the develop viewer uses (ADR 0112 §3).
        // From fit, only zooming *in* enters the zoom: a wheel-down on a
        // fitted photograph means "show me less than all of it", which is
        // nothing.
        scroll-event(event) => {
            if (event.modifiers.control) {
                if (root.zoomed) {
                    root.zoom-requested(Zoom.stepped(root.scale, event.delta-y));
                    return accept;
                }
                if (event.delta-y > 0) {
                    root.zoom-requested(Zoom.stepped(parent.height / (root.image-h * 1px), event.delta-y));
                    return accept;
                }
            }
            return reject;
        }
    }
}

// The loaded grid window, seen edge-on (ADR 0055 §5): one strip of
// thumbnails under a photo shown large, in develop as in the loupe.
//
// Takes the cell model rather than reading `GridState` itself, like every
// other control here — that is what lets the two panels mount it without
// either of them owning it.
export component Filmstrip inherits Rectangle {
    in property <[Cell]> cells;
    // Grid index of `cells[0]`, so a click can report a whole-grid index.
    in property <int> window-start;
    in property <int> selected;
    callback clicked(int);

    // One thumbnail's width, and the strip's height: the cells are square.
    property <length> cell-size: 64px;

    height: root.cell-size;

    // Brings the current photo back into view.
    //
    // The strip shows the loaded window, and the arrow keys walk the whole
    // grid: without this the highlight simply left the visible run of
    // thumbnails and the strip went on showing a stretch of photographs
    // that had nothing to do with the one on screen.
    function scroll-into-view() {
        if (root.selected < root.window-start
            || root.selected >= root.window-start + root.cells.length) {
            return;
        }
        // Scroll by the smallest amount that puts the cell inside: stepping
        // off the left edge scrolls one cell left, off the right edge one
        // cell right, and a cell already visible moves nothing.
        if ((root.selected - root.window-start) * root.cell-size < -strip.viewport-x) {
            strip.viewport-x = -(root.selected - root.window-start) * root.cell-size;
        } else if ((root.selected - root.window-start + 1) * root.cell-size
            > -strip.viewport-x + strip.width) {
            strip.viewport-x = strip.width
                - (root.selected - root.window-start + 1) * root.cell-size;
        }
    }
    // Two handlers because both halves of "which cell is highlighted" move
    // on their own: the selection walks inside the loaded window, and the
    // window itself slides under the selection when navigation crosses a
    // virtual-scrolling boundary.
    changed selected => {
        root.scroll-into-view();
    }
    changed window-start => {
        root.scroll-into-view();
    }

    // The wheel, caught *under* the strip rather than on it.
    //
    // Slint's `Flickable` ignores a vertical wheel whenever its viewport is
    // no taller than itself — which a one-row strip never is — so the
    // gesture used to fall through to nothing at all. Ignoring is not
    // swallowing: the event carries on to the items behind, and a
    // `TouchArea` declared *before* the `Flickable` is exactly that. The
    // cells keep their own `TouchArea`s in front, so a click still picks a
    // photograph.
    TouchArea {
        scroll-event(event) => {
            if (strip.viewport-width <= strip.width) {
                return reject;
            }
            // Both axes, added: `delta-y` is the ordinary wheel and
            // `delta-x` the horizontal one — and Slint has already swapped
            // the two when Shift was held.
            strip.viewport-x = Math.clamp(
                strip.viewport-x + event.delta-x + event.delta-y,
                strip.width - strip.viewport-width, 0);
            return accept;
        }
    }

    strip := Flickable {
        width: 100%;
        height: 100%;
        viewport-width: root.cells.length * root.cell-size;

        HorizontalLayout {
            for cell[i] in root.cells: TouchArea {
                width: root.cell-size;
                height: root.cell-size;
                clicked => {
                    root.clicked(root.window-start + i);
                }
                Rectangle {
                    x: 2px;
                    y: 2px;
                    width: parent.width - 4px;
                    height: parent.height - 4px;
                    border-radius: 3px;
                    border-width: root.window-start + i == root.selected ? 2px : 0px;
                    border-color: #6fa8dc;
                    Image {
                        source: cell.thumbnail;
                        image-fit: contain;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
        }
    }
}

// A track and nothing else, for a setting whose effect is the feedback
// (ADR 0055 §3: the thumbnail size). Unlike `EditSlider` it reports while
// dragging rather than on release — a size that only changed once the mouse
// came up would feel broken, and there is nothing expensive behind it.
export component MiniSlider inherits Rectangle {
    in property <float> minimum;
    in property <float> maximum;
    in property <float> value;
    callback edited(float);

    property <bool> dragging;

    width: 96px;
    height: 20px;

    Rectangle {
        y: parent.height / 2 - 2px;
        height: 4px;
        border-radius: 2px;
        background: #3a3a3a;
    }
    Rectangle {
        x: (root.width - 12px) * (root.value - root.minimum) / (root.maximum - root.minimum);
        y: parent.height / 2 - 6px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: root.dragging ? #6fa8dc : #8a8a8a;
    }
    TouchArea {
        moved => {
            if (self.pressed) {
                root.dragging = true;
                root.edited(Math.clamp(root.minimum + (self.mouse-x / self.width) * (root.maximum - root.minimum), root.minimum, root.maximum));
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up) {
                root.dragging = false;
            }
        }
    }
}

// The two ways of looking at a library (ADR 0055 §3), shared by the grid and
// the loupe so leaving one is never a keyboard-only gesture.
export component ViewModeChips inherits HorizontalLayout {
    in property <bool> loupe;
    // A loupe with no photo in it would be an empty grey rectangle.
    in property <bool> loupe-available: true;
    callback show-grid();
    callback show-loupe();

    spacing: 6px;

    FilterChip {
        text: @tr("Grid");
        active: !root.loupe;
        clicked => {
            root.show-grid();
        }
    }
    FilterChip {
        text: @tr("Loupe");
        active: root.loupe;
        enabled: root.loupe-available;
        clicked => {
            root.show-loupe();
        }
    }
}

// The seventeen categories of develop settings (ADR 0132 §1, `docs/presets.md`
// §3.1), and the arithmetic that packs them into one number.
//
// A bitfield rather than seventeen properties because two dialogs ask the
// same question — *what does this carry?* — and a single `int` crosses to
// Rust once, is stored once, and cannot drift into two lists that disagree.
// Slint 1.13 has no bit operators, so this is the `Math.pow` arrangement
// ADR 0128 §3 already uses for the remembered panel state.
//
// **The bit order is a contract with Rust**: index 0 is White balance and
// index 16 is Local adjustments, in the order of the table in
// `docs/presets.md` §3.1, which is also the order of the develop panel.
// `crate::groups::GROUP_BITS` on the Rust side reads the same order, and the
// two are checked against each other by a test there.
export global SettingsGroups {
    // Everything a *look* is made of: bits 0..10 (ADR 0132 §6). The six
    // positional categories — geometry, rendering, reshape, spot removal,
    // red eye, local adjustments — are left out, because they are statements
    // about one frame or about one file.
    out property <int> look: 2047;
    // All seventeen, for a Check All that means it.
    out property <int> every: 131071;

    pure public function has(mask: int, bit: int) -> bool {
        return Math.mod(Math.floor(mask / Math.pow(2, bit)), 2) == 1;
    }
    pure public function flip(mask: int, bit: int) -> int {
        return SettingsGroups.has(mask, bit)
            ? mask - Math.pow(2, bit)
            : mask + Math.pow(2, bit);
    }
}

// One chip of the row below. Its own component so the bit arithmetic is
// written once instead of seventeen times.
component GroupChip inherits FilterChip {
    in property <int> bit;
    in property <int> mask;
    in property <string> label;
    callback toggled(int);

    text: root.label;
    active: SettingsGroups.has(root.mask, root.bit);
    clicked => {
        root.toggled(root.bit);
    }
}

// One row of that bitfield, as chips.
//
// Chips and not Lightroom's column of checkboxes because ours are **atomic**
// (`docs/presets.md` §3.1 — a category is captured whole or not at all), so
// there is no sub-tree to draw and nothing to half-tick. Seventeen of them
// wrap onto four rows, in the order they appear down the develop panel: a
// photographer looking for *Color grading* finds it where it is on screen.
// Five rows, because seventeen chips on four ran the last one into the
// dialog's edge.
export component SettingsGroupChips inherits VerticalLayout {
    in property <int> mask;
    callback toggled(int);

    spacing: 6px;

    // Three per row, and the number is measured rather than chosen: in
    // French the widest three — « Courbe des tonalités », « Mélangeur TSL »,
    // « Étalonnage couleur » — come to 409px of the 440px a dialog leaves
    // between its paddings, and a fourth would put the row through the card's
    // right border (ADR 0138 §3). It was four per row until that measurement
    // was taken on the translated build rather than the English one, where
    // « LUT créative » ended exactly on the border and « Retouches locales »
    // had already run into it once before.
    HorizontalLayout {
        spacing: 6px;
        GroupChip { bit: 0; label: @tr("White balance"); mask: root.mask; toggled(b) => { root.toggled(b); } }
        GroupChip { bit: 1; label: @tr("Tone"); mask: root.mask; toggled(b) => { root.toggled(b); } }
        GroupChip { bit: 2; label: @tr("Presence"); mask: root.mask; toggled(b) => { root.toggled(b); } }
        Rectangle { horizontal-stretch: 1; }
    }
    HorizontalLayout {
        spacing: 6px;
        GroupChip { bit: 3; label: @tr("Tone curve"); mask: root.mask; toggled(b) => { root.toggled(b); } }
        GroupChip { bit: 4; label: @tr("Color mixer"); mask: root.mask; toggled(b) => { root.toggled(b); } }
        GroupChip { bit: 5; label: @tr("Color grading"); mask: root.mask; toggled(b) => { root.toggled(b); } }
        Rectangle { horizontal-stretch: 1; }
    }
    HorizontalLayout {
        spacing: 6px;
        GroupChip { bit: 6; label: @tr("Camera profile"); mask: root.mask; toggled(b) => { root.toggled(b); } }
        GroupChip { bit: 7; label: @tr("Creative LUT"); mask: root.mask; toggled(b) => { root.toggled(b); } }
        GroupChip { bit: 8; label: @tr("Effects"); mask: root.mask; toggled(b) => { root.toggled(b); } }
        Rectangle { horizontal-stretch: 1; }
    }
    HorizontalLayout {
        spacing: 6px;
        GroupChip { bit: 9; label: @tr("Lens correction"); mask: root.mask; toggled(b) => { root.toggled(b); } }
        GroupChip { bit: 10; label: @tr("Detail"); mask: root.mask; toggled(b) => { root.toggled(b); } }
        GroupChip { bit: 11; label: @tr("Rendering"); mask: root.mask; toggled(b) => { root.toggled(b); } }
        Rectangle { horizontal-stretch: 1; }
    }
    HorizontalLayout {
        spacing: 6px;
        GroupChip { bit: 12; label: @tr("Geometry"); mask: root.mask; toggled(b) => { root.toggled(b); } }
        GroupChip { bit: 13; label: @tr("Reshape"); mask: root.mask; toggled(b) => { root.toggled(b); } }
        GroupChip { bit: 14; label: @tr("Spot removal"); mask: root.mask; toggled(b) => { root.toggled(b); } }
        Rectangle { horizontal-stretch: 1; }
    }
    HorizontalLayout {
        spacing: 6px;
        GroupChip { bit: 15; label: @tr("Red eye"); mask: root.mask; toggled(b) => { root.toggled(b); } }
        GroupChip { bit: 16; label: @tr("Local adjustments"); mask: root.mask; toggled(b) => { root.toggled(b); } }
        Rectangle { horizontal-stretch: 1; }
    }
}

// The reminder that the selection is going to move on its own (ADR 0131 §4),
// mounted by the grid and the loupe — the two views the advance acts in.
//
// It shows itself only while the mode is on: an always-present chip would
// buy discoverability with permanent clutter on the two surfaces that most
// need to be quiet, and the mode is discovered in Photo ▸ Advance after
// rating, not here. What it adds is the way *out* — one click, without
// leaving the photographs for a menu.
export component AdvanceChip inherits Rectangle {
    // A bare `if` at a layout's top level would still occupy a slot; this
    // collapses to nothing at all when the mode is off.
    width: PreferencesState.advance-after-classement ? chip.preferred-width : 0px;
    visible: PreferencesState.advance-after-classement;

    chip := FilterChip {
        // `▸` and not `⏵`: the bundled font has no U+23F5, and a glyph it
        // cannot draw comes out as an empty box — seen on the running
        // binary, not in the source. The marker `SubmenuHeader` already
        // uses is the one known to render.
        text: @tr("Advance ▸");
        active: true;
        clicked => {
            PreferencesState.set-advance-after-classement(false);
        }
    }
}

// One develop slider: label, track and value on a single row (ADR 0054 §2).
//
// One row rather than two, because the panel is read as a *stack*: the eye
// scans a column of names and numbers, and a track that pushes each control
// onto two lines halves how much of the edit is visible at once. The whole
// tonal set fits on one screen this way, which is what makes a settings panel
// feel like one thing instead of a scroll.
//
// The displayed position follows the authoritative value from Rust except
// while dragging, so refreshing the settings after a commit never breaks a
// binding.
export component EditSlider inherits HorizontalLayout {
    in property <string> label;
    // One sentence saying what this slider does, shown on hovering its
    // label (ADR 0133). Empty for a label that names its own effect —
    // `Exposure`, `Rotation`, `Crop left`; the classification of every
    // slider in Develop is enforced by a test, see `src/hints.rs`.
    in property <string> hint;
    in property <float> minimum;
    in property <float> maximum;
    in property <float> value;
    in property <int> decimals;
    // Where a double-click sends the slider back to (ADR 0054 §2). Zero for
    // almost everything; the settings whose neutral is not zero say so, and
    // the value is clamped to the range so a slider that never reaches zero
    // (a radius, a temperature) still resets to something it can hold.
    in property <float> neutral: 0;
    // A track that shows what the slider does: the white-balance and colour
    // sliders carry a gradient of their own effect, the tonal ones stay grey.
    // Two colours rather than a `brush`, so a caller cannot accidentally hand
    // a solid fill to a control whose meaning is the gradient.
    in property <color> track-from: #333333;
    in property <color> track-to: #333333;
    // Fired on release: this is the one that commits (ADR 0074 §1).
    callback edited(float);
    // Fired *during* the drag: this one only shows. Rust throttles it and
    // writes nothing — see `develop::live_preview`.
    callback previewing(float);

    property <bool> dragging;
    property <float> drag-value;
    property <float> shown: root.dragging ? root.drag-value : root.value;
    property <float> factor: Math.pow(10, root.decimals);
    property <float> rounded: Math.round(root.shown * root.factor) / root.factor;
    property <float> range: root.maximum - root.minimum;
    // Where the drag began, in value and in pointer position (ADR 0126 §1).
    // Movement is counted from here rather than read off the pointer's
    // absolute position, which is what makes §2 possible at all: on a 110px
    // track, absolute means one pixel is a hundredth of the range and there
    // is no way to ask for less.
    property <float> anchor-value;
    property <length> anchor-x;
    // Whether `Shift` is down. Refreshed from `pointer-event`, because
    // `moved` carries no modifiers and `Move` reaches `pointer-event` just
    // before it — read continuously and not latched at press time, so one
    // can start coarse and finish fine without releasing.
    property <bool> fine;

    // One wheel notch: 1 % of the range, a fifth of that with `Shift`
    // (ADR 0126 §3), rounded to a value this slider can actually hold.
    function nudge(direction: float, small: bool) {
        root.edited(Math.clamp(
            Math.round((root.value + direction * root.range / (small ? 500 : 100)) * root.factor) / root.factor,
            root.minimum,
            root.maximum));
    }

    spacing: 8px;
    height: 22px;

    // The hint lives on the **word**, not on the control (ADR 0133 §3): the
    // track carries the drag, the wheel and the double-click, and a hint
    // that appeared in the middle of aiming is the one ADR 0127 §3 refuses.
    // Pointing at the word one does not understand *is* the question.
    Rectangle {
        // 108px and not 88: measured on the built binary **in French**, a
        // column of 88 truncated twenty of the panel's fifty-five labels
        // (ADR 0140 §1). The twenty extra pixels come from the panel, not
        // from the track — the track keeps the 118px ADR 0126 measured its
        // precision against.
        width: 108px;
        Text {
            // Right-aligned against the track, fixed width: the labels line
            // up as a column, and the tracks all start at the same x.
            text: root.label;
            color: #9a9a9a;
            font-size: 12px;
            width: 100%;
            height: 100%;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
        label-touch := TouchArea {
            // Declared only when there is something to say, so a label with
            // no hint keeps taking no input at all — the panel behind goes
            // on scrolling under the wheel, as ADR 0126 §3 requires.
            enabled: root.hint != "";
            changed has-hover => {
                if (root.hint != "") {
                    if (self.has-hover) {
                        HintState.enter(root.hint, self.absolute-position.x, self.absolute-position.y + parent.height);
                    } else {
                        HintState.leave(root.hint);
                    }
                }
            }
        }
    }
    track := Rectangle {
        horizontal-stretch: 1;
        Rectangle {
            y: parent.height / 2 - 2px;
            height: 4px;
            border-radius: 2px;
            background: @linear-gradient(90deg, root.track-from 0%, root.track-to 100%);
        }
        Rectangle {
            x: (track.width - 12px) * (root.shown - root.minimum) / (root.maximum - root.minimum);
            y: parent.height / 2 - 6px;
            width: 12px;
            height: 12px;
            border-radius: 6px;
            background: root.dragging ? #6fa8dc : #8a8a8a;
        }
        TouchArea {
            moved => {
                if (self.pressed) {
                    // Relative to the anchor, and a fifth of the distance
                    // while `Shift` is held (ADR 0126 §2).
                    root.drag-value = Math.clamp(
                        root.anchor-value
                            + ((self.mouse-x - root.anchor-x) / self.width) * root.range / (root.fine ? 5 : 1),
                        root.minimum,
                        root.maximum);
                    // Show what the value does, under the finger. Nothing is
                    // written until the release below (ADR 0074 §2).
                    root.previewing(root.drag-value);
                }
            }
            pointer-event(event) => {
                root.fine = event.modifiers.shift;
                // A press sets the value and becomes the anchor (ADR 0126
                // §1). Before this, pressing the track without moving did
                // nothing whatever — the drag began on `moved`, so the most
                // ordinary gesture on the most-used control in the
                // application was dead.
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.dragging = true;
                    root.anchor-x = self.mouse-x;
                    root.anchor-value = Math.clamp(root.minimum + (self.mouse-x / self.width) * root.range, root.minimum, root.maximum);
                    root.drag-value = root.anchor-value;
                    root.previewing(root.drag-value);
                }
                if (event.kind == PointerEventKind.up && root.dragging) {
                    root.dragging = false;
                    root.edited(root.drag-value);
                }
            }
            // The wheel, over the **track** and nowhere else (ADR 0126 §3):
            // over the label, the number or the gap between rows it is
            // declined, and the panel behind goes on scrolling — which is
            // how the panel is read, and what a wheel that edited whatever
            // it passed over would destroy.
            //
            // Each notch commits, there being no release to commit on. That
            // is affordable because successive edits of one setting coalesce
            // into a single revision (ADR 0120), so a turn of the wheel
            // writes one revision and not thirty.
            scroll-event(event) => {
                if (event.delta-y == 0 && event.delta-x == 0) {
                    return reject;
                }
                root.nudge(event.delta-y + event.delta-x > 0 ? 1 : -1, event.modifiers.shift);
                return accept;
            }
            // The gesture everyone already has in their fingers: a
            // double-click puts the slider back where it does nothing.
            double-clicked => {
                root.dragging = false;
                root.edited(Math.clamp(root.neutral, root.minimum, root.maximum));
            }
        }
    }
    // The number, typed as readily as dragged (ADR 0112 §1). A fixed column
    // so the numbers align, and an explicit sign so a glance tells which way
    // a slider was moved — on the two-sided sliders only: a temperature in
    // kelvin or a strength in percent is a quantity, not a deviation, and
    // "+6500 K" reads as an error.
    //
    // The text cannot simply be *bound* to the value: a `TextInput` writes
    // its own `text` as the user types, which in Slint drops the binding for
    // good. So the field is written imperatively — whenever the value moves,
    // and again when focus leaves — and read back only on Enter or on that
    // same focus loss.
    property <string> formatted: root.minimum < 0 && root.rounded > 0
        ? "+\{root.rounded}"
        : "\{root.rounded}";
    changed formatted => {
        if (!field.has-focus) {
            field.text = root.formatted;
        }
    }
    Rectangle {
        width: 46px;
        // A frame only while it is being typed into: at rest the number must
        // read as a number, not as a form to fill in.
        background: field.has-focus ? #1b1b1b : transparent;
        border-radius: 3px;
        border-width: field.has-focus ? 1px : 0;
        border-color: #6fa8dc;
        field := TextInput {
            width: 100%;
            height: 100%;
            text: root.formatted;
            color: #e6e6e6;
            font-size: 12px;
            horizontal-alignment: right;
            vertical-alignment: center;
            single-line: true;
            accepted => {
                root.commit-typed();
                // Enter should leave the field, not keep the caret blinking
                // in it — `clear-focus` is `EditSlider`'s own, inherited
                // from every element, so the sink below is what takes it.
                focus-sink.focus();
            }
            changed has-focus => {
                if (!self.has-focus) {
                    root.commit-typed();
                }
            }
        }
    }

    // Reads the field back: a number inside the range commits, anything else
    // puts the current value back. `to-float` returns 0 for text that is not
    // a number, so the two are told apart by re-formatting rather than by
    // trusting the parse.
    function commit-typed() {
        if (field.text != root.formatted) {
            if (field.text.is-float()) {
                root.edited(Math.clamp(field.text.to-float(), root.minimum, root.maximum));
            }
            field.text = root.formatted;
        }
    }

    focus-sink := FocusScope {
        width: 0;
        height: 0;
    }
}

// A determinate progress bar for the long jobs a dialog waits on: import,
// export, print (ADR 0045 §3).
//
// Determinate on purpose. A spinner says "something is happening"; on a
// folder of seventeen thousand photos what the user needs to know is
// *how long*, and only a filled proportion answers that. The count beside
// it says the same thing in the other register — a bar at 3 % and "512 /
// 17 204" are read by different people.
export component ProgressBar inherits Rectangle {
    // Completed fraction, 0.0 to 1.0.
    in property <float> value;
    // Already-formatted count, e.g. "512 / 17 204". Empty hides it.
    in property <string> caption;

    height: caption == "" ? 6px : 22px;

    track := Rectangle {
        y: 0;
        width: 100%;
        height: 6px;
        border-radius: 3px;
        background: #2a2a2a;

        Rectangle {
            x: 0;
            y: 0;
            width: parent.width * clamp(root.value, 0.0, 1.0);
            height: 100%;
            border-radius: 3px;
            background: #c8a04a;
            // Widening rather than sliding: the eye reads a growing bar as
            // progress and a moving one as activity.
            animate width { duration: 120ms; }
        }
    }

    if root.caption != "": Text {
        y: 10px;
        width: 100%;
        text: root.caption;
        color: #9a9a9a;
        font-size: 11px;
        horizontal-alignment: right;
    }
}
