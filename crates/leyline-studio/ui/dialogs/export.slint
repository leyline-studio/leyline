// Export (ADR 0025): either a stored preset or an ad-hoc recipe —
// format, quality and longest edge — with the option of saving that recipe
// as a new preset.
//
// One of the dialogs hosted by `panels/dialogs.slint` (ADR 0045 §3).

import { DialogState } from "../state/dialog.slint";
import { FilterChip } from "../widgets/controls.slint";

export component ExportDialog inherits VerticalLayout {
    spacing: 12px;
    Text {
        text: DialogState.export-photo-count > 1
            ? @tr("Export {} selected photos", DialogState.export-photo-count)
            : @tr("Export selected photo");
        color: #f0f0f0;
        font-size: 15px;
        font-weight: 600;
    }
    Text {
        text: @tr("Preset");
        color: #9a9a9a;
        font-size: 12px;
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        FilterChip {
            text: @tr("Custom");
            active: DialogState.export-preset == -1;
            clicked => {
                DialogState.export-preset = -1;
            }
        }
        for name[i] in DialogState.export-presets: FilterChip {
            text: name;
            active: DialogState.export-preset == i;
            clicked => {
                DialogState.export-preset = i;
            }
        }
    }
    if DialogState.export-preset == -1: VerticalLayout {
        spacing: 8px;
        Text {
            text: @tr("Format");
            color: #9a9a9a;
            font-size: 12px;
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            for name[i] in ["JPEG", "PNG", "TIFF", "WebP", "AVIF"]: FilterChip {
                text: name;
                active: DialogState.export-format == i;
                clicked => {
                    DialogState.export-format = i;
                }
            }
        }
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                Text {
                    text: @tr("Quality (1-100)");
                    color: #9a9a9a;
                    font-size: 12px;
                }
                Rectangle {
                    height: 28px;
                    background: #1b1b1b;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #3a3a3a;
                    TextInput {
                        x: 8px;
                        width: parent.width - 16px;
                        height: 100%;
                        text <=> DialogState.export-quality-text;
                        color: #e6e6e6;
                        font-size: 12px;
                        vertical-alignment: center;
                        single-line: true;
                    }
                }
            }
            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                Text {
                    text: @tr("Max edge px (blank = full size)");
                    color: #9a9a9a;
                    font-size: 12px;
                }
                Rectangle {
                    height: 28px;
                    background: #1b1b1b;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #3a3a3a;
                    TextInput {
                        x: 8px;
                        width: parent.width - 16px;
                        height: 100%;
                        text <=> DialogState.export-max-edge-text;
                        color: #e6e6e6;
                        font-size: 12px;
                        vertical-alignment: center;
                        single-line: true;
                    }
                }
            }
        }
        VerticalLayout {
            spacing: 4px;
            Text {
                text: @tr("Watermark text (blank = none)");
                color: #9a9a9a;
                font-size: 12px;
            }
            Rectangle {
                height: 28px;
                background: #1b1b1b;
                border-radius: 4px;
                border-width: 1px;
                border-color: #3a3a3a;
                TextInput {
                    x: 8px;
                    width: parent.width - 16px;
                    height: 100%;
                    text <=> DialogState.export-watermark-text;
                    color: #e6e6e6;
                    font-size: 12px;
                    vertical-alignment: center;
                    single-line: true;
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                Text {
                    text: @tr("Save as preset (optional name)");
                    color: #9a9a9a;
                    font-size: 12px;
                }
                Rectangle {
                    height: 28px;
                    background: #1b1b1b;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #3a3a3a;
                    TextInput {
                        x: 8px;
                        width: parent.width - 16px;
                        height: 100%;
                        text <=> DialogState.export-preset-name;
                        color: #e6e6e6;
                        font-size: 12px;
                        vertical-alignment: center;
                        single-line: true;
                    }
                }
            }
            FilterChip {
                text: @tr("Save as preset");
                active: false;
                clicked => {
                    DialogState.run-save-export-preset(
                        DialogState.export-preset-name,
                        DialogState.export-format,
                        DialogState.export-quality-text,
                        DialogState.export-max-edge-text,
                        DialogState.export-watermark-text,
                    );
                }
            }
        }
    }
    Text {
        text: @tr("Destination folder (absolute path)");
        color: #9a9a9a;
        font-size: 12px;
    }
    HorizontalLayout {
        spacing: 8px;
        Rectangle {
            height: 28px;
            horizontal-stretch: 1;
            background: #1b1b1b;
            border-radius: 4px;
            border-width: 1px;
            border-color: #3a3a3a;
            export-destination := TextInput {
                x: 8px;
                width: parent.width - 16px;
                height: 100%;
                text <=> DialogState.export-destination-text;
                color: #e6e6e6;
                font-size: 12px;
                vertical-alignment: center;
                single-line: true;
            }
        }
        FilterChip {
            text: @tr("Browse…");
            active: false;
            clicked => {
                DialogState.browse-export-destination();
            }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: end;
        FilterChip {
            text: @tr("Cancel");
            active: false;
            clicked => {
                DialogState.dialog = "";
            }
        }
        FilterChip {
            text: @tr("Export");
            active: true;
            clicked => {
                DialogState.run-export(
                    DialogState.export-preset,
                    export-destination.text,
                    DialogState.export-format,
                    DialogState.export-quality-text,
                    DialogState.export-max-edge-text,
                    DialogState.export-watermark-text,
                );
            }
        }
    }
}
