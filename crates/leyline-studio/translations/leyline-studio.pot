msgctxt "BasicGroup"
msgid "Clarity"
msgstr ""

#: crates/leyline-studio/ui/panels/develop_basic.slint:224
msgctxt "BasicGroup"
msgid "Contrast over broad shapes. Coarser than Texture, gentler than Dehaze."
msgstr ""

#: crates/leyline-studio/ui/panels/develop_basic.slint:236
msgctxt "BasicGroup"
msgid "Dehaze"
msgstr ""

#: crates/leyline-studio/ui/panels/develop_basic.slint:237
msgctxt "BasicGroup"
msgid ""
"Pulls contrast back into flat, veiled light. A contrast tool, not a weather "
"one."
msgstr ""

