// The loupe view (ADR 0055 §3): the selected photo, large, with the strip of
// its neighbours under it (ADR 0045 §3).
//
// Same shape as the develop and map panels — a whole-window mode gated on a
// flag, inheriting a layout and setting no geometry of its own.
//
// What makes it worth existing next to develop: **no edit session is
// opened**. It shows the cached preview and nothing else, so it costs a file
// read, creates no revision and has nothing to undo. Looking at a photo and
// working on it are two different intentions, and only one of them should
// write to the catalog.

import { GridState } from "../state/grid.slint";
import { PreferencesState } from "../state/preferences.slint";
import { DevelopState } from "../state/develop.slint";
import { Filmstrip, FilterChip, ViewModeChips, ZoomableImage, Zoom } from "../widgets/controls.slint";

export component LoupePanel inherits VerticalLayout {
    // Panel folding, owned by the window (ADR 0055 §6). The loupe has no
    // side panel to fold, only its chips and its filmstrip.
    in property <bool> chrome-hidden;

    // Zoom and viewpoint, panel-private: the loupe drives one image, the
    // compare view drives two (ADR 0057 §2).
    // `in-out`: the window's `Z` shortcut toggles it from outside.
    in-out property <bool> zoomed: false;
    // One scale for the view — and in compare, one for both halves, like the
    // centre beside it (ADR 0112 §3).
    in-out property <float> scale: 1.0;
    property <float> center-x: 0.5;
    property <float> center-y: 0.5;
    // A different photo starts fitted and centred again.
    property <image> loaded: GridState.loupe-image;
    changed loaded => {
        root.zoomed = false;
        root.center-x = 0.5;
        root.center-y = 0.5;
    }

    visible: GridState.loupe-mode;
    padding: 12px;
    spacing: 8px;

    // Clears the menu row above, like every other whole-window panel.
    Rectangle {
        height: 28px;
    }

    if !root.chrome-hidden: HorizontalLayout {
        height: 24px;
        spacing: 8px;
        alignment: start;

        ViewModeChips {
            loupe: true;
            show-grid => {
                GridState.loupe-mode = false;
                GridState.loupe-mode-changed();
            }
            show-loupe => { }
        }
        FilterChip {
            text: root.zoomed ? @tr("Fit") : @tr("100%    Z");
            active: root.zoomed;
            clicked => {
                root.scale = 1.0;
                root.zoomed = !root.zoomed;
            }
        }
        if root.zoomed: Text {
            text: Zoom.percent(root.scale);
            color: #9a9a9a;
            font-size: 12px;
            vertical-alignment: center;
        }
        FilterChip {
            text: @tr("Develop    D");
            active: false;
            enabled: GridState.selected >= 0;
            clicked => {
                GridState.loupe-mode = false;
                GridState.loupe-mode-changed();
                DevelopState.enter-develop();
            }
        }
    }

    // The same widget the compare view mounts twice (ADR 0057 §2) — which is
    // how the loupe gained the 100 % zoom it did not have.
    ZoomableImage {
        vertical-stretch: 1;
        // ADR 0117: the loupe is where a photograph is looked at, so it is
        // the first view the ground matters in.
        background: PreferencesState.viewer-ground;
        source: GridState.loupe-image;
        zoomed: root.zoomed;
        scale: root.scale;
        center-x: root.center-x;
        center-y: root.center-y;
        panned(x, y) => {
            root.center-x = x;
            root.center-y = y;
        }
        zoom-requested(s) => {
            root.scale = s;
            root.zoomed = true;
        }
    }

    if !root.chrome-hidden: Filmstrip {
        cells: GridState.cells;
        window-start: GridState.window-start;
        selected: GridState.selected;
        clicked(index) => {
            // Plain selection, exactly what clicking the same photo in the
            // grid does — the loupe follows the selection rather than owning
            // one of its own.
            GridState.selected = index;
            GridState.select(index);
        }
    }
}
