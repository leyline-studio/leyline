// Keyboard shortcuts reference — the same callbacks the menu bar exposes,
// listed with the keys that reach them.
//
// One of the dialogs hosted by `panels/dialogs.slint` (ADR 0045 §3).
//
// This is the card a photographer opens on their first evening with Leyline,
// so it is the one list in the interface that must not be a subset of what
// `studio.slint` actually binds: a key missing here is a feature nobody
// finds. Grouped by *where* a key works, because several of them mean
// different things in the library and in develop.

import { DialogState } from "../state/dialog.slint";
import { FilterChip } from "../widgets/controls.slint";

// One line of the card: the keys, then what they do.
component Shortcut inherits HorizontalLayout {
    in property <string> keys;
    in property <string> what;
    spacing: 12px;
    Text {
        text: root.keys;
        color: #e6e6e6;
        font-size: 12px;
        font-weight: 600;
        width: 110px;
    }
    Text {
        text: root.what;
        color: #9a9a9a;
        font-size: 12px;
    }
}

component Section inherits Text {
    color: #6fa8dc;
    font-size: 11px;
    font-weight: 600;
}

export component ShortcutsDialog inherits VerticalLayout {
    spacing: 12px;
    Text {
        text: @tr("Keyboard shortcuts");
        color: #f0f0f0;
        font-size: 15px;
        font-weight: 600;
    }
    VerticalLayout {
        spacing: 4px;

        Section {
            text: @tr("Anywhere");
        }
        Shortcut {
            keys: "Tab / Shift+Tab";
            what: @tr("Fold the panels / fold everything");
        }
        Shortcut {
            keys: "Ctrl+E";
            what: @tr("Export");
        }
        Shortcut {
            keys: "Ctrl+P";
            what: @tr("Print");
        }
        Shortcut {
            keys: "Ctrl+C / Ctrl+V";
            what: @tr("Copy / paste develop settings");
        }

        Section {
            text: @tr("Library");
        }
        Shortcut {
            keys: "D / Enter";
            what: @tr("Develop the selected photo");
        }
        Shortcut {
            keys: "E";
            what: @tr("Loupe (large view)");
        }
        Shortcut {
            keys: "C";
            what: @tr("Compare two photos");
        }
        Shortcut {
            keys: "N";
            what: @tr("Survey the selection");
        }
        Shortcut {
            keys: "M";
            what: @tr("Map of the geotagged photos");
        }
        Shortcut {
            keys: "I";
            what: @tr("Import");
        }
        Shortcut {
            keys: "T";
            what: @tr("Tethered capture");
        }
        Shortcut {
            keys: "Ctrl+N";
            what: @tr("New collection");
        }
        Shortcut {
            keys: "B / Shift+B";
            what: @tr("Add / remove from collection");
        }
        Shortcut {
            keys: "Shift+R";
            what: @tr("Reprocess library");
        }
        Shortcut {
            keys: "Ctrl+Z / Ctrl+Y";
            what: @tr("Undo / redo the last library change");
        }
        Shortcut {
            keys: @tr("Arrows");
            what: @tr("Move the selection");
        }
        Shortcut {
            keys: "0–5";
            what: @tr("Rate");
        }
        Shortcut {
            keys: "6–9";
            what: @tr("Color label");
        }
        Shortcut {
            keys: "P / X / U";
            what: @tr("Pick / reject / clear");
        }

        Section {
            text: @tr("Develop");
        }
        Shortcut {
            keys: "G / Esc";
            what: @tr("Back to the library");
        }
        Shortcut {
            keys: "Ctrl+Z / Ctrl+Y";
            what: @tr("Undo / redo");
        }
        Shortcut {
            keys: "\\";
            what: @tr("Before / after");
        }
        Shortcut {
            keys: "J";
            what: @tr("Clipping warnings");
        }
        Shortcut {
            keys: "Z";
            what: @tr("Zoom to 100%");
        }
        Shortcut {
            keys: "O";
            what: @tr("Composition guide, while cropping");
        }
        Shortcut {
            keys: "S";
            what: @tr("Save preset");
        }
        Shortcut {
            keys: "R";
            what: @tr("Reprocess this photo");
        }
        Shortcut {
            keys: "← / →";
            what: @tr("Previous / next photo");
        }
        // Not keys, but the two gestures on a slider nothing else announces
        // (ADR 0126 §2, §3). This card is where a photographer looks for
        // what the interface can do that is not written on it.
        Shortcut {
            keys: @tr("Wheel");
            what: @tr("Over a slider's track: adjust it");
        }
        Shortcut {
            keys: @tr("Shift + drag");
            what: @tr("Fine adjustment, five times slower");
        }
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: end;
        FilterChip {
            text: @tr("Close");
            active: true;
            clicked => {
                DialogState.dialog = "";
            }
        }
    }
}
