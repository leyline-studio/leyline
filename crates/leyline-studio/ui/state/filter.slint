// What narrows and orders the grid: the filter bar and the search box
// (ADR 0045 §1).
//
// Every value here is a mirror of the `GridQuery` held in Rust — the UI
// never decides what matches, it only reports which chip was clicked and
// displays the state Rust sends back.
export global FilterState {
    // Filter state, mirrored from the GridQuery held in Rust.
    in property <int> filter-rating; // 0 = off, else minimum stars
    in property <int> filter-label; // -1 = off, else ColorLabel encoding
    in property <int> filter-pick; // -1 = off, else PickState encoding
    // Active keyword filter's full path, or "" when off.
    in property <string> filter-keyword-label;
    in property <string> sort-label;
    in property <[color]> label-colors;
    callback rating-filter(int);
    callback label-filter(int);
    callback pick-filter(int);
    callback cycle-sort();
    // Toggles the grid filter to the keyword at an index of
    // `detail-keywords` (its descendants included); clicking the active
    // one turns the filter off.
    callback keyword-filter(int);
    callback clear-keyword-filter();
    callback search(string);

    // Shot filters (ADR 0064). The two lists are what the library was
    // actually shot with, sent by Rust after every import or removal — a
    // body nobody used is never offered.
    in property <[string]> shot-cameras;
    in property <[string]> shot-lenses;
    // Index of the active body / lens in the lists above, -1 when off.
    in property <int> shot-camera: -1;
    in property <int> shot-lens: -1;
    // How many shot criteria are on, shown on the chip that opens the panel
    // so a filtered grid never looks unfiltered when the panel is folded.
    in property <int> shot-count;
    callback camera-filter(int);
    callback lens-filter(int);
    // A written interval — `min-max`, `min-` or `-max` — for one of "iso",
    // "aperture", "focal", "shutter". Rust parses it: the same reader serves
    // the CLI, so the two clients cannot disagree on what `1/200-` means.
    callback shot-range(string, string);
    callback clear-shot-filters();
}
