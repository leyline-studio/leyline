// What is left of Develop's left column (ADR 0124 §1): the Navigator.
//
// The presets, the versions and the history left it for the rail
// (ADR 0158 §4, `develop_states.slint`). The Navigator is the one section
// the rail does not take: ADR 0158 §3 turns it into an overlay on the
// photograph, the next step of that slice, and until then it keeps this
// column to itself.

import { Frame, Hues, Theme } from "../theme.slint";
import { DevelopState } from "../state/develop.slint";
import { PreferencesState } from "../state/preferences.slint";
import { GroupHeader } from "../widgets/controls.slint";

export component DevelopLeftPanel inherits Rectangle {
    // The viewer's zoom state, read and never owned (ADR 0124, Consequences):
    // the same four properties the toolbar and the image share. The
    // Navigator draws them; moving the view goes back out through `panned`.
    in property <bool> zoomed;
    in property <float> scale: 1.0;
    in property <float> center-x: 0.5;
    in property <float> center-y: 0.5;
    // The viewer's own size, which is what decides how much of the frame is
    // on screen. Handed in rather than read off the sibling element: a
    // binding that reaches across to the middle column's geometry is the
    // layout cycle ADR 0045 §3 is about.
    in property <length> viewer-width;
    in property <length> viewer-height;
    callback panned(float, float);

    // Section folding survives the session (ADR 0128), by the same
    // one-number-per-view arrangement the settings panel opposite uses.
    // Bit 0 is the Navigator; bits 1–3 were the sections the rail took,
    // and an old stored value's are simply never read again.
    property <int> stored-view: PreferencesState.develop-left-view;
    property <bool> expand-navigator: root.stored-bit(root.stored-view, 0, true);

    // See the twin in `develop.slint`: the `fallback` is what a first
    // launch gets, and it belongs in the function because a negative
    // code must never reach the arithmetic — it decodes as *every bit
    // set*, which shipped an interface with all its groups open.
    pure function stored-bit(code: int, index: int, fallback: bool) -> bool {
        return code < 0
            ? fallback
            : Math.mod(Math.floor(code / Math.pow(2, index)), 2) == 1;
    }
    property <int> view-code: root.expand-navigator ? 1 : 0;
    changed view-code => {
        PreferencesState.remember-develop-left-view(self.view-code);
    }

    width: 260px;
    background: Theme.surface;

    Flickable {
        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            alignment: start;

            // Clears the window's menu row, like the settings panel
            // opposite — a spacer child, never a geometry override on the
            // column (see the note above `menu-row` in `menubar.slint`).
            Rectangle {
                height: Frame.top-bar;
            }

            GroupHeader {
                label: @tr("Navigator");
                expanded <=> root.expand-navigator;
            }
            if root.expand-navigator: navigator := Rectangle {
                height: 150px;
                background: Theme.sunken;
                border-radius: 4px;
                // The viewport frame is drawn in the photograph's own
                // coordinates and is not clamped to it: at the edge of a
                // zoomed image the viewer really does show ground beside
                // the frame, and a rectangle that stopped at the border
                // would say otherwise. Clipping is what keeps that honest
                // *and* inside the box.
                clip: true;

                property <float> image-w: max(DevelopState.develop-image.width, 1);
                property <float> image-h: max(DevelopState.develop-image.height, 1);
                // Where `image-fit: contain` actually puts the photograph
                // inside this box — the same letterbox the viewer computes,
                // at thumbnail size.
                property <length> shown-w: min(self.width, self.height * self.image-w / self.image-h);
                property <length> shown-h: min(self.height, self.width * self.image-h / self.image-w);
                property <length> shown-x: (self.width - self.shown-w) / 2;
                property <length> shown-y: (self.height - self.shown-h) / 2;
                // The fraction of the frame on screen: the viewport's size
                // in image pixels, over the image's own size. Capped at 1 —
                // a viewport wider than the photograph shows all of it.
                property <float> visible-w: min(1, root.viewer-width / (self.image-w * root.scale * 1px));
                property <float> visible-h: min(1, root.viewer-height / (self.image-h * root.scale * 1px));

                Image {
                    source: DevelopState.develop-image;
                    image-fit: contain;
                    width: 100%;
                    height: 100%;
                }

                // Only while zoomed: fitted, the frame *is* the thumbnail,
                // and a rectangle drawn around the whole picture says
                // nothing while hiding its edges.
                if root.zoomed: Rectangle {
                    x: navigator.shown-x + navigator.shown-w * (root.center-x - navigator.visible-w / 2);
                    y: navigator.shown-y + navigator.shown-h * (root.center-y - navigator.visible-h / 2);
                    width: navigator.shown-w * navigator.visible-w;
                    height: navigator.shown-h * navigator.visible-h;
                    border-width: 1px;
                    border-color: Hues.navigator-frame;
                    background: Hues.navigator-fill;
                }

                // Click or drag to move the view. Both are the same
                // gesture — where the pointer is *becomes* the centre — so
                // there is nothing to grab and nothing to miss.
                TouchArea {
                    mouse-cursor: root.zoomed ? pointer : default;
                    property <length> at-x: self.mouse-x;
                    property <length> at-y: self.mouse-y;
                    function aim() {
                        if (!root.zoomed || navigator.shown-w <= 0 || navigator.shown-h <= 0) {
                            return;
                        }
                        root.panned(
                            Math.clamp((self.at-x - navigator.shown-x) / navigator.shown-w, 0, 1),
                            Math.clamp((self.at-y - navigator.shown-y) / navigator.shown-h, 0, 1));
                    }
                    clicked => {
                        self.aim();
                    }
                    moved => {
                        if (self.pressed) {
                            self.aim();
                        }
                    }
                }
            }

            Rectangle {
                height: Frame.bottom-bar;
            }
        }
    }
}
