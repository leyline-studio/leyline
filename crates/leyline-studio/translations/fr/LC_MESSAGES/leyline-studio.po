msgctxt "Tr"
msgid "Pair"
msgstr "Appairer"

#: crates/leyline-studio/ui/types.slint:581
msgctxt "Tr"
msgid "No RAW+JPEG couple left to pair."
msgstr "Plus aucun couple RAW+JPEG à appairer."

