// Leyline Studio main window (`docs/roadmap.md` phase 5).
//
// The library browser: a filter bar on top, a thumbnail grid on the left,
// the metadata of the selected photo on the right.
//
// This file is the assembly point (ADR 0045): shared types live in
// `types.slint`, reusable controls in `widgets/`, and each panel or dialog
// in its own file. `StudioWindow` below holds the window attributes, the
// keyboard `FocusScope`, and the layout that puts the pieces together.
//
// The generated Rust re-exports what it needs through the `ui` module in
// `src/main.rs`, so every type named here must stay `export`ed from the
// file that declares it.

import {
    Cell,
    CollectionRow,
    ColorGradingZoneValues,
    CurveMarker,
    DevSettings,
    HslBandValues,
    MapPinMarker,
    Tr,
} from "types.slint";
import { LibraryState } from "state/library.slint";
import { FilterState } from "state/filter.slint";
import { DetailState } from "state/detail.slint";
import { CollectionState } from "state/collection.slint";
import { GridState } from "state/grid.slint";
import { MapState } from "state/map.slint";
import { DevelopState } from "state/develop.slint";
import { DialogState } from "state/dialog.slint";
import { BrowserPanel } from "panels/browser.slint";
import { DevelopPanel } from "panels/develop.slint";
import { MapPanel } from "panels/map.slint";
import { DetailRow, EditSlider, FilterChip, GroupHeader } from "widgets/controls.slint";
import { MenuDropdown, MenuRow, MenuSep, SubmenuHeader, TopMenuLabel } from "widgets/menu.slint";

// Structs reach the generated Rust just by being used in the compiled tree,
// but a `global` only does when the root file re-exports it explicitly —
// without this, `ui::Tr` doesn't exist and Rust can't build its status-line
// and dialog messages (ADR 0019).
export { CollectionState, DetailState, DevelopState, DialogState, FilterState, GridState, LibraryState, MapState, Tr }

export component StudioWindow inherits Window {
    title: "Leyline Studio — " + LibraryState.library-name;
    // Taskbar/Alt-Tab/window-manager icon: the square badge, matching the
    // .exe icon embedded via windows-manifest.rc and the Linux desktop
    // entry's `packaging/icons` (ADR 0019) — one source of truth for "the
    // app icon" everywhere it's requested at a fixed square size.
    icon: @image-url("../../../packaging/icons/icon.png");
    preferred-width: 1280px;
    preferred-height: 800px;
    // Keeps the window from being resized below a usable size — mirrors
    // `MIN_WINDOW_WIDTH`/`MIN_WINDOW_HEIGHT` in main.rs, which only clamp
    // the *initial* screen-relative size and don't constrain later resizes.
    min-width: 1024px;
    min-height: 700px;
    background: #1b1b1b;
    forward-focus: keys;











    // Custom menu bar state (see `TopMenuLabel`/`MenuDropdown` above).
    // `open-menu` is "" or one of "file"/"library"/"photo"/"develop-menu"/
    // "view"/"help"; the inline-expand submenus are independent booleans
    // since at most one of each is ever meaningfully open at a time.
    property <string> open-menu: "";
    property <bool> rate-submenu-open: false;
    property <bool> label-submenu-open: false;
    property <bool> flag-submenu-open: false;
    property <bool> apply-preset-submenu-open: false;
    property <bool> open-recent-submenu-open: false;

    function reset-submenus() {
        root.rate-submenu-open = false;
        root.label-submenu-open = false;
        root.flag-submenu-open = false;
        root.apply-preset-submenu-open = false;
        root.open-recent-submenu-open = false;
    }



    keys := FocusScope {
        key-pressed(event) => {
            if (DialogState.dialog != "") {
                if (event.text == Key.Escape) {
                    DialogState.dialog = "";
                }
                return accept;
            }
            if (root.open-menu != "") {
                if (event.text == Key.Escape) {
                    root.open-menu = "";
                    root.reset-submenus();
                }
                return accept;
            }
            if (MapState.map-mode) {
                if (event.text == "m" || event.text == "M" || event.text == Key.Escape) {
                    MapState.exit-map();
                }
                return accept;
            }
            if (event.modifiers.control && (event.text == "p" || event.text == "P")) {
                DialogState.open-print();
                return accept;
            }
            if (event.modifiers.control && (event.text == "c" || event.text == "C")) {
                DevelopState.copy-settings();
                return accept;
            }
            if (event.modifiers.control && (event.text == "v" || event.text == "V")) {
                DevelopState.paste-settings();
                return accept;
            }
            if (DevelopState.develop-mode) {
                if (event.text == "g" || event.text == "G" || event.text == Key.Escape) {
                    DevelopState.exit-develop();
                    return accept;
                }
                if (event.modifiers.control && (event.text == "z" || event.text == "Z")) {
                    DevelopState.develop-undo();
                    return accept;
                }
                if (event.modifiers.control && (event.text == "y" || event.text == "Y")) {
                    DevelopState.develop-redo();
                    return accept;
                }
                if (event.text == "s" || event.text == "S") {
                    DevelopState.open-preset-dialog();
                    return accept;
                }
                if (event.text == "r" || event.text == "R") {
                    DevelopState.develop-reprocess();
                    return accept;
                }
                if (event.text == "\\") {
                    DevelopState.toggle-compare();
                    return accept;
                }
                if ((event.text == "z" || event.text == "Z") && develop.active-tool == "select") {
                    develop.dev-zoomed = !develop.dev-zoomed;
                    return accept;
                }
                if (event.text == Key.LeftArrow) {
                    DevelopState.develop-prev();
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    DevelopState.develop-next();
                    return accept;
                }
                GridState.classify(event.text);
                return accept;
            }
            if (event.text == "d" || event.text == "D" || event.text == Key.Return) {
                DevelopState.enter-develop();
                return accept;
            }
            if (event.text == "i" || event.text == "I") {
                DialogState.dialog-result = "";
                DialogState.dialog = "import";
                return accept;
            }
            if (event.text == "e" || event.text == "E") {
                DialogState.open-export();
                return accept;
            }
            if (event.text == "t" || event.text == "T") {
                DialogState.open-tether();
                return accept;
            }
            if (event.text == "m" || event.text == "M") {
                MapState.enter-map();
                return accept;
            }
            if (event.text == "n" || event.text == "N") {
                DialogState.dialog-result = "";
                DialogState.dialog = "collection";
                return accept;
            }
            if (event.text == "b" || event.text == "B") {
                if (event.modifiers.shift) {
                    CollectionState.remove-from-collection();
                } else {
                    CollectionState.add-to-collection();
                }
                return accept;
            }
            if ((event.text == "r" || event.text == "R") && event.modifiers.shift) {
                DevelopState.reprocess-library();
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                browser.select-cell(max(GridState.selected - 1, 0));
                return accept;
            }
            if (event.text == Key.RightArrow) {
                browser.select-cell(GridState.selected < 0 ? 0 : GridState.selected + 1);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                browser.select-cell(GridState.selected - browser.columns);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                browser.select-cell(GridState.selected < 0 ? 0 : GridState.selected + browser.columns);
                return accept;
            }
            GridState.classify(event.text);
            accept
        }

        develop := DevelopPanel { }

        MapPanel { }

        browser := BrowserPanel {
            return-focus => {
                keys.focus();
            }
        }

        // Modal overlay: import and export dialogs.
        Rectangle {
            visible: DialogState.dialog != "";
            background: #000000aa;
            TouchArea {
                clicked => {
                    DialogState.dialog = "";
                }
            }

            Rectangle {
                width: 480px;
                background: #262626;
                border-radius: 8px;
                border-width: 1px;
                border-color: #3a3a3a;
                height: body.preferred-height;
                TouchArea { }

                body := VerticalLayout {
                    padding: 20px;
                    spacing: 12px;

                    if DialogState.dialog == "import": VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: @tr("Import photos");
                            color: #f0f0f0;
                            font-size: 15px;
                            font-weight: 600;
                        }
                        Text {
                            text: @tr("Source folder (absolute path)");
                            color: #9a9a9a;
                            font-size: 12px;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                height: 28px;
                                horizontal-stretch: 1;
                                background: #1b1b1b;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #3a3a3a;
                                import-source := TextInput {
                                    x: 8px;
                                    width: parent.width - 16px;
                                    height: 100%;
                                    text <=> DialogState.import-source-text;
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    single-line: true;
                                }
                            }
                            FilterChip {
                                text: @tr("Browse…");
                                active: false;
                                clicked => {
                                    DialogState.browse-import-source();
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            FilterChip {
                                text: @tr("Copy into library");
                                active: DialogState.import-copy;
                                clicked => {
                                    DialogState.import-copy = !DialogState.import-copy;
                                }
                            }
                            FilterChip {
                                text: @tr("Recursive");
                                active: DialogState.import-recursive;
                                clicked => {
                                    DialogState.import-recursive = !DialogState.import-recursive;
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            FilterChip {
                                text: @tr("Cancel");
                                active: false;
                                clicked => {
                                    DialogState.dialog = "";
                                }
                            }
                            FilterChip {
                                text: @tr("Import");
                                active: true;
                                clicked => {
                                    DialogState.run-import(import-source.text, DialogState.import-copy, DialogState.import-recursive);
                                }
                            }
                        }
                    }

                    if DialogState.dialog == "export": VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: DialogState.export-photo-count > 1
                                ? @tr("Export {} selected photos", DialogState.export-photo-count)
                                : @tr("Export selected photo");
                            color: #f0f0f0;
                            font-size: 15px;
                            font-weight: 600;
                        }
                        Text {
                            text: @tr("Preset");
                            color: #9a9a9a;
                            font-size: 12px;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            FilterChip {
                                text: @tr("Custom");
                                active: DialogState.export-preset == -1;
                                clicked => {
                                    DialogState.export-preset = -1;
                                }
                            }
                            for name[i] in DialogState.export-presets: FilterChip {
                                text: name;
                                active: DialogState.export-preset == i;
                                clicked => {
                                    DialogState.export-preset = i;
                                }
                            }
                        }
                        if DialogState.export-preset == -1: VerticalLayout {
                            spacing: 8px;
                            Text {
                                text: @tr("Format");
                                color: #9a9a9a;
                                font-size: 12px;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                for name[i] in ["JPEG", "PNG", "TIFF", "WebP", "AVIF"]: FilterChip {
                                    text: name;
                                    active: DialogState.export-format == i;
                                    clicked => {
                                        DialogState.export-format = i;
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    spacing: 4px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: @tr("Quality (1-100)");
                                        color: #9a9a9a;
                                        font-size: 12px;
                                    }
                                    Rectangle {
                                        height: 28px;
                                        background: #1b1b1b;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: #3a3a3a;
                                        TextInput {
                                            x: 8px;
                                            width: parent.width - 16px;
                                            height: 100%;
                                            text <=> DialogState.export-quality-text;
                                            color: #e6e6e6;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            single-line: true;
                                        }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: @tr("Max edge px (blank = full size)");
                                        color: #9a9a9a;
                                        font-size: 12px;
                                    }
                                    Rectangle {
                                        height: 28px;
                                        background: #1b1b1b;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: #3a3a3a;
                                        TextInput {
                                            x: 8px;
                                            width: parent.width - 16px;
                                            height: 100%;
                                            text <=> DialogState.export-max-edge-text;
                                            color: #e6e6e6;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            single-line: true;
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    spacing: 4px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: @tr("Save as preset (optional name)");
                                        color: #9a9a9a;
                                        font-size: 12px;
                                    }
                                    Rectangle {
                                        height: 28px;
                                        background: #1b1b1b;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: #3a3a3a;
                                        TextInput {
                                            x: 8px;
                                            width: parent.width - 16px;
                                            height: 100%;
                                            text <=> DialogState.export-preset-name;
                                            color: #e6e6e6;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            single-line: true;
                                        }
                                    }
                                }
                                FilterChip {
                                    text: @tr("Save as preset");
                                    active: false;
                                    clicked => {
                                        DialogState.run-save-export-preset(
                                            DialogState.export-preset-name,
                                            DialogState.export-format,
                                            DialogState.export-quality-text,
                                            DialogState.export-max-edge-text,
                                        );
                                    }
                                }
                            }
                        }
                        Text {
                            text: @tr("Destination folder (absolute path)");
                            color: #9a9a9a;
                            font-size: 12px;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                height: 28px;
                                horizontal-stretch: 1;
                                background: #1b1b1b;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #3a3a3a;
                                export-destination := TextInput {
                                    x: 8px;
                                    width: parent.width - 16px;
                                    height: 100%;
                                    text <=> DialogState.export-destination-text;
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    single-line: true;
                                }
                            }
                            FilterChip {
                                text: @tr("Browse…");
                                active: false;
                                clicked => {
                                    DialogState.browse-export-destination();
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            FilterChip {
                                text: @tr("Cancel");
                                active: false;
                                clicked => {
                                    DialogState.dialog = "";
                                }
                            }
                            FilterChip {
                                text: @tr("Export");
                                active: true;
                                clicked => {
                                    DialogState.run-export(
                                        DialogState.export-preset,
                                        export-destination.text,
                                        DialogState.export-format,
                                        DialogState.export-quality-text,
                                        DialogState.export-max-edge-text,
                                    );
                                }
                            }
                        }
                    }

                    if DialogState.dialog == "print": VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: @tr("Print selected photo");
                            color: #f0f0f0;
                            font-size: 15px;
                            font-weight: 600;
                        }
                        Text {
                            text: @tr("Preset");
                            color: #9a9a9a;
                            font-size: 12px;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            FilterChip {
                                text: @tr("Custom");
                                active: DialogState.print-preset == -1;
                                clicked => {
                                    DialogState.print-preset = -1;
                                }
                            }
                            for name[i] in DialogState.print-presets: FilterChip {
                                text: name;
                                active: DialogState.print-preset == i;
                                clicked => {
                                    DialogState.print-preset = i;
                                }
                            }
                        }
                        if DialogState.print-preset == -1: VerticalLayout {
                            spacing: 8px;
                            Text {
                                text: @tr("Paper");
                                color: #9a9a9a;
                                font-size: 12px;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                for name[i] in ["A4", "A3", "Letter"]: FilterChip {
                                    text: name;
                                    active: DialogState.print-paper == i;
                                    clicked => {
                                        DialogState.print-paper = i;
                                    }
                                }
                            }
                            Text {
                                text: @tr("Orientation");
                                color: #9a9a9a;
                                font-size: 12px;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                for name[i] in ["Portrait", "Landscape"]: FilterChip {
                                    text: name;
                                    active: DialogState.print-orientation == i;
                                    clicked => {
                                        DialogState.print-orientation = i;
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    spacing: 4px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: @tr("Margins (mm, all sides)");
                                        color: #9a9a9a;
                                        font-size: 12px;
                                    }
                                    Rectangle {
                                        height: 28px;
                                        background: #1b1b1b;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: #3a3a3a;
                                        TextInput {
                                            x: 8px;
                                            width: parent.width - 16px;
                                            height: 100%;
                                            text <=> DialogState.print-margins-text;
                                            color: #e6e6e6;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            single-line: true;
                                        }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: @tr("DPI");
                                        color: #9a9a9a;
                                        font-size: 12px;
                                    }
                                    Rectangle {
                                        height: 28px;
                                        background: #1b1b1b;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: #3a3a3a;
                                        TextInput {
                                            x: 8px;
                                            width: parent.width - 16px;
                                            height: 100%;
                                            text <=> DialogState.print-dpi-text;
                                            color: #e6e6e6;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            single-line: true;
                                        }
                                    }
                                }
                            }
                            Text {
                                text: @tr("Destination ICC profile (blank = sRGB)");
                                color: #9a9a9a;
                                font-size: 12px;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    height: 28px;
                                    horizontal-stretch: 1;
                                    background: #1b1b1b;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: #3a3a3a;
                                    TextInput {
                                        x: 8px;
                                        width: parent.width - 16px;
                                        height: 100%;
                                        text <=> DialogState.print-profile-text;
                                        color: #e6e6e6;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        single-line: true;
                                    }
                                }
                                FilterChip {
                                    text: @tr("Browse…");
                                    active: false;
                                    clicked => {
                                        DialogState.browse-print-profile();
                                    }
                                }
                            }
                            Text {
                                text: @tr("Rendering intent");
                                color: #9a9a9a;
                                font-size: 12px;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                for name[i] in ["Perceptual", "Relative", "Saturation", "Absolute"]: FilterChip {
                                    text: name;
                                    active: DialogState.print-intent == i;
                                    clicked => {
                                        DialogState.print-intent = i;
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    spacing: 4px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: @tr("Save as preset (optional name)");
                                        color: #9a9a9a;
                                        font-size: 12px;
                                    }
                                    Rectangle {
                                        height: 28px;
                                        background: #1b1b1b;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: #3a3a3a;
                                        TextInput {
                                            x: 8px;
                                            width: parent.width - 16px;
                                            height: 100%;
                                            text <=> DialogState.print-preset-name;
                                            color: #e6e6e6;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            single-line: true;
                                        }
                                    }
                                }
                                FilterChip {
                                    text: @tr("Save as preset");
                                    active: false;
                                    clicked => {
                                        DialogState.run-save-print-preset(
                                            DialogState.print-preset-name,
                                            DialogState.print-paper,
                                            DialogState.print-orientation,
                                            DialogState.print-margins-text,
                                            DialogState.print-dpi-text,
                                            DialogState.print-profile-text,
                                            DialogState.print-intent,
                                        );
                                    }
                                }
                            }
                        }
                        Text {
                            text: @tr("Destination folder (absolute path)");
                            color: #9a9a9a;
                            font-size: 12px;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                height: 28px;
                                horizontal-stretch: 1;
                                background: #1b1b1b;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #3a3a3a;
                                print-destination := TextInput {
                                    x: 8px;
                                    width: parent.width - 16px;
                                    height: 100%;
                                    text <=> DialogState.print-destination-text;
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    single-line: true;
                                }
                            }
                            FilterChip {
                                text: @tr("Browse…");
                                active: false;
                                clicked => {
                                    DialogState.browse-print-destination();
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                Text {
                                    text: @tr("Copies");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                                Rectangle {
                                    height: 28px;
                                    background: #1b1b1b;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: #3a3a3a;
                                    TextInput {
                                        x: 8px;
                                        width: parent.width - 16px;
                                        height: 100%;
                                        text <=> DialogState.print-copies-text;
                                        color: #e6e6e6;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        single-line: true;
                                    }
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            FilterChip {
                                text: @tr("Cancel");
                                active: false;
                                clicked => {
                                    DialogState.dialog = "";
                                }
                            }
                            FilterChip {
                                text: @tr("Print");
                                active: true;
                                clicked => {
                                    DialogState.run-print(
                                        DialogState.print-preset,
                                        print-destination.text,
                                        DialogState.print-paper,
                                        DialogState.print-orientation,
                                        DialogState.print-margins-text,
                                        DialogState.print-dpi-text,
                                        DialogState.print-profile-text,
                                        DialogState.print-intent,
                                        DialogState.print-copies-text,
                                    );
                                }
                            }
                        }
                    }

                    if DialogState.dialog == "tether": VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: @tr("Tethered capture");
                            color: #f0f0f0;
                            font-size: 15px;
                            font-weight: 600;
                        }
                        Text {
                            text: DialogState.tether-connected ? @tr("Connected — waiting for shots") : (DialogState.tether-status == "" ? @tr("Not connected. Plug in a camera over USB and click Connect.") : DialogState.tether-status);
                            color: DialogState.tether-connected ? #7fc97f : #9a9a9a;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        if DialogState.tether-connected: Text {
                            text: @tr("{} captured this session", DialogState.tether-captured-count);
                            color: #9a9a9a;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        if DialogState.tether-connected && DialogState.tether-last-captured != "": Text {
                            text: @tr("Last: {}", DialogState.tether-last-captured);
                            color: #9a9a9a;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            FilterChip {
                                text: @tr("Close");
                                active: false;
                                clicked => {
                                    DialogState.dialog = "";
                                }
                            }
                            if !DialogState.tether-connected: FilterChip {
                                text: @tr("Connect");
                                active: true;
                                clicked => {
                                    DialogState.run-tether-connect();
                                }
                            }
                            if DialogState.tether-connected: FilterChip {
                                text: @tr("Disconnect");
                                active: true;
                                clicked => {
                                    DialogState.run-tether-disconnect();
                                }
                            }
                        }
                    }

                    if DialogState.dialog == "watch": VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: @tr("Auto import");
                            color: #f0f0f0;
                            font-size: 15px;
                            font-weight: 600;
                        }
                        Text {
                            text: DialogState.watch-active ? @tr("Watching — waiting for files") : (DialogState.watch-status == "" ? @tr("Not watching. Pick a folder and click Start.") : DialogState.watch-status);
                            color: DialogState.watch-active ? #7fc97f : #9a9a9a;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        if !DialogState.watch-active: HorizontalLayout {
                            spacing: 8px;
                            watch-folder-input := TextInput {
                                text <=> DialogState.watch-folder-text;
                                color: #f0f0f0;
                                font-size: 12px;
                            }
                            FilterChip {
                                text: @tr("Browse…");
                                active: false;
                                clicked => {
                                    DialogState.browse-watch-folder();
                                }
                            }
                        }
                        if DialogState.watch-active: Text {
                            text: @tr("{} imported this session", DialogState.watch-imported-count);
                            color: #9a9a9a;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        if DialogState.watch-active && DialogState.watch-last-imported != "": Text {
                            text: @tr("Last: {}", DialogState.watch-last-imported);
                            color: #9a9a9a;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            FilterChip {
                                text: @tr("Close");
                                active: false;
                                clicked => {
                                    DialogState.dialog = "";
                                }
                            }
                            if !DialogState.watch-active: FilterChip {
                                text: @tr("Start");
                                active: true;
                                clicked => {
                                    DialogState.run-watch-start();
                                }
                            }
                            if DialogState.watch-active: FilterChip {
                                text: @tr("Stop");
                                active: true;
                                clicked => {
                                    DialogState.run-watch-stop();
                                }
                            }
                        }
                    }

                    if DialogState.dialog == "collection": VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: @tr("New collection");
                            color: #f0f0f0;
                            font-size: 15px;
                            font-weight: 600;
                        }
                        Text {
                            text: @tr("Name");
                            color: #9a9a9a;
                            font-size: 12px;
                        }
                        Rectangle {
                            height: 28px;
                            background: #1b1b1b;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #3a3a3a;
                            collection-name := TextInput {
                                x: 8px;
                                width: parent.width - 16px;
                                height: 100%;
                                color: #e6e6e6;
                                font-size: 12px;
                                vertical-alignment: center;
                                single-line: true;
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            FilterChip {
                                text: @tr("Cancel");
                                active: false;
                                clicked => {
                                    DialogState.dialog = "";
                                }
                            }
                            FilterChip {
                                text: @tr("Create");
                                active: true;
                                clicked => {
                                    CollectionState.run-new-collection(collection-name.text);
                                }
                            }
                        }
                    }

                    if DialogState.dialog == "preset": save-group := VerticalLayout {
                        spacing: 12px;
                        property <bool> g-white-balance: true;
                        property <bool> g-tone: true;
                        property <bool> g-presence: true;
                        property <bool> g-lens-correction: false;
                        property <bool> g-detail: false;
                        property <bool> g-geometry: false;

                        Text {
                            text: @tr("Save as preset");
                            color: #f0f0f0;
                            font-size: 15px;
                            font-weight: 600;
                        }
                        Text {
                            text: @tr("Name");
                            color: #9a9a9a;
                            font-size: 12px;
                        }
                        Rectangle {
                            height: 28px;
                            background: #1b1b1b;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #3a3a3a;
                            preset-name := TextInput {
                                x: 8px;
                                width: parent.width - 16px;
                                height: 100%;
                                color: #e6e6e6;
                                font-size: 12px;
                                vertical-alignment: center;
                                single-line: true;
                            }
                        }
                        Text {
                            text: @tr("Groups (geometry is rarely reused across photos)");
                            color: #9a9a9a;
                            font-size: 12px;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            FilterChip {
                                text: @tr("White balance");
                                active: save-group.g-white-balance;
                                clicked => {
                                    save-group.g-white-balance = !save-group.g-white-balance;
                                }
                            }
                            FilterChip {
                                text: @tr("Tone");
                                active: save-group.g-tone;
                                clicked => {
                                    save-group.g-tone = !save-group.g-tone;
                                }
                            }
                            FilterChip {
                                text: @tr("Presence");
                                active: save-group.g-presence;
                                clicked => {
                                    save-group.g-presence = !save-group.g-presence;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            FilterChip {
                                text: @tr("Lens correction");
                                active: save-group.g-lens-correction;
                                clicked => {
                                    save-group.g-lens-correction = !save-group.g-lens-correction;
                                }
                            }
                            FilterChip {
                                text: @tr("Detail");
                                active: save-group.g-detail;
                                clicked => {
                                    save-group.g-detail = !save-group.g-detail;
                                }
                            }
                            FilterChip {
                                text: @tr("Geometry");
                                active: save-group.g-geometry;
                                clicked => {
                                    save-group.g-geometry = !save-group.g-geometry;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            FilterChip {
                                text: @tr("Cancel");
                                active: false;
                                clicked => {
                                    DialogState.dialog = "";
                                }
                            }
                            FilterChip {
                                text: @tr("Save");
                                active: true;
                                clicked => {
                                    DevelopState.run-save-preset(
                                        preset-name.text,
                                        save-group.g-white-balance,
                                        save-group.g-tone,
                                        save-group.g-presence,
                                        save-group.g-lens-correction,
                                        save-group.g-detail,
                                        save-group.g-geometry);
                                }
                            }
                        }
                    }

                    // Help ▸ Keyboard Shortcuts…: the shortcut list already
                    // in this file, made discoverable outside develop mode
                    // too. Designing a dedicated panel is out of scope for
                    // ADR 0020 — this is the minimal read-only stand-in.
                    if DialogState.dialog == "shortcuts": VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: @tr("Keyboard shortcuts");
                            color: #f0f0f0;
                            font-size: 15px;
                            font-weight: 600;
                        }
                        VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: "G / D";
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    font-weight: 600;
                                    width: 110px;
                                }
                                Text {
                                    text: @tr("Library / develop");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: "I";
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    font-weight: 600;
                                    width: 110px;
                                }
                                Text {
                                    text: @tr("Import");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: "E";
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    font-weight: 600;
                                    width: 110px;
                                }
                                Text {
                                    text: @tr("Export");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: "T";
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    font-weight: 600;
                                    width: 110px;
                                }
                                Text {
                                    text: @tr("Tethered capture");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: "N";
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    font-weight: 600;
                                    width: 110px;
                                }
                                Text {
                                    text: @tr("New collection");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: "B / Shift+B";
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    font-weight: 600;
                                    width: 110px;
                                }
                                Text {
                                    text: @tr("Add / remove from collection");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: "Shift+R";
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    font-weight: 600;
                                    width: 110px;
                                }
                                Text {
                                    text: @tr("Reprocess library");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: "R";
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    font-weight: 600;
                                    width: 110px;
                                }
                                Text {
                                    text: @tr("Reprocess (develop mode)");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: "Ctrl+Z / Ctrl+Y";
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    font-weight: 600;
                                    width: 110px;
                                }
                                Text {
                                    text: @tr("Undo / redo");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: "S";
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    font-weight: 600;
                                    width: 110px;
                                }
                                Text {
                                    text: @tr("Save preset");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: "0–5";
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    font-weight: 600;
                                    width: 110px;
                                }
                                Text {
                                    text: @tr("Rate");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: "6–9";
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    font-weight: 600;
                                    width: 110px;
                                }
                                Text {
                                    text: @tr("Color label");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: "P / X / U";
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    font-weight: 600;
                                    width: 110px;
                                }
                                Text {
                                    text: @tr("Pick / reject / clear");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            FilterChip {
                                text: @tr("Close");
                                active: true;
                                clicked => {
                                    DialogState.dialog = "";
                                }
                            }
                        }
                    }

                    if DialogState.dialog == "about": VerticalLayout {
                        spacing: 12px;
                        HorizontalLayout {
                            alignment: center;
                            // The wide wordmark banner, not the square app
                            // icon: About is the one place in the UI with
                            // room to show the full brand lockup rather than
                            // just the badge used everywhere else (window
                            // icon, taskbar, installer — see `icon:` on
                            // `StudioWindow`).
                            Image {
                                source: @image-url("../../../assets/leyline-studio.png");
                                width: 300px;
                                height: 200px;
                                image-fit: contain;
                            }
                        }
                        Text {
                            text: @tr("Version {}", LibraryState.app-version);
                            color: #9a9a9a;
                            font-size: 11px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: @tr("Local-first, non-destructive RAW development.");
                            color: #c8c8c8;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        Text {
                            text: @tr("Library: {}", LibraryState.library-path);
                            color: #909090;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "https://github.com/leyline-studio/leyline";
                            color: #c8b06a;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        Text {
                            text: @tr("Licensed under {}", "GPL-3.0-only");
                            color: #9a9a9a;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            FilterChip {
                                text: @tr("Close");
                                active: true;
                                clicked => {
                                    DialogState.dialog = "";
                                }
                            }
                        }
                    }

                    if DialogState.dialog-result != "": Text {
                        text: DialogState.dialog-result;
                        color: #d8b23c;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // Custom menu bar's dropdown panels (see `TopMenuLabel` above for
        // why this isn't Slint's native `MenuBar`). Declared last so they
        // paint over everything, including the modal dialog overlay above.
        if root.open-menu != "": Rectangle {
            // Invisible full-window catcher: clicking outside any dropdown
            // closes the open menu.
            TouchArea {
                clicked => {
                    root.open-menu = "";
                    root.reset-submenus();
                }
            }

            if root.open-menu == "file": MenuDropdown {
                x: file-label.x;
                y: 28px;
                MenuRow {
                    title: @tr("Import…    I");
                    activated => {
                        DialogState.dialog-result = "";
                        DialogState.dialog = "import";
                        root.open-menu = "";
                    }
                }
                MenuRow {
                    title: @tr("Export…    E");
                    activated => {
                        DialogState.open-export();
                        root.open-menu = "";
                    }
                }
                MenuSep { }
                MenuRow {
                    title: @tr("Open Library…");
                    activated => {
                        LibraryState.open-library-requested();
                        root.open-menu = "";
                    }
                }
                SubmenuHeader {
                    title: @tr("Open Recent");
                    expanded <=> root.open-recent-submenu-open;
                    enabled: LibraryState.recent-libraries.length > 0;
                }
                if root.open-recent-submenu-open: VerticalLayout {
                    for path[index] in LibraryState.recent-libraries: MenuRow {
                        title: path;
                        activated => {
                            LibraryState.open-recent-library(index);
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                }
                MenuSep { }
                MenuRow {
                    title: @tr("Print…    Ctrl+P");
                    activated => {
                        DialogState.open-print();
                        root.open-menu = "";
                    }
                }
                MenuRow {
                    title: @tr("Tethered Capture…    T");
                    activated => {
                        DialogState.open-tether();
                        root.open-menu = "";
                    }
                }
                MenuRow {
                    title: @tr("Auto Import…");
                    activated => {
                        DialogState.open-watch();
                        root.open-menu = "";
                    }
                }
                MenuRow {
                    title: @tr("Map…    M");
                    activated => {
                        MapState.enter-map();
                        root.open-menu = "";
                    }
                }
                MenuSep { }
                MenuRow {
                    // ADR 0019 (language preferences) is decided but not
                    // yet implemented: kept visible per the ADR 0020 menu
                    // map, disabled until there is a preferences panel to
                    // open.
                    title: @tr("Preferences…");
                    enabled: false;
                }
                MenuSep { }
                MenuRow {
                    title: @tr("Quit");
                    activated => {
                        LibraryState.quit();
                    }
                }
            }

            if root.open-menu == "library": MenuDropdown {
                x: library-label.x;
                y: 28px;
                MenuRow {
                    title: @tr("New Collection…    N");
                    activated => {
                        DialogState.dialog-result = "";
                        DialogState.dialog = "collection";
                        root.open-menu = "";
                    }
                }
                MenuRow {
                    title: @tr("Add to Collection    B");
                    enabled: GridState.selected >= 0 && CollectionState.active-collection >= 0;
                    activated => {
                        CollectionState.add-to-collection();
                        root.open-menu = "";
                    }
                }
                MenuRow {
                    title: @tr("Remove from Collection    Shift+B");
                    enabled: GridState.selected >= 0 && CollectionState.active-collection >= 0;
                    activated => {
                        CollectionState.remove-from-collection();
                        root.open-menu = "";
                    }
                }
                MenuSep { }
                MenuRow {
                    title: @tr("Reprocess Library…    Shift+R");
                    activated => {
                        DevelopState.reprocess-library();
                        root.open-menu = "";
                    }
                }
            }

            if root.open-menu == "photo": MenuDropdown {
                x: photo-label.x;
                y: 28px;
                SubmenuHeader {
                    title: @tr("Rate");
                    expanded <=> root.rate-submenu-open;
                }
                if root.rate-submenu-open: VerticalLayout {
                    MenuRow {
                        title: @tr("1 star    1");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("1");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                    MenuRow {
                        title: @tr("2 stars    2");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("2");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                    MenuRow {
                        title: @tr("3 stars    3");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("3");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                    MenuRow {
                        title: @tr("4 stars    4");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("4");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                    MenuRow {
                        title: @tr("5 stars    5");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("5");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                    MenuSep { }
                    MenuRow {
                        title: @tr("Clear Rating    0");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("0");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                }
                SubmenuHeader {
                    title: @tr("Label");
                    expanded <=> root.label-submenu-open;
                }
                if root.label-submenu-open: VerticalLayout {
                    MenuRow {
                        title: @tr("Red    6");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("6");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                    MenuRow {
                        title: @tr("Yellow    7");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("7");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                    MenuRow {
                        title: @tr("Green    8");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("8");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                    MenuRow {
                        title: @tr("Blue    9");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("9");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                }
                SubmenuHeader {
                    title: @tr("Flag");
                    expanded <=> root.flag-submenu-open;
                }
                if root.flag-submenu-open: VerticalLayout {
                    MenuRow {
                        title: @tr("Pick    P");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("p");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                    MenuRow {
                        title: @tr("Reject    X");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("x");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                    MenuRow {
                        title: @tr("Clear    U");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("u");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                }
                MenuSep { }
                MenuRow {
                    title: @tr("Develop    D");
                    enabled: GridState.selected >= 0 && !DevelopState.develop-mode;
                    activated => {
                        DevelopState.enter-develop();
                        root.open-menu = "";
                    }
                }
                MenuRow {
                    // Today `R` only reprocesses the photo open in
                    // develop — same contract here: disabled outside
                    // that context rather than silently acting on
                    // something else.
                    title: @tr("Reprocess    R");
                    enabled: DevelopState.develop-mode;
                    activated => {
                        DevelopState.develop-reprocess();
                        root.open-menu = "";
                    }
                }
            }

            if root.open-menu == "develop-menu" && DevelopState.develop-mode: MenuDropdown {
                x: develop-label.x;
                y: 28px;
                MenuRow {
                    title: @tr("Undo    Ctrl+Z");
                    activated => {
                        DevelopState.develop-undo();
                        root.open-menu = "";
                    }
                }
                MenuRow {
                    title: @tr("Redo    Ctrl+Y");
                    activated => {
                        DevelopState.develop-redo();
                        root.open-menu = "";
                    }
                }
                MenuSep { }
                MenuRow {
                    title: @tr("Save Preset…    S");
                    activated => {
                        DevelopState.open-preset-dialog();
                        root.open-menu = "";
                    }
                }
                SubmenuHeader {
                    title: @tr("Apply Preset");
                    expanded <=> root.apply-preset-submenu-open;
                    enabled: DevelopState.dev-presets.length > 0;
                }
                if root.apply-preset-submenu-open: VerticalLayout {
                    for name[index] in DevelopState.dev-presets: MenuRow {
                        title: name;
                        activated => {
                            DevelopState.apply-preset(index);
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                }
                MenuSep { }
                MenuRow {
                    title: @tr("Back to Library    G");
                    activated => {
                        DevelopState.exit-develop();
                        root.open-menu = "";
                    }
                }
            }

            if root.open-menu == "view": MenuDropdown {
                x: view-label.x;
                y: 28px;
                MenuRow {
                    title: @tr("Library    G");
                    enabled: DevelopState.develop-mode;
                    activated => {
                        DevelopState.exit-develop();
                        root.open-menu = "";
                    }
                }
                MenuRow {
                    title: @tr("Develop    D");
                    enabled: !DevelopState.develop-mode && GridState.selected >= 0;
                    activated => {
                        DevelopState.enter-develop();
                        root.open-menu = "";
                    }
                }
            }

            if root.open-menu == "help": MenuDropdown {
                x: help-label.x;
                y: 28px;
                MenuRow {
                    title: @tr("Keyboard Shortcuts…");
                    activated => {
                        DialogState.dialog-result = "";
                        DialogState.dialog = "shortcuts";
                        root.open-menu = "";
                    }
                }
                MenuRow {
                    title: @tr("About Leyline");
                    activated => {
                        DialogState.dialog-result = "";
                        DialogState.dialog = "about";
                        root.open-menu = "";
                    }
                }
            }
        }
    }

    // `MenuBar` was a magic top-level element Slint gives special sizing
    // treatment (reserving space above the rest of the content natively);
    // a plain `HorizontalLayout` isn't. `keys` above (and its content)
    // therefore keeps its untouched, default fill-parent geometry —
    // giving it (or any ancestor of its repeaters: the grid, the
    // collections list) an explicit position/size override of any kind,
    // even a inert-looking one, was enough on its own to reintroduce a
    // repaint bug extremely similar to the native-`MenuBar` one this whole
    // rewrite exists to avoid (confirmed repeatedly; see
    // studio-repaint-bug-unresolved in project memory for the fuller
    // writeup). Concretely, this means: (1) `menu-row` is declared last —
    // after `keys` — purely so it paints on top of it (Slint paints
    // siblings in declaration order); it is not stacked above `keys` via
    // layout, the two simply overlap, and (2) each content column that
    // needs to visually clear the menu row's height reserves that space
    // with a plain spacer `Rectangle` as an extra *child* inside its own
    // already-existing `VerticalLayout` (adding a sibling element was
    // safe in testing) — never via a property override on the column
    // itself or on `keys`.
    menu-row := HorizontalLayout {
        // Custom menu bar (ADR 0020): a second, discoverable path to the
        // same callbacks already wired to keyboard shortcuts above — no
        // new functionality, no new code path. Context-sensitive entries
        // are disabled outside the context where their shortcut is
        // meaningful. Not Slint's native `MenuBar` — see the comment above
        // `TopMenuLabel` for why. The dropdown panels themselves are
        // declared later, in the same overlay z-order as the modal
        // dialogs, so they paint on top of the grid/develop view; only the
        // row of labels lives here.
        x: 0;
        y: 0;
        height: 28px;
        alignment: start;
        padding-left: 4px;
        spacing: 2px;

        file-label := TopMenuLabel {
            title: @tr("File");
            active: root.open-menu == "file";
            clicked => {
                root.open-menu = root.open-menu == "file" ? "" : "file";
                root.reset-submenus();
            }
        }
        library-label := TopMenuLabel {
            title: @tr("Library");
            active: root.open-menu == "library";
            clicked => {
                root.open-menu = root.open-menu == "library" ? "" : "library";
                root.reset-submenus();
            }
        }
        photo-label := TopMenuLabel {
            title: @tr("Photo");
            active: root.open-menu == "photo";
            clicked => {
                root.open-menu = root.open-menu == "photo" ? "" : "photo";
                root.reset-submenus();
            }
        }
        develop-label := TopMenuLabel {
            title: @tr("Develop");
            active: root.open-menu == "develop-menu";
            enabled: DevelopState.develop-mode;
            clicked => {
                root.open-menu = root.open-menu == "develop-menu" ? "" : "develop-menu";
                root.reset-submenus();
            }
        }
        view-label := TopMenuLabel {
            title: @tr("View");
            active: root.open-menu == "view";
            clicked => {
                root.open-menu = root.open-menu == "view" ? "" : "view";
                root.reset-submenus();
            }
        }
        help-label := TopMenuLabel {
            title: @tr("Help");
            active: root.open-menu == "help";
            clicked => {
                root.open-menu = root.open-menu == "help" ? "" : "help";
                root.reset-submenus();
            }
        }
    }
}
