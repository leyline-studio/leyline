// New collection: just a name — the parent is whatever is selected in the
// sidebar.
//
// One of the dialogs hosted by `panels/dialogs.slint` (ADR 0045 §3).

import { CollectionState } from "../state/collection.slint";
import { DialogState } from "../state/dialog.slint";
import { FilterChip } from "../widgets/controls.slint";

export component CollectionDialog inherits VerticalLayout {
    spacing: 12px;
    Text {
        text: @tr("New collection");
        color: #f0f0f0;
        font-size: 15px;
        font-weight: 600;
    }
    // Which kind (ADR 0143 §1). A dynamic collection is not a second way of
    // grouping: it is *this filter*, kept — so the choice is made here,
    // where the filter is still on screen behind the dialog.
    HorizontalLayout {
        spacing: 8px;
        FilterChip {
            text: @tr("Manual");
            active: !CollectionState.new-collection-smart;
            clicked => {
                CollectionState.new-collection-smart = false;
            }
        }
        FilterChip {
            text: @tr("Dynamic — the current filter");
            active: CollectionState.new-collection-smart;
            clicked => {
                CollectionState.new-collection-smart = true;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
    }
    if CollectionState.new-collection-smart: Text {
        text: CollectionState.smart-summary;
        color: CollectionState.smart-refused ? #d08a6a : #9a9a9a;
        font-size: 11px;
        wrap: word-wrap;
    }
    Text {
        text: @tr("Name");
        color: #9a9a9a;
        font-size: 12px;
    }
    Rectangle {
        height: 28px;
        background: #1b1b1b;
        border-radius: 4px;
        border-width: 1px;
        border-color: #3a3a3a;
        collection-name := TextInput {
            x: 8px;
            width: parent.width - 16px;
            height: 100%;
            color: #e6e6e6;
            font-size: 12px;
            vertical-alignment: center;
            single-line: true;
        }
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: end;
        FilterChip {
            text: @tr("Cancel");
            active: false;
            clicked => {
                DialogState.dialog = "";
            }
        }
        FilterChip {
            text: @tr("Create");
            active: true;
            // A filter this engine cannot express as rules is refused before
            // the click, not after (ADR 0143 §2).
            enabled: !CollectionState.new-collection-smart || !CollectionState.smart-refused;
            clicked => {
                CollectionState.run-new-collection(collection-name.text, CollectionState.new-collection-smart);
            }
        }
    }
}

// Renaming a collection: the same one field as creating one, prefilled
// (`docs/catalog.md` §24). Kept in this file rather than in three more:
// four dialogs of thirty lines about one subject are one subject, and
// splitting them would only spread the same import list.
export component RenameCollectionDialog inherits VerticalLayout {
    spacing: 12px;
    Text {
        text: @tr("Rename collection");
        color: #f0f0f0;
        font-size: 15px;
        font-weight: 600;
    }
    Text {
        text: @tr("Name");
        color: #9a9a9a;
        font-size: 12px;
    }
    Rectangle {
        height: 28px;
        background: #1b1b1b;
        border-radius: 4px;
        border-width: 1px;
        border-color: #3a3a3a;
        new-name := TextInput {
            x: 8px;
            width: parent.width - 16px;
            height: 100%;
            text: CollectionState.target-name;
            color: #e6e6e6;
            font-size: 12px;
            vertical-alignment: center;
            single-line: true;
            accepted => {
                CollectionState.run-rename(self.text);
            }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: end;
        FilterChip {
            text: @tr("Cancel");
            active: false;
            clicked => {
                DialogState.dialog = "";
            }
        }
        FilterChip {
            text: @tr("Rename");
            active: true;
            clicked => {
                CollectionState.run-rename(new-name.text);
            }
        }
    }
}

// Moving a collection: the list Rust prepared, which already excludes the
// collection itself and everything under it — a move into its own subtree
// would make it vanish from every read that starts at the root.
export component MoveCollectionDialog inherits VerticalLayout {
    spacing: 12px;
    Text {
        text: @tr("Move “{}” to", CollectionState.target-name);
        color: #f0f0f0;
        font-size: 15px;
        font-weight: 600;
    }
    Rectangle {
        height: 220px;
        background: #1b1b1b;
        border-radius: 4px;
        border-width: 1px;
        border-color: #3a3a3a;
        Flickable {
            viewport-height: CollectionState.move-targets.length * 26px;
            for label[i] in CollectionState.move-targets: Rectangle {
                y: i * 26px;
                width: parent.width;
                height: 26px;
                background: touch.has-hover ? #2f4f6f : transparent;
                Text {
                    x: 8px;
                    width: parent.width - 16px;
                    height: 100%;
                    text: label;
                    color: #e6e6e6;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                touch := TouchArea {
                    clicked => {
                        CollectionState.run-move(i);
                    }
                }
            }
        }
    }
    HorizontalLayout {
        alignment: end;
        FilterChip {
            text: @tr("Cancel");
            active: false;
            clicked => {
                DialogState.dialog = "";
            }
        }
    }
}

// Deleting: says how many collections go, because a subtree goes as a whole,
// and says what does *not* go, because that is the question one actually has
// at that moment.
export component DeleteCollectionDialog inherits VerticalLayout {
    spacing: 12px;
    Text {
        text: CollectionState.target-doomed > 1
            ? @tr("Delete “{}” and the {} collections under it?", CollectionState.target-name, CollectionState.target-doomed - 1)
            : @tr("Delete “{}”?", CollectionState.target-name);
        color: #f0f0f0;
        font-size: 15px;
        font-weight: 600;
        wrap: word-wrap;
        width: 380px;
    }
    Text {
        text: @tr("No photo is deleted: a collection is a grouping, and only the grouping goes.");
        color: #9a9a9a;
        font-size: 12px;
        wrap: word-wrap;
        width: 380px;
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: end;
        FilterChip {
            text: @tr("Cancel");
            active: false;
            clicked => {
                DialogState.dialog = "";
            }
        }
        FilterChip {
            text: @tr("Delete");
            active: true;
            clicked => {
                CollectionState.run-delete();
            }
        }
    }
}
