// The library browser: the filter bar, the collections sidebar, the
// thumbnail grid and the metadata panel (ADR 0045 §3).
//
// The default view — visible whenever neither develop nor the map has taken
// over the window.
//
// Inherits `HorizontalLayout` and sets no geometry of its own: the grid
// `Flickable` and the collections list are exactly the repeaters the repaint
// bug documented above `menu-row` in `studio.slint` is about, so nothing
// here may gain a position or size override.

import { Cell, CollectionRow, FolderRow, Tr } from "../types.slint";
import { CollectionState } from "../state/collection.slint";
import { FolderState } from "../state/folder.slint";
import { LibraryState } from "../state/library.slint";
import { DetailState } from "../state/detail.slint";
import { DevelopState } from "../state/develop.slint";
import { DialogState } from "../state/dialog.slint";
import { FilterState } from "../state/filter.slint";
import { GridState } from "../state/grid.slint";
import { MapState } from "../state/map.slint";
import { AdvanceChip, DetailRow, FilterChip, MiniSlider, RangeField, ViewModeChips } from "../widgets/controls.slint";
import { KeywordRow } from "../types.slint";
import { DragState } from "../state/drag.slint";
import { KeywordState } from "../state/keyword.slint";
import { PreferencesState } from "../state/preferences.slint";
import { HintState } from "../state/hint.slint";

export component BrowserPanel inherits HorizontalLayout {
    // Hands keyboard focus back to the window's `FocusScope` after a text
    // field is validated, so the single-key shortcuts start working again
    // instead of typing into the box. A callback rather than a global: this
    // is UI-internal plumbing that never reaches Rust (ADR 0045 §2).
    callback return-focus();
    // Panel folding, owned by the window (ADR 0055 §6): the sidebar and the
    // metadata panel go first, the toolbar under the grid with `Maj+Tab`.
    //
    // Two flags rather than one since ADR 0130 §2: the two panels are not
    // worth the same on a narrow window. The metadata panel is
    // informational — ADR 0055 §6's own words — while the sidebar is how one
    // reaches a folder or a collection at all, so a width that can carry
    // only one of them carries the sidebar.
    in property <bool> sidebar-hidden;
    in property <bool> detail-hidden;
    in property <bool> chrome-hidden;
    // Whether the panels are hidden because someone pressed `Tab`, as
    // opposed to because the window is too narrow to hold them. Only the
    // first has a way back that is not "resize the window", so only the
    // first gets a handle to click (ADR 0130 §2).
    in property <bool> folded-by-hand;
    callback unfold();
    // How many thumbnails fit per row. Exposed because the window's Up/Down
    // arrow shortcuts move the selection by exactly one row, and only the
    // grid knows how wide a row currently is.
    out property <int> columns: flick.columns;

    // Whether the shot-filter row under the bar is unfolded (ADR 0064 §5).
    // Panel-private: what is folded is a way of looking, not a filter, and
    // Rust has no use for it.
    property <bool> shot-panel-open: false;
    // The sort strip of ADR 0148 §1, open only while one is choosing.
    property <bool> sort-panel-open: false;

    // Thumbnail size (ADR 0055 §3), driven by the toolbar slider under the
    // grid. Panel-private and never stored: it is how one is looking right
    // now, not a setting (ADR 0045 §2).
    // Followed from the stored preference rather than owned here
    // (ADR 0136 §5): Rust holds the value, the slider reports a new one, and
    // the binding brings it back.
    property <length> cell-size: PreferencesState.thumbnail-size * 1px;
    // The cell is **taller** than it is wide (ADR 0146 §2): the name and the
    // stars take a row at its foot, and the photograph above them has to be
    // able to occupy a square — that is what gives a portrait frame and a
    // landscape one the same long edge, and the row a baseline. Squaring the
    // cell instead would have shrunk every landscape thumbnail to the height
    // a portrait could reach, which fixes the rhythm by taking something
    // away. 20px is the foot: 14px of text and the 6px above it.
    property <length> cell-h: root.cell-size + 20px;

    // Moves the selection to `index` and scrolls it into view.
    //
    // `public` because the window's arrow-key shortcuts call it: scrolling
    // needs `flick`, which lives in here, so the function has to as well
    // (ADR 0045 §2).
    public function select-cell(index: int) {
        if (index < 0 || index >= GridState.total-cells) {
            return;
        }
        GridState.selected = index;
        GridState.select(index);
        root.scroll-into-view(index);
    }

    // Scrolls the grid by the smallest amount that puts row `index` inside
    // the viewport, and nothing at all when it is already there.
    function scroll-into-view(index: int) {
        if (index < 0) {
            return;
        }
        if (Math.floor(index / flick.columns) * root.cell-h < -flick.viewport-y) {
            flick.viewport-y = -Math.floor(index / flick.columns) * root.cell-h;
        } else if ((Math.floor(index / flick.columns) + 1) * root.cell-h > -flick.viewport-y + flick.height) {
            flick.viewport-y = flick.height - (Math.floor(index / flick.columns) + 1) * root.cell-h;
        }
    }

    // The selection also moves while the grid is *not* the visible module:
    // develop's arrow keys walk this same grid, and can now walk clean past
    // the loaded window. Following it here — rather than only inside
    // `select-cell` — is what makes leaving develop land on the photograph
    // one was editing instead of wherever the grid happened to be left.
    // A local mirror because `changed` only ever attaches to a property of
    // the element declaring it, never to a global's.
    property <int> followed-selection: GridState.selected;
    changed followed-selection => {
        root.scroll-into-view(root.followed-selection);
    }

        visible: !DevelopState.develop-mode && !MapState.map-mode
            && !GridState.loupe-mode && !GridState.compare-mode && !GridState.survey-mode;

        // The sidebar, top to bottom: what the library holds, where it is on
        // disk, and how it has been grouped by hand (ADR 0055 §2). One
        // exclusive selection runs across the three — picking a folder drops
        // the collection and the other way round, since a grid showing "the
        // intersection of a folder and a collection" would be a filter nobody
        // asked for.
        if !root.sidebar-hidden: Rectangle {
            width: 200px;
            background: #202020;

            VerticalLayout {
                padding: 10px;
                spacing: 4px;

                Rectangle {
                    height: 28px;
                }

                Text {
                    text: @tr("Catalog");
                    color: #9a9a9a;
                    font-size: 11px;
                }

                Rectangle {
                    height: 24px;
                    border-radius: 4px;
                    background: CollectionState.active-collection == -1 && FolderState.active-folder == -1
                        ? #2f4f6f : transparent;
                    Text {
                        x: 8px;
                        width: parent.width - 16px;
                        height: 100%;
                        text: @tr("All photos");
                        color: #e6e6e6;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    TouchArea {
                        clicked => {
                            // Clears both filters at once — see the panel
                            // comment above.
                            FolderState.select-folder(-1);
                        }
                    }
                }

                Text {
                    text: @tr("Folders");
                    color: #9a9a9a;
                    font-size: 11px;
                }

                Flickable {
                    vertical-stretch: 1;
                    viewport-height: FolderState.folders.length * 26px;
                    for row[i] in FolderState.folders: Rectangle {
                        y: i * 26px;
                        height: 24px;
                        width: parent.width;
                        border-radius: 4px;
                        background: FolderState.active-folder == i ? #2f4f6f : transparent;
                        Text {
                            x: 8px + row.depth * 12px;
                            width: parent.width - self.x - 34px;
                            height: 100%;
                            text: row.name;
                            color: #d0d0d0;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        // The count sits in its own right-hand column, and an
                        // empty folder shows nothing rather than a zero: the
                        // number is there to find where the photos are.
                        Text {
                            x: parent.width - 30px;
                            width: 26px;
                            height: 100%;
                            text: row.count > 0 ? row.count : "";
                            color: #6f6f6f;
                            font-size: 11px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                FolderState.select-folder(i);
                            }
                        }
                    }
                }

                Text {
                    text: @tr("Collections");
                    color: #9a9a9a;
                    font-size: 11px;
                }

                Flickable {
                    vertical-stretch: 1;
                    viewport-height: CollectionState.collections.length * 26px;
                    for row[i] in CollectionState.collections: collection-row := Rectangle {
                        y: i * 26px;
                        height: 24px;
                        width: parent.width;
                        border-radius: 4px;
                        // A row tests the dragged pointer against its own
                        // rectangle (ADR 0130 §1): during a drag the grid
                        // cell holds the pointer grab, so `has-hover` here
                        // never becomes true and this is the only way a row
                        // can know. A smart collection is not a drop target
                        // — its members are its query's answer, and adding
                        // to it by hand would be a lie.
                        property <bool> drop-target: DragState.dragging && !row.smart
                            && DragState.x >= self.absolute-position.x
                            && DragState.x < self.absolute-position.x + self.width
                            && DragState.y >= self.absolute-position.y
                            && DragState.y < self.absolute-position.y + self.height;
                        changed drop-target => {
                            if (self.drop-target) {
                                DragState.target = i;
                                DragState.target-kind = "collection";
                            } else if (DragState.target == i && DragState.target-kind == "collection") {
                                DragState.target = -1;
                                DragState.target-kind = "";
                            }
                        }
                        background: self.drop-target ? #3f6f3f
                            : (CollectionState.active-collection == i ? #2f4f6f : transparent);
                        Text {
                            x: 8px + row.depth * 12px;
                            width: parent.width - self.x - 8px;
                            height: 100%;
                            text: (row.smart ? "◈ " : "") + row.name;
                            color: #d0d0d0;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        TouchArea {
                            clicked => {
                                CollectionState.select-collection(i);
                            }
                        }

                        // Managing the tree (`docs/catalog.md` §24), on the
                        // right click that ADR 0021 already established as
                        // the second path to everything: the three entries
                        // open dialogs, because each needs something Rust
                        // has to look up first — the current name, the legal
                        // parents, the size of the subtree.
                        ContextMenuArea {
                            Menu {
                                MenuItem {
                                    title: @tr("Rename…");
                                    activated => {
                                        CollectionState.open-rename(i);
                                    }
                                }
                                MenuItem {
                                    title: @tr("Move to…");
                                    activated => {
                                        CollectionState.open-move(i);
                                    }
                                }
                                MenuSeparator { }
                                MenuItem {
                                    title: @tr("Delete…");
                                    activated => {
                                        CollectionState.open-delete(i);
                                    }
                                }
                            }
                        }
                    }
                }

                // The library's keyword tree (ADR 0134 §2) — the third way
                // a library is navigated, beside folders and collections,
                // and until now the only one with no surface at all.
                //
                // Hidden entirely while the library has no keywords: an
                // empty strip under a heading says less than nothing, and
                // the way keywords are made is the field opposite.
                if KeywordState.any: Text {
                    text: @tr("Keywords");
                    color: #9a9a9a;
                    font-size: 11px;
                }
                if KeywordState.any: Flickable {
                    vertical-stretch: 1;
                    viewport-height: KeywordState.keywords.length * 26px;
                    for row[i] in KeywordState.keywords: keyword-row := Rectangle {
                        y: i * 26px;
                        height: 24px;
                        width: parent.width;
                        border-radius: 4px;
                        // The same hit test the collection rows use, and for
                        // the same reason (ADR 0130 §1): during a drag the
                        // grid cell holds the pointer grab, so `has-hover`
                        // here never becomes true.
                        property <bool> drop-target: DragState.dragging
                            && DragState.x >= self.absolute-position.x
                            && DragState.x < self.absolute-position.x + self.width
                            && DragState.y >= self.absolute-position.y
                            && DragState.y < self.absolute-position.y + self.height;
                        changed drop-target => {
                            if (self.drop-target) {
                                DragState.target = i;
                                DragState.target-kind = "keyword";
                            } else if (DragState.target == i && DragState.target-kind == "keyword") {
                                DragState.target = -1;
                                DragState.target-kind = "";
                            }
                        }
                        background: self.drop-target ? #3f6f3f
                            : (row.active ? #2f4f6f
                                : ((name-touch.has-hover || plus-touch.has-hover) ? #ffffff10 : transparent));

                        // The chevron, on the parents only, and its own
                        // touch target: opening a branch is not filtering on
                        // it, and the two must not be the same click.
                        if row.has-children: Rectangle {
                            x: 4px + row.depth * 12px;
                            width: 14px;
                            height: 100%;
                            Text {
                                text: row.expanded ? "▾" : "▸";
                                color: #7a7a7a;
                                font-size: 10px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                            TouchArea {
                                clicked => {
                                    KeywordState.toggle-expand(i);
                                }
                            }
                        }

                        Text {
                            x: 20px + row.depth * 12px;
                            width: parent.width - self.x - 62px;
                            height: 100%;
                            // A dot on a keyword the focused photograph
                            // carries: the panel and the tag list opposite
                            // then agree without either reading the other.
                            text: (row.tagged ? "• " : "") + row.name;
                            color: row.active ? #e6e6e6 : #d0d0d0;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        // Photographs in the subtree — the set clicking the
                        // row filters to, so the number and the gesture
                        // agree.
                        Text {
                            x: parent.width - 38px;
                            width: 34px;
                            height: 100%;
                            text: row.count > 0 ? row.count : "";
                            color: #6a6a6a;
                            font-size: 11px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        // Writing, under the pointer only (ADR 0134 §2): a
                        // permanent control here would sit a pixel from the
                        // name and mean the opposite of it.
                        //
                        // The area is always declared and only its glyph
                        // appears: a conditional `TouchArea` would have to
                        // read its own `has-hover` to decide whether to
                        // exist. It also keeps the count from shifting as
                        // the pointer crosses the row.
                        Rectangle {
                            x: parent.width - 18px;
                            width: 16px;
                            height: 100%;
                            Text {
                                text: "+";
                                visible: name-touch.has-hover || plus-touch.has-hover;
                                color: #6fa8dc;
                                font-size: 14px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                            plus-touch := TouchArea {
                                clicked => {
                                    KeywordState.tag-selection(i);
                                }
                            }
                        }
                        name-touch := TouchArea {
                            // Starts where the name starts and stops short
                            // of the `+`, so neither the chevron nor the `+`
                            // ever competes with it for a click. Declared
                            // last, it sits on top: without the `x` it
                            // covered the chevron entirely, and opening a
                            // branch filtered on it instead.
                            x: 20px + row.depth * 12px;
                            width: parent.width - self.x - 20px;
                            clicked => {
                                KeywordState.filter(i);
                            }
                        }

                        ContextMenuArea {
                            Menu {
                                MenuItem {
                                    title: @tr("Rename…");
                                    activated => {
                                        KeywordState.open-rename(i);
                                    }
                                }
                                MenuSeparator { }
                                MenuItem {
                                    title: @tr("Delete…");
                                    activated => {
                                        KeywordState.open-delete(i);
                                    }
                                }
                            }
                        }
                    }
                }

                // The two gestures that make photos come in and go out, at
                // the bottom of the panel where Lightroom puts them
                // (ADR 0055 §2). They replace the grey shortcut line that
                // used to sit here: a shortcut is discovered afterwards, it
                // is not a door.
                HorizontalLayout {
                    spacing: 6px;
                    FilterChip {
                        text: @tr("Import…");
                        active: false;
                        clicked => {
                            DialogState.dialog-result = "";
                            DialogState.dialog = "import";
                        }
                    }
                    FilterChip {
                        text: @tr("Export…");
                        active: false;
                        enabled: GridState.selected >= 0;
                        clicked => {
                            DialogState.open-export();
                        }
                    }
                }
            }
        }

        // The way back, for panels hidden by hand (ADR 0130 §2). `Tab`
        // goes on working and is what an experienced user reaches for;
        // this is what says the panels exist at all to someone who pressed
        // it by accident, or who never knew.
        if root.sidebar-hidden && root.folded-by-hand: Rectangle {
            width: 14px;
            background: #202020;
            Text {
                text: "›";
                color: unfold-touch.has-hover ? #e6e6e6 : #6a6a6a;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
            unfold-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.unfold();
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            padding: 12px;
            spacing: 8px;

            Rectangle {
                height: 28px;
            }

            HorizontalLayout {
                spacing: 10px;

                HorizontalLayout {
                    spacing: 2px;
                    for s in 5: TouchArea {
                        width: 18px;
                        height: 24px;
                        Text {
                            text: FilterState.filter-rating > s ? "★" : "☆";
                            color: FilterState.filter-rating > s ? #d8b23c : #666666;
                            font-size: 15px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                        clicked => {
                            FilterState.rating-filter(s + 1);
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 4px;
                    for l[i] in 5: dot := TouchArea {
                        width: 16px;
                        height: 24px;
                        // Five coloured circles, and nothing anywhere says
                        // they filter (ADR 0127 §1). The names are the
                        // labels' own, in the order `label-colors` holds
                        // them, which is the order the `6`–`9` keys assign
                        // them in — red, yellow, green, blue, purple.
                        property <string> label-name: i == 0 ? @tr("Filter: red label")
                            : i == 1 ? @tr("Filter: yellow label")
                            : i == 2 ? @tr("Filter: green label")
                            : i == 3 ? @tr("Filter: blue label")
                            : @tr("Filter: purple label");
                        changed has-hover => {
                            if (self.has-hover) {
                                HintState.enter(self.label-name,
                                    self.absolute-position.x, self.absolute-position.y + self.height);
                            } else {
                                HintState.leave(self.label-name);
                            }
                        }
                        Rectangle {
                            width: 12px;
                            height: 12px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 6px;
                            background: FilterState.label-colors[l];
                            border-width: FilterState.filter-label == l ? 2px : 0px;
                            border-color: #f0f0f0;
                            opacity: FilterState.filter-label == l || FilterState.filter-label == -1 ? 1 : 0.35;
                        }
                        clicked => {
                            HintState.dismiss();
                            FilterState.label-filter(l);
                        }
                    }
                }

                FilterChip {
                    text: @tr("⚑ Picked");
                    active: FilterState.filter-pick == 1;
                    clicked => {
                        FilterState.pick-filter(1);
                    }
                }
                FilterChip {
                    text: @tr("✕ Rejected");
                    active: FilterState.filter-pick == 2;
                    clicked => {
                        FilterState.pick-filter(2);
                    }
                }
                FilterChip {
                    text: @tr("– Unflagged");
                    active: FilterState.filter-pick == 0;
                    clicked => {
                        FilterState.pick-filter(0);
                    }
                }

                if FilterState.filter-keyword-label != "": FilterChip {
                    // `#` and not `🏷`: the bundled font has no U+1F3F7 and
                    // drew an empty box — seen the moment ADR 0134 made this
                    // chip reachable from the sidebar, having been unreachable
                    // before.
                    text: "# " + FilterState.filter-keyword-label;
                    active: true;
                    clicked => {
                        FilterState.clear-keyword-filter();
                    }
                }

                // The one control on this row that can give ground. Everything
                // else is a chip sized by its own label, so when the bar runs
                // out of room the search field is what yields — down to a box
                // still wide enough to read a short query in, never to zero.
                Rectangle {
                    height: 24px;
                    min-width: 90px;
                    max-width: 180px;
                    horizontal-stretch: 1;
                    background: #1b1b1b;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: search-input.text == "" ? #333333 : #6fa8dc;
                    search-input := TextInput {
                        x: 10px;
                        width: parent.width - 20px;
                        height: 100%;
                        color: #e6e6e6;
                        font-size: 12px;
                        vertical-alignment: center;
                        single-line: true;
                        accepted => {
                            FilterState.search(self.text);
                            root.return-focus();
                        }
                    }
                    if search-input.text == "" && !search-input.has-focus: Text {
                        x: 10px;
                        height: 100%;
                        text: @tr("Search…");
                        color: #666666;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                FilterChip {
                    // No emoji: the camera pictogram is a colour glyph that
                    // simply vanishes on the fonts of a bare X session, and a
                    // chip whose label disappears is worse than a plain one.
                    text: FilterState.shot-count > 0
                        ? @tr("Shot ({})", FilterState.shot-count)
                        : @tr("Shot");
                    active: FilterState.shot-count > 0;
                    clicked => {
                        shot-panel-open = !shot-panel-open;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                // The order, and the way to change it (ADR 0148 §1). The
                // chip used to advance through eight orders on click, so
                // reaching one cost up to seven reloads and the other seven
                // were never visible. It now opens the strip below, where
                // the two questions are asked once each.
                FilterChip {
                    text: @tr("Sort: {} {}",
                        Tr.sort-name(FilterState.sort-key),
                        Tr.sort-direction-short(FilterState.sort-key, FilterState.sort-ascending));
                    active: sort-panel-open;
                    clicked => {
                        sort-panel-open = !sort-panel-open;
                    }
                }
            }

            // Under the bar and not in a popup of its own, for the reason
            // the shot filters are (ADR 0064 §5): it orders the same grid
            // the chips above narrow, so it belongs under them.
            if sort-panel-open: VerticalLayout {
                spacing: 6px;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Text {
                        // 56px rather than the shot panel's 44: « Critère »
                        // does not fit in 44, and the two rows of this strip
                        // line up with each other rather than with a panel
                        // that is not open at the same time.
                        text: @tr("By");
                        color: #9a9a9a;
                        font-size: 12px;
                        vertical-alignment: center;
                        width: 56px;
                    }
                    for key[k] in 4: FilterChip {
                        text: Tr.sort-name(k);
                        active: FilterState.sort-key == k;
                        clicked => {
                            // Changing the key keeps the direction, and the
                            // other way round: two questions, answered one
                            // at a time.
                            FilterState.choose-sort(k, FilterState.sort-ascending);
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Text {
                        text: @tr("Order");
                        color: #9a9a9a;
                        font-size: 12px;
                        vertical-alignment: center;
                        width: 56px;
                    }
                    for way[w] in 2: FilterChip {
                        // Both ends, in words, for the key in force.
                        text: Tr.sort-direction(FilterState.sort-key, w == 0);
                        active: FilterState.sort-ascending == (w == 0);
                        clicked => {
                            FilterState.choose-sort(FilterState.sort-key, w == 0);
                        }
                    }
                }
            }

            // The shot filters (ADR 0064 §5): folded under the bar rather
            // than off in a side tab, because they narrow the same grid as
            // the stars and the labels just above, and looking for them
            // somewhere else would be looking twice.
            if shot-panel-open: VerticalLayout {
                spacing: 6px;

                if FilterState.shot-cameras.length > 0: HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Text {
                        text: @tr("Body");
                        color: #9a9a9a;
                        font-size: 12px;
                        vertical-alignment: center;
                        width: 44px;
                    }
                    for camera[i] in FilterState.shot-cameras: FilterChip {
                        text: camera;
                        active: FilterState.shot-camera == i;
                        clicked => {
                            FilterState.camera-filter(i);
                        }
                    }
                }

                if FilterState.shot-lenses.length > 0: HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Text {
                        text: @tr("Lens");
                        color: #9a9a9a;
                        font-size: 12px;
                        vertical-alignment: center;
                        width: 44px;
                    }
                    for lens[i] in FilterState.shot-lenses: FilterChip {
                        text: lens;
                        active: FilterState.shot-lens == i;
                        clicked => {
                            FilterState.lens-filter(i);
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    iso-range := RangeField {
                        label: "ISO";
                        placeholder: "3200-";
                        accepted(text) => {
                            FilterState.shot-range("iso", text);
                            root.return-focus();
                        }
                    }
                    aperture-range := RangeField {
                        label: "f/";
                        placeholder: "-2.8";
                        accepted(text) => {
                            FilterState.shot-range("aperture", text);
                            root.return-focus();
                        }
                    }
                    focal-range := RangeField {
                        label: "mm";
                        placeholder: "24-70";
                        accepted(text) => {
                            FilterState.shot-range("focal", text);
                            root.return-focus();
                        }
                    }
                    shutter-range := RangeField {
                        label: "s";
                        placeholder: "-1/500";
                        accepted(text) => {
                            FilterState.shot-range("shutter", text);
                            root.return-focus();
                        }
                    }
                    FilterChip {
                        text: @tr("Clear");
                        active: false;
                        enabled: FilterState.shot-count > 0;
                        clicked => {
                            iso-range.clear();
                            aperture-range.clear();
                            focal-range.clear();
                            shutter-range.clear();
                            FilterState.clear-shot-filters();
                        }
                    }
                }

                // The library holds nothing to filter on yet: say so, rather
                // than show an empty row that looks broken.
                if FilterState.shot-cameras.length == 0 && FilterState.shot-lenses.length == 0: Text {
                    text: @tr("No camera or lens recorded in this library yet.");
                    color: #666666;
                    font-size: 12px;
                }
            }

            Text {
                text: LibraryState.status-line;
                color: #9a9a9a;
                font-size: 13px;
            }

            // An empty library says what to do, where the photos would be
            // (ADR 0054 §1) — the grid is the first thing a new user looks at,
            // and a bare one told them nothing.
            // Left-aligned with its own padding rather than centred: the
            // centring depended on the column's width reaching this block,
            // which it does not do predictably here, and an empty state that
            // drifts is worse than one that sits where the first thumbnail
            // would.
            if GridState.total-cells == 0: VerticalLayout {
                vertical-stretch: 1;
                alignment: start;
                spacing: 10px;
                padding-top: 32px;
                padding-left: 8px;
                padding-right: 24px;

                // Two different empty grids, and telling them apart is the
                // whole point: a library that holds nothing wants photographs
                // imported, a library narrowed to nothing wants the criteria
                // widened. Offering "Import…" to someone whose only mistake
                // was a three-star filter sends them the wrong way, and
                // saying "No photos yet" about 38 000 photographs is a lie.
                Text {
                    text: GridState.narrowed ? @tr("No photo matches") : @tr("No photos yet");
                    color: #e6e6e6;
                    font-size: 18px;
                }
                Text {
                    // `word-wrap` needs a width to wrap against, and a width
                    // read off the parent is a layout cycle — Slint answers
                    // that one with "Recursion detected" at startup, the
                    // geometry hazard of ADR 0045 §3 in its most literal form.
                    width: 420px;
                    text: GridState.narrowed
                        ? @tr("The library is not empty — nothing in it answers the filters, the search or the folder currently selected.")
                        : @tr("Import a folder of photos, or watch one so new shots arrive on their own.");
                    color: #9a9a9a;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    if GridState.narrowed: FilterChip {
                        text: @tr("Show all photos");
                        active: true;
                        clicked => {
                            // The search box holds its own text — the query
                            // Rust just reset knows nothing about it, so it
                            // is cleared here or the box would still show a
                            // term that no longer filters anything.
                            search-input.text = "";
                            GridState.clear-criteria();
                        }
                    }
                    if !GridState.narrowed: FilterChip {
                        text: @tr("Import photos…");
                        active: true;
                        clicked => {
                            DialogState.dialog = "import";
                        }
                    }
                    if !GridState.narrowed: FilterChip {
                        text: @tr("Watch a folder…");
                        active: false;
                        clicked => {
                            DialogState.open-watch();
                        }
                    }
                }
            }

            flick := Flickable {
                property <int> columns: max(1, Math.floor(self.width / root.cell-size));
                // Virtual scrolling: only the loaded window has cells, but
                // the viewport spans the whole grid; scrolling or resizing
                // asks Rust for the matching window.
                property <int> first-cell: Math.floor(-self.viewport-y / root.cell-h) * self.columns;
                property <int> visible-cells: (Math.ceil(self.height / root.cell-h) + 1) * self.columns;
                viewport-height: Math.ceil(GridState.total-cells / self.columns) * root.cell-h;
                changed first-cell => {
                    GridState.viewport-moved(self.first-cell, self.visible-cells);
                }
                changed visible-cells => {
                    GridState.viewport-moved(self.first-cell, self.visible-cells);
                }

                for cell[i] in GridState.cells: Rectangle {
                    x: Math.mod(GridState.window-start + i, flick.columns) * root.cell-size;
                    y: Math.floor((GridState.window-start + i) / flick.columns) * root.cell-h;
                    width: root.cell-size;
                    height: root.cell-h;

                    Rectangle {
                        x: 4px;
                        y: 4px;
                        width: parent.width - 8px;
                        height: parent.height - 8px;
                        background: (GridState.window-start + i == GridState.selected || cell.multi-selected) ? #2f4f6f : #242424;
                        border-radius: 4px;
                        border-width: (GridState.window-start + i == GridState.selected || cell.multi-selected) ? 2px : 1px;
                        border-color: GridState.window-start + i == GridState.selected ? #6fa8dc : (cell.multi-selected ? #4a7aa8 : #333333);

                        VerticalLayout {
                            padding: 6px;
                            spacing: 4px;

                            // One rhythm for the grid (ADR 0146 §2). The
                            // cell is square, the image area under it is
                            // not — the name and stars take the foot — so
                            // `image-fit: contain` alone drew a portrait
                            // frame a third taller than its landscape
                            // neighbours, and a row of mixed orientations
                            // had no baseline. Fitted into the largest
                            // square the area holds, both orientations get
                            // the same long edge, which is the rule of the
                            // contact sheet a grid is a picture of.
                            Rectangle {
                                vertical-stretch: 1;
                                Image {
                                    source: cell.thumbnail;
                                    image-fit: contain;
                                    width: min(parent.width, parent.height);
                                    height: self.width;
                                    // A `Rectangle` is not a layout: without
                                    // these two the square sits top-left.
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                if cell.has-label: Rectangle {
                                    width: 10px;
                                    height: 10px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 5px;
                                    background: cell.label;
                                }
                                Text {
                                    text: cell.filename;
                                    color: #d0d0d0;
                                    font-size: 11px;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: cell.stars;
                                    color: #d8b23c;
                                    font-size: 11px;
                                }
                            }
                        }

                        // Cell badges (ADR 0055 §5), each in its own corner
                        // so none of them ever covers another: the grid
                        // number top-left — it is how one says "the 47th" to
                        // someone —, the flag beside it, and the mark of a
                        // photo already worked on at the top right.
                        Text {
                            x: 6px;
                            y: 4px;
                            text: GridState.window-start + i + 1;
                            color: #6a6a6a;
                            font-size: 11px;
                        }
                        if cell.flagged || cell.rejected: Text {
                            x: 30px;
                            y: 4px;
                            text: cell.flagged ? "⚑" : "✕";
                            color: cell.flagged ? #d0d0d0 : #b0574f;
                            font-size: 11px;
                        }
                        if cell.edited: Text {
                            x: parent.width - 20px;
                            y: 4px;
                            text: "◐";
                            color: #6fa8dc;
                            font-size: 11px;
                        }
                        // The fourth corner, and the fourth badge (ADR 0079
                        // §6): this photo carries the camera's own rendering
                        // of the same shot. Text and not an emoji — a colour
                        // emoji vanishes outright in these fonts.
                        if cell.paired: Text {
                            x: parent.width - 42px;
                            y: parent.height - 20px;
                            text: "RAW+J";
                            color: #7a7a7a;
                            font-size: 9px;
                        }
                        // What the assistant proposes for this frame, and why
                        // (ADR 0145 §1). Over the thumbnail's foot rather than
                        // in a corner: it is a *sentence*, not a glyph, and it
                        // is only there while a proposal is under review.
                        if cell.proposal != "": Rectangle {
                            x: 6px;
                            y: parent.height - 38px;
                            width: proposal-text.preferred-width + 12px;
                            height: 16px;
                            border-radius: 8px;
                            background: cell.proposal-keep ? #2f4f6fe0 : #6f4a2ae0;
                            proposal-text := Text {
                                text: cell.proposal;
                                color: #e6e6e6;
                                font-size: 10px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                        }
                        // More than one development of this photo exists
                        // (ADR 0094 §1). The grid still shows one cell per
                        // photo; the badge is how a branch announces itself,
                        // and the develop panel's chips are where one
                        // switches.
                        if cell.version-count > 1: Text {
                            x: parent.width - 20px;
                            y: 18px;
                            text: "×\{cell.version-count}";
                            color: #c8a86a;
                            font-size: 10px;
                        }
                        // The volume is unplugged (ADR 0085 §5). The badge
                        // says the *original* is out of reach, not that the
                        // photograph is gone — the thumbnail beneath it is
                        // still there and still correct.
                        //
                        // Top-left, after the number and the flag, and not in
                        // the bottom-left corner it was first put in: that
                        // corner is the filename row, and `parent` here is
                        // the whole card rather than the thumbnail, so the
                        // badge landed on top of the name. Which is what the
                        // comment above already warned about.
                        if cell.offline: Text {
                            x: 54px;
                            y: 4px;
                            text: @tr("offline");
                            color: #d08a5a;
                            font-size: 9px;
                        }
                    }

                    cell-touch := TouchArea {
                        double-clicked => {
                            GridState.selected = GridState.window-start + i;
                            GridState.select(GridState.window-start + i);
                            DevelopState.enter-develop();
                        }
                        // Dragging a photograph onto a collection
                        // (ADR 0130 §1). A drag only becomes one after 6px
                        // of movement, so a click that wanders a pixel
                        // between press and release is still a click — and
                        // the selection, which happens on release below, is
                        // left alone when it was a drag.
                        moved => {
                            if (self.pressed) {
                                if (!DragState.dragging
                                    && (abs((self.mouse-x - self.pressed-x) / 1px)
                                        + abs((self.mouse-y - self.pressed-y) / 1px)) > 6) {
                                    DragState.dragging = true;
                                    DragState.from-cell = GridState.window-start + i;
                                    // What the drop will actually file, and
                                    // read the same way Rust reads it: the
                                    // selection only when *this* cell
                                    // belongs to it, otherwise this one
                                    // photograph (ADR 0130 §1). The cell
                                    // carries its own membership, so the
                                    // label cannot disagree with the drop.
                                    DragState.count = cell.multi-selected
                                        ? GridState.selection-size
                                        : 1;
                                }
                                if (DragState.dragging) {
                                    DragState.x = self.absolute-position.x + self.mouse-x;
                                    DragState.y = self.absolute-position.y + self.mouse-y;
                                }
                            }
                        }
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                if (DragState.dragging) {
                                    if (DragState.target >= 0 && DragState.target-kind == "collection") {
                                        CollectionState.drop-on-collection(DragState.from-cell, DragState.target);
                                    } else if (DragState.target >= 0 && DragState.target-kind == "keyword") {
                                        // The cell it began on, not the
                                        // selection: Rust applies ADR 0130
                                        // §1's rule — the whole selection
                                        // when the dragged cell belongs to
                                        // it, that one photograph when it
                                        // does not. Selecting here first
                                        // would destroy the very thing the
                                        // rule reads.
                                        KeywordState.drop-on-keyword(DragState.from-cell, DragState.target);
                                    }
                                    DragState.stop();
                                } else {
                                    GridState.cell-clicked(GridState.window-start + i, event.modifiers.control, event.modifiers.shift);
                                }
                            }
                        }
                    }

                    // Right-click (ADR 0021): a second, per-photo path
                    // to the same classement/collection/reprocess
                    // callbacks already wired above and to the
                    // MenuBar (ADR 0020). Rate/Label/Flag/Reprocess/Copy
                    // Settings reset to a plain single selection here
                    // (`GridState.selected = ...; GridState.select(...)`), like
                    // every keyboard shortcut and menu-bar entry —
                    // *Paste* Settings is the one exception, acting on
                    // whatever multi-selection is already current
                    // instead (see its own comment below).
                    ContextMenuArea {
                        Menu {
                            MenuItem {
                                title: @tr("Develop    D");
                                activated => {
                                    GridState.selected = GridState.window-start + i;
                                    GridState.select(GridState.window-start + i);
                                    DevelopState.enter-develop();
                                }
                            }
                            MenuSeparator { }
                            Menu {
                                title: @tr("Rate");
                                MenuItem {
                                    title: @tr("1 star    1");
                                    activated => {
                                        GridState.selected = GridState.window-start + i;
                                        GridState.select(GridState.window-start + i);
                                        GridState.classify("1");
                                    }
                                }
                                MenuItem {
                                    title: @tr("2 stars    2");
                                    activated => {
                                        GridState.selected = GridState.window-start + i;
                                        GridState.select(GridState.window-start + i);
                                        GridState.classify("2");
                                    }
                                }
                                MenuItem {
                                    title: @tr("3 stars    3");
                                    activated => {
                                        GridState.selected = GridState.window-start + i;
                                        GridState.select(GridState.window-start + i);
                                        GridState.classify("3");
                                    }
                                }
                                MenuItem {
                                    title: @tr("4 stars    4");
                                    activated => {
                                        GridState.selected = GridState.window-start + i;
                                        GridState.select(GridState.window-start + i);
                                        GridState.classify("4");
                                    }
                                }
                                MenuItem {
                                    title: @tr("5 stars    5");
                                    activated => {
                                        GridState.selected = GridState.window-start + i;
                                        GridState.select(GridState.window-start + i);
                                        GridState.classify("5");
                                    }
                                }
                                MenuSeparator { }
                                MenuItem {
                                    title: @tr("Clear Rating    0");
                                    activated => {
                                        GridState.selected = GridState.window-start + i;
                                        GridState.select(GridState.window-start + i);
                                        GridState.classify("0");
                                    }
                                }
                            }
                            Menu {
                                title: @tr("Label");
                                MenuItem {
                                    title: @tr("Red    6");
                                    activated => {
                                        GridState.selected = GridState.window-start + i;
                                        GridState.select(GridState.window-start + i);
                                        GridState.classify("6");
                                    }
                                }
                                MenuItem {
                                    title: @tr("Yellow    7");
                                    activated => {
                                        GridState.selected = GridState.window-start + i;
                                        GridState.select(GridState.window-start + i);
                                        GridState.classify("7");
                                    }
                                }
                                MenuItem {
                                    title: @tr("Green    8");
                                    activated => {
                                        GridState.selected = GridState.window-start + i;
                                        GridState.select(GridState.window-start + i);
                                        GridState.classify("8");
                                    }
                                }
                                MenuItem {
                                    title: @tr("Blue    9");
                                    activated => {
                                        GridState.selected = GridState.window-start + i;
                                        GridState.select(GridState.window-start + i);
                                        GridState.classify("9");
                                    }
                                }
                            }
                            Menu {
                                title: @tr("Flag");
                                MenuItem {
                                    title: @tr("Pick    P");
                                    activated => {
                                        GridState.selected = GridState.window-start + i;
                                        GridState.select(GridState.window-start + i);
                                        GridState.classify("p");
                                    }
                                }
                                MenuItem {
                                    title: @tr("Reject    X");
                                    activated => {
                                        GridState.selected = GridState.window-start + i;
                                        GridState.select(GridState.window-start + i);
                                        GridState.classify("x");
                                    }
                                }
                                MenuItem {
                                    title: @tr("Clear    U");
                                    activated => {
                                        GridState.selected = GridState.window-start + i;
                                        GridState.select(GridState.window-start + i);
                                        GridState.classify("u");
                                    }
                                }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: @tr("Add to Collection    B");
                                enabled: CollectionState.active-collection >= 0;
                                activated => {
                                    GridState.selected = GridState.window-start + i;
                                    GridState.select(GridState.window-start + i);
                                    CollectionState.add-to-collection();
                                }
                            }
                            MenuItem {
                                title: @tr("Remove from Collection    Shift+B");
                                enabled: CollectionState.active-collection >= 0;
                                activated => {
                                    GridState.selected = GridState.window-start + i;
                                    GridState.select(GridState.window-start + i);
                                    CollectionState.remove-from-collection();
                                }
                            }
                            MenuSeparator { }
                            MenuItem {
                                // Library::reprocess (§10.4) on this photo
                                // alone — not the EditSession::reprocess
                                // path behind `R`, which needs an open
                                // develop session. Same call as
                                // Shift+R, scoped to one version.
                                title: @tr("Reprocess");
                                activated => {
                                    GridState.selected = GridState.window-start + i;
                                    GridState.select(GridState.window-start + i);
                                    DevelopState.reprocess-selected();
                                }
                            }
                            MenuSeparator { }
                            MenuItem {
                                // Renaming files on disk (ADR 0100): acts
                                // on the whole selection, so it does not
                                // collapse it to this one cell.
                                title: @tr("Rename Files…");
                                activated => {
                                    DialogState.open-rename();
                                }
                            }
                            MenuItem {
                                // A second development of this photo
                                // (ADR 0094 §2). Static, never a list of the
                                // existing versions: a `MenuItem` title that
                                // is an expression panics Slint's generator
                                // (ADR 0089).
                                title: @tr("New Version");
                                activated => {
                                    GridState.selected = GridState.window-start + i;
                                    GridState.select(GridState.window-start + i);
                                    DevelopState.create-version();
                                }
                            }
                            MenuSeparator { }
                            MenuItem {
                                // Copies from this one cell — reset to a
                                // plain single selection is fine, the
                                // source of a copy is always singular.
                                title: @tr("Copy Settings");
                                activated => {
                                    GridState.selected = GridState.window-start + i;
                                    GridState.select(GridState.window-start + i);
                                    DevelopState.copy-settings();
                                }
                            }
                            MenuItem {
                                title: @tr("Copy Settings…");
                                activated => {
                                    GridState.selected = GridState.window-start + i;
                                    GridState.select(GridState.window-start + i);
                                    DevelopState.open-copy-dialog();
                                }
                            }
                            MenuItem {
                                // Deliberately does *not* touch
                                // `selected`/`select` first: pasting must
                                // act on whatever multi-selection is
                                // already current (right-clicking one of
                                // several already-selected photos), not
                                // collapse it down to this one cell.
                                title: @tr("Paste Settings");
                                enabled: DevelopState.has-settings-clipboard;
                                activated => {
                                    DevelopState.paste-settings();
                                }
                            }
                        }
                    }
                }
            }

            // The toolbar under the grid (ADR 0055 §3): how to look, and how
            // big. The sort and the filters stay in the bar above — a setting
            // that lives in two places is a setting one has to look for.
            if !root.chrome-hidden: HorizontalLayout {
                height: 26px;
                spacing: 8px;
                padding-top: 4px;

                ViewModeChips {
                    loupe: false;
                    loupe-available: GridState.selected >= 0;
                    show-grid => { }
                    show-loupe => {
                        GridState.loupe-mode = true;
                        GridState.loupe-mode-changed();
                    }
                }
                AdvanceChip { }
                Rectangle {
                    horizontal-stretch: 1;
                }
                Text {
                    text: @tr("Thumbnails");
                    color: #7a7a7a;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                MiniSlider {
                    minimum: PreferencesState.thumbnail-size-min;
                    maximum: PreferencesState.thumbnail-size-max;
                    value: root.cell-size / 1px;
                    edited(v) => {
                        PreferencesState.remember-thumbnail-size(v);
                    }
                }
            }
        }

        if !root.detail-hidden: Rectangle {
            width: 300px;
            background: #212121;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                alignment: start;

                Rectangle {
                    height: 28px;
                }

                Text {
                    text: GridState.selected < 0 ? @tr("No photo selected") : DetailState.detail-filename;
                    color: #f0f0f0;
                    font-size: 15px;
                    font-weight: 600;
                    overflow: elide;
                }
                if GridState.selected >= 0: VerticalLayout {
                    spacing: 6px;
                    DetailRow {
                        label: @tr("Path");
                        value: DetailState.detail-path;
                    }
                    DetailRow {
                        label: @tr("Captured");
                        value: DetailState.detail-capture;
                    }
                    DetailRow {
                        label: @tr("Size");
                        value: DetailState.detail-dimensions;
                    }
                    DetailRow {
                        label: @tr("File");
                        value: DetailState.detail-file-size;
                    }
                    DetailRow {
                        label: @tr("Camera");
                        value: DetailState.detail-camera;
                    }
                    DetailRow {
                        label: @tr("Lens");
                        value: DetailState.detail-lens;
                    }
                    DetailRow {
                        label: @tr("Exposure");
                        value: DetailState.detail-exposure;
                    }
                    if DetailState.detail-companion != "": DetailRow {
                        label: @tr("Companion file");
                        value: DetailState.detail-companion;
                    }

                    // What someone writes about the photograph (ADR 0099).
                    // Editable, unlike every row above: those report what
                    // the file says, these are the photographer's own.
                    // Committed on Enter, like the keyword field — a field
                    // saving on every keystroke would write a revision per
                    // letter.
                    Text {
                        text: @tr("Description");
                        color: #9a9a9a;
                        font-size: 11px;
                        font-weight: 600;
                    }
                    for field in [
                        { key: "title", label: @tr("Title"), value: DetailState.written-title, hint: "" },
                        { key: "caption", label: @tr("Caption"), value: DetailState.written-caption, hint: "" },
                        // Only these two have a file equivalent worth
                        // showing (ADR 0147 §1): no EXIF tag means what a
                        // title or a caption means.
                        { key: "creator", label: @tr("Creator"), value: DetailState.written-creator,
                          hint: DetailState.file-creator-hint },
                        { key: "copyright", label: @tr("Copyright"), value: DetailState.written-copyright,
                          hint: DetailState.file-copyright-hint },
                    ]: HorizontalLayout {
                        // 72px and 8px, which is what `DetailRow` uses for
                        // every row above: these four were 90px and 6px, so
                        // the labels of one block did not line up with the
                        // labels of the other, and the field was 20px
                        // narrower than it could be (ADR 0147 §1 needs the
                        // room for its hint).
                        spacing: 8px;
                        Text {
                            width: 72px;
                            text: field.label;
                            color: #9a9a9a;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            height: 24px;
                            horizontal-stretch: 1;
                            background: #1b1b1b;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: written-input.has-focus ? #6fa8dc : #333333;
                            // What the file says, while nobody has written
                            // anything (ADR 0147 §1). A hint and never a
                            // value: nothing is stored, and it is what the
                            // export would write on its own. Declared
                            // before the input so the input paints over it,
                            // and it carries no `TouchArea` — a click goes
                            // through to the field underneath.
                            if field.hint != "" && written-input.text == "": Text {
                                x: 8px;
                                width: parent.width - 16px;
                                height: 100%;
                                text: field.hint;
                                color: #6a6a6a;
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            written-input := TextInput {
                                x: 8px;
                                width: parent.width - 16px;
                                height: 100%;
                                text: field.value;
                                color: #e0e0e0;
                                font-size: 12px;
                                vertical-alignment: center;
                                single-line: true;
                                accepted => {
                                    DetailState.write-description(field.key, self.text);
                                    root.return-focus();
                                }
                            }
                        }
                    }

                    Text {
                        text: @tr("Keywords");
                        color: #9a9a9a;
                        font-size: 11px;
                    }
                    for kw[i] in DetailState.detail-keywords: HorizontalLayout {
                        spacing: 6px;
                        TouchArea {
                            horizontal-stretch: 1;
                            Text {
                                text: kw;
                                color: FilterState.filter-keyword-label == kw ? #6fa8dc : #e6e6e6;
                                font-size: 12px;
                                overflow: elide;
                                width: 100%;
                                height: 100%;
                                vertical-alignment: center;
                            }
                            clicked => {
                                FilterState.keyword-filter(i);
                            }
                        }
                        TouchArea {
                            width: 16px;
                            height: 16px;
                            Text {
                                text: "×";
                                color: #9a9a9a;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                            clicked => {
                                DetailState.remove-keyword(i);
                            }
                        }
                    }
                    Rectangle {
                        height: 24px;
                        background: #1b1b1b;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: keyword-input.text == "" ? #333333 : #6fa8dc;
                        keyword-input := TextInput {
                            x: 8px;
                            width: parent.width - 16px;
                            height: 100%;
                            color: #e6e6e6;
                            font-size: 12px;
                            vertical-alignment: center;
                            single-line: true;
                            // What exists, before something new is made
                            // (ADR 0134 §3). Rust matches on **any level**,
                            // so `her` finds `Nature/Birds/Heron` without
                            // typing the branch.
                            edited => {
                                DetailState.suggest-keywords(self.text);
                            }
                            accepted => {
                                DetailState.add-keyword(self.text);
                                self.text = "";
                                DetailState.suggest-keywords("");
                                root.return-focus();
                            }
                        }
                        if keyword-input.text == "" && !keyword-input.has-focus: Text {
                            x: 8px;
                            height: 100%;
                            text: @tr("Add keyword (Nature/Birds)…");
                            color: #666666;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                    // The suggestions, under the field and only while there
                    // are any: clicking one tags with the path it names,
                    // which is also how a misspelling gets corrected — the
                    // wrong spelling has nothing behind it and the right one
                    // is one click away (ADR 0134 §3).
                    if DetailState.keyword-suggestions.length > 0: VerticalLayout {
                        spacing: 1px;
                        for path[s] in DetailState.keyword-suggestions: Rectangle {
                            height: 20px;
                            background: suggestion-touch.has-hover ? #2f4f6f : #1b1b1b;
                            border-radius: 3px;
                            Text {
                                x: 8px;
                                width: parent.width - 16px;
                                height: 100%;
                                text: path;
                                color: #d0d0d0;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            suggestion-touch := TouchArea {
                                clicked => {
                                    DetailState.add-keyword(path);
                                    keyword-input.text = "";
                                    DetailState.suggest-keywords("");
                                }
                            }
                        }
                    }
                }
            }
        }
}
