// The develop view (`docs/pipeline.md`): the rendered photo, the tool strip
// over it, the filmstrip under it, and the adjustment panel beside it
// (ADR 0045 §3).
//
// Inherits `HorizontalLayout` and sets no geometry of its own so the element
// tree keeps exactly the shape it had inline — see the comment above
// `menu-row` in `studio.slint` for why any position or size override around
// this content is a repaint hazard.

import { DevSettings, MaskRow } from "../types.slint";
import { DevelopState } from "../state/develop.slint";
import { PresetsPanel } from "presets.slint";
import { GridState } from "../state/grid.slint";
import { MaskState } from "../state/mask.slint";
import { EditSlider, Filmstrip, FilterChip, GroupHeader, SubHeading } from "../widgets/controls.slint";

export component DevelopPanel inherits HorizontalLayout {
    // Panel folding, owned by the window (ADR 0055 §6): the settings panel
    // first, then the toolbar, the shortcut line and the filmstrip.
    in property <bool> side-panels-hidden;
    in property <bool> chrome-hidden;
    // Panel-private state (ADR 0045 §2): none of it crosses to Rust.
    //
    // Accordion state — basic adjustments start open, the rest start
    // collapsed so a photo that only needs exposure/white-balance doesn't
    // force scrolling past groups that weren't touched.
    // Progressive disclosure (ADR 0054 §2): Basic shows what has an obvious
    // equivalent in any photo tool, Full shows the fifteen groups and the six
    // tools. Panel-private, like every other bit of interface state here: Rust
    // never reads it, and it deliberately survives nothing — not a file, not a
    // preset, not a session (§3).
    property <bool> basic-mode: true;
    // White balance, tone and presence are one foldable group now, read as a
    // single sequence (ADR 0054 §2), so they share one flag.
    property <bool> expand-basic: true;
    property <bool> expand-camera-profile: false;
    property <bool> expand-lut: false;
    property <bool> expand-lens: false;
    property <bool> expand-detail: false;
    property <bool> expand-effects: false;
    property <bool> expand-tone-curve: false;
    property <bool> expand-hsl: false;
    property <bool> expand-color-grading: false;
    property <bool> expand-spot-removal: false;
    property <bool> expand-local: false;
    property <bool> expand-proof: false;
    property <bool> expand-geometry: false;
    property <bool> expand-history: false;
    // Fixed band order (ADR 0031), parallel to `DevSettings::hsl`.
    property <[string]> hsl-band-names: [
        @tr("Red"), @tr("Orange"), @tr("Yellow"), @tr("Green"),
        @tr("Aqua"), @tr("Blue"), @tr("Purple"), @tr("Magenta"),
    ];

    // Which drag tool the develop image responds to: "select" (default,
    // dragging does nothing), "crop" (dragging draws the crop rectangle),
    // "spot" (two clicks place a spot-removal clone, ADR 0032), or one of
    // the three local-adjustment tools — "radial"/"gradient" (one drag
    // traces the geometry) and "brush" (each click adds a dab), ADR 0049 §1.
    // `in-out` because the window's keyboard shortcuts switch tools too.
    in-out property <string> active-tool: "select";
    // Loupe zoom: fit-to-window (false) or 100%-with-pan (true). Only
    // meaningful for the Select tool — Crop/Spot's coordinate mapping
    // assumes the fit-to-window letterbox, so switching tools drops back to
    // fit rather than making every drag tool zoom-aware. `in-out` for the
    // same reason as `active-tool`.
    in-out property <bool> dev-zoomed: false;

    // Every entry of the profile browser costs a render, so the grid is
    // built when the group is opened and not before (ADR 0089 §1). A
    // `changed` handler rather than a callback on `GroupHeader`: the flag is
    // this panel's own, and giving the shared widget an event for one of its
    // fifteen users would be the wrong place to put it.
    changed expand-camera-profile => {
        if (self.expand-camera-profile) {
            DevelopState.load-profiles();
        }
    }
    // Spot tool's two-click gesture: true between the first (source) click
    // and the second (target) one, with the first click's viewport position
    // held here so a pending-source marker can be drawn.
    property <bool> spot-pending: false;
    property <float> spot-pending-vx: 0;
    property <float> spot-pending-vy: 0;

    // An ellipse centered on `cx`/`cy` with radii `rx`/`ry`, as `Path`
    // commands in whatever unit those four arrive in (ADR 0049 §5).
    //
    // Four cubic segments rather than two `A` arcs: Slint's path parser
    // accepts arc commands and then draws nothing for them. 0.5523 is the
    // usual control-point ratio that makes a cubic quarter indistinguishable
    // from a quarter ellipse.
    pure function ellipse-path(cx: float, cy: float, rx: float, ry: float) -> string {
        return "M\{cx - rx} \{cy}"
            + " C\{cx - rx} \{cy - 0.5523 * ry} \{cx - 0.5523 * rx} \{cy - ry} \{cx} \{cy - ry}"
            + " C\{cx + 0.5523 * rx} \{cy - ry} \{cx + rx} \{cy - 0.5523 * ry} \{cx + rx} \{cy}"
            + " C\{cx + rx} \{cy + 0.5523 * ry} \{cx + 0.5523 * rx} \{cy + ry} \{cx} \{cy + ry}"
            + " C\{cx - 0.5523 * rx} \{cy + ry} \{cx - rx} \{cy + 0.5523 * ry} \{cx - rx} \{cy} Z";
    }

    // A new photo's image just loaded (entered develop, or navigated): loupe
    // zoom is per-photo UI state, so it resets like Compare Before/After
    // does (in Rust, for `dev-compare`). `changed` only ever attaches to a
    // property of the element declaring it, never to a global's, hence this
    // local mirror.
    property <image> loaded-develop-image: DevelopState.develop-image;
    changed loaded-develop-image => {
        root.dev-zoomed = false;
    }

        visible: DevelopState.develop-mode;

        // The library of modifications, on the left (ADR 0058 §1) — folded
        // by the same manual `Tab` as the settings panel opposite, and by
        // nothing else: on a narrow window Develop keeps both panels,
        // because there the panels *are* the module.
        if !root.side-panels-hidden: PresetsPanel { }

        VerticalLayout {
            horizontal-stretch: 1;
            // `horizontal-stretch` asks for the slack; it cannot take more
            // than this column's *maximum*, and the rows below carry a
            // bounded one. The whole develop view therefore sat at 610px of
            // viewer beside 300px of settings, the rest of the window dark,
            // identically at 1280 and at 1900.
            //
            // Attributed by measurement rather than by reading, after two
            // wrong guesses. A probe reported `root=2400 col=610`: the panel
            // already filled the window, so the cap was inside this column.
            // Cutting the shortcut line below to a single character dropped
            // it to `col=191` — the exact width of the `Select/Crop/100%/Z`
            // chip row, the next bounded thing. So it is the **un-wrapped
            // text and the fixed-width chips** that bound this column, each
            // at its natural width, and the widest of them wins.
            //
            // It is *not* the preview image, which was the tempting
            // explanation and is wrong: the loupe mounts the same
            // `width: 100%` shape and fills a 2400px window while showing a
            // 400x300 photo scaled up. Anyone adding a row here should know
            // that a line of text is what silently sets this view's width.
            //
            // Declaring no maximum is the only way out in Slint 1.13, the
            // same idiom and the same reason as `StudioWindow`.
            max-width: 100000px;
            padding: 12px;
            spacing: 8px;

            Rectangle {
                height: 28px;
            }

            if !root.chrome-hidden: HorizontalLayout {
                Text {
                    text: DevelopState.develop-filename;
                    color: #f0f0f0;
                    font-size: 14px;
                    font-weight: 600;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    // A hint line, and a hint is what yields when room runs
                    // short. Without these two lines it did the opposite: a
                    // `Text` reports its natural width as its column's
                    // *minimum* even when it would elide, and this is the
                    // longest string in the module — markedly so in French.
                    // The column above documents that un-wrapped text sets
                    // this view's width; that cuts both ways, and here it
                    // was setting the minimum, which demanded ~1200px and
                    // pushed the settings panel — the module itself — off
                    // the right of the window.
                    min-width: 0px;
                    overflow: elide;
                    text: @tr("← →: next/prev photo · G: library · Ctrl+Z/Y: undo/redo · S: save preset · R: reprocess · Ctrl+P: print");
                    color: #666666;
                    font-size: 12px;
                }
            }

            if !root.chrome-hidden: HorizontalLayout {
                spacing: 6px;
                FilterChip {
                    text: @tr("Select");
                    active: root.active-tool == "select";
                    clicked => {
                        root.active-tool = "select";
                        root.spot-pending = false;
                    }
                }
                FilterChip {
                    text: @tr("Crop");
                    active: root.active-tool == "crop";
                    clicked => {
                        root.active-tool = "crop";
                        root.spot-pending = false;
                        root.dev-zoomed = false;
                    }
                }
                FilterChip {
                    // The white-balance picker (ADR 0091): W, like the
                    // sliders it drives, lives in Basic.
                    text: @tr("WB Picker");
                    active: root.active-tool == "wb";
                    clicked => {
                        root.active-tool = "wb";
                        root.spot-pending = false;
                        root.dev-zoomed = false;
                    }
                }
                if !root.basic-mode: FilterChip {
                    text: @tr("Spot Removal");
                    active: root.active-tool == "spot";
                    clicked => {
                        root.active-tool = "spot";
                        root.dev-zoomed = false;
                    }
                }
                // The three local-adjustment tools (ADR 0049 §1). Like Crop
                // and Spot Removal they assume the fit-to-window letterbox,
                // so picking one drops the loupe back to fit; each also opens
                // the panel section that shows what the gesture just wrote.
                // Full mode only (ADR 0054 §2).
                if !root.basic-mode: FilterChip {
                    text: @tr("Radial");
                    active: root.active-tool == "radial";
                    clicked => {
                        root.active-tool = "radial";
                        root.spot-pending = false;
                        root.dev-zoomed = false;
                        root.expand-local = true;
                    }
                }
                if !root.basic-mode: FilterChip {
                    text: @tr("Gradient");
                    active: root.active-tool == "gradient";
                    clicked => {
                        root.active-tool = "gradient";
                        root.spot-pending = false;
                        root.dev-zoomed = false;
                        root.expand-local = true;
                    }
                }
                if !root.basic-mode: FilterChip {
                    text: @tr("Brush");
                    active: root.active-tool == "brush";
                    clicked => {
                        root.active-tool = "brush";
                        root.spot-pending = false;
                        root.dev-zoomed = false;
                        root.expand-local = true;
                    }
                }
                FilterChip {
                    // Loupe zoom (Z): 100%-with-pan vs fit-to-window,
                    // Select tool only (see `dev-zoomed`'s declaration).
                    text: root.dev-zoomed ? @tr("Fit") : @tr("100%    Z");
                    active: root.dev-zoomed;
                    enabled: root.active-tool == "select";
                    clicked => {
                        root.dev-zoomed = !root.dev-zoomed;
                    }
                }
            }

            preview := Rectangle {
                vertical-stretch: 1;
                clip: true;

                // Where the fit-to-window preview actually sits inside this
                // viewport: the same letterbox `develop::letterbox_unit`
                // inverts on the Rust side, so a mask outline drawn from
                // stored [0, 1] coordinates lands exactly where the gesture
                // that traced it was read (ADR 0049 §5).
                property <float> image-w: max(DevelopState.develop-image.width, 1);
                property <float> image-h: max(DevelopState.develop-image.height, 1);
                property <length> fit: min(self.width / self.image-w, self.height / self.image-h);
                property <length> pad-x: (self.width - self.image-w * self.fit) / 2;
                property <length> pad-y: (self.height - self.image-h * self.fit) / 2;

                if !root.dev-zoomed: Image {
                    source: DevelopState.viewer-image;
                    image-fit: contain;
                    width: 100%;
                    height: 100%;
                }

                // 100%-with-pan: the image at its native pixel size
                // inside a scrollable viewport, instead of scaled to
                // fit — for judging sharpening/noise reduction at the
                // pixel level, which fit-to-window can't show.
                if root.dev-zoomed: Flickable {
                    width: 100%;
                    height: 100%;
                    viewport-width: DevelopState.develop-image.width * 1px;
                    viewport-height: DevelopState.develop-image.height * 1px;
                    Image {
                        source: DevelopState.viewer-image;
                        width: DevelopState.develop-image.width * 1px;
                        height: DevelopState.develop-image.height * 1px;
                    }
                }

                if DevelopState.dev-compare: Rectangle {
                    x: 8px;
                    y: 8px;
                    width: label.preferred-width + 16px;
                    height: label.preferred-height + 8px;
                    background: #000000aa;
                    border-radius: 4px;
                    label := Text {
                        x: 8px;
                        y: 4px;
                        text: @tr("Before");
                        color: #f0f0f0;
                        font-size: 12px;
                    }
                }

                // Only the Crop tool drags a crop rectangle — the
                // default Select tool leaves dragging a no-op so a
                // photo can be looked at without accidentally cropping.
                crop-drag := TouchArea {
                    enabled: root.active-tool == "crop";
                    mouse-cursor: crosshair;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                            DevelopState.develop-crop-drag(
                                self.pressed-x / 1px, self.pressed-y / 1px,
                                self.mouse-x / 1px, self.mouse-y / 1px,
                                self.width / 1px, self.height / 1px,
                                DevelopState.develop-image.width, DevelopState.develop-image.height);
                        }
                    }
                }

                // Selection rectangle, live while the mouse is down.
                Rectangle {
                    visible: crop-drag.pressed;
                    x: min(crop-drag.pressed-x, crop-drag.mouse-x);
                    y: min(crop-drag.pressed-y, crop-drag.mouse-y);
                    width: abs((crop-drag.pressed-x - crop-drag.mouse-x) / 1px) * 1px;
                    height: abs((crop-drag.pressed-y - crop-drag.mouse-y) / 1px) * 1px;
                    background: #ffffff22;
                    border-width: 1px;
                    border-color: #f0f0f0;
                }

                // Spot removal (ADR 0032): two clicks place one spot —
                // the first sets the source pin (shown as a marker
                // until the second click), the second sets the target
                // and commits the clone in one `develop-spot-click`
                // call, mirroring `develop-crop-drag`'s single-call
                // shape.
                spot-click := TouchArea {
                    enabled: root.active-tool == "spot";
                    mouse-cursor: crosshair;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                            if (!root.spot-pending) {
                                root.spot-pending = true;
                                root.spot-pending-vx = self.mouse-x / 1px;
                                root.spot-pending-vy = self.mouse-y / 1px;
                            } else {
                                DevelopState.develop-spot-click(
                                    root.spot-pending-vx, root.spot-pending-vy,
                                    self.mouse-x / 1px, self.mouse-y / 1px,
                                    self.width / 1px, self.height / 1px,
                                    DevelopState.develop-image.width, DevelopState.develop-image.height);
                                root.spot-pending = false;
                            }
                        }
                    }
                }

                // White-balance picker (ADR 0091): one click on a neutral
                // grey resolves temperature and tint, then the tool hands
                // back to Select — the gesture answers one question.
                wb-click := TouchArea {
                    enabled: root.active-tool == "wb";
                    mouse-cursor: crosshair;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                            DevelopState.develop-wb-click(
                                self.mouse-x / 1px, self.mouse-y / 1px,
                                self.width / 1px, self.height / 1px,
                                DevelopState.develop-image.width, DevelopState.develop-image.height);
                            root.active-tool = "select";
                        }
                    }
                }

                // Pending source pin, shown between the two spot clicks.
                Rectangle {
                    visible: root.spot-pending;
                    x: root.spot-pending-vx * 1px - 5px;
                    y: root.spot-pending-vy * 1px - 5px;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: #ffcc0055;
                    border-width: 1px;
                    border-color: #ffcc00;
                }

                // Radial and gradient: one drag traces the geometry
                // (ADR 0049 §1), onto the selected row when it is of the
                // same kind and as a new entry otherwise — the decision is
                // Rust's, in `masks::place_geometry`.
                mask-drag := TouchArea {
                    enabled: root.active-tool == "radial" || root.active-tool == "gradient";
                    mouse-cursor: crosshair;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                            MaskState.place-mask(
                                MaskState.selected-mask, root.active-tool,
                                self.pressed-x / 1px, self.pressed-y / 1px,
                                self.mouse-x / 1px, self.mouse-y / 1px,
                                self.width / 1px, self.height / 1px,
                                DevelopState.develop-image.width, DevelopState.develop-image.height);
                        }
                    }
                }

                // Live feedback while tracing: the ellipse that will be
                // inscribed in the dragged rectangle, or the gradient's axis.
                //
                // Both are one `Path` spanning the whole viewport with a
                // viewbox in viewport pixels, so its coordinates *are* the
                // viewport's own — a `Path` scales its viewbox uniformly and
                // centers it, so a stretched square viewbox would draw a
                // circle where an ellipse belongs.
                if mask-drag.pressed && root.active-tool == "radial": Path {
                    width: 100%;
                    height: 100%;
                    viewbox-width: self.width / 1px;
                    viewbox-height: self.height / 1px;
                    commands: ellipse-path(
                        (mask-drag.pressed-x + mask-drag.mouse-x) / 2 / 1px,
                        (mask-drag.pressed-y + mask-drag.mouse-y) / 2 / 1px,
                        abs((mask-drag.pressed-x - mask-drag.mouse-x) / 1px) / 2,
                        abs((mask-drag.pressed-y - mask-drag.mouse-y) / 1px) / 2);
                    stroke: #ffcc00;
                    stroke-width: 1px;
                }
                if mask-drag.pressed && root.active-tool == "gradient": Path {
                    width: 100%;
                    height: 100%;
                    viewbox-width: self.width / 1px;
                    viewbox-height: self.height / 1px;
                    commands: "M\{mask-drag.pressed-x / 1px} \{mask-drag.pressed-y / 1px} L\{mask-drag.mouse-x / 1px} \{mask-drag.mouse-y / 1px}";
                    stroke: #ffcc00;
                    stroke-width: 1px;
                }

                // Brush: one dab per click, appended to the selected brush or
                // starting a new one (ADR 0049 §2).
                brush-click := TouchArea {
                    enabled: root.active-tool == "brush";
                    mouse-cursor: crosshair;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                            MaskState.paint-mask-dab(
                                MaskState.selected-mask,
                                self.mouse-x / 1px, self.mouse-y / 1px,
                                self.width / 1px, self.height / 1px,
                                DevelopState.develop-image.width, DevelopState.develop-image.height);
                        }
                    }
                }

                // The selected mask's outline (ADR 0049 §5): the geometry
                // itself, never the resulting coverage — that would include
                // the range term, hence the pixels, hence a render the engine
                // does not expose. Drawn from the stored [0, 1] coordinates
                // through the letterbox above.
                //
                // A radial's `angle` is not reflected: the tools only ever
                // write 0 (a two-corner drag has no rotation to report), and
                // an ellipse written at an angle through the CLI or the SDK
                // shows its unrotated outline.
                if MaskState.selected-mask >= 0 && MaskState.selected-mask < MaskState.masks.length: outline := Rectangle {
                    property <MaskRow> shape: MaskState.masks[MaskState.selected-mask];
                    // Where the image sits, so children can work in image
                    // fractions without repeating the letterbox.
                    x: preview.pad-x;
                    y: preview.pad-y;
                    width: preview.image-w * preview.fit;
                    height: preview.image-h * preview.fit;

                    // The image area in its own pixels, the unit both paths
                    // below work in (see the live feedback's comment for why
                    // the viewbox has to match the element's aspect ratio).
                    property <float> w: self.width / 1px;
                    property <float> h: self.height / 1px;

                    if outline.shape.kind == "radial": Path {
                        width: 100%;
                        height: 100%;
                        viewbox-width: outline.w;
                        viewbox-height: outline.h;
                        commands: ellipse-path(
                            outline.shape.cx * outline.w, outline.shape.cy * outline.h,
                            outline.shape.rx * outline.w, outline.shape.ry * outline.h);
                        stroke: #ffcc00;
                        stroke-width: 1px;
                    }
                    if outline.shape.kind == "gradient": Path {
                        width: 100%;
                        height: 100%;
                        viewbox-width: outline.w;
                        viewbox-height: outline.h;
                        commands: "M\{outline.shape.x0 * outline.w} \{outline.shape.y0 * outline.h} L\{outline.shape.x1 * outline.w} \{outline.shape.y1 * outline.h}";
                        stroke: #ffcc00;
                        stroke-width: 1px;
                    }
                    // The full-coverage end of the gradient, so which way it
                    // runs is visible rather than guessed.
                    if outline.shape.kind == "gradient": Rectangle {
                        x: outline.shape.x0 * parent.width - 4px;
                        y: outline.shape.y0 * parent.height - 4px;
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: #ffcc00;
                    }
                    // Dab radii are normalized against the larger dimension,
                    // so a dab is a circle on screen and not an ellipse.
                    if outline.shape.kind == "brush": Rectangle {
                        for dab in outline.shape.dabs: Rectangle {
                            x: dab.x * parent.width - dab.radius * max(parent.width, parent.height);
                            y: dab.y * parent.height - dab.radius * max(parent.width, parent.height);
                            width: 2 * dab.radius * max(parent.width, parent.height);
                            height: self.width;
                            border-radius: self.width / 2;
                            border-width: 1px;
                            border-color: #ffcc0088;
                        }
                    }
                }

                // Right-click (ADR 0021): every entry is an existing
                // callback already wired to a keyboard shortcut or a
                // panel control above.
                ContextMenuArea {
                    Menu {
                        MenuItem {
                            title: @tr("Reset Crop");
                            activated => {
                                DevelopState.develop-edit("crop-reset", 0);
                            }
                        }
                        MenuItem {
                            title: @tr("Undo Last Spot");
                            enabled: DevelopState.dev-spot-count > 0;
                            activated => {
                                DevelopState.develop-spot-undo();
                            }
                        }
                        MenuItem {
                            title: @tr("Clear All Spots");
                            enabled: DevelopState.dev-spot-count > 0;
                            activated => {
                                DevelopState.develop-spot-reset();
                            }
                        }
                        MenuItem {
                            title: DevelopState.dev-compare ? @tr("Show After    \\") : @tr("Compare Before/After    \\");
                            activated => {
                                DevelopState.toggle-compare();
                            }
                        }
                        MenuSeparator { }
                        MenuItem {
                            title: @tr("Reprocess    R");
                            activated => {
                                DevelopState.develop-reprocess();
                            }
                        }
                        MenuSeparator { }
                        MenuItem {
                            title: @tr("Back to Library    G");
                            activated => {
                                DevelopState.exit-develop();
                            }
                        }
                    }
                }
            }

            // Filmstrip: the loaded grid window's thumbnails, so switching
            // photos doesn't require leaving develop mode. Reuses
            // `GridState.cells` (already populated for the grid) — no
            // separate data path — through the same widget the loupe mounts
            // (ADR 0055 §5).
            if !root.chrome-hidden: Filmstrip {
                cells: GridState.cells;
                window-start: GridState.window-start;
                selected: GridState.selected;
                clicked(index) => {
                    DevelopState.develop-switch(index);
                }
            }
        }

        if !root.side-panels-hidden: Rectangle {
            width: 300px;
            background: #212121;

            Flickable {
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    alignment: start;

                    Rectangle {
                        height: 28px;
                    }

                    // Histogram (RGB, sqrt-scaled so one dominant bin
                    // doesn't flatten the rest, `develop::histogram_layout`):
                    // read-only, refreshed whenever the develop preview
                    // itself refreshes (i.e. at each commit point, the
                    // same cadence the image updates at).
                    Rectangle {
                        height: 90px;
                        background: #1a1a1a;
                        border-radius: 4px;
                        Path {
                            width: 100%;
                            height: 100%;
                            viewbox-width: 256;
                            viewbox-height: 90;
                            fill: #ff444455;
                            commands: DevelopState.dev-histogram-r;
                        }
                        Path {
                            width: 100%;
                            height: 100%;
                            viewbox-width: 256;
                            viewbox-height: 90;
                            fill: #44ff4455;
                            commands: DevelopState.dev-histogram-g;
                        }
                        Path {
                            width: 100%;
                            height: 100%;
                            viewbox-width: 256;
                            viewbox-height: 90;
                            fill: #4444ff55;
                            commands: DevelopState.dev-histogram-b;
                        }

                        // The two clipping indicators (ADR 0092): lit when
                        // their end of the histogram is occupied, filled
                        // while their overlay paints the image. Squares
                        // rather than glyph triangles — the software
                        // renderer's fallback font drops most triangle
                        // glyphs (a lesson already paid for by the star
                        // ratings).
                        shadows-clip := Rectangle {
                            x: 4px;
                            y: 4px;
                            width: 10px;
                            height: 10px;
                            border-radius: 2px;
                            border-width: 1px;
                            border-color: DevelopState.dev-shadows-clipped ? #6fa8dc : #444444;
                            background: DevelopState.dev-clip-shadows
                                ? #0a84ff
                                : (DevelopState.dev-shadows-clipped ? #0a84ff40 : transparent);
                            TouchArea {
                                clicked => {
                                    DevelopState.toggle-clipping("shadows");
                                }
                            }
                        }
                        highlights-clip := Rectangle {
                            x: parent.width - 14px;
                            y: 4px;
                            width: 10px;
                            height: 10px;
                            border-radius: 2px;
                            border-width: 1px;
                            border-color: DevelopState.dev-highlights-clipped ? #e08080 : #444444;
                            background: DevelopState.dev-clip-highlights
                                ? #ff3b30
                                : (DevelopState.dev-highlights-clipped ? #ff3b3040 : transparent);
                            TouchArea {
                                clicked => {
                                    DevelopState.toggle-clipping("highlights");
                                }
                            }
                        }
                    }

                    // How the photo was taken, right under the histogram that
                    // shows what came of it: sensitivity, focal length,
                    // aperture, time. Read-only, and never a placeholder — a
                    // file that recorded none of it shows nothing rather than
                    // a row of dashes. The full metadata stays one keystroke
                    // away in the library panel; this is the part one checks
                    // *while* correcting an exposure.
                    if DevelopState.dev-iso != "" || DevelopState.dev-focal != ""
                        || DevelopState.dev-aperture != "" || DevelopState.dev-shutter != "":
                    HorizontalLayout {
                        alignment: space-between;
                        padding-left: 4px;
                        padding-right: 4px;
                        padding-bottom: 2px;
                        Text {
                            text: DevelopState.dev-iso;
                            color: #7a7a7a;
                            font-size: 11px;
                        }
                        Text {
                            text: DevelopState.dev-focal;
                            color: #7a7a7a;
                            font-size: 11px;
                        }
                        Text {
                            text: DevelopState.dev-aperture;
                            color: #7a7a7a;
                            font-size: 11px;
                        }
                        Text {
                            text: DevelopState.dev-shutter;
                            color: #7a7a7a;
                            font-size: 11px;
                        }
                    }

                    // Leaving Full mode drops any tool it alone showed, so a
                    // click on the image cannot keep tracing a mask whose
                    // panel is no longer visible (ADR 0054, Conséquences).
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        FilterChip {
                            text: @tr("Basic");
                            active: root.basic-mode;
                            clicked => {
                                root.basic-mode = true;
                                if (root.active-tool != "select" && root.active-tool != "crop") {
                                    root.active-tool = "select";
                                    root.spot-pending = false;
                                }
                            }
                        }
                        FilterChip {
                            text: @tr("Full");
                            active: !root.basic-mode;
                            clicked => {
                                root.basic-mode = false;
                            }
                        }
                    }

                    // The two buttons Lightroom puts above the Basic
                    // sliders (ADR 0088). `HDR`, its third, is a V1
                    // exclusion and is deliberately absent rather than
                    // present and disabled.
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        FilterChip {
                            text: @tr("Auto");
                            active: false;
                            clicked => {
                                DevelopState.run-auto-tone();
                            }
                        }
                        FilterChip {
                            text: @tr("B&W");
                            active: DevelopState.dev.monochrome;
                            clicked => {
                                DevelopState.develop-edit("monochrome", DevelopState.dev.monochrome ? 0 : 1);
                            }
                        }
                    }

                    // One panel, three sub-headings: the light first, the
                    // matter next, the colour last — the order the Basic panel
                    // is taught in, and the reason it is one group rather than
                    // three (ADR 0054 §2).
                    GroupHeader {
                        label: @tr("Basic");
                        expanded <=> root.expand-basic;
                    }
                    if root.expand-basic: VerticalLayout {
                        spacing: 6px;
                        // The fixed white balances (ADR 0091 §4), momentary
                        // like Auto: each writes both sliders in one
                        // revision. "As Shot" clears the override — the
                        // true neutral of the model; "Auto WB" measures.
                        HorizontalLayout {
                            spacing: 4px;
                            FilterChip {
                                text: @tr("As Shot");
                                clicked => {
                                    DevelopState.apply-wb-preset("as-shot");
                                }
                            }
                            FilterChip {
                                text: @tr("Auto WB");
                                clicked => {
                                    DevelopState.run-auto-wb();
                                }
                            }
                            FilterChip {
                                text: @tr("Daylight");
                                clicked => {
                                    DevelopState.apply-wb-preset("daylight");
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            FilterChip {
                                text: @tr("Cloudy");
                                clicked => {
                                    DevelopState.apply-wb-preset("cloudy");
                                }
                            }
                            FilterChip {
                                text: @tr("Shade");
                                clicked => {
                                    DevelopState.apply-wb-preset("shade");
                                }
                            }
                            FilterChip {
                                text: @tr("Tungsten");
                                clicked => {
                                    DevelopState.apply-wb-preset("tungsten");
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            FilterChip {
                                text: @tr("Fluorescent");
                                clicked => {
                                    DevelopState.apply-wb-preset("fluorescent");
                                }
                            }
                            FilterChip {
                                text: @tr("Flash");
                                clicked => {
                                    DevelopState.apply-wb-preset("flash");
                                }
                            }
                        }
                        EditSlider {
                            label: @tr("Temperature");
                            minimum: 2000;
                            maximum: 12000;
                            // Not zero: the neutral of a temperature is the
                            // daylight it is measured against (`Settings`
                            // default, 6500 K).
                            neutral: 6500;
                            track-from: #4a6fd0;
                            track-to: #d8b45a;
                            value: DevelopState.dev.wb-temp;
                            edited(v) => {
                                DevelopState.develop-edit("wb-temp", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("wb-temp", v);
                            }
                        }
                        EditSlider {
                            label: @tr("Tint");
                            minimum: -100;
                            maximum: 100;
                            track-from: #4fae54;
                            track-to: #b756c4;
                            value: DevelopState.dev.wb-tint;
                            edited(v) => {
                                DevelopState.develop-edit("wb-tint", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("wb-tint", v);
                            }
                        }

                        SubHeading {
                            label: @tr("Tone");
                        }
                        EditSlider {
                            label: @tr("Exposure");
                            minimum: -5;
                            maximum: 5;
                            decimals: 2;
                            value: DevelopState.dev.exposure;
                            edited(v) => {
                                DevelopState.develop-edit("exposure", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("exposure", v);
                            }
                        }
                        EditSlider {
                            label: @tr("Contrast");
                            minimum: -100;
                            maximum: 100;
                            value: DevelopState.dev.contrast;
                            edited(v) => {
                                DevelopState.develop-edit("contrast", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("contrast", v);
                            }
                        }
                        EditSlider {
                            label: @tr("Highlights");
                            minimum: -100;
                            maximum: 100;
                            value: DevelopState.dev.highlights;
                            edited(v) => {
                                DevelopState.develop-edit("highlights", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("highlights", v);
                            }
                        }
                        EditSlider {
                            label: @tr("Shadows");
                            minimum: -100;
                            maximum: 100;
                            value: DevelopState.dev.shadows;
                            edited(v) => {
                                DevelopState.develop-edit("shadows", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("shadows", v);
                            }
                        }
                        EditSlider {
                            label: @tr("Whites");
                            minimum: -100;
                            maximum: 100;
                            value: DevelopState.dev.whites;
                            edited(v) => {
                                DevelopState.develop-edit("whites", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("whites", v);
                            }
                        }
                        EditSlider {
                            label: @tr("Blacks");
                            minimum: -100;
                            maximum: 100;
                            value: DevelopState.dev.blacks;
                            edited(v) => {
                                DevelopState.develop-edit("blacks", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("blacks", v);
                            }
                        }

                        SubHeading {
                            label: @tr("Presence");
                        }
                        EditSlider {
                            label: @tr("Texture");
                            minimum: -100;
                            maximum: 100;
                            value: DevelopState.dev.texture;
                            edited(v) => {
                                DevelopState.develop-edit("texture", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("texture", v);
                            }
                        }
                        EditSlider {
                            label: @tr("Clarity");
                            minimum: -100;
                            maximum: 100;
                            value: DevelopState.dev.clarity;
                            edited(v) => {
                                DevelopState.develop-edit("clarity", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("clarity", v);
                            }
                        }
                        EditSlider {
                            label: @tr("Dehaze");
                            minimum: -100;
                            maximum: 100;
                            value: DevelopState.dev.dehaze;
                            edited(v) => {
                                DevelopState.develop-edit("dehaze", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("dehaze", v);
                            }
                        }
                        // What the *decoder* does with a channel that
                        // saturated at the sensor (ADR 0050), as opposed to
                        // the roll-off below, which decides what becomes of
                        // the headroom on the way out. Full mode only: it
                        // supposes knowing what a clipped channel is
                        // (ADR 0054 §2).
                        if !root.basic-mode: Text {
                            text: @tr("Clipped highlights");
                            color: #9a9a9a;
                            font-size: 12px;
                        }
                        if !root.basic-mode: HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            FilterChip {
                                text: @tr("Clip");
                                active: DevelopState.dev.highlight-reconstruction == "clip";
                                clicked => {
                                    DevelopState.develop-set-highlight-reconstruction("clip");
                                }
                            }
                            FilterChip {
                                text: @tr("Blend");
                                active: DevelopState.dev.highlight-reconstruction == "blend";
                                clicked => {
                                    DevelopState.develop-set-highlight-reconstruction("blend");
                                }
                            }
                            FilterChip {
                                text: @tr("Rebuild");
                                active: DevelopState.dev.highlight-reconstruction == "rebuild";
                                clicked => {
                                    DevelopState.develop-set-highlight-reconstruction("rebuild");
                                }
                            }
                        }
                        // Demosaic (ADR 0061), Complete mode only: the very
                        // first rendering decision, and one that supposes
                        // knowing what a Bayer sensor is (ADR 0054 §2). The
                        // caption is not decoration — the choice genuinely
                        // does nothing at these preview sizes, and a control
                        // that appears inert reads as broken.
                        if !root.basic-mode: Text {
                            text: @tr("Demosaic");
                            color: #9a9a9a;
                            font-size: 12px;
                        }
                        if !root.basic-mode: HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            FilterChip {
                                text: @tr("AHD");
                                active: DevelopState.dev.demosaic == "ahd";
                                clicked => {
                                    DevelopState.develop-set-demosaic("ahd");
                                }
                            }
                            FilterChip {
                                text: @tr("VNG");
                                active: DevelopState.dev.demosaic == "vng";
                                clicked => {
                                    DevelopState.develop-set-demosaic("vng");
                                }
                            }
                            FilterChip {
                                text: @tr("DCB");
                                active: DevelopState.dev.demosaic == "dcb";
                                clicked => {
                                    DevelopState.develop-set-demosaic("dcb");
                                }
                            }
                            FilterChip {
                                text: @tr("DHT");
                                active: DevelopState.dev.demosaic == "dht";
                                clicked => {
                                    DevelopState.develop-set-demosaic("dht");
                                }
                            }
                        }
                        if !root.basic-mode: Text {
                            text: @tr("Visible at full size and on export only — small previews skip interpolation.");
                            color: #6f6f6f;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        EditSlider {
                            label: @tr("Vibrance");
                            minimum: -100;
                            maximum: 100;
                            // Grey to colour, the direction the slider goes.
                            track-from: #6b6b6b;
                            track-to: #d05a8c;
                            value: DevelopState.dev.vibrance;
                            edited(v) => {
                                DevelopState.develop-edit("vibrance", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("vibrance", v);
                            }
                        }
                        EditSlider {
                            label: @tr("Saturation");
                            minimum: -100;
                            maximum: 100;
                            track-from: #6b6b6b;
                            track-to: #4fae54;
                            value: DevelopState.dev.saturation;
                            edited(v) => {
                                DevelopState.develop-edit("saturation", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("saturation", v);
                            }
                        }
                        // An output decision rather than a presence one, and
                        // one that supposes knowing what headroom above white
                        // is: Full mode, after the sequence rather than inside
                        // it (ADR 0054 §2).
                        if !root.basic-mode: EditSlider {
                            label: @tr("Highlight roll-off");
                            minimum: 0;
                            maximum: 100;
                            value: DevelopState.dev.highlight-rolloff;
                            edited(v) => {
                                DevelopState.develop-edit("highlight-rolloff", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("highlight-rolloff", v);
                            }
                        }
                    }

                    if !root.basic-mode: GroupHeader {
                        label: @tr("Camera profile");
                        expanded <=> root.expand-camera-profile;
                    }
                    if !root.basic-mode && root.expand-camera-profile: VerticalLayout {
                        spacing: 8px;
                        // The matrix path has not been validated against
                        // Adobe's own renders yet (`docs/pipeline.md`
                        // process 11): say so where the user chooses,
                        // not only in the ADR.
                        Text {
                            text: @tr("Experimental: colors are not yet validated against reference renders.");
                            color: #c8a45a;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        // The browser (ADR 0089 §1): each entry is the open
                        // photo as that profile renders it, not a stock
                        // swatch — what a profile does depends on the sensor
                        // that shot the file.
                        //
                        // Two per row, because a colour decision is made by
                        // comparing two renderings and a single column would
                        // put them a scroll apart.
                        Flickable {
                            height: min(260px, grid.preferred-height);
                            viewport-height: grid.preferred-height;
                            grid := VerticalLayout {
                                width: parent.width;
                                spacing: 6px;
                                for row[i] in DevelopState.profile-rows: Rectangle {
                                    height: 74px;
                                    background: row.selected ? #2f4f6f : (entry.has-hover ? #ffffff10 : transparent);
                                    border-radius: 4px;
                                    HorizontalLayout {
                                        x: 4px;
                                        width: parent.width - 8px;
                                        height: 100%;
                                        spacing: 8px;
                                        Rectangle {
                                            width: 66px;
                                            background: #151515;
                                            border-radius: 3px;
                                            Image {
                                                source: row.thumbnail;
                                                image-fit: contain;
                                                width: 100%;
                                                height: 100%;
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 2px;
                                            horizontal-stretch: 1;
                                            padding-top: 8px;
                                            Text {
                                                text: row.name;
                                                color: #e6e6e6;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }
                                            // A profile that produced no
                                            // picture says so rather than
                                            // showing an unexplained black
                                            // square: it is in the list
                                            // because the file is in the
                                            // library, and refusing it is
                                            // the useful thing to be able
                                            // to do.
                                            if row.thumbnail.width == 0 && row.path != "": Text {
                                                text: @tr("Could not be read");
                                                color: #d98a8a;
                                                font-size: 10px;
                                            }
                                        }
                                    }
                                    entry := TouchArea {
                                        clicked => {
                                            DevelopState.choose-profile(i);
                                        }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            FilterChip {
                                text: @tr("Import .dcp…");
                                active: false;
                                clicked => {
                                    DevelopState.browse-camera-profile();
                                }
                            }
                            if DevelopState.camera-profile-name != "": FilterChip {
                                active: DevelopState.dev.camera-profile;
                                text: DevelopState.dev.camera-profile ? @tr("Enabled") : @tr("Disabled");
                                clicked => {
                                    DevelopState.develop-edit("camera-profile", DevelopState.dev.camera-profile ? 0 : 1);
                                }
                            }
                        }
                    }

                    if !root.basic-mode: GroupHeader {
                        label: @tr("Creative LUT");
                        expanded <=> root.expand-lut;
                    }
                    // A look chosen elsewhere and imported into the library
                    // (ADR 0053), as opposed to the color operators above,
                    // which are Leyline's own.
                    if !root.basic-mode && root.expand-lut: VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: DevelopState.lut-name == ""
                                ? @tr("No LUT — Leyline's own color only")
                                : DevelopState.lut-name;
                            color: #9a9a9a;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            FilterChip {
                                text: @tr("Choose .cube…");
                                active: false;
                                clicked => {
                                    DevelopState.browse-lut();
                                }
                            }
                            if DevelopState.lut-name != "": FilterChip {
                                active: DevelopState.dev.lut;
                                text: DevelopState.dev.lut ? @tr("Enabled") : @tr("Disabled");
                                clicked => {
                                    DevelopState.develop-edit("lut", DevelopState.dev.lut ? 0 : 1);
                                }
                            }
                            if DevelopState.lut-name != "": FilterChip {
                                text: @tr("Remove");
                                active: false;
                                clicked => {
                                    DevelopState.clear-lut();
                                }
                            }
                        }
                        if DevelopState.lut-name != "": EditSlider {
                            label: @tr("Strength");
                            minimum: 0;
                            maximum: 100;
                            value: DevelopState.dev.lut-strength;
                            edited(v) => {
                                DevelopState.develop-edit("lut-strength", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("lut-strength", v);
                            }
                        }
                    }

                    GroupHeader {
                        label: @tr("Lens correction");
                        expanded <=> root.expand-lens;
                    }
                    if root.expand-lens: VerticalLayout {
                        spacing: 12px;
                        FilterChip {
                            active: DevelopState.dev.lens-correction;
                            text: DevelopState.dev.lens-correction ? @tr("Enabled") : @tr("Disabled");
                            clicked => {
                                DevelopState.develop-edit("lens-correction", DevelopState.dev.lens-correction ? 0 : 1);
                            }
                        }
                    }

                    GroupHeader {
                        label: @tr("Detail");
                        expanded <=> root.expand-detail;
                    }
                    if root.expand-detail: VerticalLayout {
                        spacing: 12px;
                        EditSlider {
                            label: @tr("Luminance NR");
                            minimum: 0;
                            maximum: 100;
                            value: DevelopState.dev.nr-luminance;
                            edited(v) => {
                                DevelopState.develop-edit("nr-luminance", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("nr-luminance", v);
                            }
                        }
                        EditSlider {
                            label: @tr("Color NR");
                            minimum: 0;
                            maximum: 100;
                            value: DevelopState.dev.nr-color;
                            edited(v) => {
                                DevelopState.develop-edit("nr-color", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("nr-color", v);
                            }
                        }
                        EditSlider {
                            label: @tr("Sharpen amount");
                            minimum: 0;
                            maximum: 100;
                            value: DevelopState.dev.sharpen-amount;
                            edited(v) => {
                                DevelopState.develop-edit("sharpen-amount", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("sharpen-amount", v);
                            }
                        }
                        EditSlider {
                            label: @tr("Sharpen radius");
                            minimum: 0.5;
                            maximum: 3;
                            decimals: 1;
                            value: DevelopState.dev.sharpen-radius;
                            edited(v) => {
                                DevelopState.develop-edit("sharpen-radius", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("sharpen-radius", v);
                            }
                        }
                    }

                    // Effects (ADR 0090): the vignette a photographer adds —
                    // not the one `Lens correction` above removes — and film
                    // grain. Advanced mode only, like the tone curve: they
                    // are finishing tools, not the first six sliders anyone
                    // reaches for (ADR 0054 §2).
                    if !root.basic-mode: GroupHeader {
                        label: @tr("Effects");
                        expanded <=> root.expand-effects;
                    }
                    if !root.basic-mode && root.expand-effects: VerticalLayout {
                        spacing: 12px;
                        // Two sub-headings rather than seven long labels:
                        // the label column truncates anything past about
                        // fifteen characters, and "Vignette roundness" was
                        // reaching the panel as "Vignette rou…".
                        SubHeading {
                            label: @tr("Vignette");
                        }
                        EditSlider {
                            label: @tr("Amount");
                            minimum: -100;
                            maximum: 100;
                            value: DevelopState.dev.vignette-amount;
                            edited(v) => {
                                DevelopState.develop-edit("vignette-amount", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("vignette-amount", v);
                            }
                        }
                        EditSlider {
                            label: @tr("Midpoint");
                            minimum: 0;
                            maximum: 100;
                            value: DevelopState.dev.vignette-midpoint;
                            edited(v) => {
                                DevelopState.develop-edit("vignette-midpoint", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("vignette-midpoint", v);
                            }
                        }
                        EditSlider {
                            label: @tr("Roundness");
                            minimum: -100;
                            maximum: 100;
                            value: DevelopState.dev.vignette-roundness;
                            edited(v) => {
                                DevelopState.develop-edit("vignette-roundness", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("vignette-roundness", v);
                            }
                        }
                        EditSlider {
                            label: @tr("Feather");
                            minimum: 0;
                            maximum: 100;
                            value: DevelopState.dev.vignette-feather;
                            edited(v) => {
                                DevelopState.develop-edit("vignette-feather", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("vignette-feather", v);
                            }
                        }
                        SubHeading {
                            label: @tr("Grain");
                        }
                        EditSlider {
                            label: @tr("Amount");
                            minimum: 0;
                            maximum: 100;
                            value: DevelopState.dev.grain-amount;
                            edited(v) => {
                                DevelopState.develop-edit("grain-amount", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("grain-amount", v);
                            }
                        }
                        EditSlider {
                            label: @tr("Size");
                            minimum: 0;
                            maximum: 100;
                            value: DevelopState.dev.grain-size;
                            edited(v) => {
                                DevelopState.develop-edit("grain-size", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("grain-size", v);
                            }
                        }
                        EditSlider {
                            label: @tr("Roughness");
                            minimum: 0;
                            maximum: 100;
                            value: DevelopState.dev.grain-roughness;
                            edited(v) => {
                                DevelopState.develop-edit("grain-roughness", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("grain-roughness", v);
                            }
                        }
                    }

                    if !root.basic-mode: GroupHeader {
                        label: @tr("Tone Curve");
                        expanded <=> root.expand-tone-curve;
                    }
                    if !root.basic-mode && root.expand-tone-curve: VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: @tr("Click to add a point, click a point to remove it.");
                            color: #666666;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        Rectangle {
                            width: 220px;
                            height: 220px;
                            background: #1b1b1b;
                            border-width: 1px;
                            border-color: #3a3a3a;

                            // Diagonal reference line: the identity curve.
                            Path {
                                width: 220px;
                                height: 220px;
                                viewbox-width: 220;
                                viewbox-height: 220;
                                commands: "M0 220 L220 0";
                                stroke: #444444;
                                stroke-width: 1px;
                            }
                            // The actual curve, empty when there are no
                            // points (the identity curve above already
                            // shows that case).
                            Path {
                                width: 220px;
                                height: 220px;
                                viewbox-width: 220;
                                viewbox-height: 220;
                                commands: DevelopState.dev-curve-path;
                                stroke: #6fa8dc;
                                stroke-width: 2px;
                            }
                            for point in DevelopState.dev-curve-points: Rectangle {
                                x: point.x * 1px - 4px;
                                y: point.y * 1px - 4px;
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: #6fa8dc;
                            }
                            curve-click := TouchArea {
                                mouse-cursor: crosshair;
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                        DevelopState.develop-curve-click(self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px);
                                    }
                                }
                            }
                        }
                        FilterChip {
                            text: @tr("Reset Curve");
                            active: false;
                            clicked => {
                                DevelopState.develop-curve-reset();
                            }
                        }
                    }

                    if !root.basic-mode: GroupHeader {
                        label: @tr("HSL Mixer");
                        expanded <=> root.expand-hsl;
                    }
                    if !root.basic-mode && root.expand-hsl && DevelopState.dev.monochrome: Text {
                        // ADR 0088 §3: in black and white the luminance
                        // sliders *are* the mix, and hue and saturation have
                        // nothing left to act on. Said rather than hidden —
                        // greying them out would suggest they were broken.
                        text: @tr("In black and white, only Luminance acts: it is the B&W mix.");
                        color: #8a8a8a;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                    if !root.basic-mode && root.expand-hsl: VerticalLayout {
                        spacing: 14px;
                        for band[i] in DevelopState.dev.hsl: VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: root.hsl-band-names[i];
                                color: #c0c0c0;
                                font-size: 12px;
                                font-weight: 600;
                            }
                            EditSlider {
                                label: @tr("Hue");
                                minimum: -100;
                                maximum: 100;
                                value: band.hue;
                                edited(v) => {
                                    DevelopState.develop-edit-hsl-band(i, "hue", v);
                                }
                                previewing(v) => {
                                    DevelopState.develop-preview-hsl-band(i, "hue", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Saturation");
                                minimum: -100;
                                maximum: 100;
                                value: band.saturation;
                                edited(v) => {
                                    DevelopState.develop-edit-hsl-band(i, "saturation", v);
                                }
                                previewing(v) => {
                                    DevelopState.develop-preview-hsl-band(i, "saturation", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Luminance");
                                minimum: -100;
                                maximum: 100;
                                value: band.luminance;
                                edited(v) => {
                                    DevelopState.develop-edit-hsl-band(i, "luminance", v);
                                }
                                previewing(v) => {
                                    DevelopState.develop-preview-hsl-band(i, "luminance", v);
                                }
                            }
                        }
                    }

                    if !root.basic-mode: GroupHeader {
                        label: @tr("Color Grading");
                        expanded <=> root.expand-color-grading;
                    }
                    if !root.basic-mode && root.expand-color-grading: VerticalLayout {
                        spacing: 14px;
                        VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: @tr("Shadows");
                                color: #c0c0c0;
                                font-size: 12px;
                                font-weight: 600;
                            }
                            EditSlider {
                                label: @tr("Hue");
                                minimum: 0;
                                maximum: 359;
                                value: DevelopState.dev.color-grading-shadows.hue;
                                edited(v) => {
                                    DevelopState.develop-edit-color-grading-zone("shadows", "hue", v);
                                }
                                previewing(v) => {
                                    DevelopState.develop-preview-color-grading-zone("shadows", "hue", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Saturation");
                                minimum: 0;
                                maximum: 100;
                                value: DevelopState.dev.color-grading-shadows.saturation;
                                edited(v) => {
                                    DevelopState.develop-edit-color-grading-zone("shadows", "saturation", v);
                                }
                                previewing(v) => {
                                    DevelopState.develop-preview-color-grading-zone("shadows", "saturation", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Luminance");
                                minimum: -100;
                                maximum: 100;
                                value: DevelopState.dev.color-grading-shadows.luminance;
                                edited(v) => {
                                    DevelopState.develop-edit-color-grading-zone("shadows", "luminance", v);
                                }
                                previewing(v) => {
                                    DevelopState.develop-preview-color-grading-zone("shadows", "luminance", v);
                                }
                            }
                        }
                        VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: @tr("Midtones");
                                color: #c0c0c0;
                                font-size: 12px;
                                font-weight: 600;
                            }
                            EditSlider {
                                label: @tr("Hue");
                                minimum: 0;
                                maximum: 359;
                                value: DevelopState.dev.color-grading-midtones.hue;
                                edited(v) => {
                                    DevelopState.develop-edit-color-grading-zone("midtones", "hue", v);
                                }
                                previewing(v) => {
                                    DevelopState.develop-preview-color-grading-zone("midtones", "hue", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Saturation");
                                minimum: 0;
                                maximum: 100;
                                value: DevelopState.dev.color-grading-midtones.saturation;
                                edited(v) => {
                                    DevelopState.develop-edit-color-grading-zone("midtones", "saturation", v);
                                }
                                previewing(v) => {
                                    DevelopState.develop-preview-color-grading-zone("midtones", "saturation", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Luminance");
                                minimum: -100;
                                maximum: 100;
                                value: DevelopState.dev.color-grading-midtones.luminance;
                                edited(v) => {
                                    DevelopState.develop-edit-color-grading-zone("midtones", "luminance", v);
                                }
                                previewing(v) => {
                                    DevelopState.develop-preview-color-grading-zone("midtones", "luminance", v);
                                }
                            }
                        }
                        VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: @tr("Highlights");
                                color: #c0c0c0;
                                font-size: 12px;
                                font-weight: 600;
                            }
                            EditSlider {
                                label: @tr("Hue");
                                minimum: 0;
                                maximum: 359;
                                value: DevelopState.dev.color-grading-highlights.hue;
                                edited(v) => {
                                    DevelopState.develop-edit-color-grading-zone("highlights", "hue", v);
                                }
                                previewing(v) => {
                                    DevelopState.develop-preview-color-grading-zone("highlights", "hue", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Saturation");
                                minimum: 0;
                                maximum: 100;
                                value: DevelopState.dev.color-grading-highlights.saturation;
                                edited(v) => {
                                    DevelopState.develop-edit-color-grading-zone("highlights", "saturation", v);
                                }
                                previewing(v) => {
                                    DevelopState.develop-preview-color-grading-zone("highlights", "saturation", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Luminance");
                                minimum: -100;
                                maximum: 100;
                                value: DevelopState.dev.color-grading-highlights.luminance;
                                edited(v) => {
                                    DevelopState.develop-edit-color-grading-zone("highlights", "luminance", v);
                                }
                                previewing(v) => {
                                    DevelopState.develop-preview-color-grading-zone("highlights", "luminance", v);
                                }
                            }
                        }
                        EditSlider {
                            label: @tr("Balance");
                            minimum: -100;
                            maximum: 100;
                            value: DevelopState.dev.color-grading-balance;
                            edited(v) => {
                                DevelopState.develop-edit("color-grading-balance", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("color-grading-balance", v);
                            }
                        }
                        EditSlider {
                            label: @tr("Blending");
                            minimum: 0;
                            maximum: 100;
                            value: DevelopState.dev.color-grading-blending;
                            edited(v) => {
                                DevelopState.develop-edit("color-grading-blending", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("color-grading-blending", v);
                            }
                        }
                    }

                    if !root.basic-mode: GroupHeader {
                        label: @tr("Spot Removal");
                        expanded <=> root.expand-spot-removal;
                    }
                    if !root.basic-mode && root.expand-spot-removal: VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: @tr("Pick the Spot Removal tool above, click a clean source, then the spot to fix.");
                            color: #666666;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                Text {
                                    text: @tr("Radius %");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                                Rectangle {
                                    height: 26px;
                                    background: #1b1b1b;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: #3a3a3a;
                                    TextInput {
                                        x: 6px;
                                        width: parent.width - 12px;
                                        height: 100%;
                                        text <=> DevelopState.spot-radius-text;
                                        color: #e6e6e6;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        single-line: true;
                                    }
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                Text {
                                    text: @tr("Feather %");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                                Rectangle {
                                    height: 26px;
                                    background: #1b1b1b;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: #3a3a3a;
                                    TextInput {
                                        x: 6px;
                                        width: parent.width - 12px;
                                        height: 100%;
                                        text <=> DevelopState.spot-feather-text;
                                        color: #e6e6e6;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        single-line: true;
                                    }
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                Text {
                                    text: @tr("Opacity %");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                                Rectangle {
                                    height: 26px;
                                    background: #1b1b1b;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: #3a3a3a;
                                    TextInput {
                                        x: 6px;
                                        width: parent.width - 12px;
                                        height: 100%;
                                        text <=> DevelopState.spot-opacity-text;
                                        color: #e6e6e6;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        single-line: true;
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: @tr("{} spot(s)", DevelopState.dev-spot-count);
                                color: #9a9a9a;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            FilterChip {
                                text: @tr("Undo Last");
                                active: false;
                                clicked => {
                                    DevelopState.develop-spot-undo();
                                }
                            }
                            FilterChip {
                                text: @tr("Clear All");
                                active: false;
                                clicked => {
                                    DevelopState.develop-spot-reset();
                                }
                            }
                        }
                    }

                    if !root.basic-mode: GroupHeader {
                        label: @tr("Local Adjustments");
                        expanded <=> root.expand-local;
                    }
                    // The masked adjustments of ADR 0029, refined by the range
                    // masks of ADR 0048 (ADR 0049): a list of entries, the
                    // selected one's values below it. Geometry is traced on the
                    // image with the three tools above, never typed here.
                    if !root.basic-mode && root.expand-local: VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: @tr("Pick Radial, Gradient or Brush above and draw on the photo. Click a row to edit it; drawing again moves the selected mask.");
                            color: #666666;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        for row[i] in MaskState.masks: mask-touch := TouchArea {
                            height: 30px;
                            clicked => {
                                // Through Rust, not a bare assignment: the
                                // overlay is composited into the preview
                                // (ADR 0071), so a selection change has to
                                // reach the engine to repaint.
                                MaskState.select-mask(MaskState.selected-mask == i ? -1 : i);
                            }
                            Rectangle {
                                width: 100%;
                                height: 100%;
                                border-radius: 4px;
                                background: i == MaskState.selected-mask ? #2f4f6f : (mask-touch.has-hover ? #2a2a2a : transparent);
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 4px;
                                    spacing: 6px;
                                    Text {
                                        text: row.kind == "radial" ? @tr("Radial")
                                            : row.kind == "gradient" ? @tr("Gradient")
                                            : row.kind == "brush" ? @tr("Brush")
                                            : @tr("Whole image");
                                        color: #e6e6e6;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        // Already formatted by Rust
                                        // (`models::mask_rows`).
                                        text: row.geometry;
                                        color: #9a9a9a;
                                        font-size: 11px;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                    remove-touch := TouchArea {
                                        width: 18px;
                                        clicked => {
                                            MaskState.remove-mask(i);
                                            MaskState.selected-mask = -1;
                                        }
                                        Text {
                                            text: "×";
                                            color: remove-touch.has-hover ? #f0f0f0 : #9a9a9a;
                                            font-size: 13px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: 100%;
                                            height: 100%;
                                        }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            alignment: start;
                            FilterChip {
                                // A range mask standing on its own needs a
                                // geometry that covers everything (ADR 0048
                                // §1) — nothing to trace, so a button.
                                text: @tr("Add whole-image mask");
                                active: false;
                                clicked => {
                                    MaskState.add-mask("everything");
                                    root.expand-local = true;
                                }
                            }
                            FilterChip {
                                // A stored coverage is imported, never
                                // traced (ADR 0070 §7): the mask was made
                                // in another program and comes in whole.
                                text: @tr("Add mask from file…");
                                active: false;
                                clicked => {
                                    MaskState.add-mask("coverage");
                                    root.expand-local = true;
                                }
                            }
                            // One chip per detection an installed detector
                            // offers (ADR 0073). Nothing installed, nothing
                            // shown: the list is empty on every installation
                            // that has not added one.
                            for detection in MaskState.detections: FilterChip {
                                text: detection.label;
                                active: false;
                                clicked => {
                                    MaskState.detect-mask(detection.key);
                                    root.expand-local = true;
                                }
                            }
                            FilterChip {
                                // Seeing the coverage is how a mask is
                                // worked on (ADR 0071) — and the only way
                                // to see a stored one, which draws no
                                // handles of its own.
                                text: @tr("Show mask");
                                active: MaskState.show-overlay;
                                clicked => {
                                    MaskState.toggle-overlay();
                                }
                            }
                        }

                        // Brush defaults, applied to the next dab painted.
                        if root.active-tool == "brush": HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                Text {
                                    text: @tr("Size %");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                                Rectangle {
                                    height: 26px;
                                    background: #1b1b1b;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: #3a3a3a;
                                    TextInput {
                                        x: 6px;
                                        width: parent.width - 12px;
                                        height: 100%;
                                        text <=> MaskState.brush-size-text;
                                        color: #e6e6e6;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        single-line: true;
                                    }
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                Text {
                                    text: @tr("Flow %");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                                Rectangle {
                                    height: 26px;
                                    background: #1b1b1b;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: #3a3a3a;
                                    TextInput {
                                        x: 6px;
                                        width: parent.width - 12px;
                                        height: 100%;
                                        text <=> MaskState.brush-flow-text;
                                        color: #e6e6e6;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        single-line: true;
                                    }
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                Text {
                                    text: @tr("Hardness %");
                                    color: #9a9a9a;
                                    font-size: 12px;
                                }
                                Rectangle {
                                    height: 26px;
                                    background: #1b1b1b;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: #3a3a3a;
                                    TextInput {
                                        x: 6px;
                                        width: parent.width - 12px;
                                        height: 100%;
                                        text <=> MaskState.brush-hardness-text;
                                        color: #e6e6e6;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        single-line: true;
                                    }
                                }
                            }
                        }

                        // The selected entry's values. Every slider back at
                        // its neutral value means "not set" (ADR 0049 §3), so
                        // there is nothing to switch off but the two pairs
                        // that have no neutral: the local white balance and
                        // each range term.
                        if MaskState.selected-mask >= 0 && MaskState.selected-mask < MaskState.masks.length: editor := VerticalLayout {
                            property <MaskRow> sel: MaskState.masks[MaskState.selected-mask];
                            spacing: 12px;

                            EditSlider {
                                label: @tr("Opacity");
                                minimum: 0;
                                maximum: 100;
                                value: editor.sel.opacity;
                                edited(v) => {
                                    MaskState.edit-mask(MaskState.selected-mask, "opacity", v);
                                }
                                previewing(v) => {
                                    MaskState.preview-mask(MaskState.selected-mask, "opacity", v);
                                }
                            }
                            if editor.sel.kind == "radial": EditSlider {
                                label: @tr("Feather");
                                minimum: 0;
                                maximum: 100;
                                value: editor.sel.feather;
                                edited(v) => {
                                    MaskState.edit-mask(MaskState.selected-mask, "feather", v);
                                }
                                previewing(v) => {
                                    MaskState.preview-mask(MaskState.selected-mask, "feather", v);
                                }
                            }
                            if editor.sel.kind == "radial": FilterChip {
                                text: editor.sel.inverted ? @tr("Outside the ellipse") : @tr("Inside the ellipse");
                                active: editor.sel.inverted;
                                clicked => {
                                    MaskState.edit-mask(MaskState.selected-mask, "invert", editor.sel.inverted ? 0 : 1);
                                }
                            }
                            EditSlider {
                                label: @tr("Exposure");
                                minimum: -5;
                                maximum: 5;
                                decimals: 2;
                                value: editor.sel.exposure;
                                edited(v) => {
                                    MaskState.edit-mask(MaskState.selected-mask, "exposure", v);
                                }
                                previewing(v) => {
                                    MaskState.preview-mask(MaskState.selected-mask, "exposure", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Contrast");
                                minimum: -100;
                                maximum: 100;
                                value: editor.sel.contrast;
                                edited(v) => {
                                    MaskState.edit-mask(MaskState.selected-mask, "contrast", v);
                                }
                                previewing(v) => {
                                    MaskState.preview-mask(MaskState.selected-mask, "contrast", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Highlights");
                                minimum: -100;
                                maximum: 100;
                                value: editor.sel.highlights;
                                edited(v) => {
                                    MaskState.edit-mask(MaskState.selected-mask, "highlights", v);
                                }
                                previewing(v) => {
                                    MaskState.preview-mask(MaskState.selected-mask, "highlights", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Shadows");
                                minimum: -100;
                                maximum: 100;
                                value: editor.sel.shadows;
                                edited(v) => {
                                    MaskState.edit-mask(MaskState.selected-mask, "shadows", v);
                                }
                                previewing(v) => {
                                    MaskState.preview-mask(MaskState.selected-mask, "shadows", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Whites");
                                minimum: -100;
                                maximum: 100;
                                value: editor.sel.whites;
                                edited(v) => {
                                    MaskState.edit-mask(MaskState.selected-mask, "whites", v);
                                }
                                previewing(v) => {
                                    MaskState.preview-mask(MaskState.selected-mask, "whites", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Blacks");
                                minimum: -100;
                                maximum: 100;
                                value: editor.sel.blacks;
                                edited(v) => {
                                    MaskState.edit-mask(MaskState.selected-mask, "blacks", v);
                                }
                                previewing(v) => {
                                    MaskState.preview-mask(MaskState.selected-mask, "blacks", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Vibrance");
                                minimum: -100;
                                maximum: 100;
                                value: editor.sel.vibrance;
                                edited(v) => {
                                    MaskState.edit-mask(MaskState.selected-mask, "vibrance", v);
                                }
                                previewing(v) => {
                                    MaskState.preview-mask(MaskState.selected-mask, "vibrance", v);
                                }
                            }
                            EditSlider {
                                label: @tr("Saturation");
                                minimum: -100;
                                maximum: 100;
                                value: editor.sel.saturation;
                                edited(v) => {
                                    MaskState.edit-mask(MaskState.selected-mask, "saturation", v);
                                }
                                previewing(v) => {
                                    MaskState.preview-mask(MaskState.selected-mask, "saturation", v);
                                }
                            }
                            FilterChip {
                                text: @tr("Local white balance");
                                active: editor.sel.wb-on;
                                clicked => {
                                    MaskState.edit-mask(MaskState.selected-mask, "wb", editor.sel.wb-on ? 0 : 1);
                                }
                            }
                            if editor.sel.wb-on: EditSlider {
                                label: @tr("Temperature");
                                minimum: 2000;
                                maximum: 12000;
                                value: editor.sel.temperature;
                                edited(v) => {
                                    MaskState.edit-mask(MaskState.selected-mask, "temperature", v);
                                }
                                previewing(v) => {
                                    MaskState.preview-mask(MaskState.selected-mask, "temperature", v);
                                }
                            }
                            if editor.sel.wb-on: EditSlider {
                                label: @tr("Tint");
                                minimum: -100;
                                maximum: 100;
                                value: editor.sel.tint;
                                edited(v) => {
                                    MaskState.edit-mask(MaskState.selected-mask, "tint", v);
                                }
                                previewing(v) => {
                                    MaskState.preview-mask(MaskState.selected-mask, "tint", v);
                                }
                            }
                            // Range mask (ADR 0048): narrows the traced
                            // geometry by luminance and by hue, each term
                            // independent and off by default.
                            FilterChip {
                                text: @tr("Luminance range");
                                active: editor.sel.range-luminance-on;
                                clicked => {
                                    MaskState.edit-mask(MaskState.selected-mask, "range-luminance", editor.sel.range-luminance-on ? 0 : 1);
                                }
                            }
                            if editor.sel.range-luminance-on: EditSlider {
                                label: @tr("Range from");
                                minimum: 0;
                                maximum: 100;
                                value: editor.sel.lum-min;
                                edited(v) => {
                                    MaskState.edit-mask(MaskState.selected-mask, "lum-min", v);
                                }
                                previewing(v) => {
                                    MaskState.preview-mask(MaskState.selected-mask, "lum-min", v);
                                }
                            }
                            if editor.sel.range-luminance-on: EditSlider {
                                label: @tr("Range to");
                                minimum: 0;
                                maximum: 100;
                                value: editor.sel.lum-max;
                                edited(v) => {
                                    MaskState.edit-mask(MaskState.selected-mask, "lum-max", v);
                                }
                                previewing(v) => {
                                    MaskState.preview-mask(MaskState.selected-mask, "lum-max", v);
                                }
                            }
                            if editor.sel.range-luminance-on: EditSlider {
                                label: @tr("Range softness");
                                minimum: 0;
                                maximum: 100;
                                value: editor.sel.lum-softness;
                                edited(v) => {
                                    MaskState.edit-mask(MaskState.selected-mask, "lum-softness", v);
                                }
                                previewing(v) => {
                                    MaskState.preview-mask(MaskState.selected-mask, "lum-softness", v);
                                }
                            }
                            FilterChip {
                                text: @tr("Color range");
                                active: editor.sel.range-color-on;
                                clicked => {
                                    MaskState.edit-mask(MaskState.selected-mask, "range-color", editor.sel.range-color-on ? 0 : 1);
                                }
                            }
                            if editor.sel.range-color-on: EditSlider {
                                label: @tr("Hue");
                                minimum: 0;
                                maximum: 359;
                                value: editor.sel.color-center;
                                edited(v) => {
                                    MaskState.edit-mask(MaskState.selected-mask, "color-center", v);
                                }
                                previewing(v) => {
                                    MaskState.preview-mask(MaskState.selected-mask, "color-center", v);
                                }
                            }
                            if editor.sel.range-color-on: EditSlider {
                                label: @tr("Hue width");
                                minimum: 1;
                                maximum: 180;
                                value: editor.sel.color-width;
                                edited(v) => {
                                    MaskState.edit-mask(MaskState.selected-mask, "color-width", v);
                                }
                                previewing(v) => {
                                    MaskState.preview-mask(MaskState.selected-mask, "color-width", v);
                                }
                            }
                            if editor.sel.range-color-on: EditSlider {
                                label: @tr("Hue softness");
                                minimum: 0;
                                maximum: 180;
                                value: editor.sel.color-softness;
                                edited(v) => {
                                    MaskState.edit-mask(MaskState.selected-mask, "color-softness", v);
                                }
                                previewing(v) => {
                                    MaskState.preview-mask(MaskState.selected-mask, "color-softness", v);
                                }
                            }
                        }
                    }

                    if !root.basic-mode: GroupHeader {
                        label: @tr("Soft Proof");
                        expanded <=> root.expand-proof;
                    }
                    // A way of looking at the photo, not a setting of it
                    // (ADR 0034): nothing here is stored, and leaving the
                    // proof shows the real render again.
                    if !root.basic-mode && root.expand-proof: VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: @tr("Shows the photo as a destination profile would reproduce it. Never stored, never exported.");
                            color: #666666;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        Text {
                            text: DevelopState.soft-proof-name == ""
                                ? @tr("No proof — the real render")
                                : DevelopState.soft-proof-name;
                            color: #9a9a9a;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            FilterChip {
                                text: @tr("Choose .icc…");
                                active: false;
                                clicked => {
                                    DevelopState.browse-soft-proof();
                                }
                            }
                            if DevelopState.soft-proof-name != "": FilterChip {
                                text: @tr("Stop proofing");
                                active: false;
                                clicked => {
                                    DevelopState.clear-soft-proof();
                                }
                            }
                        }
                        if DevelopState.soft-proof-name != "": HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            FilterChip {
                                text: @tr("Perceptual");
                                active: DevelopState.soft-proof-intent == 0;
                                clicked => {
                                    DevelopState.set-soft-proof-intent(0);
                                }
                            }
                            FilterChip {
                                text: @tr("Relative");
                                active: DevelopState.soft-proof-intent == 1;
                                clicked => {
                                    DevelopState.set-soft-proof-intent(1);
                                }
                            }
                            FilterChip {
                                text: @tr("Saturation");
                                active: DevelopState.soft-proof-intent == 2;
                                clicked => {
                                    DevelopState.set-soft-proof-intent(2);
                                }
                            }
                            FilterChip {
                                text: @tr("Absolute");
                                active: DevelopState.soft-proof-intent == 3;
                                clicked => {
                                    DevelopState.set-soft-proof-intent(3);
                                }
                            }
                        }
                        if DevelopState.soft-proof-name != "": FilterChip {
                            text: @tr("Flag out-of-gamut colors");
                            active: DevelopState.soft-proof-gamut-warning;
                            clicked => {
                                DevelopState.toggle-soft-proof-gamut-warning();
                            }
                        }
                    }

                    GroupHeader {
                        label: @tr("Geometry");
                        expanded <=> root.expand-geometry;
                    }
                    if root.expand-geometry: VerticalLayout {
                        spacing: 12px;
                        EditSlider {
                            label: @tr("Rotation");
                            minimum: -45;
                            maximum: 45;
                            decimals: 1;
                            value: DevelopState.dev.rotation;
                            edited(v) => {
                                DevelopState.develop-edit("rotation", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("rotation", v);
                            }
                        }
                        // Perspective (ADR 0052): between rotation and crop
                        // in the panel exactly as in the pipeline.
                        EditSlider {
                            label: @tr("Vertical perspective");
                            minimum: -100;
                            maximum: 100;
                            value: DevelopState.dev.perspective-vertical;
                            edited(v) => {
                                DevelopState.develop-edit("perspective-vertical", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("perspective-vertical", v);
                            }
                        }
                        EditSlider {
                            label: @tr("Horizontal perspective");
                            minimum: -100;
                            maximum: 100;
                            value: DevelopState.dev.perspective-horizontal;
                            edited(v) => {
                                DevelopState.develop-edit("perspective-horizontal", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("perspective-horizontal", v);
                            }
                        }
                        EditSlider {
                            label: @tr("Crop left");
                            minimum: 0;
                            maximum: 100;
                            value: DevelopState.dev.crop-left;
                            edited(v) => {
                                DevelopState.develop-edit("crop-left", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("crop-left", v);
                            }
                        }
                        EditSlider {
                            label: @tr("Crop top");
                            minimum: 0;
                            maximum: 100;
                            value: DevelopState.dev.crop-top;
                            edited(v) => {
                                DevelopState.develop-edit("crop-top", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("crop-top", v);
                            }
                        }
                        EditSlider {
                            label: @tr("Crop width");
                            minimum: 1;
                            maximum: 100;
                            value: DevelopState.dev.crop-width;
                            edited(v) => {
                                DevelopState.develop-edit("crop-width", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("crop-width", v);
                            }
                        }
                        EditSlider {
                            label: @tr("Crop height");
                            minimum: 1;
                            maximum: 100;
                            value: DevelopState.dev.crop-height;
                            edited(v) => {
                                DevelopState.develop-edit("crop-height", v);
                            }
                            previewing(v) => {
                                DevelopState.develop-preview("crop-height", v);
                            }
                        }
                        HorizontalLayout {
                            alignment: end;
                            FilterChip {
                                text: @tr("Reset crop");
                                active: false;
                                clicked => {
                                    DevelopState.develop-edit("crop-reset", 0);
                                }
                            }
                        }
                    }

                    GroupHeader {
                        label: @tr("History");
                        expanded <=> root.expand-history;
                    }
                    // Browsable revision list beyond linear undo/redo
                    // (Ctrl+Z/Y): head first, click any row to jump
                    // straight to it (`checkout-history-row`).
                    if root.expand-history: VerticalLayout {
                        for entry[index] in DevelopState.dev-history: touch := TouchArea {
                            height: 26px;
                            clicked => {
                                DevelopState.checkout-history-row(index);
                            }
                            Rectangle {
                                width: 100%;
                                height: 100%;
                                background: index == DevelopState.dev-history-current ? #2f4f6f : (touch.has-hover ? #2a2a2a : transparent);
                                border-radius: 4px;
                                Text {
                                    x: 8px;
                                    text: index == DevelopState.dev-history-current ? @tr("{} (current)", entry) : entry;
                                    color: #d0d0d0;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    height: 100%;
                                }
                            }
                        }
                    }
                }
            }
        }
}
