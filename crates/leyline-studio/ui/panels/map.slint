// The GPS map view (ADR 0040): the tile canvas Rust renders, the pin
// markers over it, and the pan/zoom controls (ADR 0045 §3).
//
// Same shape as the develop panel — a whole-window mode gated on
// `MapState.map-mode`, inheriting `HorizontalLayout` and setting no geometry
// of its own.

import { MapState } from "../state/map.slint";
import { FilterChip } from "../widgets/controls.slint";

export component MapPanel inherits HorizontalLayout {
        visible: MapState.map-mode;
        VerticalLayout {
            padding: 12px;
            spacing: 8px;

            // Clears the menu row, like every other whole-window panel: its
            // own title used to sit under the File menu, and its buttons
            // under the module switcher (ADR 0055 §1).
            Rectangle {
                height: 28px;
            }

            HorizontalLayout {
                height: 28px;
                spacing: 8px;
                Text {
                    text: @tr("Map");
                    color: #f0f0f0;
                    font-size: 15px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                if MapState.map-pack-available: FilterChip {
                    text: "−";
                    active: false;
                    clicked => {
                        MapState.map-zoom-out();
                    }
                }
                if MapState.map-pack-available: FilterChip {
                    text: "+";
                    active: false;
                    clicked => {
                        MapState.map-zoom-in();
                    }
                }
                FilterChip {
                    text: @tr("Import Map Pack…");
                    active: false;
                    clicked => {
                        MapState.browse-map-pack();
                    }
                }
                FilterChip {
                    text: @tr("Close");
                    active: false;
                    clicked => {
                        MapState.exit-map();
                    }
                }
            }

            // The canvas is instantiated unconditionally, and that is the
            // fix rather than an incidental detail. It carries
            // `changed width`/`changed height` so Rust composites tiles at
            // exactly the canvas's pixel size, and Slint's `ChangeTracker`
            // reads that geometry the instant the element is created. Behind
            // an `if MapState.map-pack-available:` — a flag Rust only raises
            // inside `enter-map` — that creation landed in the middle of the
            // layout pass the click on "Map" had just started: the tracker
            // asked for a width that same pass had not finished computing,
            // and Slint answered "Recursion detected" and took the process
            // down with it. Every attempt to open the map crashed the app.
            // Creating the canvas at window construction moves the read to a
            // moment when no layout is in flight, and Rust already ignores
            // the 0x0 it reports there: `on_map_resized` returns early until
            // a map session exists. Same hazard as the empty-library text in
            // `browser.slint`, ADR 0045 §3 — a geometry read that closes a
            // loop through the layout that is computing that geometry.
            Rectangle {
                // No geometry of its own: the map is the point of this
                // view, so it takes every pixel the window has left after
                // the title row. Its real size goes back to Rust on each
                // layout pass — the tile compositing happens at exactly
                // this many pixels, so the canvas is never scaled and never
                // letterboxed.
                vertical-stretch: 1;
                clip: true;
                background: #1a1a1a;

                changed width => {
                    MapState.map-resized(self.width / 1px, self.height / 1px);
                }
                changed height => {
                    MapState.map-resized(self.width / 1px, self.height / 1px);
                }

                Image {
                    source: MapState.map-image;
                    width: 100%;
                    height: 100%;
                }

                // Drag-to-pan: recomputed once on release, not on every
                // pointer move — repositioning would mean refetching
                // and recompositing tiles, too heavy to do per pixel of
                // movement.
                map-drag := TouchArea {
                    width: 100%;
                    height: 100%;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                            MapState.map-pan(
                                (self.mouse-x - self.pressed-x) / 1px,
                                (self.mouse-y - self.pressed-y) / 1px,
                            );
                        }
                    }
                }

                for pin[index] in MapState.map-pins: TouchArea {
                    x: pin.x * 1px - 6px;
                    y: pin.y * 1px - 6px;
                    width: 12px;
                    height: 12px;
                    clicked => {
                        MapState.map-pin-clicked(index);
                    }
                    Rectangle {
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        background: #e05c3e;
                        border-width: 1.5px;
                        border-color: #ffffff;
                    }
                }

                // Why the map is empty. Without this the view is
                // indistinguishable from a broken one: the world is drawn,
                // nothing is on it, and nothing says whether that is the
                // library's doing or the app's. Placed over the canvas
                // rather than replacing it — panning a world map is still
                // useful, and an empty map is not an error state.
                // One overlay for the two reasons a map can show nothing:
                // this build ships no basemap, or this library holds no GPS
                // coordinates. They used to be two blocks, and the first was
                // a *sibling* of the canvas — so a build without a pack laid
                // the view out in a different shape than every other build,
                // which is the shape nobody ever looks at.
                //
                // Both widths are fixed rather than read off the parent, and
                // the height is read off the wrapped text rather than the
                // other way round. The canvas is a plain `Rectangle`, so its
                // layout info is the envelope of its children: an overlay
                // sized from `parent.width`, wrapping text against it, would
                // make the canvas's width depend on the canvas's width —
                // the same loop the canvas comment above describes.
                if !MapState.map-pack-available || MapState.map-pin-total == 0: Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 420px;
                    height: no-gps.height + 24px;
                    background: #000000cc;
                    border-radius: 6px;
                    no-gps := Text {
                        x: 12px;
                        y: 12px;
                        width: 396px;
                        text: !MapState.map-pack-available
                            ? (MapState.map-status == ""
                                ? @tr("This build ships no map background. Import an offline MBTiles map pack to place GPS-tagged photos on a map.")
                                : MapState.map-status)
                            : @tr("No photo in this library has GPS coordinates. Leyline reads them from the file's own metadata — it never invents a position, and never asks the network for one.");
                        color: #d8d8d8;
                        font-size: 12px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                // OpenStreetMap attribution (ODbL requires it travel
                // with wherever the data is displayed, ADR 0040) — a
                // fixed overlay, not just a mention buried in About.
                Rectangle {
                    // Nothing to attribute when no basemap is drawn.
                    visible: MapState.map-pack-available;
                    x: parent.width - self.width - 4px;
                    y: parent.height - self.height - 4px;
                    width: attribution-text.width + 8px;
                    height: attribution-text.height + 4px;
                    background: #000000aa;
                    attribution-text := Text {
                        x: 4px;
                        y: 2px;
                        text: MapState.map-pack-attribution == "" ? "© OpenStreetMap contributors" : MapState.map-pack-attribution;
                        color: #d8d8d8;
                        font-size: 10px;
                    }
                }
            }
        }
}
