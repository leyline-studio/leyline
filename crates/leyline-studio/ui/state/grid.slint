// The thumbnail grid: the loaded window of cells, the focus, and the
// classement actions that apply to it (ADR 0045 §1).
//
// Only a window of rows is ever held here, not the whole catalog: Rust
// sends `cells` for rows `window-start .. window-start + cells.length` out
// of `total-cells`, and refills it as `viewport-moved` reports scrolling.

import { Cell, SurveyCell } from "../types.slint";
export global GridState {
    // The loaded window of grid cells; cell `i` shows grid row
    // `window-start + i` out of `total-cells` matching rows.
    in property <[Cell]> cells;
    in property <int> total-cells;
    // Whether the query behind those rows narrows the library at all — a
    // filter, a search, a folder, a collection, a culling proposal. Sent by
    // Rust from `GridQuery::narrows()` rather than guessed from the mirrored
    // filter chips, which is what lets the empty grid tell an empty library
    // apart from criteria that match nothing.
    in property <bool> narrowed;
    in property <int> window-start;
    in-out property <int> selected: -1;
    callback select(int);
    // A grid cell was clicked: index, then whether Ctrl/Shift was held
    // (multi-select) — plain clicks (both false) behave like `select`.
    callback cell-clicked(int, bool, bool);
    // How many photographs a batch action would touch: the multi-selection
    // when there is one, otherwise the lone focused photo. Set by Rust from
    // the one place the selection changes; read by the label under a drag
    // (ADR 0130 §1), which has to say *how many* before the drop.
    in property <int> selection-size;
    // Everything the grid is currently showing — the filter's answer, not
    // the library's (ADR 0141 §1). Rows the virtual window never loaded are
    // part of it: what the selection names is the query, not the screen.
    callback select-all();
    // Back to the one focused photograph.
    callback select-none();
    callback classify(string);
    // Drops every criterion at once and shows the whole library again: the
    // way out of a grid narrowed to nothing, where no single chip is the one
    // to click because several of them may be on at the same time.
    callback clear-criteria();
    // First visible cell and how many cells fit, sent on scroll or resize.
    callback viewport-moved(int, int);
    // Loupe view (ADR 0055 §3): the selected photo, large, from the same
    // cached preview develop uses — no edit session is opened, so nothing is
    // written and there is nothing to undo. `loupe-mode` is `in-out` because
    // both the UI (a chip, `E`, `G`) and Rust (leaving develop) move it, and
    // Rust has to know: it only fills `loupe-image` while the loupe is up.
    in-out property <bool> loupe-mode;
    in property <image> loupe-image;
    callback loupe-mode-changed();

    // Compare view (ADR 0057): the photo being defended on the left, the one
    // challenging it on the right. Both are cached previews, like the loupe's
    // — no edit session, nothing written.
    in-out property <bool> compare-mode;
    in property <image> compare-select-image;
    in property <image> compare-candidate-image;
    in property <string> compare-select-name;
    in property <string> compare-candidate-name;
    callback compare-mode-changed();
    // Moves the *candidate* by ±1 through the grid, never the select (§3).
    callback compare-candidate-step(int);
    // Promotes the candidate: it becomes the select, the select becomes the
    // candidate, and the sort has advanced by one photo.
    callback compare-swap();

    // Survey view (ADR 0057 §4): the multi-selection, or the lone selected
    // photo when there is no multi-selection. Removing an entry drops it from
    // the selection — nothing is deleted, and nothing is stored.
    in-out property <bool> survey-mode;
    in property <[SurveyCell]> survey-cells;
    callback survey-mode-changed();
    callback survey-remove(int);

    // Taking photos out of the catalog (ADR 0060). Both act on the whole
    // multi-selection, and both open the confirmation dialog rather than
    // doing anything themselves — Rust fills in the wording, since only it
    // knows how many photos are involved.
    callback remove-selected();
    callback delete-selected();
}
