// Help ▸ Report a Problem… (ADR 0123): Leyline assembles a report, the
// photographer sends it.
//
// One of the dialogs hosted by `panels/dialogs.slint` (ADR 0045 §3).
//
// The attachment list is the promise: it shows every file that will be in
// the folder, before the folder exists, and each one can be taken back out.
// A report that surprises its author when they open it has already failed at
// the only thing this feature is for (ADR 0123 §3).

import { Theme } from "../theme.slint";
import { DialogState } from "../state/dialog.slint";
import { FilterChip } from "../widgets/controls.slint";

export component ReportDialog inherits VerticalLayout {
    spacing: 10px;
    Text {
        text: @tr("Report a problem");
        color: Theme.text;
        font-size: 15px;
        font-weight: 600;
    }
    Text {
        text: @tr("Leyline writes a folder and opens it. Nothing is sent: you look at it, then attach it wherever you like.");
        color: Theme.text-dim;
        font-size: 12px;
        wrap: word-wrap;
    }

    Text {
        text: @tr("What were you doing, and what happened?");
        color: Theme.text;
        font-size: 12px;
    }
    Rectangle {
        height: 84px;
        background: Theme.surface;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.border;
        description := TextInput {
            x: 8px;
            y: 6px;
            width: parent.width - 16px;
            height: parent.height - 12px;
            text <=> DialogState.report-description;
            color: Theme.text;
            font-size: 12px;
            single-line: false;
            wrap: word-wrap;
        }
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        FilterChip {
            text: @tr("Attach a screenshot…");
            active: false;
            clicked => {
                DialogState.report-add-files();
            }
        }
    }

    Text {
        // Optional, and said so: a description on its own is a report.
        text: @tr("A screenshot helps, and is not required. The folder will hold these, and nothing else:");
        color: Theme.text-dim;
        font-size: 11px;
        // Two sentences now, and without this the line was cut mid-word at
        // the dialog's edge.
        wrap: word-wrap;
    }
    Text {
        text: "description.txt · build.txt";
        color: Theme.text-dim;
        font-size: 11px;
    }
    // Absolute positions inside a fixed-height row, the same shape the folder
    // tree uses: a `HorizontalLayout` gave the name all the width and left
    // nothing for the × — it was there and could not be seen.
    for attachment[index] in DialogState.report-attachments: Rectangle {
        height: 18px;
        Text {
            x: 0;
            width: parent.width - 22px;
            height: 100%;
            text: attachment;
            color: Theme.text-dim;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle {
            x: parent.width - 18px;
            width: 16px;
            height: 100%;
            Text {
                text: "×";
                color: remove.has-hover ? Theme.alert : Theme.text-disabled;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
            remove := TouchArea {
                clicked => {
                    DialogState.report-remove-attachment(index);
                }
            }
        }
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: end;
        FilterChip {
            text: @tr("Close");
            active: false;
            clicked => {
                DialogState.dialog = "";
            }
        }
        FilterChip {
            text: @tr("Create the folder");
            active: true;
            clicked => {
                DialogState.run-report();
            }
        }
    }
}

// What a panic leaves for the next launch (ADR 0162 §2). No window can be
// trusted inside the process that panicked; the next start is the one moment
// Studio is known to be healthy, and the one when the photographer can still
// say what they were doing.
export component LastPanicDialog inherits VerticalLayout {
    spacing: 12px;
    Text {
        text: @tr("Leyline stopped unexpectedly last time.");
        color: Theme.text;
        font-size: 15px;
        font-weight: 600;
        wrap: word-wrap;
    }
    Text {
        text: @tr("What it was doing when it stopped is in last-panic.txt. A report lets you add what you were doing, and shows the file before anything is written.");
        color: Theme.text-dim;
        font-size: 12px;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: end;
        FilterChip {
            text: @tr("Dismiss");
            active: false;
            clicked => {
                DialogState.dismiss-last-panic();
            }
        }
        FilterChip {
            text: @tr("Report the problem…");
            active: true;
            clicked => {
                DialogState.report-last-panic();
            }
        }
    }
}
