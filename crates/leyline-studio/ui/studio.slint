// Leyline Studio main window (`docs/roadmap.md` phase 5).
//
// The library browser: a filter bar on top, a thumbnail grid on the left,
// the metadata of the selected photo on the right. All strings arrive
// preformatted from Rust — the UI never interprets catalog values itself,
// and every filter or classement decision is made in Rust too: the UI only
// reports what was clicked or typed.

export struct Cell {
    thumbnail: image,
    filename: string,
    stars: string,
    label: color,
    has-label: bool,
}

// One row of the collections sidebar, already flattened by Rust.
export struct CollectionRow {
    name: string,
    depth: int,
    smart: bool,
}

// Develop slider values, mirrored from the Settings held in Rust.
export struct DevSettings {
    exposure: float,
    contrast: float,
    highlights: float,
    shadows: float,
    whites: float,
    blacks: float,
    vibrance: float,
    saturation: float,
    wb-temp: float,
    wb-tint: float,
    rotation: float,
    crop-left: float,
    crop-top: float,
    crop-width: float,
    crop-height: float,
    nr-luminance: float,
    nr-color: float,
    sharpen-amount: float,
    sharpen-radius: float,
    lens-correction: bool,
}

component DetailRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 8px;
    Text {
        text: root.label;
        color: #9a9a9a;
        font-size: 12px;
        width: 72px;
    }
    Text {
        text: root.value;
        color: #e6e6e6;
        font-size: 12px;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}

component FilterChip inherits Rectangle {
    in property <bool> active;
    in property <string> text;
    callback clicked;

    height: 24px;
    width: chip-text.preferred-width + 18px;
    border-radius: 12px;
    background: root.active ? #2f4f6f : #242424;
    border-width: 1px;
    border-color: root.active ? #6fa8dc : #333333;

    chip-text := Text {
        text: root.text;
        color: root.active ? #e6e6e6 : #9a9a9a;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// One develop slider. The displayed position follows the authoritative
// value from Rust except while dragging, so refreshing the settings after
// a commit never breaks a binding.
component EditSlider inherits VerticalLayout {
    in property <string> label;
    in property <float> minimum;
    in property <float> maximum;
    in property <float> value;
    in property <int> decimals;
    callback edited(float);

    property <bool> dragging;
    property <float> drag-value;
    property <float> shown: root.dragging ? root.drag-value : root.value;
    property <float> factor: root.decimals == 0 ? 1 : 100;

    spacing: 2px;

    HorizontalLayout {
        Text {
            text: root.label;
            color: #9a9a9a;
            font-size: 12px;
            horizontal-stretch: 1;
        }
        Text {
            text: Math.round(root.shown * root.factor) / root.factor;
            color: #e6e6e6;
            font-size: 12px;
        }
    }
    track := Rectangle {
        height: 14px;
        Rectangle {
            y: parent.height / 2 - 2px;
            height: 4px;
            border-radius: 2px;
            background: #333333;
        }
        Rectangle {
            x: (track.width - 12px) * (root.shown - root.minimum) / (root.maximum - root.minimum);
            y: parent.height / 2 - 6px;
            width: 12px;
            height: 12px;
            border-radius: 6px;
            background: root.dragging ? #6fa8dc : #8a8a8a;
        }
        TouchArea {
            moved => {
                if (self.pressed) {
                    root.dragging = true;
                    root.drag-value = Math.clamp(root.minimum + (self.mouse-x / self.width) * (root.maximum - root.minimum), root.minimum, root.maximum);
                }
            }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.up && root.dragging) {
                    root.dragging = false;
                    root.edited(root.drag-value);
                }
            }
        }
    }
}

export component StudioWindow inherits Window {
    title: "Leyline Studio — " + root.library-name;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: #1b1b1b;
    forward-focus: keys;

    in property <string> library-name;
    in property <string> status-line;
    // The loaded window of grid cells; cell `i` shows grid row
    // `window-start + i` out of `total-cells` matching rows.
    in property <[Cell]> cells;
    in property <int> total-cells;
    in property <int> window-start;
    in-out property <int> selected: -1;

    // Filter state, mirrored from the GridQuery held in Rust.
    in property <int> filter-rating; // 0 = off, else minimum stars
    in property <int> filter-label; // -1 = off, else ColorLabel encoding
    in property <int> filter-pick; // -1 = off, else PickState encoding
    in property <string> sort-label;
    in property <[color]> label-colors;
    // Active keyword filter's full path, or "" when off.
    in property <string> filter-keyword-label;

    in property <string> detail-filename;
    in property <string> detail-path;
    in property <string> detail-capture;
    in property <string> detail-dimensions;
    in property <string> detail-file-size;
    in property <string> detail-camera;
    in property <string> detail-lens;
    in property <string> detail-exposure;
    // Keyword paths of the selected photo, already flattened by Rust.
    in property <[string]> detail-keywords;

    // Develop view state, mirrored from Rust.
    in property <bool> develop-mode;
    in property <image> develop-image;
    in property <string> develop-filename;
    in property <DevSettings> dev;
    // Stored develop preset names, already ordered by Rust.
    in property <[string]> dev-presets;

    callback select(int);
    callback classify(string);
    callback rating-filter(int);
    callback label-filter(int);
    callback pick-filter(int);
    callback cycle-sort();
    callback enter-develop();
    callback exit-develop();
    callback develop-edit(string, float);
    // Mouse crop: press x/y, release x/y, viewport w/h, preview w/h (px).
    callback develop-crop-drag(float, float, float, float, float, float, float, float);
    callback develop-undo();
    callback develop-redo();
    callback develop-reprocess();
    callback reprocess-library();
    // Library::reprocess (§10.4) scoped to the currently selected photo —
    // same call as Shift+R, just bounded to one version instead of the
    // whole catalog (ADR 0021, grid context menu).
    callback reprocess-selected();
    // Apply / delete the develop preset at an index of `dev-presets`.
    callback apply-preset(int);
    callback delete-preset(int);
    callback open-preset-dialog();
    // Name, then one flag per group: white-balance, tone, presence,
    // lens-correction, detail, geometry (`docs/presets.md` §3.1).
    callback run-save-preset(string, bool, bool, bool, bool, bool, bool);
    callback run-import(string, bool, bool);
    callback open-export();
    // Stops the event loop — the menu bar's File ▸ Quit, equivalent to
    // closing the window from the OS chrome.
    callback quit();
    // preset index (-1 = ad-hoc), destination, format index, quality text, max-edge text.
    // Format/quality/max-edge are ignored when a stored preset is chosen.
    callback run-export(int, string, int, string, string);
    in-out property <int> export-format: 0;
    in-out property <string> export-quality-text: "90";
    in-out property <string> export-max-edge-text: "";

    // Modal dialog state: "" (none), "import" or "export".
    in-out property <string> dialog;
    in-out property <string> dialog-result;
    in-out property <bool> import-copy: true;
    in-out property <bool> import-recursive: true;
    in property <[string]> export-presets;
    in-out property <int> export-preset: -1;
    in property <[CollectionRow]> collections;
    in-out property <int> active-collection: -1;
    callback select-collection(int);
    callback run-new-collection(string);
    callback add-to-collection();
    callback remove-from-collection();
    // Tag the selected photo with a slash-separated keyword path, or untag
    // the keyword at an index of `detail-keywords`.
    callback add-keyword(string);
    callback remove-keyword(int);
    // Toggles the grid filter to the keyword at an index of
    // `detail-keywords` (its descendants included); clicking the active
    // one turns the filter off.
    callback keyword-filter(int);
    callback clear-keyword-filter();
    callback search(string);
    // First visible cell and how many cells fit, sent on scroll or resize.
    callback viewport-moved(int, int);

    property <length> cell-size: 176px;

    // Moves the selection to `index` and scrolls it into view.
    function select-cell(index: int) {
        if (index < 0 || index >= root.total-cells) {
            return;
        }
        root.selected = index;
        root.select(index);
        if (Math.floor(index / flick.columns) * root.cell-size < -flick.viewport-y) {
            flick.viewport-y = -Math.floor(index / flick.columns) * root.cell-size;
        } else if ((Math.floor(index / flick.columns) + 1) * root.cell-size > -flick.viewport-y + flick.height) {
            flick.viewport-y = flick.height - (Math.floor(index / flick.columns) + 1) * root.cell-size;
        }
    }

    // Native menu bar (ADR 0020): a second, discoverable path to the same
    // callbacks already wired to keyboard shortcuts above — no new
    // functionality, no new code path. Context-sensitive entries are
    // disabled outside the context where their shortcut is meaningful.
    MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "Import…    I";
                activated => {
                    root.dialog-result = "";
                    root.dialog = "import";
                }
            }
            MenuItem {
                title: "Export…    E";
                activated => {
                    root.open-export();
                }
            }
            MenuSeparator { }
            MenuItem {
                // ADR 0019 (language preferences) is decided but not yet
                // implemented: kept visible per the ADR 0020 menu map,
                // disabled until there is a preferences panel to open.
                title: "Preferences…";
                enabled: false;
            }
            MenuSeparator { }
            MenuItem {
                title: "Quit";
                activated => {
                    root.quit();
                }
            }
        }
        Menu {
            title: "Library";
            MenuItem {
                title: "New Collection…    N";
                activated => {
                    root.dialog-result = "";
                    root.dialog = "collection";
                }
            }
            MenuItem {
                title: "Add to Collection    B";
                enabled: root.selected >= 0 && root.active-collection >= 0;
                activated => {
                    root.add-to-collection();
                }
            }
            MenuItem {
                title: "Remove from Collection    Shift+B";
                enabled: root.selected >= 0 && root.active-collection >= 0;
                activated => {
                    root.remove-from-collection();
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Reprocess Library…    Shift+R";
                activated => {
                    root.reprocess-library();
                }
            }
        }
        Menu {
            title: "Photo";
            Menu {
                title: "Rate";
                MenuItem {
                    title: "1 star    1";
                    enabled: root.selected >= 0;
                    activated => {
                        root.classify("1");
                    }
                }
                MenuItem {
                    title: "2 stars    2";
                    enabled: root.selected >= 0;
                    activated => {
                        root.classify("2");
                    }
                }
                MenuItem {
                    title: "3 stars    3";
                    enabled: root.selected >= 0;
                    activated => {
                        root.classify("3");
                    }
                }
                MenuItem {
                    title: "4 stars    4";
                    enabled: root.selected >= 0;
                    activated => {
                        root.classify("4");
                    }
                }
                MenuItem {
                    title: "5 stars    5";
                    enabled: root.selected >= 0;
                    activated => {
                        root.classify("5");
                    }
                }
                MenuSeparator { }
                MenuItem {
                    title: "Clear Rating    0";
                    enabled: root.selected >= 0;
                    activated => {
                        root.classify("0");
                    }
                }
            }
            Menu {
                title: "Label";
                MenuItem {
                    title: "Red    6";
                    enabled: root.selected >= 0;
                    activated => {
                        root.classify("6");
                    }
                }
                MenuItem {
                    title: "Yellow    7";
                    enabled: root.selected >= 0;
                    activated => {
                        root.classify("7");
                    }
                }
                MenuItem {
                    title: "Green    8";
                    enabled: root.selected >= 0;
                    activated => {
                        root.classify("8");
                    }
                }
                MenuItem {
                    title: "Blue    9";
                    enabled: root.selected >= 0;
                    activated => {
                        root.classify("9");
                    }
                }
            }
            Menu {
                title: "Flag";
                MenuItem {
                    title: "Pick    P";
                    enabled: root.selected >= 0;
                    activated => {
                        root.classify("p");
                    }
                }
                MenuItem {
                    title: "Reject    X";
                    enabled: root.selected >= 0;
                    activated => {
                        root.classify("x");
                    }
                }
                MenuItem {
                    title: "Clear    U";
                    enabled: root.selected >= 0;
                    activated => {
                        root.classify("u");
                    }
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Develop    D";
                enabled: root.selected >= 0 && !root.develop-mode;
                activated => {
                    root.enter-develop();
                }
            }
            MenuItem {
                // Today `R` only reprocesses the photo open in develop —
                // same contract here: disabled outside that context rather
                // than silently acting on something else.
                title: "Reprocess    R";
                enabled: root.develop-mode;
                activated => {
                    root.develop-reprocess();
                }
            }
        }
        Menu {
            title: "Develop";
            enabled: root.develop-mode;
            MenuItem {
                title: "Undo    Ctrl+Z";
                activated => {
                    root.develop-undo();
                }
            }
            MenuItem {
                title: "Redo    Ctrl+Y";
                activated => {
                    root.develop-redo();
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Save Preset…    S";
                activated => {
                    root.open-preset-dialog();
                }
            }
            Menu {
                title: "Apply Preset";
                enabled: root.dev-presets.length > 0;
                for name[index] in root.dev-presets: MenuItem {
                    title: name;
                    activated => {
                        root.apply-preset(index);
                    }
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Back to Library    G";
                activated => {
                    root.exit-develop();
                }
            }
        }
        Menu {
            title: "View";
            MenuItem {
                title: "Library    G";
                enabled: root.develop-mode;
                activated => {
                    root.exit-develop();
                }
            }
            MenuItem {
                title: "Develop    D";
                enabled: !root.develop-mode && root.selected >= 0;
                activated => {
                    root.enter-develop();
                }
            }
        }
        Menu {
            title: "Help";
            MenuItem {
                title: "Keyboard Shortcuts…";
                activated => {
                    root.dialog-result = "";
                    root.dialog = "shortcuts";
                }
            }
            MenuItem {
                title: "About Leyline";
                activated => {
                    root.dialog-result = "";
                    root.dialog = "about";
                }
            }
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (root.dialog != "") {
                if (event.text == Key.Escape) {
                    root.dialog = "";
                }
                return accept;
            }
            if (root.develop-mode) {
                if (event.text == "g" || event.text == "G" || event.text == Key.Escape) {
                    root.exit-develop();
                    return accept;
                }
                if (event.modifiers.control && (event.text == "z" || event.text == "Z")) {
                    root.develop-undo();
                    return accept;
                }
                if (event.modifiers.control && (event.text == "y" || event.text == "Y")) {
                    root.develop-redo();
                    return accept;
                }
                if (event.text == "s" || event.text == "S") {
                    root.open-preset-dialog();
                    return accept;
                }
                if (event.text == "r" || event.text == "R") {
                    root.develop-reprocess();
                    return accept;
                }
                root.classify(event.text);
                return accept;
            }
            if (event.text == "d" || event.text == "D" || event.text == Key.Return) {
                root.enter-develop();
                return accept;
            }
            if (event.text == "i" || event.text == "I") {
                root.dialog-result = "";
                root.dialog = "import";
                return accept;
            }
            if (event.text == "e" || event.text == "E") {
                root.open-export();
                return accept;
            }
            if (event.text == "n" || event.text == "N") {
                root.dialog-result = "";
                root.dialog = "collection";
                return accept;
            }
            if (event.text == "b" || event.text == "B") {
                if (event.modifiers.shift) {
                    root.remove-from-collection();
                } else {
                    root.add-to-collection();
                }
                return accept;
            }
            if ((event.text == "r" || event.text == "R") && event.modifiers.shift) {
                root.reprocess-library();
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.select-cell(max(root.selected - 1, 0));
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.select-cell(root.selected < 0 ? 0 : root.selected + 1);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.select-cell(root.selected - flick.columns);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.select-cell(root.selected < 0 ? 0 : root.selected + flick.columns);
                return accept;
            }
            root.classify(event.text);
            accept
        }

        HorizontalLayout {
            visible: root.develop-mode;
            VerticalLayout {
                horizontal-stretch: 1;
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    Text {
                        text: root.develop-filename;
                        color: #f0f0f0;
                        font-size: 14px;
                        font-weight: 600;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: "G: library · Ctrl+Z/Y: undo/redo · S: save preset · R: reprocess · drag: crop";
                        color: #666666;
                        font-size: 12px;
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    clip: true;

                    Image {
                        source: root.develop-image;
                        image-fit: contain;
                        width: 100%;
                        height: 100%;
                    }

                    crop-drag := TouchArea {
                        mouse-cursor: crosshair;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                root.develop-crop-drag(
                                    self.pressed-x / 1px, self.pressed-y / 1px,
                                    self.mouse-x / 1px, self.mouse-y / 1px,
                                    self.width / 1px, self.height / 1px,
                                    root.develop-image.width, root.develop-image.height);
                            }
                        }
                    }

                    // Selection rectangle, live while the mouse is down.
                    Rectangle {
                        visible: crop-drag.pressed;
                        x: min(crop-drag.pressed-x, crop-drag.mouse-x);
                        y: min(crop-drag.pressed-y, crop-drag.mouse-y);
                        width: abs((crop-drag.pressed-x - crop-drag.mouse-x) / 1px) * 1px;
                        height: abs((crop-drag.pressed-y - crop-drag.mouse-y) / 1px) * 1px;
                        background: #ffffff22;
                        border-width: 1px;
                        border-color: #f0f0f0;
                    }

                    // Right-click (ADR 0021): every entry is an existing
                    // callback already wired to a keyboard shortcut or a
                    // panel control above.
                    ContextMenuArea {
                        Menu {
                            MenuItem {
                                title: "Reset Crop";
                                activated => {
                                    root.develop-edit("crop-reset", 0);
                                }
                            }
                            MenuItem {
                                // No before/after compare control exists in
                                // this build yet (kept visible, disabled,
                                // like File ▸ Preferences… in ADR 0020) —
                                // wiring one up would be new functionality,
                                // which ADR 0021 explicitly excludes.
                                title: "Compare Before/After";
                                enabled: false;
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: "Reprocess    R";
                                activated => {
                                    root.develop-reprocess();
                                }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: "Back to Library    G";
                                activated => {
                                    root.exit-develop();
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                width: 300px;
                background: #212121;

                Flickable {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        alignment: start;

                        Text {
                            text: "Presets";
                            color: #9a9a9a;
                            font-size: 11px;
                        }
                        for name[i] in root.dev-presets: HorizontalLayout {
                            spacing: 6px;
                            TouchArea {
                                horizontal-stretch: 1;
                                Text {
                                    text: name;
                                    color: #e6e6e6;
                                    font-size: 12px;
                                    overflow: elide;
                                    width: 100%;
                                    height: 100%;
                                    vertical-alignment: center;
                                }
                                clicked => {
                                    root.apply-preset(i);
                                }
                            }
                            TouchArea {
                                width: 16px;
                                height: 16px;
                                Text {
                                    text: "×";
                                    color: #9a9a9a;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                                clicked => {
                                    root.delete-preset(i);
                                }
                            }
                        }
                        HorizontalLayout {
                            alignment: end;
                            FilterChip {
                                text: "Save as preset…";
                                active: false;
                                clicked => {
                                    root.open-preset-dialog();
                                }
                            }
                        }

                        Text {
                            text: "White balance";
                            color: #9a9a9a;
                            font-size: 11px;
                        }
                        EditSlider {
                            label: "Temperature";
                            minimum: 2000;
                            maximum: 12000;
                            value: root.dev.wb-temp;
                            edited(v) => {
                                root.develop-edit("wb-temp", v);
                            }
                        }
                        EditSlider {
                            label: "Tint";
                            minimum: -100;
                            maximum: 100;
                            value: root.dev.wb-tint;
                            edited(v) => {
                                root.develop-edit("wb-tint", v);
                            }
                        }

                        Text {
                            text: "Tone";
                            color: #9a9a9a;
                            font-size: 11px;
                        }
                        EditSlider {
                            label: "Exposure";
                            minimum: -5;
                            maximum: 5;
                            decimals: 2;
                            value: root.dev.exposure;
                            edited(v) => {
                                root.develop-edit("exposure", v);
                            }
                        }
                        EditSlider {
                            label: "Contrast";
                            minimum: -100;
                            maximum: 100;
                            value: root.dev.contrast;
                            edited(v) => {
                                root.develop-edit("contrast", v);
                            }
                        }
                        EditSlider {
                            label: "Highlights";
                            minimum: -100;
                            maximum: 100;
                            value: root.dev.highlights;
                            edited(v) => {
                                root.develop-edit("highlights", v);
                            }
                        }
                        EditSlider {
                            label: "Shadows";
                            minimum: -100;
                            maximum: 100;
                            value: root.dev.shadows;
                            edited(v) => {
                                root.develop-edit("shadows", v);
                            }
                        }
                        EditSlider {
                            label: "Whites";
                            minimum: -100;
                            maximum: 100;
                            value: root.dev.whites;
                            edited(v) => {
                                root.develop-edit("whites", v);
                            }
                        }
                        EditSlider {
                            label: "Blacks";
                            minimum: -100;
                            maximum: 100;
                            value: root.dev.blacks;
                            edited(v) => {
                                root.develop-edit("blacks", v);
                            }
                        }

                        Text {
                            text: "Presence";
                            color: #9a9a9a;
                            font-size: 11px;
                        }
                        EditSlider {
                            label: "Vibrance";
                            minimum: -100;
                            maximum: 100;
                            value: root.dev.vibrance;
                            edited(v) => {
                                root.develop-edit("vibrance", v);
                            }
                        }
                        EditSlider {
                            label: "Saturation";
                            minimum: -100;
                            maximum: 100;
                            value: root.dev.saturation;
                            edited(v) => {
                                root.develop-edit("saturation", v);
                            }
                        }

                        Text {
                            text: "Lens correction";
                            color: #9a9a9a;
                            font-size: 11px;
                        }
                        FilterChip {
                            active: root.dev.lens-correction;
                            text: root.dev.lens-correction ? "Enabled" : "Disabled";
                            clicked => {
                                root.develop-edit("lens-correction", root.dev.lens-correction ? 0 : 1);
                            }
                        }

                        Text {
                            text: "Detail";
                            color: #9a9a9a;
                            font-size: 11px;
                        }
                        EditSlider {
                            label: "Luminance NR";
                            minimum: 0;
                            maximum: 100;
                            value: root.dev.nr-luminance;
                            edited(v) => {
                                root.develop-edit("nr-luminance", v);
                            }
                        }
                        EditSlider {
                            label: "Color NR";
                            minimum: 0;
                            maximum: 100;
                            value: root.dev.nr-color;
                            edited(v) => {
                                root.develop-edit("nr-color", v);
                            }
                        }
                        EditSlider {
                            label: "Sharpen amount";
                            minimum: 0;
                            maximum: 100;
                            value: root.dev.sharpen-amount;
                            edited(v) => {
                                root.develop-edit("sharpen-amount", v);
                            }
                        }
                        EditSlider {
                            label: "Sharpen radius";
                            minimum: 0.5;
                            maximum: 3;
                            decimals: 1;
                            value: root.dev.sharpen-radius;
                            edited(v) => {
                                root.develop-edit("sharpen-radius", v);
                            }
                        }

                        Text {
                            text: "Geometry";
                            color: #9a9a9a;
                            font-size: 11px;
                        }
                        EditSlider {
                            label: "Rotation";
                            minimum: -45;
                            maximum: 45;
                            decimals: 1;
                            value: root.dev.rotation;
                            edited(v) => {
                                root.develop-edit("rotation", v);
                            }
                        }
                        EditSlider {
                            label: "Crop left";
                            minimum: 0;
                            maximum: 100;
                            value: root.dev.crop-left;
                            edited(v) => {
                                root.develop-edit("crop-left", v);
                            }
                        }
                        EditSlider {
                            label: "Crop top";
                            minimum: 0;
                            maximum: 100;
                            value: root.dev.crop-top;
                            edited(v) => {
                                root.develop-edit("crop-top", v);
                            }
                        }
                        EditSlider {
                            label: "Crop width";
                            minimum: 1;
                            maximum: 100;
                            value: root.dev.crop-width;
                            edited(v) => {
                                root.develop-edit("crop-width", v);
                            }
                        }
                        EditSlider {
                            label: "Crop height";
                            minimum: 1;
                            maximum: 100;
                            value: root.dev.crop-height;
                            edited(v) => {
                                root.develop-edit("crop-height", v);
                            }
                        }
                        HorizontalLayout {
                            alignment: end;
                            FilterChip {
                                text: "Reset crop";
                                active: false;
                                clicked => {
                                    root.develop-edit("crop-reset", 0);
                                }
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            visible: !root.develop-mode;

            Rectangle {
                width: 190px;
                background: #202020;

                VerticalLayout {
                    padding: 10px;
                    spacing: 4px;

                    Text {
                        text: "Collections";
                        color: #9a9a9a;
                        font-size: 11px;
                    }

                    Rectangle {
                        height: 24px;
                        border-radius: 4px;
                        background: root.active-collection == -1 ? #2f4f6f : transparent;
                        Text {
                            x: 8px;
                            width: parent.width - 16px;
                            height: 100%;
                            text: "All photos";
                            color: #e6e6e6;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        TouchArea {
                            clicked => {
                                root.select-collection(-1);
                            }
                        }
                    }

                    Flickable {
                        vertical-stretch: 1;
                        viewport-height: root.collections.length * 26px;
                        for row[i] in root.collections: Rectangle {
                            y: i * 26px;
                            height: 24px;
                            width: parent.width;
                            border-radius: 4px;
                            background: root.active-collection == i ? #2f4f6f : transparent;
                            Text {
                                x: 8px + row.depth * 12px;
                                width: parent.width - self.x - 8px;
                                height: 100%;
                                text: (row.smart ? "◈ " : "") + row.name;
                                color: #d0d0d0;
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            TouchArea {
                                clicked => {
                                    root.select-collection(i);
                                }
                            }
                        }
                    }

                    Text {
                        text: "N: new · B: add photo";
                        color: #666666;
                        font-size: 10px;
                    }
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 2px;
                        for s in 5: TouchArea {
                            width: 18px;
                            height: 24px;
                            Text {
                                text: root.filter-rating > s ? "★" : "☆";
                                color: root.filter-rating > s ? #d8b23c : #666666;
                                font-size: 15px;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                            clicked => {
                                root.rating-filter(s + 1);
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        for l in 5: TouchArea {
                            width: 16px;
                            height: 24px;
                            Rectangle {
                                width: 12px;
                                height: 12px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 6px;
                                background: root.label-colors[l];
                                border-width: root.filter-label == l ? 2px : 0px;
                                border-color: #f0f0f0;
                                opacity: root.filter-label == l || root.filter-label == -1 ? 1 : 0.35;
                            }
                            clicked => {
                                root.label-filter(l);
                            }
                        }
                    }

                    FilterChip {
                        text: "⚑ Picked";
                        active: root.filter-pick == 1;
                        clicked => {
                            root.pick-filter(1);
                        }
                    }
                    FilterChip {
                        text: "✕ Rejected";
                        active: root.filter-pick == 2;
                        clicked => {
                            root.pick-filter(2);
                        }
                    }
                    FilterChip {
                        text: "– Unflagged";
                        active: root.filter-pick == 0;
                        clicked => {
                            root.pick-filter(0);
                        }
                    }

                    if root.filter-keyword-label != "": FilterChip {
                        text: "🏷 " + root.filter-keyword-label;
                        active: true;
                        clicked => {
                            root.clear-keyword-filter();
                        }
                    }

                    Rectangle {
                        height: 24px;
                        width: 180px;
                        background: #1b1b1b;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: search-input.text == "" ? #333333 : #6fa8dc;
                        search-input := TextInput {
                            x: 10px;
                            width: parent.width - 20px;
                            height: 100%;
                            color: #e6e6e6;
                            font-size: 12px;
                            vertical-alignment: center;
                            single-line: true;
                            accepted => {
                                root.search(self.text);
                                keys.focus();
                            }
                        }
                        if search-input.text == "" && !search-input.has-focus: Text {
                            x: 10px;
                            height: 100%;
                            text: "Search…";
                            color: #666666;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    FilterChip {
                        text: "Sort: " + root.sort-label;
                        active: false;
                        clicked => {
                            root.cycle-sort();
                        }
                    }
                }

                Text {
                    text: root.status-line;
                    color: #9a9a9a;
                    font-size: 13px;
                }

                flick := Flickable {
                    property <int> columns: max(1, Math.floor(self.width / root.cell-size));
                    // Virtual scrolling: only the loaded window has cells, but
                    // the viewport spans the whole grid; scrolling or resizing
                    // asks Rust for the matching window.
                    property <int> first-cell: Math.floor(-self.viewport-y / root.cell-size) * self.columns;
                    property <int> visible-cells: (Math.ceil(self.height / root.cell-size) + 1) * self.columns;
                    viewport-height: Math.ceil(root.total-cells / self.columns) * root.cell-size;
                    changed first-cell => {
                        root.viewport-moved(self.first-cell, self.visible-cells);
                    }
                    changed visible-cells => {
                        root.viewport-moved(self.first-cell, self.visible-cells);
                    }

                    for cell[i] in root.cells: Rectangle {
                        x: Math.mod(root.window-start + i, flick.columns) * root.cell-size;
                        y: Math.floor((root.window-start + i) / flick.columns) * root.cell-size;
                        width: root.cell-size;
                        height: root.cell-size;

                        Rectangle {
                            x: 4px;
                            y: 4px;
                            width: parent.width - 8px;
                            height: parent.height - 8px;
                            background: root.window-start + i == root.selected ? #2f4f6f : #242424;
                            border-radius: 4px;
                            border-width: root.window-start + i == root.selected ? 2px : 1px;
                            border-color: root.window-start + i == root.selected ? #6fa8dc : #333333;

                            VerticalLayout {
                                padding: 6px;
                                spacing: 4px;

                                Image {
                                    source: cell.thumbnail;
                                    image-fit: contain;
                                    vertical-stretch: 1;
                                }
                                HorizontalLayout {
                                    spacing: 4px;
                                    if cell.has-label: Rectangle {
                                        width: 10px;
                                        height: 10px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 5px;
                                        background: cell.label;
                                    }
                                    Text {
                                        text: cell.filename;
                                        color: #d0d0d0;
                                        font-size: 11px;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: cell.stars;
                                        color: #d8b23c;
                                        font-size: 11px;
                                    }
                                }
                            }
                        }

                        TouchArea {
                            clicked => {
                                root.selected = root.window-start + i;
                                root.select(root.window-start + i);
                            }
                            double-clicked => {
                                root.selected = root.window-start + i;
                                root.select(root.window-start + i);
                                root.enter-develop();
                            }
                        }

                        // Right-click (ADR 0021): a second, per-photo path
                        // to the same classement/collection/reprocess
                        // callbacks already wired above and to the
                        // MenuBar (ADR 0020). No multi-select exists in
                        // this app yet, so — like every keyboard shortcut
                        // and menu-bar entry — this acts on the single
                        // `selected` index, which right-click sets first
                        // exactly like a left click does.
                        ContextMenuArea {
                            Menu {
                                MenuItem {
                                    title: "Develop    D";
                                    activated => {
                                        root.selected = root.window-start + i;
                                        root.select(root.window-start + i);
                                        root.enter-develop();
                                    }
                                }
                                MenuSeparator { }
                                Menu {
                                    title: "Rate";
                                    MenuItem {
                                        title: "1 star    1";
                                        activated => {
                                            root.selected = root.window-start + i;
                                            root.select(root.window-start + i);
                                            root.classify("1");
                                        }
                                    }
                                    MenuItem {
                                        title: "2 stars    2";
                                        activated => {
                                            root.selected = root.window-start + i;
                                            root.select(root.window-start + i);
                                            root.classify("2");
                                        }
                                    }
                                    MenuItem {
                                        title: "3 stars    3";
                                        activated => {
                                            root.selected = root.window-start + i;
                                            root.select(root.window-start + i);
                                            root.classify("3");
                                        }
                                    }
                                    MenuItem {
                                        title: "4 stars    4";
                                        activated => {
                                            root.selected = root.window-start + i;
                                            root.select(root.window-start + i);
                                            root.classify("4");
                                        }
                                    }
                                    MenuItem {
                                        title: "5 stars    5";
                                        activated => {
                                            root.selected = root.window-start + i;
                                            root.select(root.window-start + i);
                                            root.classify("5");
                                        }
                                    }
                                    MenuSeparator { }
                                    MenuItem {
                                        title: "Clear Rating    0";
                                        activated => {
                                            root.selected = root.window-start + i;
                                            root.select(root.window-start + i);
                                            root.classify("0");
                                        }
                                    }
                                }
                                Menu {
                                    title: "Label";
                                    MenuItem {
                                        title: "Red    6";
                                        activated => {
                                            root.selected = root.window-start + i;
                                            root.select(root.window-start + i);
                                            root.classify("6");
                                        }
                                    }
                                    MenuItem {
                                        title: "Yellow    7";
                                        activated => {
                                            root.selected = root.window-start + i;
                                            root.select(root.window-start + i);
                                            root.classify("7");
                                        }
                                    }
                                    MenuItem {
                                        title: "Green    8";
                                        activated => {
                                            root.selected = root.window-start + i;
                                            root.select(root.window-start + i);
                                            root.classify("8");
                                        }
                                    }
                                    MenuItem {
                                        title: "Blue    9";
                                        activated => {
                                            root.selected = root.window-start + i;
                                            root.select(root.window-start + i);
                                            root.classify("9");
                                        }
                                    }
                                }
                                Menu {
                                    title: "Flag";
                                    MenuItem {
                                        title: "Pick    P";
                                        activated => {
                                            root.selected = root.window-start + i;
                                            root.select(root.window-start + i);
                                            root.classify("p");
                                        }
                                    }
                                    MenuItem {
                                        title: "Reject    X";
                                        activated => {
                                            root.selected = root.window-start + i;
                                            root.select(root.window-start + i);
                                            root.classify("x");
                                        }
                                    }
                                    MenuItem {
                                        title: "Clear    U";
                                        activated => {
                                            root.selected = root.window-start + i;
                                            root.select(root.window-start + i);
                                            root.classify("u");
                                        }
                                    }
                                }
                                MenuSeparator { }
                                MenuItem {
                                    title: "Add to Collection    B";
                                    enabled: root.active-collection >= 0;
                                    activated => {
                                        root.selected = root.window-start + i;
                                        root.select(root.window-start + i);
                                        root.add-to-collection();
                                    }
                                }
                                MenuItem {
                                    title: "Remove from Collection    Shift+B";
                                    enabled: root.active-collection >= 0;
                                    activated => {
                                        root.selected = root.window-start + i;
                                        root.select(root.window-start + i);
                                        root.remove-from-collection();
                                    }
                                }
                                MenuSeparator { }
                                MenuItem {
                                    // Library::reprocess (§10.4) on this photo
                                    // alone — not the EditSession::reprocess
                                    // path behind `R`, which needs an open
                                    // develop session. Same call as
                                    // Shift+R, scoped to one version.
                                    title: "Reprocess";
                                    activated => {
                                        root.selected = root.window-start + i;
                                        root.select(root.window-start + i);
                                        root.reprocess-selected();
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                width: 300px;
                background: #212121;

                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    alignment: start;

                    Text {
                        text: root.selected < 0 ? "No photo selected" : root.detail-filename;
                        color: #f0f0f0;
                        font-size: 15px;
                        font-weight: 600;
                        overflow: elide;
                    }
                    if root.selected >= 0: VerticalLayout {
                        spacing: 6px;
                        DetailRow {
                            label: "Path";
                            value: root.detail-path;
                        }
                        DetailRow {
                            label: "Captured";
                            value: root.detail-capture;
                        }
                        DetailRow {
                            label: "Size";
                            value: root.detail-dimensions;
                        }
                        DetailRow {
                            label: "File";
                            value: root.detail-file-size;
                        }
                        DetailRow {
                            label: "Camera";
                            value: root.detail-camera;
                        }
                        DetailRow {
                            label: "Lens";
                            value: root.detail-lens;
                        }
                        DetailRow {
                            label: "Exposure";
                            value: root.detail-exposure;
                        }

                        Text {
                            text: "Keywords";
                            color: #9a9a9a;
                            font-size: 11px;
                        }
                        for kw[i] in root.detail-keywords: HorizontalLayout {
                            spacing: 6px;
                            TouchArea {
                                horizontal-stretch: 1;
                                Text {
                                    text: kw;
                                    color: root.filter-keyword-label == kw ? #6fa8dc : #e6e6e6;
                                    font-size: 12px;
                                    overflow: elide;
                                    width: 100%;
                                    height: 100%;
                                    vertical-alignment: center;
                                }
                                clicked => {
                                    root.keyword-filter(i);
                                }
                            }
                            TouchArea {
                                width: 16px;
                                height: 16px;
                                Text {
                                    text: "×";
                                    color: #9a9a9a;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                                clicked => {
                                    root.remove-keyword(i);
                                }
                            }
                        }
                        Rectangle {
                            height: 24px;
                            background: #1b1b1b;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: keyword-input.text == "" ? #333333 : #6fa8dc;
                            keyword-input := TextInput {
                                x: 8px;
                                width: parent.width - 16px;
                                height: 100%;
                                color: #e6e6e6;
                                font-size: 12px;
                                vertical-alignment: center;
                                single-line: true;
                                accepted => {
                                    root.add-keyword(self.text);
                                    self.text = "";
                                    keys.focus();
                                }
                            }
                            if keyword-input.text == "" && !keyword-input.has-focus: Text {
                                x: 8px;
                                height: 100%;
                                text: "Add keyword (Nature/Birds)…";
                                color: #666666;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Modal overlay: import and export dialogs.
        Rectangle {
            visible: root.dialog != "";
            background: #000000aa;
            TouchArea {
                clicked => {
                    root.dialog = "";
                }
            }

            Rectangle {
                width: 480px;
                background: #262626;
                border-radius: 8px;
                border-width: 1px;
                border-color: #3a3a3a;
                height: body.preferred-height;
                TouchArea { }

                body := VerticalLayout {
                    padding: 20px;
                    spacing: 12px;

                    if root.dialog == "import": VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: "Import photos";
                            color: #f0f0f0;
                            font-size: 15px;
                            font-weight: 600;
                        }
                        Text {
                            text: "Source folder (absolute path)";
                            color: #9a9a9a;
                            font-size: 12px;
                        }
                        Rectangle {
                            height: 28px;
                            background: #1b1b1b;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #3a3a3a;
                            import-source := TextInput {
                                x: 8px;
                                width: parent.width - 16px;
                                height: 100%;
                                color: #e6e6e6;
                                font-size: 12px;
                                vertical-alignment: center;
                                single-line: true;
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            FilterChip {
                                text: "Copy into library";
                                active: root.import-copy;
                                clicked => {
                                    root.import-copy = !root.import-copy;
                                }
                            }
                            FilterChip {
                                text: "Recursive";
                                active: root.import-recursive;
                                clicked => {
                                    root.import-recursive = !root.import-recursive;
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            FilterChip {
                                text: "Cancel";
                                active: false;
                                clicked => {
                                    root.dialog = "";
                                }
                            }
                            FilterChip {
                                text: "Import";
                                active: true;
                                clicked => {
                                    root.run-import(import-source.text, root.import-copy, root.import-recursive);
                                }
                            }
                        }
                    }

                    if root.dialog == "export": VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: "Export selected photo";
                            color: #f0f0f0;
                            font-size: 15px;
                            font-weight: 600;
                        }
                        Text {
                            text: "Preset";
                            color: #9a9a9a;
                            font-size: 12px;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            FilterChip {
                                text: "Custom";
                                active: root.export-preset == -1;
                                clicked => {
                                    root.export-preset = -1;
                                }
                            }
                            for name[i] in root.export-presets: FilterChip {
                                text: name;
                                active: root.export-preset == i;
                                clicked => {
                                    root.export-preset = i;
                                }
                            }
                        }
                        if root.export-preset == -1: VerticalLayout {
                            spacing: 8px;
                            Text {
                                text: "Format";
                                color: #9a9a9a;
                                font-size: 12px;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                for name[i] in ["JPEG", "PNG", "TIFF", "WebP", "AVIF"]: FilterChip {
                                    text: name;
                                    active: root.export-format == i;
                                    clicked => {
                                        root.export-format = i;
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    spacing: 4px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: "Quality (1-100)";
                                        color: #9a9a9a;
                                        font-size: 12px;
                                    }
                                    Rectangle {
                                        height: 28px;
                                        background: #1b1b1b;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: #3a3a3a;
                                        TextInput {
                                            x: 8px;
                                            width: parent.width - 16px;
                                            height: 100%;
                                            text <=> root.export-quality-text;
                                            color: #e6e6e6;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            single-line: true;
                                        }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: "Max edge px (blank = full size)";
                                        color: #9a9a9a;
                                        font-size: 12px;
                                    }
                                    Rectangle {
                                        height: 28px;
                                        background: #1b1b1b;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: #3a3a3a;
                                        TextInput {
                                            x: 8px;
                                            width: parent.width - 16px;
                                            height: 100%;
                                            text <=> root.export-max-edge-text;
                                            color: #e6e6e6;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            single-line: true;
                                        }
                                    }
                                }
                            }
                        }
                        Text {
                            text: "Destination folder (absolute path)";
                            color: #9a9a9a;
                            font-size: 12px;
                        }
                        Rectangle {
                            height: 28px;
                            background: #1b1b1b;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #3a3a3a;
                            export-destination := TextInput {
                                x: 8px;
                                width: parent.width - 16px;
                                height: 100%;
                                color: #e6e6e6;
                                font-size: 12px;
                                vertical-alignment: center;
                                single-line: true;
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            FilterChip {
                                text: "Cancel";
                                active: false;
                                clicked => {
                                    root.dialog = "";
                                }
                            }
                            FilterChip {
                                text: "Export";
                                active: true;
                                clicked => {
                                    root.run-export(
                                        root.export-preset,
                                        export-destination.text,
                                        root.export-format,
                                        root.export-quality-text,
                                        root.export-max-edge-text,
                                    );
                                }
                            }
                        }
                    }

                    if root.dialog == "collection": VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: "New collection";
                            color: #f0f0f0;
                            font-size: 15px;
                            font-weight: 600;
                        }
                        Text {
                            text: "Name";
                            color: #9a9a9a;
                            font-size: 12px;
                        }
                        Rectangle {
                            height: 28px;
                            background: #1b1b1b;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #3a3a3a;
                            collection-name := TextInput {
                                x: 8px;
                                width: parent.width - 16px;
                                height: 100%;
                                color: #e6e6e6;
                                font-size: 12px;
                                vertical-alignment: center;
                                single-line: true;
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            FilterChip {
                                text: "Cancel";
                                active: false;
                                clicked => {
                                    root.dialog = "";
                                }
                            }
                            FilterChip {
                                text: "Create";
                                active: true;
                                clicked => {
                                    root.run-new-collection(collection-name.text);
                                }
                            }
                        }
                    }

                    if root.dialog == "preset": save-group := VerticalLayout {
                        spacing: 12px;
                        property <bool> g-white-balance: true;
                        property <bool> g-tone: true;
                        property <bool> g-presence: true;
                        property <bool> g-lens-correction: false;
                        property <bool> g-detail: false;
                        property <bool> g-geometry: false;

                        Text {
                            text: "Save as preset";
                            color: #f0f0f0;
                            font-size: 15px;
                            font-weight: 600;
                        }
                        Text {
                            text: "Name";
                            color: #9a9a9a;
                            font-size: 12px;
                        }
                        Rectangle {
                            height: 28px;
                            background: #1b1b1b;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #3a3a3a;
                            preset-name := TextInput {
                                x: 8px;
                                width: parent.width - 16px;
                                height: 100%;
                                color: #e6e6e6;
                                font-size: 12px;
                                vertical-alignment: center;
                                single-line: true;
                            }
                        }
                        Text {
                            text: "Groups (geometry is rarely reused across photos)";
                            color: #9a9a9a;
                            font-size: 12px;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            FilterChip {
                                text: "White balance";
                                active: save-group.g-white-balance;
                                clicked => {
                                    save-group.g-white-balance = !save-group.g-white-balance;
                                }
                            }
                            FilterChip {
                                text: "Tone";
                                active: save-group.g-tone;
                                clicked => {
                                    save-group.g-tone = !save-group.g-tone;
                                }
                            }
                            FilterChip {
                                text: "Presence";
                                active: save-group.g-presence;
                                clicked => {
                                    save-group.g-presence = !save-group.g-presence;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            FilterChip {
                                text: "Lens correction";
                                active: save-group.g-lens-correction;
                                clicked => {
                                    save-group.g-lens-correction = !save-group.g-lens-correction;
                                }
                            }
                            FilterChip {
                                text: "Detail";
                                active: save-group.g-detail;
                                clicked => {
                                    save-group.g-detail = !save-group.g-detail;
                                }
                            }
                            FilterChip {
                                text: "Geometry";
                                active: save-group.g-geometry;
                                clicked => {
                                    save-group.g-geometry = !save-group.g-geometry;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            FilterChip {
                                text: "Cancel";
                                active: false;
                                clicked => {
                                    root.dialog = "";
                                }
                            }
                            FilterChip {
                                text: "Save";
                                active: true;
                                clicked => {
                                    root.run-save-preset(
                                        preset-name.text,
                                        save-group.g-white-balance,
                                        save-group.g-tone,
                                        save-group.g-presence,
                                        save-group.g-lens-correction,
                                        save-group.g-detail,
                                        save-group.g-geometry);
                                }
                            }
                        }
                    }

                    // Help ▸ Keyboard Shortcuts…: the shortcut list already
                    // in this file, made discoverable outside develop mode
                    // too. Designing a dedicated panel is out of scope for
                    // ADR 0020 — this is the minimal read-only stand-in.
                    if root.dialog == "shortcuts": VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: "Keyboard shortcuts";
                            color: #f0f0f0;
                            font-size: 15px;
                            font-weight: 600;
                        }
                        Text {
                            text: "G / D — library / develop\nI — import · E — export · N — new collection\nB / Shift+B — add / remove from collection\nShift+R — reprocess library · R — reprocess (develop)\nCtrl+Z / Ctrl+Y — undo / redo · S — save preset\n0–5 — rate · 6–9 — color label · P / X / U — pick / reject / clear";
                            color: #c8c8c8;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            FilterChip {
                                text: "Close";
                                active: true;
                                clicked => {
                                    root.dialog = "";
                                }
                            }
                        }
                    }

                    if root.dialog == "about": VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: "Leyline Studio";
                            color: #f0f0f0;
                            font-size: 15px;
                            font-weight: 600;
                        }
                        Text {
                            text: "Local-first, non-destructive RAW development.";
                            color: #c8c8c8;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            FilterChip {
                                text: "Close";
                                active: true;
                                clicked => {
                                    root.dialog = "";
                                }
                            }
                        }
                    }

                    if root.dialog-result != "": Text {
                        text: root.dialog-result;
                        color: #d8b23c;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
