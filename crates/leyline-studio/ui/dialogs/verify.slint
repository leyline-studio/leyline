// File ▸ Verify an Export… (ADR 0153 §4, §6): is this file one this library
// wrote, and from what?
//
// One of the dialogs hosted by `panels/dialogs.slint` (ADR 0045 §3).
//
// The headline never says "authentic": a checksum says the bytes are the
// same, not who wrote them (ADR 0153 §4).

import { Theme } from "../theme.slint";
import { DialogState } from "../state/dialog.slint";
import { DetailRow, FilterChip } from "../widgets/controls.slint";

export component VerifyDialog inherits VerticalLayout {
    spacing: 12px;
    Text {
        text: DialogState.verify-verdict == "intact" ? @tr("Exported from this library, unchanged since.")
            : DialogState.verify-verdict == "modified" ? @tr("Exported from this library, changed since.")
            : DialogState.verify-verdict == "unknown" ? @tr("Not an export this library knows.")
            : @tr("This file could not be read.");
        color: Theme.text;
        font-size: 15px;
        font-weight: 600;
        wrap: word-wrap;
    }
    Text {
        text: DialogState.verify-verdict == "intact" ? @tr("Its bytes are the ones the export wrote.")
            : DialogState.verify-verdict == "modified" ? @tr("It names a revision this library exported, but its bytes are not the ones written: re-saved, re-compressed or edited elsewhere.")
            : DialogState.verify-verdict == "unknown" ? @tr("Neither its bytes nor the revision it names are in this library's export journal. It may come from another library, from an export made before the journal kept them, or from elsewhere.")
            : DialogState.verify-error;
        color: Theme.text-dim;
        font-size: 12px;
        wrap: word-wrap;
    }
    VerticalLayout {
        spacing: 6px;
        DetailRow {
            label: @tr("File");
            value: DialogState.verify-file;
        }
        if DialogState.verify-photo != "": DetailRow {
            label: @tr("Photo");
            value: DialogState.verify-photo;
        }
        if DialogState.verify-when != "": DetailRow {
            label: @tr("Exported");
            value: DialogState.verify-when;
        }
        if DialogState.verify-recipe != "": DetailRow {
            label: @tr("Recipe");
            value: DialogState.verify-recipe;
        }
        if DialogState.verify-destination != "": DetailRow {
            label: @tr("Written to");
            value: DialogState.verify-destination;
        }
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: end;
        FilterChip {
            text: @tr("Verify Another…");
            active: false;
            clicked => {
                DialogState.verify-export();
            }
        }
        FilterChip {
            text: @tr("Close");
            active: true;
            clicked => {
                DialogState.dialog = "";
            }
        }
    }
}
