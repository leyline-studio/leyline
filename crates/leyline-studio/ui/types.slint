// Data types shared across the Studio UI, and the translation helpers Rust
// calls into (ADR 0045 §3).
//
// The structs below are the Rust ↔ UI contract: every catalog value (dates,
// sizes, exposure, ratings…) arrives already formatted from Rust — the UI
// never interprets those itself — and every filter or classement decision
// is made in Rust too. The one exception is prose meant for translation
// (ADR 0019), assembled through the `Tr` global at the bottom of this file,
// because `@tr(...)` — and therefore `slint-tr-extractor` — only sees
// strings written in `.slint` files.
//
// Kept apart from `state/`: these are types the generated Rust imports as
// types, whereas a global is a runtime access point. Merging the two would
// recreate a catch-all file.

export struct Cell {
    thumbnail: image,
    filename: string,
    stars: string,
    label: color,
    has-label: bool,
    // Part of a multi-selection (Ctrl/Shift-click), independent of `selected`
    // — the single-index focus/anchor kept for keyboard nav and the detail
    // panel.
    multi-selected: bool,
    // The three badges of a cell (ADR 0055 §5): kept apart rather than
    // pre-composed into a string, because they sit in different corners.
    flagged: bool,
    rejected: bool,
    edited: bool,
    // A camera rendering of the same shot is attached to this photo
    // (ADR 0079 §6).
    paired: bool,
    // How many develop versions the asset carries (ADR 0094 §1). Above one,
    // the cell says so — the grid still shows one cell per photo.
    version-count: int,
    // The volume holding this photograph is not plugged in (ADR 0085 §5).
    // **Offline, not missing**: the cell keeps its thumbnail, its rating and
    // its place — what it cannot do is give up its pixels.
    offline: bool,
}

// One entry of the camera-profile browser (ADR 0089 §1): the open photo as
// that profile renders it, and its name.
//
// The first entry is always "no profile", which is a real choice and not an
// empty state — its `path` is empty, and that is how Rust tells it apart.
export struct ProfileRow {
    name: string,
    // Library-relative path, empty for "no profile".
    path: string,
    // The open photo rendered through this profile. Nothing was committed
    // to obtain it.
    thumbnail: image,
    selected: bool,
}

// One row of the develop presets panel (ADR 0058 §1–§3), already flattened
// by Rust the way `CollectionRow` is — one level of folders, so `is-folder`
// and nothing deeper.
export struct PresetRow {
    name: string,
    // What the preset changes, in plain terms — "Exposure +0.35 · Contrast
    // +12" (ADR 0058 §3). Empty on a folder row, and empty on a preset whose
    // groups have nothing worth naming.
    summary: string,
    is-folder: bool,
    // Folder rows only.
    expanded: bool,
    count: int,
    // Preset rows only. Favourites are listed first (ADR 0058 §2).
    favourite: bool,
    // Index into the library's preset list — what `apply-preset` and
    // `delete-preset` already take. `-1` on a folder row, where it is the
    // folder's own index into the folder list instead.
    index: int,
}

// One exposure control of the tethered-capture bar (ADR 0087 §3).
//
// `id` is the stable identifier Rust round-trips (`shutter`, `aperture`,
// `iso`, `wb`) — the label is derived from it by `Tr.tether-setting` so the
// four names live where `slint-tr-extractor` can see them. `value` is the
// camera's own spelling ("1/160", "5.6", "2000"), never reformatted here.
export struct TetherControl {
    id: string,
    value: string,
    // The body will accept a new value here. False for a setting it reports
    // but refuses to have set — a mode dial on M, an aperture on a manual
    // lens: shown, not offered.
    settable: bool,
}

// One row of the collections sidebar, already flattened by Rust.
export struct CollectionRow {
    name: string,
    depth: int,
    smart: bool,
}

// One photo of the survey view (ADR 0057 §4): the preview Rust already had
// in cache, and the name under it. Its index in the list is what a removal
// reports back.
export struct SurveyCell {
    image: image,
    filename: string,
}

// One line of the import contact sheet (ADR 0065 §5): a file the library
// does not have yet, shown before anyone decides to take it.
//
// The picture is the preview the camera itself wrote inside the file — no
// asset exists yet, so there is nothing else it could be.
export struct CandidateRow {
    filename: string,
    // Body and size, in one already-formatted line: Rust formats, the panel
    // displays (ADR 0045 §2).
    detail: string,
    thumbnail: image,
    // A file of that name and size is already in the library. Unticked by
    // default, never hidden.
    already: bool,
    selected: bool,
}

// One root the library references (ADR 0085 §8). Rust formats `location`,
// including the word shown when there is nowhere to show: the panel displays
// (ADR 0045 §2).
export struct RootRow {
    name: string,
    // The identity. Shown because it is what `root-locate` needs, and what a
    // user has to be able to read off the screen to type back.
    uuid: string,
    location: string,
    // Reachable right now. False means **offline, not missing**: the photos
    // are still catalogued and still browsable.
    online: bool,
    // The library's own root, which cannot be forgotten.
    is-library: bool,
}

// One row of the folder tree in the sidebar (ADR 0055 §2). Rust sends the
// last path segment and the depth it sits at — the panel indents, and never
// splits a path itself.
export struct FolderRow {
    name: string,
    depth: int,
    // Photos directly in that folder; shown as-is, blank when none.
    count: int,
}

// One tone-curve control point marker, already mapped into the curve
// canvas' own pixel space by `develop::curve_layout`.
export struct CurveMarker {
    x: float,
    y: float,
}

// One GPS pin, already projected into the map canvas' own pixel space by
// `map_view::render` (ADR 0040).
export struct MapPinMarker {
    x: float,
    y: float,
}

// One HSL mixer band's current values (ADR 0031), mirrored from
// `Settings::hsl[i]`.
export struct HslBandValues {
    hue: float,
    saturation: float,
    luminance: float,
}

// One color grading zone's current values (ADR 0031), mirrored from
// `Settings::color_grading.{shadows,midtones,highlights}`.
export struct ColorGradingZoneValues {
    hue: float,
    saturation: float,
    luminance: float,
}

// One brush dab of a local adjustment's mask, in [0, 1] image coordinates
// (ADR 0026) — what the preview outline draws (ADR 0049 §5).
export struct MaskDab {
    x: float,
    y: float,
    radius: float,
}

// One keystone guide (ADR 0119), in the displayed frame's own units so the
// overlay follows the photograph through a window resize. The pre-crop
// coordinates the solver actually needs never cross to the panel: it draws
// this and nothing else.
export struct KeystoneGuide {
    x1: float,
    y1: float,
    x2: float,
    y2: float,
}

// One entry of `Settings::local_adjustments` (ADR 0029, ADR 0048), mirrored
// by `models::mask_rows` for the local-adjustment panel (ADR 0049).
//
// The whole list is mirrored rather than only the selected entry: which row is
// selected never crosses to Rust (ADR 0045 §2), so the panel reads the row it
// is showing straight out of this model and names its index when it edits.
//
// The `-on` flags stand for a value being *set* rather than zero: an
// adjustment's fields are `Option`s, and "not set" is not the same as 0
// (ADR 0049 §3).
// One detection an installed detector offers (ADR 0073 §3). Discovered at
// launch, so the panel shows nothing at all when nothing is installed — which
// is every installation until someone adds a detector.
export struct DetectionRow {
    // "<detector id>/<detection id>", the pair Rust needs to run it. Opaque
    // to the panel, which only hands it back.
    key: string,
    // The detector's own words, never translated here: it alone knows what
    // its model was trained on (`leyline_detect::Detection`).
    label: string,
}

export struct MaskRow {
    // "radial", "gradient", "brush" or "everything".
    kind: string,
    // The geometry in words, already formatted by Rust — positions in percent,
    // dab counts — since the UI never formats a stored value itself.
    geometry: string,
    // Percent, like every [0, 1] field below.
    opacity: float,
    // Radial only, ignored by the panel for the other kinds.
    feather: float,
    inverted: bool,
    // Local white balance: the pair is set together or not at all, since
    // neither field has a neutral value (ADR 0049 §3).
    wb-on: bool,
    temperature: float,
    tint: float,
    exposure: float,
    contrast: float,
    highlights: float,
    shadows: float,
    whites: float,
    blacks: float,
    vibrance: float,
    saturation: float,
    // The five operators that read a neighbourhood (ADR 0108). Clarity,
    // texture and sharpness run [-100, 100] — the negative half is the
    // softening nothing else in the panel can do; the two noise sliders
    // have no meaningful negative and run [0, 100].
    clarity: float,
    texture: float,
    sharpness: float,
    noise-luminance: float,
    noise-color: float,
    // The defringe pair on a mask (ADR 0116), in [0, 100].
    defringe-purple: float,
    defringe-green: float,
    range-luminance-on: bool,
    lum-min: float,
    lum-max: float,
    lum-softness: float,
    range-color-on: bool,
    // Degrees, all three.
    color-center: float,
    color-width: float,
    color-softness: float,
    // Geometry in [0, 1] image coordinates, for the preview outline: center
    // and radii of a radial, both ends of a gradient, every dab of a brush.
    cx: float,
    cy: float,
    rx: float,
    ry: float,
    x0: float,
    y0: float,
    x1: float,
    y1: float,
    dabs: [MaskDab],
}

// Develop slider values, mirrored from the Settings held in Rust.
export struct DevSettings {
    exposure: float,
    contrast: float,
    highlights: float,
    shadows: float,
    whites: float,
    blacks: float,
    clarity: float,
    texture: float,
    dehaze: float,
    highlight-rolloff: float,
    vibrance: float,
    saturation: float,
    wb-temp: float,
    wb-tint: float,
    rotation: float,
    // Perspective correction (ADR 0052), both sliders in [-100, 100].
    perspective-vertical: float,
    perspective-horizontal: float,
    crop-left: float,
    crop-top: float,
    crop-width: float,
    crop-height: float,
    nr-luminance: float,
    nr-color: float,
    sharpen-amount: float,
    sharpen-radius: float,
    // Confines sharpening to edges (ADR 0096). 0 sharpens everything,
    // which is what v1 always did.
    sharpen-masking: float,
    // The vignette drawn on the composed frame, and film grain (ADR 0090).
    // Four values and three: a shape and a strength are one tool, so the
    // engine commits each group whole.
    vignette-amount: float,
    vignette-midpoint: float,
    vignette-roundness: float,
    vignette-feather: float,
    grain-amount: float,
    grain-size: float,
    grain-roughness: float,
    grain-color: float,
    // Black and white (ADR 0088 §3): one flag, and turning it off gives
    // the photo back exactly as it was — nothing else moved.
    monochrome: bool,
    lens-correction: bool,
    // Manual transverse chromatic aberration (ADR 0111), percent of the
    // radius: measured by the button beside them, or dragged by hand.
    lens-tca-red: float,
    lens-tca-blue: float,
    // Defringe (ADR 0113), beside the aberration pair it belongs with.
    defringe-purple: float,
    defringe-green: float,
    // Whether the referenced camera profile is applied (ADR 0035); its
    // name lives in `camera-profile-name`, empty when none is referenced.
    camera-profile: bool,
    // What the decoder does with channels that saturated at the sensor
    // (ADR 0050): "clip", "blend" or "rebuild".
    highlight-reconstruction: string,
    // Which interpolation the decoder uses (ADR 0061): "ahd", "vng", "dcb"
    // or "dht". No effect on thumbnail/small previews, which decode at half
    // size and skip interpolation — the panel says so.
    demosaic: string,
    // Creative LUT (ADR 0053): whether the referenced look is applied, and its
    // dose. The file name lives in `lut-name`, empty when none is referenced.
    lut: bool,
    lut-strength: float,
    // Fixed order: red, orange, yellow, green, aqua, blue, purple, magenta
    // (ADR 0031) — always exactly 8 entries.
    hsl: [HslBandValues],
    color-grading-shadows: ColorGradingZoneValues,
    color-grading-midtones: ColorGradingZoneValues,
    color-grading-highlights: ColorGradingZoneValues,
    color-grading-balance: float,
    color-grading-blending: float,
}

// Translated templates for the status-line and dialog messages Rust builds
// from catalog numbers (counts, paths, error text…). Slint 1.13 has no
// public `slint::tr!()` for Rust code — translation is a `.slint`-only
// mechanism — so Rust supplies the numbers and calls these functions
// instead of formatting the sentence itself; `slint-tr-extractor` picks up
// the `@tr(...)` calls below exactly like any other UI string.
export global Tr {
    // The field names of a preset's summary line (ADR 0058 §3). Same
    // reason as `tether-setting` below: Rust assembles the sentence, and a
    // string built in Rust is a string no `.pot` ever learns about.
    public pure function preset-field(id: string) -> string {
        if (id == "wb") {
            return @tr("White balance");
        }
        if (id == "temperature") {
            return @tr("Temperature");
        }
        if (id == "exposure") {
            return @tr("Exposure");
        }
        if (id == "contrast") {
            return @tr("Contrast");
        }
        if (id == "highlights") {
            return @tr("Highlights");
        }
        if (id == "shadows") {
            return @tr("Shadows");
        }
        if (id == "whites") {
            return @tr("Whites");
        }
        if (id == "blacks") {
            return @tr("Blacks");
        }
        if (id == "vibrance") {
            return @tr("Vibrance");
        }
        if (id == "saturation") {
            return @tr("Saturation");
        }
        if (id == "lens") {
            return @tr("Lens correction");
        }
        if (id == "noise") {
            return @tr("Noise reduction");
        }
        if (id == "sharpening") {
            return @tr("Sharpening");
        }
        if (id == "rotation") {
            return @tr("Rotation");
        }
        if (id == "crop") {
            return @tr("Crop");
        }
        if (id == "as-shot") {
            return @tr("as shot");
        }
        return id;
    }
    // The first row of the camera-profile browser (ADR 0089 §2): a real
    // choice, not an empty state.
    public pure function no-camera-profile() -> string {
        return @tr("No profile — the decoder's own colors");
    }
    // The root of the presets panel, where an unfiled preset sits.
    public pure function preset-root-folder() -> string {
        return @tr("My presets");
    }

    // The four labels of the tethered-capture bar (ADR 0087 §3). Written
    // here rather than carried in `TetherControl` so the extractor sees
    // them: Rust builds that model, and a string built in Rust is a string
    // no `.pot` ever learns about.
    public pure function tether-setting(id: string) -> string {
        if (id == "shutter") {
            return @tr("Shutter");
        }
        if (id == "aperture") {
            return @tr("Aperture");
        }
        if (id == "iso") {
            return @tr("ISO");
        }
        if (id == "wb") {
            return @tr("WB");
        }
        return id;
    }
    public pure function tether-captured(n: int) -> string {
        return @tr("{} shot" | "{} shots" % n, n);
    }
    public pure function photo-count(n: int) -> string {
        return @tr("{} photo" | "{} photos" % n, n);
    }
    public pure function importing-progress(done: int, total: int) -> string {
        return @tr("Importing {}/{}…", done, total);
    }
    public pure function exporting-progress(done: int, total: int) -> string {
        return @tr("Exporting {}/{}…", done, total);
    }
    public pure function import-failed(reason: string) -> string {
        return @tr("Import failed: {}", reason);
    }
    public pure function export-failed(reason: string) -> string {
        return @tr("Export failed: {}", reason);
    }
    public pure function printing-progress(done: int, total: int) -> string {
        return @tr("Printing {}/{}…", done, total);
    }
    public pure function print-failed(reason: string) -> string {
        return @tr("Print failed: {}", reason);
    }
    public pure function printing-ellipsis() -> string {
        return @tr("Printing…");
    }
    // Contact sheets (ADR 0110). A sheet is one file whatever the number of
    // photographs, so its outcome names the file and how much of the
    // selection reached it — an empty cell is a failure worth reading.
    public pure function sheet-progress(done: int, total: int) -> string {
        return @tr("Rendering {}/{}…", done, total);
    }
    public pure function sheet-written(path: string, placed: int, pages: int) -> string {
        return @tr("Wrote {} — {} photo(s) on {} page(s).", path, placed, pages);
    }
    public pure function sheet-empty-cells(n: int) -> string {
        return @tr("{} photo could not be rendered and left an empty cell." | "{} photos could not be rendered and left empty cells." % n, n);
    }
    // Chromatic aberration (ADR 0111 §6): a photograph with nothing to
    // measure on gets an answer, not a silence.
    // The three grounds a viewer can paint (ADR 0117 §1). Named here rather
    // than in the dialog because Rust assembles the list, and a string built
    // in Rust is a string no `.pot` ever learns about.
    public pure function ground-dark() -> string {
        return @tr("Dark");
    }
    public pure function ground-grey() -> string {
        return @tr("Mid-grey");
    }
    public pure function ground-white() -> string {
        return @tr("White");
    }
    public pure function tca-not-enough-edges(samples: int) -> string {
        return @tr("Not enough usable edges on this photo ({}) — try a frame with detail away from the centre.", samples);
    }
    public pure function sheet-failed(reason: string) -> string {
        return @tr("Contact sheet failed: {}", reason);
    }
    public pure function reprocessed(reprocessed: int, already-current: int, failed: int) -> string {
        return @tr("Reprocessed {} photo(s), {} already current, {} failed", reprocessed, already-current, failed);
    }
    // Removal (ADR 0060). The two messages differ on one thing only — what
    // happens to the files — because that is the whole distinction between
    // the two menu entries, and the only sentence worth reading twice.
    public pure function remove-from-catalog-title(n: int) -> string {
        return @tr("Remove {} photo from the catalog?" | "Remove {} photos from the catalog?" % n, n);
    }
    public pure function remove-from-catalog-message() -> string {
        return @tr("The files stay exactly where they are, and can be imported again. Develop settings, keywords and collection membership go with the photos.");
    }
    public pure function remove-from-catalog-accept() -> string {
        return @tr("Remove");
    }
    public pure function delete-from-disk-title(n: int) -> string {
        return @tr("Delete {} photo from the disk?" | "Delete {} photos from the disk?" % n, n);
    }
    public pure function delete-from-disk-message() -> string {
        return @tr("The photos leave the catalog, and their files — with their XMP sidecars — are sent to the system trash, from where they can still be recovered.");
    }
    public pure function delete-from-disk-accept() -> string {
        return @tr("Delete");
    }
    // Pairing (ADR 0079 §7). The dialog announces the count because the
    // pass makes half the thumbnails of a RAW+JPEG library leave the grid,
    // and that is startling if nobody said so first.
    public pure function pair-library-title(n: int) -> string {
        return @tr("Pair {} shot?" | "Pair {} shots?" % n, n);
    }
    public pure function pair-library-message() -> string {
        return @tr("Each JPEG the camera wrote alongside a RAW of the same shot becomes a companion of it: one photo in the grid instead of two. No file is moved or deleted, and any photo can be detached again.");
    }
    public pure function pair-library-accept() -> string {
        return @tr("Pair");
    }
    public pure function pair-library-none() -> string {
        return @tr("No RAW+JPEG couple left to pair.");
    }
    // ADR 0107: the word that matters is "new photo" — a derivation is not
    // an edit of the one it was made from, and a user who reads it as one
    // will go looking for a slider to undo.
    public pure function deriving-ellipsis() -> string {
        return @tr("Processing…");
    }
    public pure function derived(name: string) -> string {
        return @tr("{} added — a new photo carrying this one's development.", name);
    }

    // ADR 0084 §2: the sentence has to say that nothing was written, and
    // how to apply it — a proposal that reads like a result is the one way
    // this feature could quietly throw a shoot away.
    public pure function culling-ellipsis() -> string {
        return @tr("Looking through the photos…");
    }
    public pure function culling-progress(done: int, total: int) -> string {
        return @tr("Looking through the photos… {} / {}", done, total);
    }
    public pure function culling-proposal(rejects: int, bursts: int) -> string {
        return @tr("{} photo proposed for rejection, in {} burst — nothing written yet: reject them with X, or Library ▸ Discard Proposal." | "{} photos proposed for rejection, in {} bursts — nothing written yet: reject them with X, or Library ▸ Discard Proposal." % rejects, rejects, bursts);
    }
    public pure function culling-found-nothing() -> string {
        return @tr("Nothing to propose: no burst, and nothing technically wrong.");
    }

    public pure function paired(n: int) -> string {
        return @tr("Paired {} shot." | "Paired {} shots." % n, n);
    }
    public pure function enter-source-folder() -> string {
        return @tr("Enter a source folder.");
    }
    public pure function importing-ellipsis() -> string {
        return @tr("Importing…");
    }
    public pure function scanning-ellipsis() -> string {
        return @tr("Looking at what is there…");
    }
    public pure function scan-found(n: int) -> string {
        return @tr("{} photo found." | "{} photos found." % n, n);
    }
    public pure function select-photo-first() -> string {
        return @tr("Select a photo first.");
    }
    public pure function enter-destination-folder() -> string {
        return @tr("Enter a destination folder.");
    }
    public pure function exporting-ellipsis() -> string {
        return @tr("Exporting…");
    }
    public pure function enter-a-name() -> string {
        return @tr("Enter a name.");
    }
    // The root of the collection tree, as the "Move to…" list names it.
    public pure function top-level() -> string {
        return @tr("Top level");
    }
    public pure function creation-failed(error: string) -> string {
        return @tr("Creation failed: {}", error);
    }
    public pure function open-photo-in-develop-first() -> string {
        return @tr("Open a photo in develop first.");
    }
    public pure function pick-at-least-one-group() -> string {
        return @tr("Pick at least one group.");
    }
    public pure function save-failed(error: string) -> string {
        return @tr("Save failed: {}", error);
    }
    public pure function error-prefix(message: string) -> string {
        return @tr("Error: {}", message);
    }
    public pure function select-collection-first() -> string {
        return @tr("Select a collection in the sidebar first.");
    }
    public pure function preset-saved() -> string {
        return @tr("Preset saved.");
    }
}
