// Building blocks of the hand-rolled menu bar (ADR 0045 §3).
//
// Hand-rolled menu bar, replacing Slint's native `MenuBar` (ADR 0020).
// Bisected 2026-07-22: the native MenuBar's OS-level menu integration
// (`muda`, pulled in unconditionally by `i-slint-backend-selector`) breaks
// repaint scheduling for the grid and collections list elsewhere in the
// window — they can go blank and stay blank, surviving even a real resize,
// until some other structural change (a dialog opening) forces a repaint.
// This purely Slint-rendered replacement never touches that native code
// path. See `StudioWindow.open-menu`/`reset-submenus()` for the state this
// wires into, and the dropdown panels near the modal dialog overlay for
// the actual menu contents.
import { Frame, Theme } from "../theme.slint";
import { HintState } from "../state/hint.slint";
export component TopMenuLabel inherits Rectangle {
    in property <string> title;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked;

    height: Frame.top-bar;
    width: label.preferred-width + 20px;
    background: root.active ? Theme.active : transparent;

    label := Text {
        text: root.title;
        color: root.enabled ? Theme.text : Theme.text-disabled;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
    TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// A glyph button of the top bar (ADR 0158 §2): the panel toggle, undo,
// redo, the theme switch. Square, the bar's own height, no plate until
// hovered, so a row of them reads as part of the bar and not as a toolbar
// laid on it. A glyph alone is a convention, so each says on hover what it
// does (ADR 0127 §1).
export component BarButton inherits Rectangle {
    in property <string> glyph;
    in property <string> hint;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked;

    width: Frame.top-bar - 8px;
    height: Frame.top-bar;

    Rectangle {
        y: 4px;
        height: parent.height - 8px;
        border-radius: 4px;
        background: touch.has-hover && root.enabled ? Theme.hover : transparent;
    }
    Text {
        text: root.glyph;
        color: !root.enabled ? Theme.text-disabled : (root.active ? Theme.text : Theme.text-dim);
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            HintState.dismiss();
            root.clicked();
        }
        changed has-hover => {
            if (root.hint != "") {
                if (self.has-hover) {
                    HintState.enter(root.hint, root.absolute-position.x, root.absolute-position.y + root.height);
                } else {
                    HintState.leave(root.hint);
                }
            }
        }
    }
}

export component MenuDropdown inherits Rectangle {
    // Without explicit sizing, a bare `Rectangle` defaults to filling its
    // parent — here that's the full-window click-catcher, which made every
    // dropdown's background span the entire page even though its rows are
    // only 240px wide. Sizing to `content`'s own preferred size instead
    // makes it hug its rows.
    background: Theme.raised;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.border;
    width: content.preferred-width;
    height: content.preferred-height;
    content := VerticalLayout {
        @children
    }
}

export component MenuRow inherits Rectangle {
    in property <string> title;
    in property <bool> enabled: true;
    callback activated;

    height: 26px;
    width: 240px;
    background: touch.has-hover && root.enabled ? Theme.active : transparent;

    Text {
        x: 12px;
        width: parent.width - 24px;
        text: root.title;
        color: root.enabled ? Theme.text : Theme.text-disabled;
        font-size: 12px;
        vertical-alignment: center;
        height: 100%;
        overflow: elide;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.activated();
        }
    }
}

// Inline-expanding submenu (Photo's Rate/Label/Flag, Develop's Apply
// Preset): a flyout to the side would need a second layer of absolute
// positioning for little benefit here, so this expands downward in place
// instead, the same interaction `GroupHeader` already uses for the develop
// panel's setting groups.
export component SubmenuHeader inherits Rectangle {
    in property <string> title;
    in-out property <bool> expanded;
    in property <bool> enabled: true;

    height: 26px;
    width: 240px;
    background: touch.has-hover && root.enabled ? Theme.active : transparent;

    Text {
        x: 12px;
        text: (root.expanded ? "▾ " : "▸ ") + root.title;
        color: root.enabled ? Theme.text : Theme.text-disabled;
        font-size: 12px;
        vertical-alignment: center;
        height: 100%;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.expanded = !root.expanded;
        }
    }
}

export component MenuSep inherits Rectangle {
    height: 9px;
    width: 240px;
    Rectangle {
        x: 8px;
        y: parent.height / 2;
        width: parent.width - 16px;
        height: 1px;
        background: Theme.hover;
    }
}


// A menu row that carries a state rather than an action (ADR 0131 §3): the
// tick lives in a column of its own, so a toggled and an untoggled row have
// their titles in the same place and the menu does not shift as one is
// switched. `MenuRow` stays what it is — a row that *does* something —
// because a checkable variant of it would leave every existing caller
// carrying a `checked: false` that means nothing.
export component MenuToggleRow inherits Rectangle {
    in property <string> title;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback activated;

    height: 26px;
    width: 240px;
    background: touch.has-hover && root.enabled ? Theme.active : transparent;

    Text {
        x: 12px;
        width: 14px;
        text: root.checked ? "✓" : "";
        color: root.enabled ? Theme.focus : Theme.text-disabled;
        font-size: 12px;
        vertical-alignment: center;
        height: 100%;
    }
    Text {
        x: 26px;
        width: parent.width - 38px;
        text: root.title;
        color: root.enabled ? Theme.text : Theme.text-disabled;
        font-size: 12px;
        vertical-alignment: center;
        height: 100%;
        overflow: elide;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.activated();
        }
    }
}
