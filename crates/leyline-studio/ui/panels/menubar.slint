// The hand-rolled menu bar (ADR 0020): the row of labels, and the dropdown
// panels they open (ADR 0045 §3).
//
// The two belong in one component because the dropdowns position themselves
// on their label's `x` — separating them would mean publishing six label
// positions across a component boundary for no gain.
//
// Not Slint's native `MenuBar`: that one pulls in OS-level menu integration
// (`muda`) which breaks repaint scheduling for the grid and the collections
// list — see the comment above `TopMenuLabel` in `widgets/menu.slint`.
//
// Instantiated last in `StudioWindow` so it paints over everything,
// including the modal dialog overlay. Its root fills the window but sets no
// geometry and catches no input of its own; only the dropdown backdrop,
// which exists solely while a menu is open, has a `TouchArea`.

import { CollectionState } from "../state/collection.slint";
import { DevelopState } from "../state/develop.slint";
import { DialogState } from "../state/dialog.slint";
import { FilterState } from "../state/filter.slint";
import { GridState } from "../state/grid.slint";
import { LibraryState } from "../state/library.slint";
import { MapState } from "../state/map.slint";
import { PreferencesState } from "../state/preferences.slint";
import { MenuDropdown, MenuRow, MenuSep, ModuleLabel, SubmenuHeader, TopMenuLabel } from "../widgets/menu.slint";

export component MenuBar inherits Rectangle {
    // Which top-level menu is open: "" or one of "file"/"library"/"photo"/
    // "develop-menu"/"view"/"help". `in-out` because the window's Escape
    // handler closes it.
    in-out property <string> open-menu: "";
    // The inline-expand submenus are independent booleans since at most one
    // of each is ever meaningfully open at a time.
    property <bool> rate-submenu-open: false;
    property <bool> label-submenu-open: false;
    property <bool> flag-submenu-open: false;
    property <bool> apply-preset-submenu-open: false;
    property <bool> delete-preset-submenu-open: false;
    property <bool> open-recent-submenu-open: false;
    property <bool> process-submenu-open: false;

    // `public` for the same reason `open-menu` is `in-out`: closing a menu
    // from the window's Escape handler has to collapse the submenus too.
    public function reset-submenus() {
        root.rate-submenu-open = false;
        root.label-submenu-open = false;
        root.flag-submenu-open = false;
        root.apply-preset-submenu-open = false;
        root.delete-preset-submenu-open = false;
        root.open-recent-submenu-open = false;
        root.process-submenu-open = false;
    }


    // Custom menu bar's dropdown panels (see `TopMenuLabel` above for
    // why this isn't Slint's native `MenuBar`). Declared last so they
    // paint over everything, including the modal dialog overlay above.
    if root.open-menu != "": Rectangle {
        // Invisible full-window catcher: clicking outside any dropdown
        // closes the open menu.
        TouchArea {
            clicked => {
                root.open-menu = "";
                root.reset-submenus();
            }
        }

        if root.open-menu == "file": MenuDropdown {
            x: menus.x + file-label.x;
            y: 28px;
            MenuRow {
                title: @tr("Import…    I");
                activated => {
                    DialogState.dialog-result = "";
                    DialogState.dialog = "import";
                    root.open-menu = "";
                }
            }
            MenuRow {
                title: @tr("Export…    Ctrl+E");
                activated => {
                    DialogState.open-export();
                    root.open-menu = "";
                }
            }
            MenuSep { }
            MenuRow {
                title: @tr("Open Library…");
                activated => {
                    LibraryState.open-library-requested();
                    root.open-menu = "";
                }
            }
            SubmenuHeader {
                title: @tr("Open Recent");
                expanded <=> root.open-recent-submenu-open;
                enabled: LibraryState.recent-libraries.length > 0;
            }
            if root.open-recent-submenu-open: VerticalLayout {
                for path[index] in LibraryState.recent-libraries: MenuRow {
                    title: path;
                    activated => {
                        LibraryState.open-recent-library(index);
                        root.open-menu = "";
                        root.reset-submenus();
                    }
                }
            }
            MenuSep { }
            MenuRow {
                title: @tr("Print…    Ctrl+P");
                activated => {
                    DialogState.open-print();
                    root.open-menu = "";
                }
            }
            MenuRow {
                title: @tr("Contact Sheet…");
                activated => {
                    DialogState.open-contact-sheet();
                    root.open-menu = "";
                }
            }
            MenuRow {
                title: @tr("Tethered Capture…    T");
                activated => {
                    DialogState.open-tether();
                    root.open-menu = "";
                }
            }
            MenuRow {
                title: @tr("Auto Import…");
                activated => {
                    DialogState.open-watch();
                    root.open-menu = "";
                }
            }
            MenuRow {
                title: @tr("Roots…");
                activated => {
                    DialogState.open-roots();
                    root.open-menu = "";
                }
            }
            MenuRow {
                title: @tr("Map…    M");
                activated => {
                    MapState.enter-map();
                    root.open-menu = "";
                }
            }
            MenuSep { }
            MenuRow {
                // The last inert entry of the menu bar (ADR 0078): the
                // language of ADR 0019 and the update consent of
                // ADR 0077 §2 both landed here, which is what finally
                // gave this panel something to hold. No keyboard
                // shortcut — one opens it twice in the life of an
                // installation.
                title: @tr("Preferences…");
                activated => {
                    PreferencesState.open-preferences();
                    root.open-menu = "";
                }
            }
            MenuSep { }
            MenuRow {
                title: @tr("Quit");
                activated => {
                    LibraryState.quit();
                }
            }
        }

        if root.open-menu == "library": MenuDropdown {
            x: menus.x + library-label.x;
            y: 28px;
            MenuRow {
                title: @tr("New Collection…    Ctrl+N");
                activated => {
                    DialogState.dialog-result = "";
                    DialogState.dialog = "collection";
                    root.open-menu = "";
                }
            }
            MenuRow {
                title: @tr("Add to Collection    B");
                enabled: GridState.selected >= 0 && CollectionState.active-collection >= 0;
                activated => {
                    CollectionState.add-to-collection();
                    root.open-menu = "";
                }
            }
            MenuRow {
                title: @tr("Remove from Collection    Shift+B");
                enabled: GridState.selected >= 0 && CollectionState.active-collection >= 0;
                activated => {
                    CollectionState.remove-from-collection();
                    root.open-menu = "";
                }
            }
            MenuSep { }
            MenuRow {
                title: @tr("Reprocess Library…    Shift+R");
                activated => {
                    DevelopState.reprocess-library();
                    root.open-menu = "";
                }
            }
            MenuRow {
                title: @tr("Pair RAW+JPEG…");
                activated => {
                    LibraryState.pair-library();
                    root.open-menu = "";
                }
            }
            MenuSep { }
            // The assistant proposes; the photographer applies (ADR 0084
            // §2). This entry only ever *shows* — what applies a verdict
            // is the reject key the photographer already uses.
            MenuRow {
                title: @tr("Assisted Culling…");
                enabled: !LibraryState.reviewing-proposal;
                activated => {
                    LibraryState.cull-library();
                    root.open-menu = "";
                }
            }
            MenuRow {
                title: @tr("Discard Proposal");
                enabled: LibraryState.reviewing-proposal;
                activated => {
                    LibraryState.discard-proposal();
                    root.open-menu = "";
                }
            }
        }

        if root.open-menu == "photo": MenuDropdown {
            x: menus.x + photo-label.x;
            y: 28px;
            SubmenuHeader {
                title: @tr("Rate");
                expanded <=> root.rate-submenu-open;
            }
            if root.rate-submenu-open: VerticalLayout {
                MenuRow {
                    title: @tr("1 star    1");
                    enabled: GridState.selected >= 0;
                    activated => {
                        GridState.classify("1");
                        root.open-menu = "";
                        root.reset-submenus();
                    }
                }
                MenuRow {
                    title: @tr("2 stars    2");
                    enabled: GridState.selected >= 0;
                    activated => {
                        GridState.classify("2");
                        root.open-menu = "";
                        root.reset-submenus();
                    }
                }
                MenuRow {
                    title: @tr("3 stars    3");
                    enabled: GridState.selected >= 0;
                    activated => {
                        GridState.classify("3");
                        root.open-menu = "";
                        root.reset-submenus();
                    }
                }
                MenuRow {
                    title: @tr("4 stars    4");
                    enabled: GridState.selected >= 0;
                    activated => {
                        GridState.classify("4");
                        root.open-menu = "";
                        root.reset-submenus();
                    }
                }
                MenuRow {
                    title: @tr("5 stars    5");
                    enabled: GridState.selected >= 0;
                    activated => {
                        GridState.classify("5");
                        root.open-menu = "";
                        root.reset-submenus();
                    }
                }
                MenuSep { }
                MenuRow {
                    title: @tr("Clear Rating    0");
                    enabled: GridState.selected >= 0;
                    activated => {
                        GridState.classify("0");
                        root.open-menu = "";
                        root.reset-submenus();
                    }
                }
            }
            SubmenuHeader {
                title: @tr("Label");
                expanded <=> root.label-submenu-open;
            }
            if root.label-submenu-open: VerticalLayout {
                MenuRow {
                    title: @tr("Red    6");
                    enabled: GridState.selected >= 0;
                    activated => {
                        GridState.classify("6");
                        root.open-menu = "";
                        root.reset-submenus();
                    }
                }
                MenuRow {
                    title: @tr("Yellow    7");
                    enabled: GridState.selected >= 0;
                    activated => {
                        GridState.classify("7");
                        root.open-menu = "";
                        root.reset-submenus();
                    }
                }
                MenuRow {
                    title: @tr("Green    8");
                    enabled: GridState.selected >= 0;
                    activated => {
                        GridState.classify("8");
                        root.open-menu = "";
                        root.reset-submenus();
                    }
                }
                MenuRow {
                    title: @tr("Blue    9");
                    enabled: GridState.selected >= 0;
                    activated => {
                        GridState.classify("9");
                        root.open-menu = "";
                        root.reset-submenus();
                    }
                }
            }
            SubmenuHeader {
                title: @tr("Flag");
                expanded <=> root.flag-submenu-open;
            }
            if root.flag-submenu-open: VerticalLayout {
                MenuRow {
                    title: @tr("Pick    P");
                    enabled: GridState.selected >= 0;
                    activated => {
                        GridState.classify("p");
                        root.open-menu = "";
                        root.reset-submenus();
                    }
                }
                MenuRow {
                    title: @tr("Reject    X");
                    enabled: GridState.selected >= 0;
                    activated => {
                        GridState.classify("x");
                        root.open-menu = "";
                        root.reset-submenus();
                    }
                }
                MenuRow {
                    title: @tr("Clear    U");
                    enabled: GridState.selected >= 0;
                    activated => {
                        GridState.classify("u");
                        root.open-menu = "";
                        root.reset-submenus();
                    }
                }
            }
            MenuSep { }
            MenuRow {
                title: @tr("Develop    D");
                enabled: GridState.selected >= 0 && !DevelopState.develop-mode;
                activated => {
                    DevelopState.enter-develop();
                    root.open-menu = "";
                }
            }
            MenuRow {
                // Today `R` only reprocesses the photo open in
                // develop — same contract here: disabled outside
                // that context rather than silently acting on
                // something else.
                title: @tr("Reprocess    R");
                enabled: DevelopState.develop-mode;
                activated => {
                    DevelopState.develop-reprocess();
                    root.open-menu = "";
                }
            }
            // Photo ▸ Process: an external processor makes a NEW photograph
            // from this one (ADR 0107). Placed under Photo and not under
            // Develop on purpose — nothing here edits the open revision.
            // No processor installed, no submenu: an operation that cannot
            // run must not appear greyed out either.
            if LibraryState.processors.length > 0: SubmenuHeader {
                title: @tr("Process");
                expanded <=> root.process-submenu-open;
                enabled: GridState.selected >= 0;
            }
            if root.process-submenu-open: VerticalLayout {
                for row[index] in LibraryState.processors: MenuRow {
                    title: row.label;
                    activated => {
                        LibraryState.derive-selected(row.key);
                        root.open-menu = "";
                        root.reset-submenus();
                    }
                }
            }
            MenuSep { }
            // Two entries, never one with a modifier (ADR 0060): confusing
            // "stop cataloguing this" with "destroy this file" is the
            // mistake a photo tool cannot afford even once, so the two acts
            // never share a control.
            MenuRow {
                title: @tr("Remove from Catalog…");
                enabled: GridState.selected >= 0;
                activated => {
                    GridState.remove-selected();
                    root.open-menu = "";
                }
            }
            MenuRow {
                title: @tr("Delete from Disk…");
                enabled: GridState.selected >= 0;
                activated => {
                    GridState.delete-selected();
                    root.open-menu = "";
                }
            }
        }

        if root.open-menu == "develop-menu" && DevelopState.develop-mode: MenuDropdown {
            x: menus.x + develop-label.x;
            y: 28px;
            MenuRow {
                title: @tr("Undo    Ctrl+Z");
                activated => {
                    DevelopState.develop-undo();
                    root.open-menu = "";
                }
            }
            MenuRow {
                title: @tr("Redo    Ctrl+Y");
                activated => {
                    DevelopState.develop-redo();
                    root.open-menu = "";
                }
            }
            MenuSep { }
            MenuRow {
                title: @tr("Save Preset…    S");
                activated => {
                    DevelopState.open-preset-dialog();
                    root.open-menu = "";
                }
            }
            SubmenuHeader {
                title: @tr("Apply Preset");
                expanded <=> root.apply-preset-submenu-open;
                enabled: DevelopState.dev-presets.length > 0;
            }
            if root.apply-preset-submenu-open: VerticalLayout {
                for name[index] in DevelopState.dev-presets: MenuRow {
                    title: name;
                    activated => {
                        DevelopState.apply-preset(index);
                        root.open-menu = "";
                        root.reset-submenus();
                    }
                }
            }
            // The develop panel no longer lists the presets itself — the
            // settings panel is the edit, not the library of edits (ADR 0054
            // §2) — so deleting one lives here, next to saving and applying,
            // rather than nowhere.
            SubmenuHeader {
                title: @tr("Delete Preset");
                expanded <=> root.delete-preset-submenu-open;
                enabled: DevelopState.dev-presets.length > 0;
            }
            if root.delete-preset-submenu-open: VerticalLayout {
                for name[index] in DevelopState.dev-presets: MenuRow {
                    title: name;
                    activated => {
                        DevelopState.delete-preset(index);
                        root.open-menu = "";
                        root.reset-submenus();
                    }
                }
            }
            MenuSep { }
            MenuRow {
                title: @tr("Back to Library    G");
                activated => {
                    DevelopState.exit-develop();
                    root.open-menu = "";
                }
            }
        }

        if root.open-menu == "view": MenuDropdown {
            x: menus.x + view-label.x;
            y: 28px;
            MenuRow {
                title: @tr("Library    G");
                enabled: DevelopState.develop-mode || GridState.loupe-mode
                    || GridState.compare-mode || GridState.survey-mode;
                activated => {
                    if (DevelopState.develop-mode) {
                        DevelopState.exit-develop();
                    }
                    GridState.loupe-mode = false;
                    GridState.loupe-mode-changed();
                    GridState.compare-mode = false;
                    GridState.compare-mode-changed();
                    GridState.survey-mode = false;
                    GridState.survey-mode-changed();
                    root.open-menu = "";
                }
            }
            // The same photo, large, without an edit session behind it
            // (ADR 0055 §3).
            MenuRow {
                title: @tr("Loupe    E");
                enabled: !DevelopState.develop-mode && !GridState.loupe-mode
                    && GridState.selected >= 0;
                activated => {
                    GridState.loupe-mode = true;
                    GridState.loupe-mode-changed();
                    root.open-menu = "";
                }
            }
            // The two comparison views (ADR 0057), between the loupe and
            // develop: they look at several photos where the loupe looks at
            // one, and none of them opens an edit session.
            MenuRow {
                title: @tr("Compare    C");
                enabled: !DevelopState.develop-mode && !GridState.compare-mode
                    && GridState.selected >= 0;
                activated => {
                    GridState.loupe-mode = false;
                    GridState.loupe-mode-changed();
                    GridState.compare-mode = true;
                    GridState.compare-mode-changed();
                    root.open-menu = "";
                }
            }
            MenuRow {
                title: @tr("Survey    N");
                enabled: !DevelopState.develop-mode && !GridState.survey-mode
                    && GridState.selected >= 0;
                activated => {
                    GridState.loupe-mode = false;
                    GridState.loupe-mode-changed();
                    GridState.survey-mode = true;
                    GridState.survey-mode-changed();
                    root.open-menu = "";
                }
            }
            MenuRow {
                title: @tr("Develop    D");
                enabled: !DevelopState.develop-mode && GridState.selected >= 0;
                activated => {
                    GridState.loupe-mode = false;
                    DevelopState.enter-develop();
                    root.open-menu = "";
                }
            }
            MenuRow {
                title: @tr("Map    M");
                enabled: !MapState.map-mode;
                activated => {
                    if (DevelopState.develop-mode) {
                        DevelopState.exit-develop();
                    }
                    GridState.loupe-mode = false;
                    MapState.enter-map();
                    root.open-menu = "";
                }
            }
        }

        if root.open-menu == "help": MenuDropdown {
            x: menus.x + help-label.x;
            y: 28px;
            // A found update is announced here and nowhere else
            // (ADR 0077 §2): no modal, no notification, no "you are up to
            // date". The entry renames itself, and the mark on the Help
            // label below is what makes it worth opening.
            MenuRow {
                title: PreferencesState.update-available
                    ? @tr("Update to {}…", PreferencesState.update-version)
                    : @tr("Check for Updates…");
                activated => {
                    PreferencesState.check-updates();
                    root.open-menu = "";
                }
            }
            MenuSep { }
            MenuRow {
                title: @tr("Keyboard Shortcuts…");
                activated => {
                    DialogState.dialog-result = "";
                    DialogState.dialog = "shortcuts";
                    root.open-menu = "";
                }
            }
            MenuRow {
                // Before About, because a photographer who has just met a
                // defect is looking for somewhere to say so, not for a
                // version number (ADR 0123).
                title: @tr("Report a Problem…");
                activated => {
                    root.open-menu = "";
                    DialogState.open-report();
                }
            }
            MenuSep { }
            MenuRow {
                title: @tr("About Leyline");
                activated => {
                    DialogState.dialog-result = "";
                    DialogState.dialog = "about";
                    root.open-menu = "";
                }
            }
        }
    }


    // The strip the row of labels sits on.
    //
    // The menu row *overlaps* the views rather than pushing them down (see
    // the note below), so every panel that scrolls sends its content
    // straight under these labels: the develop settings column, the presets
    // column, the metadata panel. With nothing behind the words, a slider
    // or a thumbnail slid up through them and the bar became unreadable
    // exactly while it was being scrolled past.
    //
    // A plain sibling `Rectangle` — the one shape the repaint hazard below
    // leaves available. It carries no `TouchArea`, so it changes nothing
    // about where a click lands; only what is painted under the labels.
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: 28px;
        background: #1b1b1b;

        // A hairline rather than a shadow: it separates the bar from
        // whatever scrolls beneath it without pretending the bar floats.
        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: #303030;
        }
    }

    // `MenuBar` was a magic top-level element Slint gives special sizing
    // treatment (reserving space above the rest of the content natively);
    // a plain `HorizontalLayout` isn't. `keys` above (and its content)
    // therefore keeps its untouched, default fill-parent geometry —
    // giving it (or any ancestor of its repeaters: the grid, the
    // collections list) an explicit position/size override of any kind,
    // even a inert-looking one, was enough on its own to reintroduce a
    // repaint bug extremely similar to the native-`MenuBar` one this whole
    // rewrite exists to avoid (confirmed repeatedly; see
    // studio-repaint-bug-unresolved in project memory for the fuller
    // writeup). Concretely, this means: (1) `menu-row` is declared last —
    // after `keys` — purely so it paints on top of it (Slint paints
    // siblings in declaration order); it is not stacked above `keys` via
    // layout, the two simply overlap, and (2) each content column that
    // needs to visually clear the menu row's height reserves that space
    // with a plain spacer `Rectangle` as an extra *child* inside its own
    // already-existing `VerticalLayout` (adding a sibling element was
    // safe in testing) — never via a property override on the column
    // itself or on `keys`.
    menu-row := HorizontalLayout {
        // Custom menu bar (ADR 0020): a second, discoverable path to the
        // same callbacks already wired to keyboard shortcuts above — no
        // new functionality, no new code path. Context-sensitive entries
        // are disabled outside the context where their shortcut is
        // meaningful. Not Slint's native `MenuBar` — see the comment above
        // `TopMenuLabel` for why. The dropdown panels themselves are
        // declared later, in the same overlay z-order as the modal
        // dialogs, so they paint on top of the grid/develop view; only the
        // row of labels lives here.
        x: 0;
        y: 0;
        height: 28px;
        // The menus keep the left end, the module switcher takes the right
        // end (ADR 0055 §1), and neither group is stretched: `space-between`
        // pushes the two apart while leaving every label at its own width.
        // The dropdowns below therefore anchor on `menus.x + <label>.x`,
        // since their `x` is measured from the window rather than from this
        // inner row.
        alignment: space-between;
        padding-left: 4px;
        padding-right: 8px;

        menus := HorizontalLayout {
            spacing: 2px;

            file-label := TopMenuLabel {
                title: @tr("File");
                active: root.open-menu == "file";
                clicked => {
                    root.open-menu = root.open-menu == "file" ? "" : "file";
                    root.reset-submenus();
                }
            }
            library-label := TopMenuLabel {
                title: @tr("Library");
                active: root.open-menu == "library";
                clicked => {
                    root.open-menu = root.open-menu == "library" ? "" : "library";
                    root.reset-submenus();
                }
            }
            photo-label := TopMenuLabel {
                title: @tr("Photo");
                active: root.open-menu == "photo";
                clicked => {
                    root.open-menu = root.open-menu == "photo" ? "" : "photo";
                    root.reset-submenus();
                }
            }
            develop-label := TopMenuLabel {
                title: @tr("Develop");
                active: root.open-menu == "develop-menu";
                enabled: DevelopState.develop-mode;
                clicked => {
                    root.open-menu = root.open-menu == "develop-menu" ? "" : "develop-menu";
                    root.reset-submenus();
                }
            }
            view-label := TopMenuLabel {
                title: @tr("View");
                active: root.open-menu == "view";
                clicked => {
                    root.open-menu = root.open-menu == "view" ? "" : "view";
                    root.reset-submenus();
                }
            }
            help-label := TopMenuLabel {
                // The badge of ADR 0077 §2 — a mark on the label, not a
                // window. It is possible only because this bar is
                // hand-rolled (ADR 0020, corrected): a native `MenuBar`
                // does not take decoration. Concatenated outside the
                // `@tr(...)` so no translation has to carry the mark.
                title: @tr("Help") + (PreferencesState.update-available ? " •" : "");
                active: root.open-menu == "help";
                clicked => {
                    root.open-menu = root.open-menu == "help" ? "" : "help";
                    root.reset-submenus();
                }
            }
        }

        // Module switcher (ADR 0055 §1): the three whole-window views, in the
        // corner where someone arriving from Lightroom looks first. Each
        // entry leaves the current view before entering its own, so the two
        // exclusive modes can never both be on. *Print* is deliberately
        // absent — it is a dialog, an action that ends, not a place one stays
        // (ADR 0055 §1, Alternatives).
        HorizontalLayout {
            spacing: 0px;

            ModuleLabel {
                title: @tr("Library");
                current: !DevelopState.develop-mode && !MapState.map-mode;
                clicked => {
                    if (DevelopState.develop-mode) {
                        DevelopState.exit-develop();
                    }
                    if (MapState.map-mode) {
                        MapState.exit-map();
                    }
                    root.open-menu = "";
                }
            }
            Text {
                text: "|";
                color: #4a4a4a;
                font-size: 13px;
                vertical-alignment: center;
            }
            ModuleLabel {
                title: @tr("Develop");
                current: DevelopState.develop-mode;
                // Develop is about *a* photo: without a selection there is
                // nothing to develop, exactly as the Develop menu is already
                // greyed out in that case.
                enabled: GridState.selected >= 0;
                clicked => {
                    if (MapState.map-mode) {
                        MapState.exit-map();
                    }
                    DevelopState.enter-develop();
                    root.open-menu = "";
                }
            }
            Text {
                text: "|";
                color: #4a4a4a;
                font-size: 13px;
                vertical-alignment: center;
            }
            ModuleLabel {
                title: @tr("Map");
                current: MapState.map-mode;
                clicked => {
                    if (DevelopState.develop-mode) {
                        DevelopState.exit-develop();
                    }
                    MapState.enter-map();
                    root.open-menu = "";
                }
            }
        }
    }
}
