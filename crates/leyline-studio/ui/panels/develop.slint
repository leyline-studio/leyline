// The develop view (`docs/pipeline.md`): the rendered photo, the tool strip
// over it, the filmstrip under it, and the adjustment panel beside it
// (ADR 0045 §3).
//
// Inherits `HorizontalLayout` and sets no geometry of its own so the element
// tree keeps exactly the shape it had inline — see the comment above
// `menu-row` in `studio.slint` for why any position or size override around
// this content is a repaint hazard.

import { Frame, Hues, Theme } from "../theme.slint";
import { DevSettings, MaskRow } from "../types.slint";
import { DevelopState } from "../state/develop.slint";
import { HintState } from "../state/hint.slint";
import { PreferencesState } from "../state/preferences.slint";
import { Navigator } from "navigator.slint";
import { HistoryPanel, VersionsPanel } from "develop_states.slint";
import { PresetsPanel } from "presets.slint";
import { Rail } from "rail.slint";
import { PhotoInfo, PhotoKeywords } from "photo_details.slint";
import { GridState } from "../state/grid.slint";
import { MaskState } from "../state/mask.slint";
import { EditSlider, Filmstrip, FilterChip, GroupHeader, SubHeading, Zoom } from "../widgets/controls.slint";
import { LocalGroup } from "develop_local.slint";
import { BasicGroup } from "develop_basic.slint";
import { ToneCurveGroup, LevelsGroup, HslGroup, ColorGradingGroup } from "develop_color.slint";
import { CameraProfileGroup, LutGroup, LensGroup, DetailGroup, EffectsGroup, ProofGroup, GeometryGroup } from "develop_optics.slint";
import { SpotRemovalGroup, RedEyeGroup, ReshapeGroup } from "develop_retouch.slint";

// One aspect-ratio chip of the crop row (ADR 0135 §2). Its own component so
// the seven of them are seven lines and not seven blocks, and so the
// comparison that lights the current one is written once.
component CropRatioChip inherits FilterChip {
    in property <string> label;
    in property <float> ratio;
    in property <float> chosen;
    callback picked(float);

    text: root.label;
    // Compared with a tolerance: `4.0 / 3.0` is not the same float twice
    // over, and a chip that failed to light because of a rounding digit
    // would be the sort of defect nobody thinks to look for.
    active: abs(root.chosen - root.ratio) < 0.0001;
    clicked => {
        root.picked(root.ratio);
    }
}

export component DevelopPanel inherits HorizontalLayout {
    // Hands keyboard focus back to the window after a field of the Info or
    // Keywords panel is validated, as the browser's detail panel does.
    callback return-focus();
    // Panel folding, owned by the window (ADR 0055 §6): the settings panel
    // first, then the file name and the filmstrip.
    in property <bool> side-panels-hidden;
    in property <bool> chrome-hidden;
    // Folded from the bottom bar (ADR 0158 §2), alone.
    in property <bool> filmstrip-hidden;
    // Room left on the left for the window's library column (ADR 0158 §3),
    // which is drawn over this view rather than inside it.
    in property <length> left-inset;
    // Panel-private state (ADR 0045 §2): none of it crosses to Rust.
    //
    // Accordion state — basic adjustments start open, the rest start
    // collapsed so a photo that only needs exposure/white-balance doesn't
    // force scrolling past groups that weren't touched.
    // Progressive disclosure (ADR 0054 §2): Basic shows what has an obvious
    // equivalent in any photo tool, Full shows the fifteen groups and the six
    // tools. Panel-private, like every other bit of interface state here: Rust
    // never reads it, and it deliberately survives nothing — not a file, not a
    // preset, not a session (§3).
    // ...and it now survives the session (ADR 0128). ADR 0054 §3 chose the
    // opposite, for a reason that has expired: *a configuration file the
    // project does not have* — `preferences.json` has existed since
    // ADR 0078. What that ADR's argument really protects is the **first**
    // session, and §2 of ADR 0128 keeps it: with nothing stored (`-1`),
    // every default below is the one ADR 0054 shipped.
    //
    // Each initial value is read once, at startup, from the number Rust
    // hands back. A click assigns the property, which in Slint drops the
    // binding for good — so nothing here is re-evaluated later, and a
    // choice made in this session is never overwritten by the one stored
    // from the last.
    property <int> stored-view: PreferencesState.develop-view;
    out property <bool> basic-mode: !root.stored-bit(root.stored-view, 0, false);
    // White balance, tone and presence are one foldable group now, read as a
    // single sequence (ADR 0054 §2), so they share one flag.
    property <bool> expand-basic: root.stored-bit(root.stored-view, 1, true);
    property <bool> expand-camera-profile: root.stored-bit(root.stored-view, 2, false);
    property <bool> expand-lut: root.stored-bit(root.stored-view, 3, false);
    property <bool> expand-lens: root.stored-bit(root.stored-view, 4, false);
    property <bool> expand-detail: root.stored-bit(root.stored-view, 5, false);
    property <bool> expand-effects: root.stored-bit(root.stored-view, 6, false);
    property <bool> expand-tone-curve: root.stored-bit(root.stored-view, 7, false);
    property <bool> expand-hsl: root.stored-bit(root.stored-view, 8, false);
    property <bool> expand-color-grading: root.stored-bit(root.stored-view, 9, false);
    property <bool> expand-spot-removal: root.stored-bit(root.stored-view, 10, false);
    property <bool> expand-reshape: root.stored-bit(root.stored-view, 11, false);
    property <bool> expand-red-eye: root.stored-bit(root.stored-view, 12, false);
    property <bool> expand-local: root.stored-bit(root.stored-view, 13, false);
    property <bool> expand-proof: root.stored-bit(root.stored-view, 14, false);
    property <bool> expand-geometry: root.stored-bit(root.stored-view, 15, false);
    property <bool> expand-levels: root.stored-bit(root.stored-view, 16, false);


    // The crop's aspect ratio, as width ÷ height (ADR 0135 §2). `0` is
    // Free, which constrains nothing.
    //
    // A number and not a pair, because the constraint only ever needs the
    // quotient — and it is applied in **screen** pixels: the render is
    // letterboxed undistorted, so a sub-rectangle whose screen ratio is 3:2
    // encloses a region whose pixel ratio is 3:2. Rust knows nothing of it.
    property <float> crop-ratio: 0;
    // Which composition guide is drawn: "none", "thirds", "golden",
    // "diagonals", "grid". Cycled by `O` and by the chip.
    property <string> crop-guide: "none";

    // The corner the rubber band actually reaches, given the ratio.
    //
    // The **longer** edge of the drag drives and the other is computed, so
    // dragging diagonally always grows the rectangle instead of fighting it
    // back to the shorter axis.
    pure function crop-corner-x(px: length, py: length, mx: length, my: length) -> length {
        if (root.crop-ratio <= 0) {
            return mx;
        }
        return abs((mx - px) / 1px) >= abs((my - py) / 1px) * root.crop-ratio
            ? mx
            : px + (mx >= px ? 1 : -1) * abs((my - py) / 1px) * root.crop-ratio * 1px;
    }
    pure function crop-corner-y(px: length, py: length, mx: length, my: length) -> length {
        if (root.crop-ratio <= 0) {
            return my;
        }
        return abs((mx - px) / 1px) >= abs((my - py) / 1px) * root.crop-ratio
            ? py + (my >= py ? 1 : -1) * abs((mx - px) / 1px) / root.crop-ratio * 1px
            : my;
    }

    // The next guide in the cycle, so `O` and the chip agree by sharing one
    // list instead of each carrying its own.
    // `O`, from the window's key handler. Opening the Crop entry as it goes
    // (ADR 0160 §1): cycling a guide one cannot see is a keystroke that
    // appears to do nothing, and the only reason to press it is to place a
    // crop.
    public function cycle-guide() {
        root.rail-entry = "crop";
        root.crop-guide = root.next-guide(root.crop-guide);
    }

    pure function next-guide(current: string) -> string {
        return current == "none" ? "thirds"
            : current == "thirds" ? "golden"
            : current == "golden" ? "diagonals"
            : current == "diagonals" ? "grid"
            : "none";
    }

    // The SVG commands of one guide over the rectangle `(gx, gy, gw, gh)`.
    //
    // A `Path` with a viewbox equal to its own pixel size, which is the
    // arrangement ADR 0119's keystone guides already use and the one known
    // to render in the software backend — and the reason `diagonals` is on
    // the list at all: a diagonal cannot be drawn with axis-aligned
    // rectangles, and this technique is shipped rather than a new bet.
    pure function guide-commands(kind: string, gx: length, gy: length, gw: length, gh: length) -> string {
        if (kind == "thirds") {
            return root.h-line(gx, gw, gy + gh / 3) + root.h-line(gx, gw, gy + 2 * gh / 3)
                + root.v-line(gy, gh, gx + gw / 3) + root.v-line(gy, gh, gx + 2 * gw / 3);
        }
        // 0.382 and 0.618 — the golden section, which sits nearer the edge
        // than a third and is the whole reason to offer both.
        if (kind == "golden") {
            return root.h-line(gx, gw, gy + gh * 0.382) + root.h-line(gx, gw, gy + gh * 0.618)
                + root.v-line(gy, gh, gx + gw * 0.382) + root.v-line(gy, gh, gx + gw * 0.618);
        }
        if (kind == "diagonals") {
            return "M\{gx / 1px} \{gy / 1px} L\{(gx + gw) / 1px} \{(gy + gh) / 1px}"
                + "M\{(gx + gw) / 1px} \{gy / 1px} L\{gx / 1px} \{(gy + gh) / 1px}";
        }
        if (kind == "grid") {
            return root.h-line(gx, gw, gy + gh / 4) + root.h-line(gx, gw, gy + gh / 2)
                + root.h-line(gx, gw, gy + 3 * gh / 4)
                + root.v-line(gy, gh, gx + gw / 4) + root.v-line(gy, gh, gx + gw / 2)
                + root.v-line(gy, gh, gx + 3 * gw / 4);
        }
        return "";
    }
    pure function h-line(gx: length, gw: length, at: length) -> string {
        return "M\{gx / 1px} \{at / 1px} L\{(gx + gw) / 1px} \{at / 1px}";
    }
    pure function v-line(gy: length, gh: length, at: length) -> string {
        return "M\{at / 1px} \{gy / 1px} L\{at / 1px} \{(gy + gh) / 1px}";
    }


    // The three things the targeted adjustment needs to know about the
    // setting it was handed (ADR 0130 §3): where it stands, how far a pixel
    // of drag moves it, and where it stops. Written here rather than read
    // off the sliders because a `for`-less panel has no way to ask an
    // `EditSlider` about itself — and kept beside those sliders' own
    // declarations, which is what makes the two easy to keep in step.
    //
    // Exposure is the exception in all three: it is the one tonal setting
    // measured in stops rather than in hundredths.
    pure function target-base(setting: string) -> float {
        return setting == "exposure" ? DevelopState.dev.exposure
            : setting == "highlights" ? DevelopState.dev.highlights
            : setting == "shadows" ? DevelopState.dev.shadows
            : setting == "whites" ? DevelopState.dev.whites
            : setting == "blacks" ? DevelopState.dev.blacks
            : 0;
    }
    pure function target-value(setting: string, base: float, moved: float) -> float {
        // 200px of drag covers 2 EV, or the whole of a [-100, 100] slider's
        // upper half — the same hand movement, in each setting's own units.
        return Math.clamp(base + moved * (setting == "exposure" ? 0.01 : 0.5),
            setting == "exposure" ? -5 : -100,
            setting == "exposure" ? 5 : 100);
    }

    // One bit per thing that folds, in the order they are declared above.
    // Bit 0 is Full mode, so a stored `0` is Basic with every group closed
    // — a real state, and the reason `-1` and not `0` means "never stored".
    // The `fallback` is what a first launch gets, and it is a parameter
    // rather than a test at each call site because the first version of
    // this guarded only two of the seventeen: `Math.mod` of a negative
    // number comes back as a value this comparison reads as *true*, so
    // "nothing stored" decoded as "everything expanded" — and a first
    // launch opened Develop with all fifteen groups unfolded, which is
    // the screen ADR 0054 exists to prevent.
    pure function stored-bit(code: int, index: int, fallback: bool) -> bool {
        return code < 0
            ? fallback
            : Math.mod(Math.floor(code / Math.pow(2, index)), 2) == 1;
    }
    // The same number, recomposed. Written as **one** derived property with
    // **one** handler rather than sixteen `changed` handlers: every fold in
    // this panel already feeds it, so a group added later is remembered by
    // adding its term here and nowhere else.
    property <int> view-code:
        (root.basic-mode ? 0 : 1)
        + (root.expand-basic ? 2 : 0)
        + (root.expand-camera-profile ? 4 : 0)
        + (root.expand-lut ? 8 : 0)
        + (root.expand-lens ? 16 : 0)
        + (root.expand-detail ? 32 : 0)
        + (root.expand-effects ? 64 : 0)
        + (root.expand-tone-curve ? 128 : 0)
        + (root.expand-hsl ? 256 : 0)
        + (root.expand-color-grading ? 512 : 0)
        + (root.expand-spot-removal ? 1024 : 0)
        + (root.expand-reshape ? 2048 : 0)
        + (root.expand-red-eye ? 4096 : 0)
        + (root.expand-local ? 8192 : 0)
        + (root.expand-proof ? 16384 : 0)
        + (root.expand-geometry ? 32768 : 0)
        + (root.expand-levels ? 65536 : 0);
    changed view-code => {
        PreferencesState.remember-develop-view(self.view-code);
    }
    // Fixed band order (ADR 0031), parallel to `DevSettings::hsl`.
    property <[string]> hsl-band-names: [
        @tr("Red"), @tr("Orange"), @tr("Yellow"), @tr("Green"),
        @tr("Aqua"), @tr("Blue"), @tr("Purple"), @tr("Magenta"),
    ];

    // Which drag tool the develop image responds to: "select" (default,
    // dragging does nothing), "crop" (dragging draws the crop rectangle),
    // "spot" (two clicks place a spot-removal clone, ADR 0032), or one of
    // the three local-adjustment tools — "radial"/"gradient" (one drag
    // traces the geometry) and "brush" (each click adds a dab), ADR 0049 §1.
    // `in-out` because the window's keyboard shortcuts switch tools too.
    in-out property <string> active-tool: "select";
    // Loupe zoom: fit-to-window (false) or 100%-with-pan (true). Only
    // meaningful for the Select tool — Crop/Spot's coordinate mapping
    // assumes the fit-to-window letterbox, so switching tools drops back to
    // fit rather than making every drag tool zoom-aware. `in-out` for the
    // same reason as `active-tool`.
    in-out property <bool> dev-zoomed: false;
    // Image pixels per screen pixel while zoomed (ADR 0112 §3): 1.0 is
    // 100 %, and the wheel walks it between `Zoom.minimum` and
    // `Zoom.maximum`. Meaningless while `dev-zoomed` is false, where the
    // image is fitted to the viewport instead.
    in-out property <float> dev-scale: 1.0;
    // Which point of the image sits in the middle of the viewport, in [0, 1].
    in-out property <float> dev-center-x: 0.5;
    in-out property <float> dev-center-y: 0.5;
    // 100 % with pan or fit, from the bottom bar of the window and from `Z`
    // (ADR 0158 §2). The exact zoom stays one gesture away whatever the
    // wheel has been doing (ADR 0112 §3), hence the reset.
    public function toggle-zoom() {
        root.dev-scale = 1.0;
        root.dev-center-x = 0.5;
        root.dev-center-y = 0.5;
        root.dev-zoomed = !root.dev-zoomed;
    }

    // Which panel the rail shows on the right (ADR 0158 §4): "edit" (the
    // settings), "crop", "retouch", "masks", "presets", "keywords", "info", "versions", "history", or "" when the user
    // closed it by clicking the open entry. Kept across launches as
    // interface state (ADR 0128), stored as "none" for a closed panel so
    // that "never stored" (`""`, a first launch) can open on the settings.
    in-out property <string> rail-entry: PreferencesState.develop-rail == ""
        ? "edit"
        : (PreferencesState.develop-rail == "none" ? "" : PreferencesState.develop-rail);
    changed rail-entry => {
        PreferencesState.remember-develop-rail(self.rail-entry == "" ? "none" : self.rail-entry);
        root.follow-rail();
    }
    // The tools the Retouch panel picks between.
    function is-retouch-tool(tool: string) -> bool {
        return tool == "spot" || tool == "red-eye" || tool == "reshape";
    }
    // The tools the Masks panel holds: the three that draw, and the
    // range-mask eyedroppers of the selected mask (ADR 0093).
    function is-mask-tool(tool: string) -> bool {
        return tool == "radial" || tool == "gradient" || tool == "brush"
            || tool == "range-lum" || tool == "range-color";
    }
    // A tool entry is a panel and a tool together (ADR 0160 §1): opening
    // Crop picks the crop tool, opening Retouch picks Spot Removal,
    // opening Masks picks none, and leaving any of them puts Select back.
    function follow-rail() {
        if ((root.rail-entry == "retouch" || root.rail-entry == "masks") && root.basic-mode) {
            // Remembered from a Full-mode session: Basic has neither.
            root.rail-entry = "edit";
        } else if (root.rail-entry == "crop") {
            root.active-tool = "crop";
            root.spot-pending = false;
            root.dev-zoomed = false;
        } else if (root.rail-entry == "retouch") {
            if (!root.is-retouch-tool(root.active-tool)) {
                root.active-tool = "spot";
                root.spot-pending = false;
                root.dev-zoomed = false;
                root.expand-spot-removal = true;
            }
        } else if (root.rail-entry == "masks") {
            if (!root.is-mask-tool(root.active-tool)) {
                root.active-tool = "select";
                root.spot-pending = false;
            }
            root.expand-local = true;
        } else if (root.active-tool == "crop" || root.is-retouch-tool(root.active-tool)
                || root.is-mask-tool(root.active-tool)) {
            root.active-tool = "select";
            root.spot-pending = false;
        }
    }
    // And the other way: a tool picked elsewhere — a key, or a picker of
    // the Edit panel (ADR 0160 §3) — closes the tool panel it no longer
    // matches, rather than leave a panel open on a gesture that is not
    // the one the photograph answers.
    changed active-tool => {
        if (self.active-tool != "crop" && root.rail-entry == "crop") {
            root.rail-entry = "edit";
        }
        if (!root.is-retouch-tool(self.active-tool) && root.rail-entry == "retouch") {
            root.rail-entry = "edit";
        }
        // Select is the Masks panel's own state: its handles are the masks'.
        if (!root.is-mask-tool(self.active-tool) && self.active-tool != "select"
                && root.rail-entry == "masks") {
            root.rail-entry = "edit";
        }
    }
    // `D` opens the Edit panel (ADR 0158 §4): entering Develop with the
    // panel closed opens the settings, and leaves any other open entry be.
    property <bool> in-develop: DevelopState.develop-mode;
    changed in-develop => {
        if (self.in-develop && root.rail-entry == "") {
            root.rail-entry = "edit";
        }
        // A Crop entry remembered from the last session comes back with
        // its tool, which the handler above only gives on a change.
        if (self.in-develop) {
            root.follow-rail();
        }
    }

    // Every entry of the profile browser costs a render, so the grid is
    // built when the group is opened and not before (ADR 0089 §1). A
    // `changed` handler rather than a callback on `GroupHeader`: the flag is
    // this panel's own, and giving the shared widget an event for one of its
    // fifteen users would be the wrong place to put it.
    changed expand-camera-profile => {
        if (self.expand-camera-profile) {
            DevelopState.load-profiles();
        }
    }
    // Spot tool's two-click gesture: true between the first (source) click
    // and the second (target) one, with the first click's viewport position
    // held here so a pending-source marker can be drawn.
    property <bool> spot-pending: false;
    property <float> spot-pending-vx: 0;
    property <float> spot-pending-vy: 0;

    // An ellipse centered on `cx`/`cy` with radii `rx`/`ry`, as `Path`
    // commands in whatever unit those four arrive in (ADR 0049 §5).
    //
    // Four cubic segments rather than two `A` arcs: Slint's path parser
    // accepts arc commands and then draws nothing for them. 0.5523 is the
    // usual control-point ratio that makes a cubic quarter indistinguishable
    // from a quarter ellipse.
    pure function ellipse-path(cx: float, cy: float, rx: float, ry: float) -> string {
        return "M\{cx - rx} \{cy}"
            + " C\{cx - rx} \{cy - 0.5523 * ry} \{cx - 0.5523 * rx} \{cy - ry} \{cx} \{cy - ry}"
            + " C\{cx + 0.5523 * rx} \{cy - ry} \{cx + rx} \{cy - 0.5523 * ry} \{cx + rx} \{cy}"
            + " C\{cx + rx} \{cy + 0.5523 * ry} \{cx + 0.5523 * rx} \{cy + ry} \{cx} \{cy + ry}"
            + " C\{cx - 0.5523 * rx} \{cy + ry} \{cx - rx} \{cy + 0.5523 * ry} \{cx - rx} \{cy} Z";
    }

    // A new photo's image just loaded (entered develop, or navigated): loupe
    // zoom is per-photo UI state, so it resets like Compare Before/After
    // does (in Rust, for `dev-compare`). `changed` only ever attaches to a
    // property of the element declaring it, never to a global's, hence this
    // local mirror.
    property <image> loaded-develop-image: DevelopState.develop-image;
    changed loaded-develop-image => {
        root.dev-zoomed = false;
    }

        visible: DevelopState.develop-mode;

        Rectangle {
            width: root.left-inset;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            // `horizontal-stretch` asks for the slack; it cannot take more
            // than this column's *maximum*, and the rows below carry a
            // bounded one. The whole develop view therefore sat at 610px of
            // viewer beside 300px of settings, the rest of the window dark,
            // identically at 1280 and at 1900.
            //
            // Attributed by measurement rather than by reading, after two
            // wrong guesses. A probe reported `root=2400 col=610`: the panel
            // already filled the window, so the cap was inside this column.
            // Cutting the shortcut line below to a single character dropped
            // it to `col=191` — the exact width of the `Select/Crop/100%/Z`
            // chip row, the next bounded thing. So it is the **un-wrapped
            // text and the fixed-width chips** that bound this column, each
            // at its natural width, and the widest of them wins.
            //
            // It is *not* the preview image, which was the tempting
            // explanation and is wrong: the loupe mounts the same
            // `width: 100%` shape and fills a 2400px window while showing a
            // 400x300 photo scaled up. Anyone adding a row here should know
            // that a line of text is what silently sets this view's width.
            //
            // Declaring no maximum is the only way out in Slint 1.13, the
            // same idiom and the same reason as `StudioWindow`.
            max-width: 100000px;
            // And no *minimum*, for the symmetric failure (ADR 0125 §1).
            // The same rows that bounded this column's maximum also set its
            // minimum — the toolbar was ten fixed-width chips deep in Full
            // mode, some 820px of them, until ADR 0160 moved its tools into
            // the panels — and a `HorizontalLayout` that cannot fit its
            // children does not shrink them: it overflows to the right. The settings panel went off the edge of the window
            // below ~1400px, at 1280 (the `preferred-width` this very
            // application declares) losing the value column of every slider,
            // and at 900 (the `min-width` it lets the user drag to) losing
            // the panel entirely. A module whose controls leave the window
            // is not a narrow layout, it is a broken one.
            //
            // Yielding the space is what a column beside a fixed panel has
            // to do.
            min-width: 0px;
            padding: 12px;
            spacing: 8px;

            Rectangle {
                height: Frame.top-bar;
            }

            // The photograph's name, and nothing beside it.
            //
            // A strip of grey text listing six shortcuts used to sit here. It
            // dated from before the menu bar (which prints each shortcut next
            // to its item) and before Help ▸ Keyboard Shortcuts (which lists
            // all six, grouped by where the key works), so by the end it
            // repeated what two other places already said — permanently, in
            // the one row that has to show the file name. It was also the
            // module's longest string, markedly so in French, and the
            // comments that used to live here existed only to stop it setting
            // this view's minimum width at ~1200px. Removing it removes the
            // hazard with the redundancy (ADR 0054 §4).
            if !root.chrome-hidden: Text {
                text: DevelopState.develop-filename;
                color: Theme.text;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }

            preview := Rectangle {
                vertical-stretch: 1;
                clip: true;
                // What the eye adapts to while it judges the photograph
                // (ADR 0117), and the proof's own ground whenever a proof is
                // in effect — a print is looked at on paper.
                background: DevelopState.soft-proof-name == ""
                    ? PreferencesState.viewer-ground
                    : PreferencesState.proof-ground;

                // Where the fit-to-window preview actually sits inside this
                // viewport: the same letterbox `develop::letterbox_unit`
                // inverts on the Rust side, so a mask outline drawn from
                // stored [0, 1] coordinates lands exactly where the gesture
                // that traced it was read (ADR 0049 §5).
                property <float> image-w: max(DevelopState.develop-image.width, 1);
                property <float> image-h: max(DevelopState.develop-image.height, 1);
                property <length> fit: min(self.width / self.image-w, self.height / self.image-h);
                property <length> pad-x: (self.width - self.image-w * self.fit) / 2;
                property <length> pad-y: (self.height - self.image-h * self.fit) / 2;

                if !root.dev-zoomed: Image {
                    source: DevelopState.viewer-image;
                    image-fit: contain;
                    width: 100%;
                    height: 100%;
                }
                // From fit, `Ctrl` + wheel enters the zoom rather than doing
                // nothing (ADR 0112 §3). Under every tool overlay, and only
                // in Select mode, where the wheel means nothing else.
                if !root.dev-zoomed && root.active-tool == "select": TouchArea {
                    // The R/G/B readout follows the pointer here, in Select
                    // mode, under every tool overlay (ADR 0112 §2). Slint's
                    // `moved` fires only while pressed, so the hover is read
                    // through a mirrored property instead.
                    property <length> hover-x: self.mouse-x;
                    property <length> hover-y: self.mouse-y;
                    changed hover-x => {
                        self.sample();
                    }
                    changed hover-y => {
                        self.sample();
                    }
                    changed has-hover => {
                        if (!self.has-hover) {
                            DevelopState.pixel-readout = "";
                        }
                    }
                    function sample() {
                        if (parent.fit <= 0) {
                            return;
                        }
                        DevelopState.sample-pixel(
                            (self.mouse-x - parent.pad-x) / (parent.image-w * parent.fit),
                            (self.mouse-y - parent.pad-y) / (parent.image-h * parent.fit));
                    }
                    scroll-event(event) => {
                        if (event.modifiers.control && event.delta-y > 0) {
                            // Into the spot under the pointer, not the middle.
                            root.dev-scale = Zoom.stepped(parent.fit / 1px, event.delta-y);
                            root.dev-center-x = Zoom.anchored(
                                Math.clamp((self.mouse-x - parent.pad-x) / (parent.image-w * parent.fit), 0, 1),
                                self.mouse-x - parent.width / 2,
                                parent.image-w * root.dev-scale * 1px);
                            root.dev-center-y = Zoom.anchored(
                                Math.clamp((self.mouse-y - parent.pad-y) / (parent.image-h * parent.fit), 0, 1),
                                self.mouse-y - parent.height / 2,
                                parent.image-h * root.dev-scale * 1px);
                            root.dev-zoomed = true;
                            return accept;
                        }
                        return reject;
                    }
                }

                // Zoomed: the image at `dev-scale` image-pixels per screen
                // pixel, slid so the requested centre sits in the middle of
                // the viewport — for judging sharpening and noise reduction
                // at the pixel level, which fit-to-window cannot show.
                //
                // Laid out by hand rather than in a `Flickable` because the
                // wheel has two meanings here (ADR 0112 §3): `Ctrl` zooms,
                // and a drag pans. A Flickable would own both.
                if root.dev-zoomed: Rectangle {
                    width: 100%;
                    height: 100%;
                    property <length> shown-w: parent.image-w * root.dev-scale * 1px;
                    property <length> shown-h: parent.image-h * root.dev-scale * 1px;
                    Image {
                        source: DevelopState.viewer-image;
                        width: parent.shown-w;
                        height: parent.shown-h;
                        x: parent.width / 2 - root.dev-center-x * parent.shown-w;
                        y: parent.height / 2 - root.dev-center-y * parent.shown-h;
                    }
                    zoom-area := TouchArea {
                        property <float> from-x;
                        property <float> from-y;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                self.from-x = root.dev-center-x;
                                self.from-y = root.dev-center-y;
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                root.dev-center-x = Math.clamp(self.from-x - (self.mouse-x - self.pressed-x) / parent.shown-w, 0, 1);
                                root.dev-center-y = Math.clamp(self.from-y - (self.mouse-y - self.pressed-y) / parent.shown-h, 0, 1);
                            }
                        }
                        scroll-event(event) => {
                            if (event.modifiers.control) {
                                // The image point under the pointer stays under it.
                                let point-x = root.dev-center-x + (self.mouse-x - parent.width / 2) / parent.shown-w;
                                let point-y = root.dev-center-y + (self.mouse-y - parent.height / 2) / parent.shown-h;
                                root.dev-scale = Zoom.stepped(root.dev-scale, event.delta-y);
                                root.dev-center-x = Zoom.anchored(
                                    Math.clamp(point-x, 0, 1),
                                    self.mouse-x - parent.width / 2,
                                    parent.shown-w);
                                root.dev-center-y = Zoom.anchored(
                                    Math.clamp(point-y, 0, 1),
                                    self.mouse-y - parent.height / 2,
                                    parent.shown-h);
                                return accept;
                            }
                            return reject;
                        }
                    }
                }

                // What the pointer is over, and how far in we are
                // (ADR 0112 §2, §3). Bottom right, out of the way of the
                // Compare badge in the opposite corner.
                if root.dev-zoomed || DevelopState.pixel-readout != "": Rectangle {
                    x: parent.width - self.width - 8px;
                    y: parent.height - self.height - 8px;
                    width: readout.preferred-width + 16px;
                    height: readout.preferred-height + 8px;
                    background: Hues.photo-scrim;
                    border-radius: 4px;
                    readout := Text {
                        text: root.dev-zoomed
                            ? Zoom.percent(root.dev-scale) + "   " + DevelopState.pixel-readout
                            : DevelopState.pixel-readout;
                        color: Hues.on-photo-text;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                if DevelopState.dev-compare: Rectangle {
                    x: 8px;
                    y: 8px;
                    width: label.preferred-width + 16px;
                    height: label.preferred-height + 8px;
                    background: Hues.photo-scrim;
                    border-radius: 4px;
                    label := Text {
                        x: 8px;
                        y: 4px;
                        text: @tr("Before");
                        color: Hues.on-photo-text;
                        font-size: 12px;
                    }
                }

                // Only the Crop tool drags a crop rectangle — the
                // default Select tool leaves dragging a no-op so a
                // photo can be looked at without accidentally cropping.
                crop-drag := TouchArea {
                    enabled: root.active-tool == "crop";
                    mouse-cursor: crosshair;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                            // The **constrained** corner, not the pointer
                            // (ADR 0135 §2): the rectangle drawn and the
                            // crop committed have to be the same rectangle,
                            // and the only way to guarantee that is for one
                            // of them to be computed from the other.
                            DevelopState.develop-crop-drag(
                                self.pressed-x / 1px, self.pressed-y / 1px,
                                root.crop-corner-x(self.pressed-x, self.pressed-y, self.mouse-x, self.mouse-y) / 1px,
                                root.crop-corner-y(self.pressed-x, self.pressed-y, self.mouse-x, self.mouse-y) / 1px,
                                self.width / 1px, self.height / 1px,
                                DevelopState.develop-image.width, DevelopState.develop-image.height);
                        }
                    }
                }

                // Selection rectangle, live while the mouse is down, drawn
                // at the chosen ratio.
                crop-band := Rectangle {
                    property <length> corner-x: root.crop-corner-x(crop-drag.pressed-x, crop-drag.pressed-y, crop-drag.mouse-x, crop-drag.mouse-y);
                    property <length> corner-y: root.crop-corner-y(crop-drag.pressed-x, crop-drag.pressed-y, crop-drag.mouse-x, crop-drag.mouse-y);
                    visible: crop-drag.pressed;
                    x: min(crop-drag.pressed-x, self.corner-x);
                    y: min(crop-drag.pressed-y, self.corner-y);
                    width: abs((crop-drag.pressed-x - self.corner-x) / 1px) * 1px;
                    height: abs((crop-drag.pressed-y - self.corner-y) / 1px) * 1px;
                    background: Hues.marquee-fill;
                    border-width: 1px;
                    border-color: Hues.marquee-edge;
                }

                // Composition guides (ADR 0135 §3), over the whole frame
                // before a drag and **inside the rubber band** during one
                // (§4): thirds of a frame one is about to discard are thirds
                // of nothing.
                //
                // Two strokes per line, dark under light: a guide has to
                // read over a white sky and a black shadow, and one colour
                // cannot do both.
                if root.active-tool == "crop" && root.crop-guide != "none": Rectangle {
                    // The **letterboxed photograph**, not the viewer: on a
                    // portrait frame in a wide viewer the two are nothing
                    // alike, and thirds of the grey surround are thirds of
                    // nothing. Seen on the running binary — the first
                    // version drew corner to corner of the element.
                    property <float> image-ratio: DevelopState.develop-image.height > 0
                        ? DevelopState.develop-image.width / DevelopState.develop-image.height
                        : 1;
                    property <length> shown-width: min(parent.width, parent.height * self.image-ratio);
                    property <length> shown-height: self.image-ratio > 0 ? self.shown-width / self.image-ratio : parent.height;
                    property <length> shown-x: (parent.width - self.shown-width) / 2;
                    property <length> shown-y: (parent.height - self.shown-height) / 2;

                    property <length> gx: crop-drag.pressed ? crop-band.x : self.shown-x;
                    property <length> gy: crop-drag.pressed ? crop-band.y : self.shown-y;
                    property <length> gw: crop-drag.pressed ? crop-band.width : self.shown-width;
                    property <length> gh: crop-drag.pressed ? crop-band.height : self.shown-height;
                    property <string> commands: root.guide-commands(root.crop-guide, self.gx, self.gy, self.gw, self.gh);

                    Path {
                        width: 100%;
                        height: 100%;
                        viewbox-width: self.width / 1px;
                        viewbox-height: self.height / 1px;
                        commands: parent.commands;
                        stroke: Hues.line-shadow;
                        stroke-width: 3px;
                    }
                    Path {
                        width: 100%;
                        height: 100%;
                        viewbox-width: self.width / 1px;
                        viewbox-height: self.height / 1px;
                        commands: parent.commands;
                        stroke: Hues.line-light;
                        stroke-width: 1px;
                    }
                }

                // Spot removal (ADR 0032): two clicks place one spot —
                // the first sets the source pin (shown as a marker
                // until the second click), the second sets the target
                // and commits the clone in one `develop-spot-click`
                // call, mirroring `develop-crop-drag`'s single-call
                // shape.
                spot-click := TouchArea {
                    enabled: root.active-tool == "spot";
                    mouse-cursor: crosshair;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                            if (!root.spot-pending) {
                                root.spot-pending = true;
                                root.spot-pending-vx = self.mouse-x / 1px;
                                root.spot-pending-vy = self.mouse-y / 1px;
                            } else {
                                DevelopState.develop-spot-click(
                                    root.spot-pending-vx, root.spot-pending-vy,
                                    self.mouse-x / 1px, self.mouse-y / 1px,
                                    self.width / 1px, self.height / 1px,
                                    DevelopState.develop-image.width, DevelopState.develop-image.height);
                                root.spot-pending = false;
                            }
                        }
                    }
                }

                // White-balance picker (ADR 0091): one click on a neutral
                // grey resolves temperature and tint, then the tool hands
                // back to Select — the gesture answers one question.
                wb-click := TouchArea {
                    enabled: root.active-tool == "wb";
                    mouse-cursor: crosshair;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                            DevelopState.develop-wb-click(
                                self.mouse-x / 1px, self.mouse-y / 1px,
                                self.width / 1px, self.height / 1px,
                                DevelopState.develop-image.width, DevelopState.develop-image.height);
                            root.active-tool = "select";
                        }
                    }
                }

                // The targeted adjustment (ADR 0130 §3): press on a tone,
                // drag up to lift it and down to lower it. The press names
                // the setting — Rust reads the pixel and says which of the
                // five it belongs to — and the drag is then an ordinary
                // slider gesture on it, preview while moving, commit on
                // release, exactly as `EditSlider` does.
                //
                // The tool stays armed after a release: adjusting a
                // photograph by pointing at it is a sequence of pulls, not
                // one answer like the eyedroppers above.
                target-drag := TouchArea {
                    enabled: root.active-tool == "target";
                    mouse-cursor: ns-resize;
                    // Where the drag started from, in the setting's own
                    // units. Read once at the press: a preview writes
                    // nothing, so `DevelopState.dev` holds still for the
                    // length of the drag.
                    property <float> base;
                    property <float> shown: root.target-value(DevelopState.target-setting, self.base,
                        (self.pressed-y - self.mouse-y) / 1px);
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            if (parent.fit > 0) {
                                DevelopState.target-pick(
                                    (self.mouse-x - parent.pad-x) / (parent.image-w * parent.fit),
                                    (self.mouse-y - parent.pad-y) / (parent.image-h * parent.fit));
                                self.base = root.target-base(DevelopState.target-setting);
                            }
                        }
                        if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left
                            && DevelopState.target-setting != "") {
                            DevelopState.develop-edit(DevelopState.target-setting, self.shown);
                            DevelopState.target-setting = "";
                        }
                    }
                    moved => {
                        if (self.pressed && DevelopState.target-setting != "") {
                            DevelopState.develop-preview(DevelopState.target-setting, self.shown);
                        }
                    }
                }

                // The range eyedropper (ADR 0093): one click writes the
                // band onto the selected mask row, then hands back to
                // Select — same one-question shape as the WB picker.
                range-click := TouchArea {
                    enabled: root.active-tool == "range-lum" || root.active-tool == "range-color";
                    mouse-cursor: crosshair;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                            MaskState.range-sample-click(
                                root.active-tool,
                                self.mouse-x / 1px, self.mouse-y / 1px,
                                self.width / 1px, self.height / 1px,
                                DevelopState.develop-image.width, DevelopState.develop-image.height);
                            root.active-tool = "select";
                        }
                    }
                }

                // Red-eye (ADR 0103): one click places one disk over a
                // pupil, and the tool stays armed — a face has two eyes.
                red-eye-click := TouchArea {
                    enabled: root.active-tool == "red-eye";
                    mouse-cursor: crosshair;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                            DevelopState.develop-red-eye-click(
                                self.mouse-x / 1px, self.mouse-y / 1px,
                                self.width / 1px, self.height / 1px,
                                DevelopState.develop-image.width, DevelopState.develop-image.height);
                        }
                    }
                }

                // Pending source pin, shown between the two spot clicks.
                Rectangle {
                    visible: root.spot-pending;
                    x: root.spot-pending-vx * 1px - 5px;
                    y: root.spot-pending-vy * 1px - 5px;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: Hues.guide-fill;
                    border-width: 1px;
                    border-color: Hues.guide;
                }

                // Radial and gradient: one drag traces the geometry
                // (ADR 0049 §1), onto the selected row when it is of the
                // same kind and as a new entry otherwise — the decision is
                // Rust's, in `masks::place_geometry`.
                mask-drag := TouchArea {
                    enabled: root.active-tool == "radial" || root.active-tool == "gradient";
                    mouse-cursor: crosshair;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                            MaskState.place-mask(
                                MaskState.selected-mask, root.active-tool,
                                self.pressed-x / 1px, self.pressed-y / 1px,
                                self.mouse-x / 1px, self.mouse-y / 1px,
                                self.width / 1px, self.height / 1px,
                                DevelopState.develop-image.width, DevelopState.develop-image.height);
                        }
                    }
                }

                // Live feedback while tracing: the ellipse that will be
                // inscribed in the dragged rectangle, or the gradient's axis.
                //
                // Both are one `Path` spanning the whole viewport with a
                // viewbox in viewport pixels, so its coordinates *are* the
                // viewport's own — a `Path` scales its viewbox uniformly and
                // centers it, so a stretched square viewbox would draw a
                // circle where an ellipse belongs.
                if mask-drag.pressed && root.active-tool == "radial": Path {
                    width: 100%;
                    height: 100%;
                    viewbox-width: self.width / 1px;
                    viewbox-height: self.height / 1px;
                    commands: ellipse-path(
                        (mask-drag.pressed-x + mask-drag.mouse-x) / 2 / 1px,
                        (mask-drag.pressed-y + mask-drag.mouse-y) / 2 / 1px,
                        abs((mask-drag.pressed-x - mask-drag.mouse-x) / 1px) / 2,
                        abs((mask-drag.pressed-y - mask-drag.mouse-y) / 1px) / 2);
                    stroke: Hues.guide;
                    stroke-width: 1px;
                }
                if mask-drag.pressed && root.active-tool == "gradient": Path {
                    width: 100%;
                    height: 100%;
                    viewbox-width: self.width / 1px;
                    viewbox-height: self.height / 1px;
                    commands: "M\{mask-drag.pressed-x / 1px} \{mask-drag.pressed-y / 1px} L\{mask-drag.mouse-x / 1px} \{mask-drag.mouse-y / 1px}";
                    stroke: Hues.guide;
                    stroke-width: 1px;
                }

                // Reshape (ADR 0109): one drag — press on the content, release
                // where it should go. The tool stays armed, because a face or
                // a horizon usually takes several handles.
                reshape-drag := TouchArea {
                    enabled: root.active-tool == "reshape";
                    mouse-cursor: crosshair;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                            DevelopState.develop-reshape-drag(
                                self.pressed-x / 1px, self.pressed-y / 1px,
                                self.mouse-x / 1px, self.mouse-y / 1px,
                                self.width / 1px, self.height / 1px,
                                DevelopState.develop-image.width, DevelopState.develop-image.height);
                        }
                    }
                }

                // What the drag is about to do: the displacement, and the
                // circle of influence around where it lands.
                if reshape-drag.pressed: Path {
                    width: 100%;
                    height: 100%;
                    viewbox-width: self.width / 1px;
                    viewbox-height: self.height / 1px;
                    commands: "M\{reshape-drag.pressed-x / 1px} \{reshape-drag.pressed-y / 1px} L\{reshape-drag.mouse-x / 1px} \{reshape-drag.mouse-y / 1px}";
                    stroke: Hues.guide;
                    stroke-width: 1px;
                }

                // Keystone (ADR 0119): one drag per guide, drawn along
                // something that ought to be straight. The tool stays armed
                // — it takes at least two.
                keystone-drag := TouchArea {
                    enabled: root.active-tool == "keystone";
                    mouse-cursor: crosshair;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                            DevelopState.develop-keystone-drag(
                                self.pressed-x / 1px, self.pressed-y / 1px,
                                self.mouse-x / 1px, self.mouse-y / 1px,
                                self.width / 1px, self.height / 1px,
                                DevelopState.develop-image.width, DevelopState.develop-image.height);
                        }
                    }
                }

                // The guides already drawn, in the displayed frame's own
                // units — so the letterbox is recomputed here rather than
                // baked into the stored numbers, and a window resize moves
                // them with the photograph.
                if root.active-tool == "keystone": Rectangle {
                    property <float> image-ratio: DevelopState.develop-image.height > 0
                        ? DevelopState.develop-image.width / DevelopState.develop-image.height
                        : 1.0;
                    property <length> shown-width: min(self.width, self.height * self.image-ratio);
                    property <length> shown-height: self.image-ratio > 0 ? self.shown-width / self.image-ratio : self.height;
                    property <length> shown-x: (self.width - self.shown-width) / 2;
                    property <length> shown-y: (self.height - self.shown-height) / 2;

                    for guide in DevelopState.keystone-guides: Path {
                        width: 100%;
                        height: 100%;
                        viewbox-width: self.width / 1px;
                        viewbox-height: self.height / 1px;
                        commands: "M\{(parent.shown-x + guide.x1 * parent.shown-width) / 1px} \{(parent.shown-y + guide.y1 * parent.shown-height) / 1px} L\{(parent.shown-x + guide.x2 * parent.shown-width) / 1px} \{(parent.shown-y + guide.y2 * parent.shown-height) / 1px}";
                        stroke: Hues.guide-alternate;
                        stroke-width: 1px;
                    }
                }

                if keystone-drag.pressed: Path {
                    width: 100%;
                    height: 100%;
                    viewbox-width: self.width / 1px;
                    viewbox-height: self.height / 1px;
                    commands: "M\{keystone-drag.pressed-x / 1px} \{keystone-drag.pressed-y / 1px} L\{keystone-drag.mouse-x / 1px} \{keystone-drag.mouse-y / 1px}";
                    stroke: Hues.guide-alternate;
                    stroke-width: 1px;
                }

                // Brush: a traced stroke, not a dab per click (ADR 0049 §2).
                // Press begins it, moving extends it, release commits the
                // whole stroke as one revision. A click that never moves is
                // still a single dab, which is what it was before.
                brush-click := TouchArea {
                    enabled: root.active-tool == "brush";
                    mouse-cursor: crosshair;
                    moved => {
                        if (self.pressed) {
                            MaskState.brush-extend(
                                self.mouse-x / 1px, self.mouse-y / 1px,
                                self.width / 1px, self.height / 1px,
                                DevelopState.develop-image.width, DevelopState.develop-image.height);
                        }
                    }
                    pointer-event(event) => {
                        if (event.button != PointerEventButton.left) {
                            return;
                        }
                        if (event.kind == PointerEventKind.down) {
                            MaskState.brush-begin(
                                self.mouse-x / 1px, self.mouse-y / 1px,
                                self.width / 1px, self.height / 1px,
                                DevelopState.develop-image.width, DevelopState.develop-image.height);
                        }
                        if (event.kind == PointerEventKind.up) {
                            MaskState.brush-end();
                        }
                    }
                }

                // Where the next dab will land, and how big it will be — the
                // circle every painting program puts under the pointer. Drawn
                // from the same size the panel's field holds, so it cannot
                // disagree with what gets painted: the radius is a percentage
                // of the image's larger dimension, exactly as `brush_defaults`
                // reads it.
                if root.active-tool == "brush" && brush-click.has-hover: Rectangle {
                    property <length> radius:
                        MaskState.brush-size-text.to-float() / 100
                        * max(preview.image-w * preview.fit, preview.image-h * preview.fit);
                    x: brush-click.mouse-x - self.radius;
                    y: brush-click.mouse-y - self.radius;
                    width: 2 * self.radius;
                    height: self.width;
                    border-radius: self.width / 2;
                    border-width: 1px;
                    // Lighter than a placed dab: this one is a promise, not a
                    // mark.
                    border-color: Hues.dab-preview;
                }

                // The stroke as it is being traced, drawn from the dabs Rust
                // has kept so far. It exists only during the drag: on release
                // the commit turns it into the selected mask's own outline
                // below, which is drawn by exactly the same arithmetic.
                if MaskState.brush-pending.length > 0: Rectangle {
                    x: preview.pad-x;
                    y: preview.pad-y;
                    width: preview.image-w * preview.fit;
                    height: preview.image-h * preview.fit;
                    for dab in MaskState.brush-pending: Rectangle {
                        x: dab.x * parent.width - dab.radius * max(parent.width, parent.height);
                        y: dab.y * parent.height - dab.radius * max(parent.width, parent.height);
                        width: 2 * dab.radius * max(parent.width, parent.height);
                        height: self.width;
                        border-radius: self.width / 2;
                        background: Hues.guide-faint;
                        border-width: 1px;
                        border-color: Hues.guide-soft;
                    }
                }

                // The selected mask's outline (ADR 0049 §5): the geometry
                // itself, never the resulting coverage — that would include
                // the range term, hence the pixels, hence a render the engine
                // does not expose. Drawn from the stored [0, 1] coordinates
                // through the letterbox above.
                //
                // A radial's `angle` is not reflected: the tools only ever
                // write 0 (a two-corner drag has no rotation to report), and
                // an ellipse written at an angle through the CLI or the SDK
                // shows its unrotated outline.
                if MaskState.selected-mask >= 0 && MaskState.selected-mask < MaskState.masks.length: outline := Rectangle {
                    property <MaskRow> shape: MaskState.masks[MaskState.selected-mask];
                    // Where the image sits, so children can work in image
                    // fractions without repeating the letterbox.
                    x: preview.pad-x;
                    y: preview.pad-y;
                    width: preview.image-w * preview.fit;
                    height: preview.image-h * preview.fit;

                    // The image area in its own pixels, the unit both paths
                    // below work in (see the live feedback's comment for why
                    // the viewbox has to match the element's aspect ratio).
                    property <float> w: self.width / 1px;
                    property <float> h: self.height / 1px;

                    if outline.shape.kind == "radial": Path {
                        width: 100%;
                        height: 100%;
                        viewbox-width: outline.w;
                        viewbox-height: outline.h;
                        commands: ellipse-path(
                            outline.shape.cx * outline.w, outline.shape.cy * outline.h,
                            outline.shape.rx * outline.w, outline.shape.ry * outline.h);
                        stroke: Hues.guide;
                        stroke-width: 1px;
                    }
                    if outline.shape.kind == "gradient": Path {
                        width: 100%;
                        height: 100%;
                        viewbox-width: outline.w;
                        viewbox-height: outline.h;
                        commands: "M\{outline.shape.x0 * outline.w} \{outline.shape.y0 * outline.h} L\{outline.shape.x1 * outline.w} \{outline.shape.y1 * outline.h}";
                        stroke: Hues.guide;
                        stroke-width: 1px;
                    }
                    // The full-coverage end of the gradient, so which way it
                    // runs is visible rather than guessed.
                    if outline.shape.kind == "gradient": Rectangle {
                        x: outline.shape.x0 * parent.width - 4px;
                        y: outline.shape.y0 * parent.height - 4px;
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: Hues.guide;
                    }

                    // Drag handles (ADR 0097). Squares with a `TouchArea`,
                    // never a `Path`: the software renderer drops most
                    // `Path` marks (ADR 0049 §5). Live under the Select
                    // tool only — a tracing tool is armed to draw, and a
                    // handle under its first click would cost a mask.
                    if root.active-tool == "select" && outline.shape.kind == "radial": handle-center := Rectangle {
                        x: outline.shape.cx * parent.width - 6px;
                        y: outline.shape.cy * parent.height - 6px;
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        background: Hues.guide-handle;
                        border-width: 1px;
                        border-color: Hues.guide-handle-edge;
                        TouchArea {
                            mouse-cursor: move;
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                    MaskState.drag-mask-handle("center",
                                        (parent.x + self.mouse-x) / 1px, (parent.y + self.mouse-y) / 1px,
                                        outline.w, outline.h,
                                        DevelopState.develop-image.width, DevelopState.develop-image.height);
                                }
                            }
                        }
                    }
                    if root.active-tool == "select" && outline.shape.kind == "radial": handle-rx := Rectangle {
                        x: (outline.shape.cx + outline.shape.rx) * parent.width - 5px;
                        y: outline.shape.cy * parent.height - 5px;
                        width: 10px;
                        height: 10px;
                        border-radius: 2px;
                        background: Hues.guide-handle;
                        border-width: 1px;
                        border-color: Hues.guide-handle-edge;
                        TouchArea {
                            mouse-cursor: ew-resize;
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                    MaskState.drag-mask-handle("rx",
                                        (parent.x + self.mouse-x) / 1px, (parent.y + self.mouse-y) / 1px,
                                        outline.w, outline.h,
                                        DevelopState.develop-image.width, DevelopState.develop-image.height);
                                }
                            }
                        }
                    }
                    if root.active-tool == "select" && outline.shape.kind == "radial": handle-ry := Rectangle {
                        x: outline.shape.cx * parent.width - 5px;
                        y: (outline.shape.cy + outline.shape.ry) * parent.height - 5px;
                        width: 10px;
                        height: 10px;
                        border-radius: 2px;
                        background: Hues.guide-handle;
                        border-width: 1px;
                        border-color: Hues.guide-handle-edge;
                        TouchArea {
                            mouse-cursor: ns-resize;
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                    MaskState.drag-mask-handle("ry",
                                        (parent.x + self.mouse-x) / 1px, (parent.y + self.mouse-y) / 1px,
                                        outline.w, outline.h,
                                        DevelopState.develop-image.width, DevelopState.develop-image.height);
                                }
                            }
                        }
                    }
                    if root.active-tool == "select" && outline.shape.kind == "gradient": handle-from := Rectangle {
                        x: outline.shape.x0 * parent.width - 6px;
                        y: outline.shape.y0 * parent.height - 6px;
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        background: Hues.guide-handle;
                        border-width: 1px;
                        border-color: Hues.guide-handle-edge;
                        TouchArea {
                            mouse-cursor: move;
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                    MaskState.drag-mask-handle("from",
                                        (parent.x + self.mouse-x) / 1px, (parent.y + self.mouse-y) / 1px,
                                        outline.w, outline.h,
                                        DevelopState.develop-image.width, DevelopState.develop-image.height);
                                }
                            }
                        }
                    }
                    if root.active-tool == "select" && outline.shape.kind == "gradient": handle-to := Rectangle {
                        x: outline.shape.x1 * parent.width - 6px;
                        y: outline.shape.y1 * parent.height - 6px;
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        background: Hues.guide-soft;
                        border-width: 1px;
                        border-color: Hues.guide-handle-edge;
                        TouchArea {
                            mouse-cursor: move;
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                    MaskState.drag-mask-handle("to",
                                        (parent.x + self.mouse-x) / 1px, (parent.y + self.mouse-y) / 1px,
                                        outline.w, outline.h,
                                        DevelopState.develop-image.width, DevelopState.develop-image.height);
                                }
                            }
                        }
                    }
                    // Dab radii are normalized against the larger dimension,
                    // so a dab is a circle on screen and not an ellipse.
                    if outline.shape.kind == "brush": Rectangle {
                        for dab in outline.shape.dabs: Rectangle {
                            x: dab.x * parent.width - dab.radius * max(parent.width, parent.height);
                            y: dab.y * parent.height - dab.radius * max(parent.width, parent.height);
                            width: 2 * dab.radius * max(parent.width, parent.height);
                            height: self.width;
                            border-radius: self.width / 2;
                            border-width: 1px;
                            border-color: Hues.guide-soft;
                        }
                    }
                }

                // Right-click (ADR 0021): every entry is an existing
                // callback already wired to a keyboard shortcut or a
                // panel control above.
                ContextMenuArea {
                    Menu {
                        MenuItem {
                            title: @tr("Reset Crop");
                            activated => {
                                DevelopState.develop-edit("crop-reset", 0);
                            }
                        }
                        MenuItem {
                            title: @tr("Undo Last Spot");
                            enabled: DevelopState.dev-spot-count > 0;
                            activated => {
                                DevelopState.develop-spot-undo();
                            }
                        }
                        MenuItem {
                            title: @tr("Clear All Spots");
                            enabled: DevelopState.dev-spot-count > 0;
                            activated => {
                                DevelopState.develop-spot-reset();
                            }
                        }
                        MenuItem {
                            title: DevelopState.dev-compare ? @tr("Show After    \\") : @tr("Compare Before/After    \\");
                            activated => {
                                DevelopState.toggle-compare();
                            }
                        }
                        MenuSeparator { }
                        MenuItem {
                            title: @tr("Reprocess    R");
                            activated => {
                                DevelopState.develop-reprocess();
                            }
                        }
                        MenuSeparator { }
                        MenuItem {
                            title: @tr("Back to Library    G");
                            activated => {
                                DevelopState.exit-develop();
                            }
                        }
                    }
                }

                // Where in the frame one is looking, in the corner opposite
                // the readout (ADR 0158 §3). Last, so its clicks are its own.
                if root.dev-zoomed: Navigator {
                    x: 8px;
                    y: parent.height - self.height - 8px;
                    scale: root.dev-scale;
                    center-x: root.dev-center-x;
                    center-y: root.dev-center-y;
                    viewer-width: parent.width;
                    viewer-height: parent.height;
                    panned(x, y) => {
                        root.dev-center-x = x;
                        root.dev-center-y = y;
                    }
                }
            }

            // Filmstrip: the loaded grid window's thumbnails, so switching
            // photos doesn't require leaving develop mode. Reuses
            // `GridState.cells` (already populated for the grid) — no
            // separate data path — through the same widget the loupe mounts
            // (ADR 0055 §5).
            if !root.chrome-hidden && !root.filmstrip-hidden: Filmstrip {
                cells: GridState.cells;
                window-start: GridState.window-start;
                selected: GridState.selected;
                clicked(index) => {
                    DevelopState.develop-switch(index);
                }
            }

            // Under the bottom bar of the window (ADR 0158 §2), which now
            // carries the views and the zoom here too.
            if !root.chrome-hidden: Rectangle {
                height: Frame.bottom-bar;
            }
        }

        if !root.side-panels-hidden && root.rail-entry != "": Rectangle {
            // 320px since ADR 0140 §1: the label column needed twenty
            // pixels it could not take from the track without spending the
            // precision ADR 0126 bought, so the panel pays instead.
            width: 320px;
            background: Theme.surface;

            // The other rail panels, built when opened: short lists, cheap
            // to make again.
            if root.rail-entry == "presets": Flickable {
                VerticalLayout {
                    padding: 16px;
                    alignment: start;
                    Rectangle {
                        height: Frame.top-bar;
                    }
                    PresetsPanel { }
                    Rectangle {
                        height: Frame.bottom-bar;
                    }
                }
            }
            if root.rail-entry == "versions": Flickable {
                VerticalLayout {
                    padding: 16px;
                    alignment: start;
                    Rectangle {
                        height: Frame.top-bar;
                    }
                    VersionsPanel { }
                    Rectangle {
                        height: Frame.bottom-bar;
                    }
                }
            }
            if root.rail-entry == "history": Flickable {
                VerticalLayout {
                    padding: 16px;
                    alignment: start;
                    Rectangle {
                        height: Frame.top-bar;
                    }
                    HistoryPanel { }
                    Rectangle {
                        height: Frame.bottom-bar;
                    }
                }
            }

            // The rail's bottom group (ADR 0158 §4): the library's own panels,
            // reachable without leaving the photograph.
            if root.rail-entry == "keywords": Flickable {
                VerticalLayout {
                    padding: 16px;
                    alignment: start;
                    Rectangle {
                        height: Frame.top-bar;
                    }
                    PhotoKeywords {
                        return-focus => {
                            root.return-focus();
                        }
                    }
                    Rectangle {
                        height: Frame.bottom-bar;
                    }
                }
            }
            if root.rail-entry == "info": Flickable {
                VerticalLayout {
                    padding: 16px;
                    alignment: start;
                    Rectangle {
                        height: Frame.top-bar;
                    }
                    PhotoInfo {
                        return-focus => {
                            root.return-focus();
                        }
                    }
                    Rectangle {
                        height: Frame.bottom-bar;
                    }
                }
            }

            // The Crop entry (ADR 0160 §2). First the shape the next drag
            // takes and the guide drawn while it is made (ADR 0135 §1) — a
            // setting that changes the meaning of a gesture, beside the
            // panel that picked the gesture — then the angle and the frame
            // that exist, as numbers.
            if root.rail-entry == "crop": Flickable {
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    alignment: start;
                    Rectangle {
                        height: Frame.top-bar;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        FilterChip {
                            text: @tr("Free");
                            active: root.crop-ratio == 0;
                            clicked => {
                                root.crop-ratio = 0;
                            }
                        }
                        CropRatioChip { label: "1:1"; ratio: 1.0; chosen: root.crop-ratio; picked(r) => { root.crop-ratio = r; } }
                        CropRatioChip { label: "5:4"; ratio: 1.25; chosen: root.crop-ratio; picked(r) => { root.crop-ratio = r; } }
                        CropRatioChip { label: "4:3"; ratio: 4.0 / 3.0; chosen: root.crop-ratio; picked(r) => { root.crop-ratio = r; } }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        CropRatioChip { label: "3:2"; ratio: 1.5; chosen: root.crop-ratio; picked(r) => { root.crop-ratio = r; } }
                        CropRatioChip { label: "16:9"; ratio: 16.0 / 9.0; chosen: root.crop-ratio; picked(r) => { root.crop-ratio = r; } }
                        CropRatioChip { label: "7:5"; ratio: 1.4; chosen: root.crop-ratio; picked(r) => { root.crop-ratio = r; } }
                        FilterChip {
                            text: @tr("Turn");
                            active: false;
                            enabled: root.crop-ratio > 0 && root.crop-ratio != 1;
                            clicked => {
                                root.crop-ratio = 1 / root.crop-ratio;
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        FilterChip {
                            // Names the guide currently drawn, and carries the key
                            // that cycles it: `O` is the gesture, and the chip is
                            // what tells anyone it exists.
                            text: root.crop-guide == "none" ? @tr("Guide    O")
                                : root.crop-guide == "thirds" ? @tr("Thirds    O")
                                : root.crop-guide == "golden" ? @tr("Golden    O")
                                : root.crop-guide == "diagonals" ? @tr("Diagonals    O")
                                : @tr("Grid    O");
                            active: root.crop-guide != "none";
                            clicked => {
                                root.crop-guide = root.next-guide(root.crop-guide);
                            }
                        }
                    }
                    EditSlider {
                        label: @tr("Rotation");
                        minimum: -45;
                        maximum: 45;
                        decimals: 1;
                        value: DevelopState.dev.rotation;
                        edited(v) => {
                            DevelopState.develop-edit("rotation", v);
                        }
                        previewing(v) => {
                            DevelopState.develop-preview("rotation", v);
                        }
                    }
                    SubHeading {
                        label: @tr("Crop");
                    }
                    EditSlider {
                        label: @tr("Left");
                        minimum: 0;
                        maximum: 100;
                        value: DevelopState.dev.crop-left;
                        edited(v) => {
                            DevelopState.develop-edit("crop-left", v);
                        }
                        previewing(v) => {
                            DevelopState.develop-preview("crop-left", v);
                        }
                    }
                    EditSlider {
                        label: @tr("Top");
                        minimum: 0;
                        maximum: 100;
                        value: DevelopState.dev.crop-top;
                        edited(v) => {
                            DevelopState.develop-edit("crop-top", v);
                        }
                        previewing(v) => {
                            DevelopState.develop-preview("crop-top", v);
                        }
                    }
                    EditSlider {
                        label: @tr("Width");
                        minimum: 1;
                        maximum: 100;
                        value: DevelopState.dev.crop-width;
                        edited(v) => {
                            DevelopState.develop-edit("crop-width", v);
                        }
                        previewing(v) => {
                            DevelopState.develop-preview("crop-width", v);
                        }
                    }
                    EditSlider {
                        label: @tr("Height");
                        minimum: 1;
                        maximum: 100;
                        value: DevelopState.dev.crop-height;
                        edited(v) => {
                            DevelopState.develop-edit("crop-height", v);
                        }
                        previewing(v) => {
                            DevelopState.develop-preview("crop-height", v);
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        FilterChip {
                            text: @tr("Reset crop");
                            active: false;
                            clicked => {
                                DevelopState.develop-edit("crop-reset", 0);
                            }
                        }
                    }
                    Rectangle {
                        height: Frame.bottom-bar;
                    }
                }
            }

            // The Retouch entry (ADR 0160 §2): the three repairs of the
            // photograph's content, the tool first and then what it placed.
            // Full mode only, like the chips it replaces (ADR 0054 §2).
            if root.rail-entry == "retouch": Flickable {
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    alignment: start;
                    Rectangle {
                        height: Frame.top-bar;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        FilterChip {
                            text: @tr("Spot Removal");
                            active: root.active-tool == "spot";
                            clicked => {
                                root.active-tool = "spot";
                                root.expand-spot-removal = true;
                            }
                        }
                        FilterChip {
                            // Red-eye (ADR 0103): one click per pupil, where spot
                            // removal takes two.
                            text: @tr("Red Eye");
                            active: root.active-tool == "red-eye";
                            clicked => {
                                root.active-tool = "red-eye";
                                root.spot-pending = false;
                                root.expand-red-eye = true;
                            }
                        }
                        FilterChip {
                            text: @tr("Reshape");
                            active: root.active-tool == "reshape";
                            clicked => {
                                root.active-tool = "reshape";
                                root.spot-pending = false;
                                root.expand-reshape = true;
                            }
                        }
                    }
                    GroupHeader {
                        label: @tr("Spot Removal");
                        group: "spot-removal";
                        reset => {
                            DevelopState.reset-group("spot-removal");
                        }
                        peek(group) => {
                            DevelopState.peek-group(group);
                        }
                        expanded <=> root.expand-spot-removal;
                    }
                    if root.expand-spot-removal: SpotRemovalGroup { }

                    GroupHeader {
                        label: @tr("Red Eye");
                        group: "red-eye";
                        reset => {
                            DevelopState.reset-group("red-eye");
                        }
                        peek(group) => {
                            DevelopState.peek-group(group);
                        }
                        expanded <=> root.expand-red-eye;
                    }
                    if root.expand-red-eye: RedEyeGroup { }

                    GroupHeader {
                        label: @tr("Reshape");
                        group: "reshape";
                        reset => {
                            DevelopState.reset-group("reshape");
                        }
                        peek(group) => {
                            DevelopState.peek-group(group);
                        }
                        expanded <=> root.expand-reshape;
                    }
                    if root.expand-reshape: ReshapeGroup { }

                    Rectangle {
                        height: Frame.bottom-bar;
                    }
                }
            }

            // The Masks entry (ADR 0160 §2): opening it picks no tool, so
            // the handles of the existing masks are what the photograph shows
            // first; the three buttons draw a new one. Full mode only.
            if root.rail-entry == "masks": Flickable {
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    alignment: start;
                    Rectangle {
                        height: Frame.top-bar;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        FilterChip {
                            text: @tr("Radial");
                            active: root.active-tool == "radial";
                            clicked => {
                                root.active-tool = "radial";
                                root.spot-pending = false;
                                root.dev-zoomed = false;
                                root.expand-local = true;
                            }
                        }
                        FilterChip {
                            text: @tr("Gradient");
                            active: root.active-tool == "gradient";
                            clicked => {
                                root.active-tool = "gradient";
                                root.spot-pending = false;
                                root.dev-zoomed = false;
                                root.expand-local = true;
                            }
                        }
                        FilterChip {
                            text: @tr("Brush");
                            active: root.active-tool == "brush";
                            clicked => {
                                root.active-tool = "brush";
                                root.spot-pending = false;
                                root.dev-zoomed = false;
                                root.expand-local = true;
                            }
                        }
                    }
                    GroupHeader {
                        label: @tr("Local Adjustments");
                        group: "local";
                        reset => {
                            DevelopState.reset-group("local");
                        }
                        peek(group) => {
                            DevelopState.peek-group(group);
                        }
                        expanded <=> root.expand-local;
                    }
                    // The masked adjustments of ADR 0029, refined by the range
                    // masks of ADR 0048 (ADR 0049): a list of entries, the
                    // selected one's values below it. Geometry is traced on the
                    // image with the three buttons above, never typed here.
                    if root.expand-local: LocalGroup {
                        active-tool <=> root.active-tool;
                        dev-zoomed <=> root.dev-zoomed;
                        expand-local <=> root.expand-local;
                    }
                    Rectangle {
                        height: Frame.bottom-bar;
                    }
                }
            }

            // The settings are hidden rather than torn down when another
            // entry opens: two thousand lines of sliders rebuilt on every
            // click of the rail, and the scroll position lost with them.
            Flickable {
                visible: root.rail-entry == "edit";
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    alignment: start;

                    Rectangle {
                        height: Frame.top-bar;
                    }

                    // Histogram (RGB, sqrt-scaled so one dominant bin
                    // doesn't flatten the rest, `develop::histogram_layout`):
                    // read-only, refreshed whenever the develop preview
                    // itself refreshes (i.e. at each commit point, the
                    // same cadence the image updates at).
                    Rectangle {
                        height: 90px;
                        background: Theme.sunken;
                        border-radius: 4px;
                        Path {
                            width: 100%;
                            height: 100%;
                            viewbox-width: 256;
                            viewbox-height: 90;
                            fill: Hues.histogram-red;
                            commands: DevelopState.dev-histogram-r;
                        }
                        Path {
                            width: 100%;
                            height: 100%;
                            viewbox-width: 256;
                            viewbox-height: 90;
                            fill: Hues.histogram-green;
                            commands: DevelopState.dev-histogram-g;
                        }
                        Path {
                            width: 100%;
                            height: 100%;
                            viewbox-width: 256;
                            viewbox-height: 90;
                            fill: Hues.histogram-blue;
                            commands: DevelopState.dev-histogram-b;
                        }

                        // The two clipping indicators (ADR 0092): lit when
                        // their end of the histogram is occupied, filled
                        // while their overlay paints the image. Squares
                        // rather than glyph triangles — the software
                        // renderer's fallback font drops most triangle
                        // glyphs (a lesson already paid for by the star
                        // ratings).
                        shadows-clip := Rectangle {
                            x: 4px;
                            y: 4px;
                            width: 10px;
                            height: 10px;
                            border-radius: 2px;
                            border-width: 1px;
                            border-color: DevelopState.dev-shadows-clipped ? Theme.focus : Theme.border;
                            background: DevelopState.dev-clip-shadows
                                ? Hues.clip-shadows
                                : (DevelopState.dev-shadows-clipped ? Hues.clip-shadows-veil : transparent);
                            // Two 10px squares at the corners of a
                            // histogram: the most wordless control in the
                            // application (ADR 0127 §2).
                            shadow-clip-touch := TouchArea {
                                clicked => {
                                    HintState.dismiss();
                                    DevelopState.toggle-clipping("shadows");
                                }
                                changed has-hover => {
                                    if (self.has-hover) {
                                        HintState.enter(@tr("Show crushed shadows    J"),
                                            self.absolute-position.x, self.absolute-position.y + self.height);
                                    } else {
                                        HintState.leave(@tr("Show crushed shadows    J"));
                                    }
                                }
                            }
                        }
                        highlights-clip := Rectangle {
                            x: parent.width - 14px;
                            y: 4px;
                            width: 10px;
                            height: 10px;
                            border-radius: 2px;
                            border-width: 1px;
                            border-color: DevelopState.dev-highlights-clipped ? Hues.clip-highlights-edge : Theme.border;
                            background: DevelopState.dev-clip-highlights
                                ? Hues.clip-highlights
                                : (DevelopState.dev-highlights-clipped ? Hues.clip-highlights-veil : transparent);
                            highlight-clip-touch := TouchArea {
                                clicked => {
                                    HintState.dismiss();
                                    DevelopState.toggle-clipping("highlights");
                                }
                                changed has-hover => {
                                    if (self.has-hover) {
                                        HintState.enter(@tr("Show clipped highlights    J"),
                                            self.absolute-position.x, self.absolute-position.y + self.height);
                                    } else {
                                        HintState.leave(@tr("Show clipped highlights    J"));
                                    }
                                }
                            }
                        }
                    }

                    // How the photo was taken, right under the histogram that
                    // shows what came of it: sensitivity, focal length,
                    // aperture, time. Read-only, and never a placeholder — a
                    // file that recorded none of it shows nothing rather than
                    // a row of dashes. The full metadata stays one keystroke
                    // away in the library panel; this is the part one checks
                    // *while* correcting an exposure.
                    if DevelopState.dev-iso != "" || DevelopState.dev-focal != ""
                        || DevelopState.dev-aperture != "" || DevelopState.dev-shutter != "":
                    HorizontalLayout {
                        alignment: space-between;
                        padding-left: 4px;
                        padding-right: 4px;
                        padding-bottom: 2px;
                        Text {
                            text: DevelopState.dev-iso;
                            color: Theme.text-disabled;
                            font-size: 11px;
                        }
                        Text {
                            text: DevelopState.dev-focal;
                            color: Theme.text-disabled;
                            font-size: 11px;
                        }
                        Text {
                            text: DevelopState.dev-aperture;
                            color: Theme.text-disabled;
                            font-size: 11px;
                        }
                        Text {
                            text: DevelopState.dev-shutter;
                            color: Theme.text-disabled;
                            font-size: 11px;
                        }
                    }

                    // Leaving Full mode drops any tool it alone showed, so a
                    // click on the image cannot keep tracing a mask whose
                    // panel is no longer visible (ADR 0054, Conséquences).
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        FilterChip {
                            text: @tr("Basic");
                            active: root.basic-mode;
                            clicked => {
                                root.basic-mode = true;
                                if (root.active-tool != "select" && root.active-tool != "crop") {
                                    root.active-tool = "select";
                                    root.spot-pending = false;
                                }
                            }
                        }
                        FilterChip {
                            text: @tr("Full");
                            active: !root.basic-mode;
                            clicked => {
                                root.basic-mode = false;
                            }
                        }
                    }

                    // The two buttons Lightroom puts above the Basic
                    // sliders (ADR 0088). `HDR`, its third, is a V1
                    // exclusion and is deliberately absent rather than
                    // present and disabled.
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        FilterChip {
                            text: @tr("Auto");
                            active: false;
                            clicked => {
                                DevelopState.run-auto-tone();
                            }
                        }
                        FilterChip {
                            text: @tr("B&W");
                            active: DevelopState.dev.monochrome;
                            clicked => {
                                DevelopState.develop-edit("monochrome", DevelopState.dev.monochrome ? 0 : 1);
                            }
                        }
                        // The whole development back to neutral, in one
                        // revision (ADR 0124 §4). Here rather than at the
                        // bottom of the column because the other two chips
                        // on this row also act on the development as a
                        // whole, and because a button one has to scroll
                        // sixteen groups to reach is a button one gives up
                        // on. No confirmation: `Ctrl+Z` and the History
                        // section take it straight back.
                        FilterChip {
                            text: @tr("Reset All");
                            active: false;
                            clicked => {
                                DevelopState.reset-group("all");
                            }
                        }
                    }

                    // One panel, three sub-headings: the light first, the
                    // matter next, the colour last — the order the Basic panel
                    // is taught in, and the reason it is one group rather than
                    // three (ADR 0054 §2).
                    GroupHeader {
                        label: @tr("Basic");
                        group: "basic";
                        reset => {
                            DevelopState.reset-group("basic");
                        }
                        peek(group) => {
                            DevelopState.peek-group(group);
                        }
                        expanded <=> root.expand-basic;
                        // The targeted adjustment (ADR 0130 §3) heads the
                        // group whose sliders it moves (ADR 0160 §3); a
                        // second click puts Select back.
                        FilterChip {
                            text: @tr("Target");
                            active: root.active-tool == "target";
                            clicked => {
                                root.active-tool = root.active-tool == "target" ? "select" : "target";
                                root.spot-pending = false;
                                root.dev-zoomed = false;
                                root.expand-basic = true;
                            }
                        }
                    }
                    if root.expand-basic: BasicGroup {
                        active-tool <=> root.active-tool;
                        basic-mode <=> root.basic-mode;
                        dev-zoomed <=> root.dev-zoomed;
                        spot-pending <=> root.spot-pending;
                    }

                    if !root.basic-mode: GroupHeader {
                        label: @tr("Camera profile");
                        group: "camera-profile";
                        reset => {
                            DevelopState.reset-group("camera-profile");
                        }
                        peek(group) => {
                            DevelopState.peek-group(group);
                        }
                        expanded <=> root.expand-camera-profile;
                    }
                    if !root.basic-mode && root.expand-camera-profile: CameraProfileGroup { }

                    if !root.basic-mode: GroupHeader {
                        label: @tr("Creative LUT");
                        group: "lut";
                        reset => {
                            DevelopState.reset-group("lut");
                        }
                        peek(group) => {
                            DevelopState.peek-group(group);
                        }
                        expanded <=> root.expand-lut;
                    }
                    // A look chosen elsewhere and imported into the library
                    // (ADR 0053), as opposed to the color operators above,
                    // which are Leyline's own.
                    if !root.basic-mode && root.expand-lut: LutGroup { }

                    GroupHeader {
                        label: @tr("Lens correction");
                        group: "lens";
                        reset => {
                            DevelopState.reset-group("lens");
                        }
                        peek(group) => {
                            DevelopState.peek-group(group);
                        }
                        expanded <=> root.expand-lens;
                    }
                    if root.expand-lens: LensGroup { }

                    GroupHeader {
                        label: @tr("Detail");
                        group: "detail";
                        reset => {
                            DevelopState.reset-group("detail");
                        }
                        peek(group) => {
                            DevelopState.peek-group(group);
                        }
                        expanded <=> root.expand-detail;
                    }
                    if root.expand-detail: DetailGroup {
                        basic-mode <=> root.basic-mode;
                    }

                    // Effects (ADR 0090): the vignette a photographer adds —
                    // not the one `Lens correction` above removes — and film
                    // grain. Advanced mode only, like the tone curve: they
                    // are finishing tools, not the first six sliders anyone
                    // reaches for (ADR 0054 §2).
                    if !root.basic-mode: GroupHeader {
                        label: @tr("Effects");
                        group: "effects";
                        reset => {
                            DevelopState.reset-group("effects");
                        }
                        peek(group) => {
                            DevelopState.peek-group(group);
                        }
                        expanded <=> root.expand-effects;
                    }
                    if !root.basic-mode && root.expand-effects: EffectsGroup { }

                    if !root.basic-mode: GroupHeader {
                        label: @tr("Tone Curve");
                        group: "tone-curve";
                        reset => {
                            DevelopState.reset-group("tone-curve");
                        }
                        peek(group) => {
                            DevelopState.peek-group(group);
                        }
                        expanded <=> root.expand-tone-curve;
                    }
                    if !root.basic-mode && root.expand-tone-curve: ToneCurveGroup { }

                    // Levels (ADR 0164): after the curves in the panel as in
                    // the pipeline's neighbourhood — rank 78, between the
                    // parametric curve and the point curve. The gamma slider
                    // stops at 3, where the useful range ends; a typed value
                    // or the CLI reaches the 9.99 the setting allows.
                    if !root.basic-mode: GroupHeader {
                        label: @tr("Levels");
                        group: "levels";
                        reset => {
                            DevelopState.reset-group("levels");
                        }
                        peek(group) => {
                            DevelopState.peek-group(group);
                        }
                        expanded <=> root.expand-levels;
                    }
                    if !root.basic-mode && root.expand-levels: LevelsGroup { }

                    if !root.basic-mode: GroupHeader {
                        label: @tr("HSL Mixer");
                        group: "hsl";
                        reset => {
                            DevelopState.reset-group("hsl");
                        }
                        peek(group) => {
                            DevelopState.peek-group(group);
                        }
                        expanded <=> root.expand-hsl;
                    }
                    if !root.basic-mode && root.expand-hsl && DevelopState.dev.monochrome: Text {
                        // ADR 0088 §3: in black and white the luminance
                        // sliders *are* the mix, and hue and saturation have
                        // nothing left to act on. Said rather than hidden —
                        // greying them out would suggest they were broken.
                        text: @tr("In black and white, only Luminance acts: it is the B&W mix.");
                        color: Theme.text-dim;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                    if !root.basic-mode && root.expand-hsl: HslGroup {
                        hsl-band-names <=> root.hsl-band-names;
                    }

                    if !root.basic-mode: GroupHeader {
                        label: @tr("Color Grading");
                        group: "color-grading";
                        reset => {
                            DevelopState.reset-group("color-grading");
                        }
                        peek(group) => {
                            DevelopState.peek-group(group);
                        }
                        expanded <=> root.expand-color-grading;
                    }
                    if !root.basic-mode && root.expand-color-grading: ColorGradingGroup { }

                    if !root.basic-mode: GroupHeader {
                        label: @tr("Soft Proof");
                        expanded <=> root.expand-proof;
                    }
                    // A way of looking at the photo, not a setting of it
                    // (ADR 0034): nothing here is stored, and leaving the
                    // proof shows the real render again.
                    if !root.basic-mode && root.expand-proof: ProofGroup { }

                    GroupHeader {
                        label: @tr("Geometry");
                        group: "geometry";
                        reset => {
                            DevelopState.reset-group("geometry");
                        }
                        peek(group) => {
                            DevelopState.peek-group(group);
                        }
                        expanded <=> root.expand-geometry;
                        // Keystone by drawn lines (ADR 0119) heads the group
                        // whose sliders it writes (ADR 0160 §3). Picking it
                        // zeroes the two perspective sliders: the guides are
                        // read against the photograph *before* the correction
                        // (§4).
                        if !root.basic-mode: FilterChip {
                            text: @tr("Keystone");
                            active: root.active-tool == "keystone";
                            clicked => {
                                if (root.active-tool == "keystone") {
                                    root.active-tool = "select";
                                } else {
                                    root.active-tool = "keystone";
                                    root.dev-zoomed = false;
                                    root.expand-geometry = true;
                                    DevelopState.develop-keystone-begin();
                                }
                            }
                        }
                    }
                    if root.expand-geometry: GeometryGroup { }

                    // Versions and History used to close this column.
                    // They are lists of *states*, not settings (ADR 0112
                    // §4), and are now rail entries of their own
                    // (ADR 0158 §4, `develop_states.slint`).

                    // The last group can still be scrolled clear of the
                    // window's bottom bar (ADR 0158 §2).
                    Rectangle {
                        height: Frame.bottom-bar;
                    }
                }
            }
        }

        if !root.side-panels-hidden: Rail {
            open-entry <=> root.rail-entry;
            full-mode: !root.basic-mode;
        }
}
