// Leyline Studio main window (`docs/roadmap.md` phase 5).
//
// The library browser: a filter bar on top, a thumbnail grid on the left,
// the metadata of the selected photo on the right.
//
// This file is the assembly point (ADR 0045): shared types live in
// `types.slint`, reusable controls in `widgets/`, and each panel or dialog
// in its own file. `StudioWindow` below holds the window attributes, the
// keyboard `FocusScope`, and the layout that puts the pieces together.
//
// The generated Rust re-exports what it needs through the `ui` module in
// `src/main.rs`, so every type named here must stay `export`ed from the
// file that declares it.

import {
    Cell,
    CollectionRow,
    ColorGradingZoneValues,
    CurveMarker,
    DevSettings,
    HslBandValues,
    MapPinMarker,
    Tr,
} from "types.slint";
import { LibraryState } from "state/library.slint";
import { FilterState } from "state/filter.slint";
import { DetailState } from "state/detail.slint";
import { CollectionState } from "state/collection.slint";
import { GridState } from "state/grid.slint";
import { MapState } from "state/map.slint";
import { DevelopState } from "state/develop.slint";
import { DialogState } from "state/dialog.slint";
import { BrowserPanel } from "panels/browser.slint";
import { DialogOverlay } from "panels/dialogs.slint";
import { DevelopPanel } from "panels/develop.slint";
import { MapPanel } from "panels/map.slint";
import { DetailRow, EditSlider, FilterChip, GroupHeader } from "widgets/controls.slint";
import { MenuDropdown, MenuRow, MenuSep, SubmenuHeader, TopMenuLabel } from "widgets/menu.slint";

// Structs reach the generated Rust just by being used in the compiled tree,
// but a `global` only does when the root file re-exports it explicitly —
// without this, `ui::Tr` doesn't exist and Rust can't build its status-line
// and dialog messages (ADR 0019).
export { CollectionState, DetailState, DevelopState, DialogState, FilterState, GridState, LibraryState, MapState, Tr }

export component StudioWindow inherits Window {
    title: "Leyline Studio — " + LibraryState.library-name;
    // Taskbar/Alt-Tab/window-manager icon: the square badge, matching the
    // .exe icon embedded via windows-manifest.rc and the Linux desktop
    // entry's `packaging/icons` (ADR 0019) — one source of truth for "the
    // app icon" everywhere it's requested at a fixed square size.
    icon: @image-url("../../../packaging/icons/icon.png");
    preferred-width: 1280px;
    preferred-height: 800px;
    // Keeps the window from being resized below a usable size — mirrors
    // `MIN_WINDOW_WIDTH`/`MIN_WINDOW_HEIGHT` in main.rs, which only clamp
    // the *initial* screen-relative size and don't constrain later resizes.
    min-width: 1024px;
    min-height: 700px;
    background: #1b1b1b;
    forward-focus: keys;











    // Custom menu bar state (see `TopMenuLabel`/`MenuDropdown` above).
    // `open-menu` is "" or one of "file"/"library"/"photo"/"develop-menu"/
    // "view"/"help"; the inline-expand submenus are independent booleans
    // since at most one of each is ever meaningfully open at a time.
    property <string> open-menu: "";
    property <bool> rate-submenu-open: false;
    property <bool> label-submenu-open: false;
    property <bool> flag-submenu-open: false;
    property <bool> apply-preset-submenu-open: false;
    property <bool> open-recent-submenu-open: false;

    function reset-submenus() {
        root.rate-submenu-open = false;
        root.label-submenu-open = false;
        root.flag-submenu-open = false;
        root.apply-preset-submenu-open = false;
        root.open-recent-submenu-open = false;
    }



    keys := FocusScope {
        key-pressed(event) => {
            if (DialogState.dialog != "") {
                if (event.text == Key.Escape) {
                    DialogState.dialog = "";
                }
                return accept;
            }
            if (root.open-menu != "") {
                if (event.text == Key.Escape) {
                    root.open-menu = "";
                    root.reset-submenus();
                }
                return accept;
            }
            if (MapState.map-mode) {
                if (event.text == "m" || event.text == "M" || event.text == Key.Escape) {
                    MapState.exit-map();
                }
                return accept;
            }
            if (event.modifiers.control && (event.text == "p" || event.text == "P")) {
                DialogState.open-print();
                return accept;
            }
            if (event.modifiers.control && (event.text == "c" || event.text == "C")) {
                DevelopState.copy-settings();
                return accept;
            }
            if (event.modifiers.control && (event.text == "v" || event.text == "V")) {
                DevelopState.paste-settings();
                return accept;
            }
            if (DevelopState.develop-mode) {
                if (event.text == "g" || event.text == "G" || event.text == Key.Escape) {
                    DevelopState.exit-develop();
                    return accept;
                }
                if (event.modifiers.control && (event.text == "z" || event.text == "Z")) {
                    DevelopState.develop-undo();
                    return accept;
                }
                if (event.modifiers.control && (event.text == "y" || event.text == "Y")) {
                    DevelopState.develop-redo();
                    return accept;
                }
                if (event.text == "s" || event.text == "S") {
                    DevelopState.open-preset-dialog();
                    return accept;
                }
                if (event.text == "r" || event.text == "R") {
                    DevelopState.develop-reprocess();
                    return accept;
                }
                if (event.text == "\\") {
                    DevelopState.toggle-compare();
                    return accept;
                }
                if ((event.text == "z" || event.text == "Z") && develop.active-tool == "select") {
                    develop.dev-zoomed = !develop.dev-zoomed;
                    return accept;
                }
                if (event.text == Key.LeftArrow) {
                    DevelopState.develop-prev();
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    DevelopState.develop-next();
                    return accept;
                }
                GridState.classify(event.text);
                return accept;
            }
            if (event.text == "d" || event.text == "D" || event.text == Key.Return) {
                DevelopState.enter-develop();
                return accept;
            }
            if (event.text == "i" || event.text == "I") {
                DialogState.dialog-result = "";
                DialogState.dialog = "import";
                return accept;
            }
            if (event.text == "e" || event.text == "E") {
                DialogState.open-export();
                return accept;
            }
            if (event.text == "t" || event.text == "T") {
                DialogState.open-tether();
                return accept;
            }
            if (event.text == "m" || event.text == "M") {
                MapState.enter-map();
                return accept;
            }
            if (event.text == "n" || event.text == "N") {
                DialogState.dialog-result = "";
                DialogState.dialog = "collection";
                return accept;
            }
            if (event.text == "b" || event.text == "B") {
                if (event.modifiers.shift) {
                    CollectionState.remove-from-collection();
                } else {
                    CollectionState.add-to-collection();
                }
                return accept;
            }
            if ((event.text == "r" || event.text == "R") && event.modifiers.shift) {
                DevelopState.reprocess-library();
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                browser.select-cell(max(GridState.selected - 1, 0));
                return accept;
            }
            if (event.text == Key.RightArrow) {
                browser.select-cell(GridState.selected < 0 ? 0 : GridState.selected + 1);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                browser.select-cell(GridState.selected - browser.columns);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                browser.select-cell(GridState.selected < 0 ? 0 : GridState.selected + browser.columns);
                return accept;
            }
            GridState.classify(event.text);
            accept
        }

        develop := DevelopPanel { }

        MapPanel { }

        browser := BrowserPanel {
            return-focus => {
                keys.focus();
            }
        }

        // Modal overlay: import and export dialogs.
        DialogOverlay { }

        // Custom menu bar's dropdown panels (see `TopMenuLabel` above for
        // why this isn't Slint's native `MenuBar`). Declared last so they
        // paint over everything, including the modal dialog overlay above.
        if root.open-menu != "": Rectangle {
            // Invisible full-window catcher: clicking outside any dropdown
            // closes the open menu.
            TouchArea {
                clicked => {
                    root.open-menu = "";
                    root.reset-submenus();
                }
            }

            if root.open-menu == "file": MenuDropdown {
                x: file-label.x;
                y: 28px;
                MenuRow {
                    title: @tr("Import…    I");
                    activated => {
                        DialogState.dialog-result = "";
                        DialogState.dialog = "import";
                        root.open-menu = "";
                    }
                }
                MenuRow {
                    title: @tr("Export…    E");
                    activated => {
                        DialogState.open-export();
                        root.open-menu = "";
                    }
                }
                MenuSep { }
                MenuRow {
                    title: @tr("Open Library…");
                    activated => {
                        LibraryState.open-library-requested();
                        root.open-menu = "";
                    }
                }
                SubmenuHeader {
                    title: @tr("Open Recent");
                    expanded <=> root.open-recent-submenu-open;
                    enabled: LibraryState.recent-libraries.length > 0;
                }
                if root.open-recent-submenu-open: VerticalLayout {
                    for path[index] in LibraryState.recent-libraries: MenuRow {
                        title: path;
                        activated => {
                            LibraryState.open-recent-library(index);
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                }
                MenuSep { }
                MenuRow {
                    title: @tr("Print…    Ctrl+P");
                    activated => {
                        DialogState.open-print();
                        root.open-menu = "";
                    }
                }
                MenuRow {
                    title: @tr("Tethered Capture…    T");
                    activated => {
                        DialogState.open-tether();
                        root.open-menu = "";
                    }
                }
                MenuRow {
                    title: @tr("Auto Import…");
                    activated => {
                        DialogState.open-watch();
                        root.open-menu = "";
                    }
                }
                MenuRow {
                    title: @tr("Map…    M");
                    activated => {
                        MapState.enter-map();
                        root.open-menu = "";
                    }
                }
                MenuSep { }
                MenuRow {
                    // ADR 0019 (language preferences) is decided but not
                    // yet implemented: kept visible per the ADR 0020 menu
                    // map, disabled until there is a preferences panel to
                    // open.
                    title: @tr("Preferences…");
                    enabled: false;
                }
                MenuSep { }
                MenuRow {
                    title: @tr("Quit");
                    activated => {
                        LibraryState.quit();
                    }
                }
            }

            if root.open-menu == "library": MenuDropdown {
                x: library-label.x;
                y: 28px;
                MenuRow {
                    title: @tr("New Collection…    N");
                    activated => {
                        DialogState.dialog-result = "";
                        DialogState.dialog = "collection";
                        root.open-menu = "";
                    }
                }
                MenuRow {
                    title: @tr("Add to Collection    B");
                    enabled: GridState.selected >= 0 && CollectionState.active-collection >= 0;
                    activated => {
                        CollectionState.add-to-collection();
                        root.open-menu = "";
                    }
                }
                MenuRow {
                    title: @tr("Remove from Collection    Shift+B");
                    enabled: GridState.selected >= 0 && CollectionState.active-collection >= 0;
                    activated => {
                        CollectionState.remove-from-collection();
                        root.open-menu = "";
                    }
                }
                MenuSep { }
                MenuRow {
                    title: @tr("Reprocess Library…    Shift+R");
                    activated => {
                        DevelopState.reprocess-library();
                        root.open-menu = "";
                    }
                }
            }

            if root.open-menu == "photo": MenuDropdown {
                x: photo-label.x;
                y: 28px;
                SubmenuHeader {
                    title: @tr("Rate");
                    expanded <=> root.rate-submenu-open;
                }
                if root.rate-submenu-open: VerticalLayout {
                    MenuRow {
                        title: @tr("1 star    1");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("1");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                    MenuRow {
                        title: @tr("2 stars    2");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("2");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                    MenuRow {
                        title: @tr("3 stars    3");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("3");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                    MenuRow {
                        title: @tr("4 stars    4");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("4");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                    MenuRow {
                        title: @tr("5 stars    5");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("5");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                    MenuSep { }
                    MenuRow {
                        title: @tr("Clear Rating    0");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("0");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                }
                SubmenuHeader {
                    title: @tr("Label");
                    expanded <=> root.label-submenu-open;
                }
                if root.label-submenu-open: VerticalLayout {
                    MenuRow {
                        title: @tr("Red    6");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("6");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                    MenuRow {
                        title: @tr("Yellow    7");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("7");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                    MenuRow {
                        title: @tr("Green    8");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("8");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                    MenuRow {
                        title: @tr("Blue    9");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("9");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                }
                SubmenuHeader {
                    title: @tr("Flag");
                    expanded <=> root.flag-submenu-open;
                }
                if root.flag-submenu-open: VerticalLayout {
                    MenuRow {
                        title: @tr("Pick    P");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("p");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                    MenuRow {
                        title: @tr("Reject    X");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("x");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                    MenuRow {
                        title: @tr("Clear    U");
                        enabled: GridState.selected >= 0;
                        activated => {
                            GridState.classify("u");
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                }
                MenuSep { }
                MenuRow {
                    title: @tr("Develop    D");
                    enabled: GridState.selected >= 0 && !DevelopState.develop-mode;
                    activated => {
                        DevelopState.enter-develop();
                        root.open-menu = "";
                    }
                }
                MenuRow {
                    // Today `R` only reprocesses the photo open in
                    // develop — same contract here: disabled outside
                    // that context rather than silently acting on
                    // something else.
                    title: @tr("Reprocess    R");
                    enabled: DevelopState.develop-mode;
                    activated => {
                        DevelopState.develop-reprocess();
                        root.open-menu = "";
                    }
                }
            }

            if root.open-menu == "develop-menu" && DevelopState.develop-mode: MenuDropdown {
                x: develop-label.x;
                y: 28px;
                MenuRow {
                    title: @tr("Undo    Ctrl+Z");
                    activated => {
                        DevelopState.develop-undo();
                        root.open-menu = "";
                    }
                }
                MenuRow {
                    title: @tr("Redo    Ctrl+Y");
                    activated => {
                        DevelopState.develop-redo();
                        root.open-menu = "";
                    }
                }
                MenuSep { }
                MenuRow {
                    title: @tr("Save Preset…    S");
                    activated => {
                        DevelopState.open-preset-dialog();
                        root.open-menu = "";
                    }
                }
                SubmenuHeader {
                    title: @tr("Apply Preset");
                    expanded <=> root.apply-preset-submenu-open;
                    enabled: DevelopState.dev-presets.length > 0;
                }
                if root.apply-preset-submenu-open: VerticalLayout {
                    for name[index] in DevelopState.dev-presets: MenuRow {
                        title: name;
                        activated => {
                            DevelopState.apply-preset(index);
                            root.open-menu = "";
                            root.reset-submenus();
                        }
                    }
                }
                MenuSep { }
                MenuRow {
                    title: @tr("Back to Library    G");
                    activated => {
                        DevelopState.exit-develop();
                        root.open-menu = "";
                    }
                }
            }

            if root.open-menu == "view": MenuDropdown {
                x: view-label.x;
                y: 28px;
                MenuRow {
                    title: @tr("Library    G");
                    enabled: DevelopState.develop-mode;
                    activated => {
                        DevelopState.exit-develop();
                        root.open-menu = "";
                    }
                }
                MenuRow {
                    title: @tr("Develop    D");
                    enabled: !DevelopState.develop-mode && GridState.selected >= 0;
                    activated => {
                        DevelopState.enter-develop();
                        root.open-menu = "";
                    }
                }
            }

            if root.open-menu == "help": MenuDropdown {
                x: help-label.x;
                y: 28px;
                MenuRow {
                    title: @tr("Keyboard Shortcuts…");
                    activated => {
                        DialogState.dialog-result = "";
                        DialogState.dialog = "shortcuts";
                        root.open-menu = "";
                    }
                }
                MenuRow {
                    title: @tr("About Leyline");
                    activated => {
                        DialogState.dialog-result = "";
                        DialogState.dialog = "about";
                        root.open-menu = "";
                    }
                }
            }
        }
    }

    // `MenuBar` was a magic top-level element Slint gives special sizing
    // treatment (reserving space above the rest of the content natively);
    // a plain `HorizontalLayout` isn't. `keys` above (and its content)
    // therefore keeps its untouched, default fill-parent geometry —
    // giving it (or any ancestor of its repeaters: the grid, the
    // collections list) an explicit position/size override of any kind,
    // even a inert-looking one, was enough on its own to reintroduce a
    // repaint bug extremely similar to the native-`MenuBar` one this whole
    // rewrite exists to avoid (confirmed repeatedly; see
    // studio-repaint-bug-unresolved in project memory for the fuller
    // writeup). Concretely, this means: (1) `menu-row` is declared last —
    // after `keys` — purely so it paints on top of it (Slint paints
    // siblings in declaration order); it is not stacked above `keys` via
    // layout, the two simply overlap, and (2) each content column that
    // needs to visually clear the menu row's height reserves that space
    // with a plain spacer `Rectangle` as an extra *child* inside its own
    // already-existing `VerticalLayout` (adding a sibling element was
    // safe in testing) — never via a property override on the column
    // itself or on `keys`.
    menu-row := HorizontalLayout {
        // Custom menu bar (ADR 0020): a second, discoverable path to the
        // same callbacks already wired to keyboard shortcuts above — no
        // new functionality, no new code path. Context-sensitive entries
        // are disabled outside the context where their shortcut is
        // meaningful. Not Slint's native `MenuBar` — see the comment above
        // `TopMenuLabel` for why. The dropdown panels themselves are
        // declared later, in the same overlay z-order as the modal
        // dialogs, so they paint on top of the grid/develop view; only the
        // row of labels lives here.
        x: 0;
        y: 0;
        height: 28px;
        alignment: start;
        padding-left: 4px;
        spacing: 2px;

        file-label := TopMenuLabel {
            title: @tr("File");
            active: root.open-menu == "file";
            clicked => {
                root.open-menu = root.open-menu == "file" ? "" : "file";
                root.reset-submenus();
            }
        }
        library-label := TopMenuLabel {
            title: @tr("Library");
            active: root.open-menu == "library";
            clicked => {
                root.open-menu = root.open-menu == "library" ? "" : "library";
                root.reset-submenus();
            }
        }
        photo-label := TopMenuLabel {
            title: @tr("Photo");
            active: root.open-menu == "photo";
            clicked => {
                root.open-menu = root.open-menu == "photo" ? "" : "photo";
                root.reset-submenus();
            }
        }
        develop-label := TopMenuLabel {
            title: @tr("Develop");
            active: root.open-menu == "develop-menu";
            enabled: DevelopState.develop-mode;
            clicked => {
                root.open-menu = root.open-menu == "develop-menu" ? "" : "develop-menu";
                root.reset-submenus();
            }
        }
        view-label := TopMenuLabel {
            title: @tr("View");
            active: root.open-menu == "view";
            clicked => {
                root.open-menu = root.open-menu == "view" ? "" : "view";
                root.reset-submenus();
            }
        }
        help-label := TopMenuLabel {
            title: @tr("Help");
            active: root.open-menu == "help";
            clicked => {
                root.open-menu = root.open-menu == "help" ? "" : "help";
                root.reset-submenus();
            }
        }
    }
}
