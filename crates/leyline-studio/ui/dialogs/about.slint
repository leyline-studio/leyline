// Help ▸ About Leyline (ADR 0020): version, library location, licence, and
// the build details a bug report needs.
//
// Two panes rather than the five tabs RawTherapee shows: credits and the
// full GPL text already live in the repository, and repeating them in a
// dialog is filler. What is *not* elsewhere — which commit this binary came
// from — is what a bug report cannot do without.
//
// One of the dialogs hosted by `panels/dialogs.slint` (ADR 0045 §3).

import { DialogState } from "../state/dialog.slint";
import { LibraryState } from "../state/library.slint";
import { FilterChip } from "../widgets/controls.slint";

export component AboutDialog inherits VerticalLayout {
    spacing: 12px;
    // Which pane is showing. Local to the dialog: nothing outside it needs
    // to know, and nothing about it is worth storing (ADR 0045 §2).
    property <bool> show-build: false;
    HorizontalLayout {
        alignment: center;
        // The wide wordmark banner, not the square app
        // icon: About is the one place in the UI with
        // room to show the full brand lockup rather than
        // just the badge used everywhere else (window
        // icon, taskbar, installer — see `icon:` on
        // `StudioWindow`).
        Image {
            source: @image-url("../../../../assets/leyline-studio.png");
            width: 300px;
            height: 200px;
            image-fit: contain;
        }
    }
    Text {
        text: @tr("Version {}", LibraryState.app-version);
        color: #9a9a9a;
        font-size: 11px;
        horizontal-alignment: center;
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: center;
        FilterChip {
            text: @tr("About");
            active: !root.show-build;
            clicked => {
                root.show-build = false;
            }
        }
        FilterChip {
            text: @tr("Build");
            active: root.show-build;
            clicked => {
                root.show-build = true;
            }
        }
    }
    if root.show-build: Text {
        // Selectable so it can be pasted straight into a report rather than
        // copied out by hand.
        text: LibraryState.build-details;
        color: #c8c8c8;
        font-size: 11px;
        wrap: word-wrap;
    }
    if !root.show-build: Text {
        text: @tr("Local-first, non-destructive RAW development.");
        color: #c8c8c8;
        font-size: 12px;
        wrap: word-wrap;
    }
    if !root.show-build: Text {
        text: @tr("Library: {}", LibraryState.library-path);
        color: #909090;
        font-size: 11px;
        wrap: word-wrap;
    }
    Text {
        text: "https://github.com/leyline-studio/leyline";
        color: #c8b06a;
        font-size: 11px;
        wrap: word-wrap;
    }
    Text {
        text: @tr("Licensed under {}", "GPL-3.0-only");
        color: #9a9a9a;
        font-size: 11px;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: end;
        FilterChip {
            text: @tr("Close");
            active: true;
            clicked => {
                DialogState.dialog = "";
            }
        }
    }
}
